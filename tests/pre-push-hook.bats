    [[ "$output" == *"romp pre-push: the OBJECT of tag refs/tags/v1 (${tag:0:10}) was captured while its SIZE reads \"$size\" (git cat-file -s) and the capture's BYTE COUNT \"\" (wc -c), not two counts"* ]]
    run remote_holds_ref refs/tags/v1
    [ "$status" -ne 0 ]
}

