    [[ "$output" == *"Binary files"* ]]
    run_hook
    [ "$status" -eq 1 ]
    [[ "$output" == *"ADDS a credential (github-pat) in: probe.py"* ]]
    [[ "$output" == *"gitleaks found a credential"* ]]
