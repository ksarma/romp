    [[ "$output" != *"romp pre-push"* ]]
    [ "$(cat "$TEST_DIR/calls.cpremise")" = in-log ]
    [ "$(cat "$TEST_DIR/calls.clogmode")" = "-rw-------" ]          # mode 600
    [[ "$(cat "$TEST_DIR/calls.clogpath")" == "$TMPDIR/romp-pre-push."*"/creds.canary.log" ]]
    [ ! -e "$(cat "$TEST_DIR/calls.clogpath")" ]
    [[ "$output" != *"$(r12b3_value)"* ]]
    r12b_no_trace_shown
    [ -z "$(ls -A "$TMPDIR")" ]
}

