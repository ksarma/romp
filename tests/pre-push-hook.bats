        printf '    %q "$@"; s=$?\n' "$real_awk"
        printf '    t=$ROMP_PATHS_FILE; %q -n 1 "$t" > "$t.cut" && %q "$t.cut" "$t"\n' "$real_head" "$real_mv"
        printf '    printf "%%s\\n" "awk cut $t" >> %q; exit "$s" ;;\n' "$TEST_DIR/calls.pathcut"
