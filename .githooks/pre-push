                # holds under any path was judged here, by the grep (read, or skipped
                # and refused below) or by the symlink pass, and is not judged again.
                LC_ALL=C awk '{ i = index($0, "\t"); split(substr($0, 1, i - 1), f, " "); if (f[1] == "100644" || f[1] == "100755" || f[1] == "120000") print f[3] }' "$scratch/listing.nl" > "$scratch/tipblobs"
                # "<mode> blob <sha> <size>\t<path>" against "<tree-ish>:<path>": a
                # regular file with bytes that the grep did not list is one it skipped.
                LC_ALL=C awk -v sha="$local_sha" '
                    FILENAME == ARGV[1] { if (substr($0, 1, length(sha) + 1) == sha ":") read[substr($0, length(sha) + 2)] = 1; next }
                    { i = index($0, "\t"); split(substr($0, 1, i - 1), f, " "); path = substr($0, i + 1)
                      if ((f[1] == "100644" || f[1] == "100755") && f[4] + 0 > 0 && !(path in read)) printf "tip\t%s\t%s\n", f[3], path }' \
                    "$scratch/read.nl" "$scratch/listing.nl" | tr '\n' '\0' >> "$scratch/entries"
            fi
        fi
    fi
    : > "$scratch/pcount"       # "<sha> <parent count>", one per line: the count the report below reads a commit's previous versions by
    while read -r -u 3 rev n; do
        [ -n "$rev" ] || continue
        listing_rc=0; git diff-tree -r --raw --no-renames --root -c -z --no-commit-id "$rev" > "$scratch/listing" || listing_rc=$?
        [ "$listing_rc" -eq 0 ] || unscanned "the CHANGED PATHS of commit ${rev:0:10} could not be listed for the BINARY VERDICT check (git diff-tree exited $listing_rc)"
        # Two records per listing entry: ":<modes> <shas> <status>" (a merge's
        # combined line has one more mode, sha and leading colon per parent; the
        # post-image mode and sha come last of their kind) and then the path.
        : > "$scratch/listed"    # every path the listing names, any status and mode, one per NUL: the population the verdicts below must agree with
        : > "$scratch/post"      # "<blob>\t<path>", one per NUL: the post-image blobs (a regular file or a symlink), a mode-only change left out
        : > "$scratch/gone"      # the pre-image blobs of the deletions, one per NUL: a pure rename's new path has its blob here
        : > "$scratch/links"     # the paths of the symlinks among a one-parent commit's post-images, one per NUL: the line for one names no attribute
        : > "$scratch/tpaths"    # the paths judged as the addition of their new object, one per NUL: a one-parent commit's type changes (status T) here; a merge's rename candidates below
        # More than one parent: the combined patch's own verdict, not the pair's.
        # Decided by the parent count the caller read (rev-list --parents, once
        # per commit for the added-lines pass), not by the listing's shape: a
        # listing that answered nothing for a merge would read as a one-parent
        # commit's, whose pair numstat prints nothing for a merge, and the two
        # empty answers would agree. The listing's shape decides only when that
        # read failed (refused there, so any verdict here is on a refused push).
        merge=0; k=1
        case "$n" in ''|*[!0-9]*) n="" ;; *) [ "$n" -le 1 ] || merge=1 ;; esac
