                # class), when it exited 0: its record count against the entry count
                # of the symlink pass's plain listing of the same tree (a different
                # number either way: a listing can answer long as well as short), and
                # every file the grep lists as read against the paths it names. An
                # emptied or shortened listing would otherwise empty the tip's
                # complement and its blob set, and a hidden text file at the tip, the
                # remote already holding it, would be judged by nothing. Each count
                # is a run of digits before -eq reads it.
                if [ "$listing_rc" -eq 0 ]; then
                    count=$(grep -c . "$scratch/listing.nl") || true
                    if [ -z "$count" ] || [ -n "${count//[0-9]/}" ] || [ -z "$tip_entries" ] || [ -n "${tip_entries//[0-9]/}" ]; then
                        unscanned "the TREE of the tip of $local_ref (${local_sha:0:10}) could not be counted for the BINARY VERDICT check (the -z listing's entries counted as \"$count\" and the symlink pass's as \"$tip_entries\", not two counts)"
                    elif [ "$count" -ne "$tip_entries" ]; then
                        unscanned "the TREE of the tip of $local_ref (${local_sha:0:10}) was listed short or long for the BINARY VERDICT check (git ls-tree -r -z -l exited 0 and listed $count entries where the symlink pass's git ls-tree -r of the same tree listed $tip_entries)"
                    fi
                    path=$(LC_ALL=C awk -v sha="$local_sha" '
                        FILENAME == ARGV[1] { i = index($0, "\t"); listed[substr($0, i + 1)] = 1; next }
                        { if (substr($0, 1, length(sha) + 1) == sha ":") { p = substr($0, length(sha) + 2); if (!(p in listed)) { print p; exit } } }' \
                        "$scratch/listing.nl" "$scratch/read.nl")
                    [ -z "$path" ] || unscanned "the TREE of the tip of $local_ref (${local_sha:0:10}) was listed short for the BINARY VERDICT check (git ls-tree -r -z -l exited 0 and its listing lacks $path, a file the grep of the tip lists as read)"
                fi
