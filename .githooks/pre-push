        # path a numstat row or a combined-patch section names must be one the
        # listing named, whatever its status or mode (a rename's row keeps the
        # new path, listed as an addition under --no-renames; the addition
        # numstat's paths are the listing's own). The first path missing names
        # the listing as short, and the push is refused as unscanned; whatever
        # was listed is still judged below. Gated on the listing's own status 0
        # and on every verdict read having exited 0, so a read that failed is
        # refused once, above, and not again here with a wrong cause. The
        # per-parent listing of a merge (-m) is never compared: it names paths
        # that differ from one parent alone, which the combined listing leaves
        # out by design.
        if [ "$listing_rc" -eq 0 ] && [ "$numstat_ok" -ne 0 ]; then
