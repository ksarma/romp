            combined_rows "$scratch/patch" > "$scratch/rows"
            rc=0; git diff-tree -r --raw --no-renames -m -z --no-commit-id "$rev" > "$scratch/parents" || rc=$?
            [ "$rc" -eq 0 ] || { numstat_ok=0; unscanned "the BINARY VERDICTS of commit ${rev:0:10} could not be read (git diff-tree --raw -m, the merge's changes against each parent, exited $rc)"; }
            while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
                # shellcheck disable=SC2206  # the record is deliberately word-split
                fields=($meta)
                [ "${fields[1]}" != 000000 ] || printf '%s\0' "${fields[2]}" >> "$scratch/gone"
            done < "$scratch/parents"
            rc=0; as_lines "$scratch/post" "$scratch/gone" || rc=$?
            if [ "$rc" -eq 1 ]; then
                unscanned "a path commit ${rev:0:10} changes holds a newline, which the BINARY VERDICT check cannot judge"
                continue
            elif [ "$rc" -ne 0 ]; then
                unscanned "the LISTINGS of commit ${rev:0:10} could not be rewritten for the BINARY VERDICT check ($rewrite_failure)"
                continue
            fi
            LC_ALL=C awk 'FILENAME == ARGV[1] { gone[$0] = 1; next } { i = index($0, "\t"); if (substr($0, 1, i - 1) in gone) print substr($0, i + 1) }' "$scratch/gone.nl" "$scratch/post.nl" | tr '\n' '\0' > "$scratch/tpaths"
        else
            # One parent: git's verdict twice over, on the PAIR the per-commit
            # diff reads (-M: a renamed file is judged with the path it came
            # from, as the diff judges it, and its content is what the diff
            # printed no hunk for) and on the same changes as deletions and
            # additions (--no-renames). The second decides for a PURE rename
            # alone: the diff prints nothing for one (the same blob under a new
            # path, so no hunk and no Binary line), and what then matters is
            # whether the NEW path hides the blob, the rule the rename refusal
            # set; a pure rename is one whose new path's blob is among the
            # commit's deletions.
            rc=0; numstat_rows "$scratch/rows" -M --root "$rev" || rc=$?
            [ "$rc" -eq 0 ] || { numstat_ok=0; unscanned "the BINARY VERDICTS of commit ${rev:0:10} could not be read (git diff-tree --numstat -M exited $rc)"; }
            rc=0; numstat_rows "$scratch/rows2" --no-renames --root "$rev" || rc=$?
            [ "$rc" -eq 0 ] || { numstat_ok=0; unscanned "the BINARY VERDICTS of commit ${rev:0:10} could not be read (git diff-tree --numstat --no-renames exited $rc)"; }
        fi
