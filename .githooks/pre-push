#!/usr/bin/env bash
# romp pre-push hook: refuse to publish a commit that carries a personal
# identifier or a credential.
#
# The repo may go public and history is permanent, so both scans read the
# COMMITS BEING PUSHED (not the working tree). Two scanners, because they catch
# opposite kinds of thing:
#
#   identifiers   strings only YOU can enumerate (names, hostnames, vault
#                 names), read from ~/.config/romp/private-strings.txt: one
#                 banned string per line, `#` comments and blank lines ignored,
#                 matched case-insensitively. With no such file the scan stays
#                 out of your way, so on a clone that never set one up (any
#                 contributor's machine) it is a no-op.
#   credentials   strings NOBODY can enumerate in advance (a token's text is
#                 unknown until it leaks), matched by gitleaks' rules, tuned by
#                 the repo's .gitleaks.toml. With no gitleaks binary the scan
#                 prints a notice and stands down; CI runs the same scan over
#                 the full history, so nothing goes unscanned for long.
#
# The identifier scan makes four checks per pushed ref, all about what THIS
# push changes on the remote:
#
#   the tip's tree    the content the push exposes. A banned string anywhere in
#                     it, in a regular file or a symlink's target, refuses the
#                     push.
#   each new commit   the lines it ADDS: against its parent, or for a merge the
#                     lines in none of its parents. A string introduced in an
#                     intermediate commit and removed by a later one is still
#                     caught, and the commit named; a commit whose tree merely
#                     INHERITS a string an older commit put there is not, and
#                     neither is a merge that brought one in from a parent the
#                     remote already has. Every commit on every branch cut from
#                     main between a string landing there and its redaction
#                     inherits it that way, and a per-commit TREE scan refuses
#                     them all, over files the branch never touched, when the
#                     only exposure any of them could add is its tip.
#   each new commit   the ADDRESSES it is authored and committed under: the part
#                     after the @, grepped like a line of content. A commit is
#                     published with its metadata, and the two checks above read
#                     none of it. A clone with no user.email set in any scope has
#                     git stamp <login>@<hostname -f> on every commit it makes,
#                     and a machine's name and its domain suffix are exactly the
#                     strings a denylist holds: such an address rode a branch's
#                     commits and a pushed merge through both content checks and
#                     gitleaks (2026-09-09). The domain only: the login and the
#                     names are the author's own, on the denylist too (a FILE
#                     must not carry them) and on every commit they make. And
#                     only for an address the clone is NOT configured to publish
#                     under (user.email in any scope, or GIT_AUTHOR_EMAIL,
#                     GIT_COMMITTER_EMAIL or EMAIL in the environment): the
#                     chosen address is the author's to publish whatever it says,
#                     and its domain may well be their own name. An unset
#                     user.email chooses nothing, which is the case this check
#                     is for.
#   each new commit   its MESSAGE, subject and body, grepped like lines of
#                     content. Metadata too, and the place a commit describing a
#                     fix names the path that failed or the machine it failed
#                     on. A string a FILE carries has a forward remedy once it
#                     is out (redact it in a later commit, push); a string a
#                     message carries has none, only a rewrite of the commit
#                     takes it back, so the push is the last check before it is
#                     out for good. The whole denylist, the author's own name
#                     included: the message is text they typed, and a file
#                     naming them is refused on the same ground. Only what THIS
#                     push publishes, like the other per-commit checks: a message
#                     a remote already holds is refused to no purpose.
#   an annotated tag  its OWN tagger and message, under the two checks above.
#                     Every other read here peels a tag to the commit it names
#                     (git grep, rev-list and log take a tag as that commit), so
#                     the tag object's metadata was read by nothing, and a
#                     `git push --tags` from a clone with no user.email stamps
#                     the tagger the way it stamps a committer. The tag object
#                     is read whenever its ref is pushed: a remote holding it at
#                     this sha would not be updating the ref, and one holding it
#                     at another sha is receiving a new object. A tag of a tag
#                     is peeled one object at a time.
#
# A read the hook cannot COMPLETE is not an empty result. The tip's content scan,
# its symlink listing, each link's target, an object's type, a tag's fields and
# each new commit's parent count, added lines, addresses and message are git
# reads whose output the checks above grep, and a read that FAILED (git's
# status, or an error line) leaves the push part-scanned: what went unread may
# be exactly the string the scan exists for. Each such read reports one line
# naming the ref or the commit and the read, and refuses the push as unscanned,
# as a gitleaks that cannot scan does; an ABSENT value (a tag with no message, a
# tree with no links, a commit whose diff or message is empty) reads as empty
# and passes. Found by execution (2026-09-20), one read at a time, each letting
# a dirty tip, tag or commit through a real push with nothing printed but git's
# own error line where it printed one; the per-commit diff failed that way with
# the real git once the added file's blob was gone from the store.
#
# Both content checks read what git calls TEXT: the tip's grep skips a blob
# git calls binary (-I), and the per-commit diff prints no line for one. git
# calls a blob binary by its bytes (a NUL in the first 8000) or by its PATH's
# diff attribute: a `-diff` line or the `binary` macro, in .gitattributes,
# .git/info/attributes or the file core.attributesFile names, or a diff driver
# whose diff.<driver>.binary is true. A text file under such an attribute is
# read by neither check, and a real push published a banned string in one with
# the denylist armed and nothing printed (2026-09-21). Where an attribute can
# hide content from the scan, the push is refused rather than scanned
# (refuse_hidden_paths, the rule refuse_replace_refs set): the diff attribute
# of every regular file at the tip and in each new commit's post-image is read
# in one git check-attr, which consults the same sources git grep and
# diff-tree consult in this clone, and a hidden path whose blob is text by
# git's byte rule is named with the tip or the commit, the attribute and the
# remedy. A hidden path whose blob is BINARY by its bytes passes as it always
# did: the scan never read binaries, and the attribute adds nothing, so a
# repository marking its images binary is not refused. Reading such a file
# from the objects instead of refusing is the longer fix, not this one. The
# check's NUL-delimited listings live in a scratch directory under TMPDIR
# (mktemp -d, prefix romp-pre-push.), removed by its exact minted path when
# the identifier scan ends: a hard kill between the minting and the removal
# leaves it behind, bounded by its living under TMPDIR with that prefix, so a
# reader can find and remove it.
#
# The credential scan reads the same new commits, each merge by its
# first-parent diff, and refuses the push on a hit. A range this clone cannot
# resolve (a force-push over a remote tip nobody fetched) sends both scans over
# everything the pushed tip reaches. That scan has one read of its own INSIDE
# gitleaks, whose exit status does not carry it: gitleaks runs `git log -p`
# itself, and any stderr line from that git it does not allowlist (the
# rename-detection warnings, the auto-gc notice) makes it log the line at its
# ERR level, drop the rest of the scan, report the commits it did read, say no
# leaks were found and exit 0, whether or not git failed. So exit 0 is read as
# "no finding reported", never as "scanned": the hook reads gitleaks' log, and
# refuses the push as unscanned on any ERR line, and separately when the commit
# count gitleaks reports is not the hook's own count of the commits with content
# to scan. Two conditions, because either alone has a hole: a log that came up
# short writes no ERR line, and a discarded scan can still report the whole
# count. Found by execution (2026-09-21): a git that wrote one benign line to
# stderr, and one that handed gitleaks a commit fewer, each let two live
# credentials through a real push with nothing printed, on a clone with the
# denylist armed. The hook's count is derived from the OBJECTS (rev-list,
# diff-tree --raw, cat-file; scannable_commits), never from the patch stream
# gitleaks reads: a count read from that same stream agreed with the scan under
# every transform of the stream, since a transform empties both alike. Six were
# found in two rounds (2026-09-21): colour (color.ui or color.diff set to
# always), a textconv driver and a -diff attribute named in .gitattributes, each
# of which published a credential with the hook reporting clean; and
# format.pretty, log.date and log.showSignature, which refused clean pushes.
# gitleaks' git is asked for a plain stream (the options in gitleaks_args, each
# outranking the config key it neutralises) so a clean push agrees. log.showRoot
# set to false (it hides a root commit's diff from git log -p) is neutralised
# the same way, by --root on the scanner's log, the shape --pretty and --date
# take: the option outranks the key in every scope and travels on the scanner's
# command line, so a scanner git that does not inherit the hook's environment
# still reads it. A scanner whose git does not honour that option, or any other
# count that comes up short, refuses on the count as before; when the short
# count meets the key false in the clone's configuration and a root commit in
# the range, the refusal also names the key, says the scanner's git did not
# honour the --root option the hook passes, and gives the remedy. The two
# halves differ in kind: the credential half's own count is derived from the
# objects and no configuration touches it, while the identifier half reads a
# log and diff stream and is config-dependent by construction, hardened key by
# key (log.showRoot today, another key another day); reading its input from
# the objects is the long fix, not taken in this fold.
#
# Both scans read the objects at the pushed shas, on the premise that what they
# read is what the push transfers. A replace ref (git replace) breaks it: every
# read follows the substitute while the push transfers the original, and a real
# push published a banned string and a credential at the pushed sha with both
# scans reading clean (2026-09-21). So every git the hook runs, gitleaks' own
# included, runs with replacement OFF (GIT_NO_REPLACE_OBJECTS), and a clone that
# carries any replace ref at all is refused before either scan
# (refuse_replace_refs): a scan under replacement cannot vouch for the bytes
# pushed. Only where a scan would otherwise run, though: the refusal exists
# because a replace ref makes the scanned bytes diverge from the transferred
# bytes, so a CLEAN REPORT would be false; where no scan runs (no denylist
# file, and gitleaks skipped or absent) there is no report and nothing false to
# prevent, and a clone that never asked for either scan is unaffected, as
# CLAUDE.md promises. The two arming tests (identifier_scan_armed,
# credential_scan_armed) are the ones the scans' own early returns read, so the
# gate and the scans agree by construction.
#
# Why pushed commits rather than a working-tree scan: the hook is symlinked into
# the SHARED git hooks dir (by install.sh), so it fires from every worktree —
# but a working-tree scan is only as good as the tree you happen to push from,
# and an untracked scanner script exists in only one worktree. Reading the
# denylist from $HOME and reading the pushed shas arms every worktree equally.
#
# Env: ROMP_PRIVATE_STRINGS (denylist path), ROMP_GITLEAKS (scanner binary),
# ROMP_NO_GITLEAKS=1 (skip the credential scan and its notice).
# Bypass a false positive from either scan with `git push --no-verify`.
set -euo pipefail
# Replacement off for every git below, gitleaks' own included (the header's
# premise): the scans read the objects the push transfers, never a substitute.
export GIT_NO_REPLACE_OBJECTS=1
# The value this clone's configuration gives log.showRoot, for the refusal arm
# in scan_credentials (the header): a plain read, so the arm can name the key
# when a short count meets it false. The key itself is neutralised on the
# scanner's command line (--root, in gitleaks_args), not here: beyond the
# replacement switch above, the hook sets nothing for the gits it runs.
showroot_configured=$(git config --type=bool log.showRoot 2>/dev/null || true)

# git feeds the ref list on stdin and both scans need it, so read it once.
refs="$(cat)"
zero=0000000000000000000000000000000000000000
blocked_ids=0
blocked_addresses=0     # a subset of blocked_ids, with a remedy of its own
blocked_messages=0      # likewise a subset of blocked_ids, with a remedy of its own
blocked_tags=0          # an annotated tag's own tagger or message: one of the two above, with a remedy of its own
blocked_creds=0
failed_scan=0           # a read or scan that could not complete: refused as unscanned (unscanned, the gitleaks arm)
failed_creds=0          # a subset of failed_scan: gitleaks itself could not scan, with advice of its own
hidden_paths=0          # a subset of failed_scan: a diff attribute hides a text file from the identifier scan, with a remedy of its own
scratch=""              # a directory for the NUL-delimited listings the attribute check reads (refuse_hidden_paths); made on first use, removed by scan_identifiers

# The commits THIS push publishes for one ref: what no remote already has.
# "Already has" means reachable from the remote ref's current value or from ANY
# remote-tracking ref this clone holds (refs/remotes/*, as last fetched) — every
# remote's, not only the pushed-to remote's or the ref being pushed. The
# difference from the ref's plain update range is a branch that merged main: its
# range holds main's commits, every one of them published already through main.
# Scanning those refuses the push over a string that main itself published, and a
# string already on a remote is fixed FORWARD, on main (redact, push main) — not
# by blocking every branch that merged main before the redaction. Every remote
# counts because that remedy exists only for a commit no remote has yet: in a
# clone with a fork and the project it forked from, a clean branch cut from the
# project's main is pushed to the fork as a new ref, and an exclusion scoped to
# the fork left the project's own commits in the range — one named as adding a
# string the project had since redacted, which no rewrite of the branch could
# fix (the #968 review). With no remote-tracking refs at all (never fetched) the
# exclusion matches nothing and the range falls back to everything the remote
# ref lacks — for a new ref, the whole history.
rev_range() {   # <local_sha> <remote_sha> → a rev-list argument list
    local args="$1 --not --remotes"
    [ "$2" = "$zero" ] || args="$args $2"
    printf '%s' "$args"
}

# The lines a commit adds, one per line as "<path>\t<text>". A commit with one
# parent: its diff against that parent (a root commit, against the empty tree).
# A merge: the combined diff against ALL its parents (-c), keeping only the lines
# in NONE of them — a conflict resolution, a line typed into the merge — which is
# what the merge itself adds. A diff against the first parent alone named a merge
# of main, taken while main carried a string, as adding it: the content came in
# through the second parent, which the remote already had, and the branch's tip
# was clean (the #968 review). In a combined diff every content line carries one
# column per parent, and a line in no parent has a `+` in each; -c also omits a
# file that matches any parent outright, which holds no such line. -M keeps a
# rename from re-adding every line of the file. A new symlink shows up here too:
# a link's target is its blob content, so it is an added line. The path comes
# from the `+++ b/<path>` header, read only between a `diff --git` or
# `diff --combined` line and the first hunk: inside a hunk, a line that begins
# with `+++ ` is added content (`++ b/x` as written) and belongs to the current
# file. Two reads, made apart by the caller so a refusal can name the one that
# failed: the parent count (parent_count; rev-list's status through pipefail; a
# failure there leaves n empty, which awk reads as 1, and a merge's combined
# diff is read in one column: over-scan, but a read that failed all the same)
# and the diff (added_lines, whose status is the diff-tree's through pipefail).
parent_count() {   # <rev>
    git rev-list --parents -n 1 "$1" | awk '{ print NF - 1 }'
}
added_lines() {   # <rev> <parent count>
    git diff-tree -p -r -M -c --root --no-commit-id --no-color "$1" | awk -v n="$2" '
        BEGIN { if (n < 1) n = 1; for (i = 0; i < n; i++) plus = plus "+" }
        /^diff --(git|combined) /        { hdr = 1; next }
        hdr && /^\+\+\+ b\//             { f = substr($0, 7); next }
        hdr && /^\+\+\+ /                { f = $0; next }
        /^@@/                            { hdr = 0; next }
        !hdr && substr($0, 1, n) == plus { print f "\t" substr($0, n + 1) }'
}

# The addresses this clone publishes under BY CHOICE: user.email from any config
# scope (an includeIf's included, as git resolves it for this repository) and the
# environment's overrides, one per line. An unset user.email contributes nothing,
# so on a clone that never set one every stamped address is checked. Blank lines
# are harmless: a non-empty address never matches one whole.
chosen_emails() {
    git config --get-all user.email 2>/dev/null || true
    printf '%s\n' "${GIT_AUTHOR_EMAIL:-}" "${GIT_COMMITTER_EMAIL:-}" "${EMAIL:-}"
}

# Whether an address is one this clone chose: matched whole, case-insensitively.
is_chosen() {   # <address> <chosen addresses, one per line>
    printf '%s\n' "$2" | grep -qixF -e "$1"
}

# The addresses a commit is stamped with that this clone did not choose, one
# line per role as "<role>\t<address>", authored and committed, whether or not
# the two addresses are the same. An empty address is skipped (there is nothing
# to publish in `<>`), and so is a chosen one.
#
# --no-show-signature here and on the message read below: with log.showSignature
# set, git log prints a signed commit's verification report (the signer's name
# or address among it) ahead of whatever the format asks for. Read as part of the
# message, that refused a clean signed commit whose signer is on the denylist,
# as the author's own name and address are, and numbered a real hit's line from
# the report's first line rather than the subject. The flag keeps both reads to
# the commit's own fields.
#
# The log is captured before the loop, so the function's status is the log's:
# piped into the loop, a log that failed was a commit stamped with no address.
stamped_addresses() {   # <rev> <chosen addresses, one per line>
    local role email stamped
    stamped=$(git log -1 --no-show-signature --format='authored%x09%ae%ncommitted%x09%ce' "$1") || return $?
    while IFS=$'\t' read -r role email; do
        [ -n "$email" ] || continue
        is_chosen "$email" "$2" && continue
        printf '%s\t%s\n' "$role" "$email"
    done <<< "$stamped"
}

# One header field of an annotated tag object (`tagger`, `object`), or its
# message: the header ends at the first empty line and the message is the rest
# (a signed tag's signature included; it is text like any other). awk reads the
# whole object before either function prints.
tag_field() {   # <tag_sha> <field>
    git cat-file -p "$1" | awk -v f="$2" 'BEGIN { hdr = 1 }
        hdr && !NF { hdr = 0; next }
        hdr && !seen && $1 == f { seen = 1; sub(/^[^ ]+ /, ""); print }'
}
tag_message() {   # <tag_sha>
    git cat-file -p "$1" | awk 'BEGIN { hdr = 1 } hdr && !NF { hdr = 0; next } !hdr { print }'
}

# A read that FAILED (git's status, or an error it printed; an absent field or an
# empty tree prints nothing and exits 0): the push is then only part-scanned, and
# what went unread may be exactly the string the scan exists for. Report it and
# refuse the push as unscanned, the road the credential scan takes when gitleaks
# cannot run. Found by execution (2026-09-20), with each such read counted as
# empty instead: a `cat-file -p` that failed while `cat-file -t` still said tag
# published a tag whose tagger domain was on the denylist; a git grep exiting 2,
# an ls-tree that failed after listing the link, a link blob that would not read
# and a failed type read each published a tip that inherited main's leak; nothing
# printed, every counter at zero. A per-commit diff-tree or log that failed (a
# shim; the diff-tree with the real git too, the added file's blob gone from the
# store) published a commit that added a banned line, one authored under a banned
# domain and one whose message named a banned host, git's own error line the only
# sign: piped into the grep or the loop that judged it, the read's failure was a
# no-match. Each caller says what could not be read; the tail and the counter are
# the same for all. The credential scan's read inside gitleaks is judged the same
# way, from gitleaks' own log (scan_credentials).
unscanned() {   # <what could not be read, as a clause>
    echo "romp pre-push: $1; the scan is incomplete, so the push is refused" >&2
    failed_scan=1
}
tag_unread() {   # <local_ref> <tag_sha> <FIELD> [<consequence>]
    unscanned "the $3 of tag $1 (${2:0:10}) could not be read${4:+, $4}"
}
# The TYPE read decides whether there is a tag to scan at all, on the pushed
# object and on each one the peel reaches; read as "not a tag" when it failed, it
# left the tag unpeeled and unscanned. A branch is pushed through this read too,
# so the line names the object the ref pushes, not "the tag".
type_unread() {   # <local_ref> <sha>
    unscanned "the TYPE of the object $1 pushes (${2:0:10}) could not be read, so whether it is an annotated tag is unknown"
}
# Whether each scan WOULD run: the identifier scan when the denylist file exists
# (ROMP_PRIVATE_STRINGS, else the XDG default), the credential scan when it is
# not skipped (ROMP_NO_GITLEAKS) and a gitleaks binary resolves and is
# executable (ROMP_GITLEAKS, else the first on PATH). Each scan's own early
# return reads its predicate, and so does refuse_replace_refs, so the gate and
# the scans agree by construction. The predicates decide only whether a scan
# runs: an empty denylist arms a scan that greps for nothing, and a skipped or
# absent scanner keeps its silence or its notice in scan_credentials. Each is
# called as a condition (an `if`, an `||`), where set -e does not act on it.
private_strings_file() {
    printf '%s' "${ROMP_PRIVATE_STRINGS:-${XDG_CONFIG_HOME:-$HOME/.config}/romp/private-strings.txt}"
}
identifier_scan_armed() {
    [ -f "$(private_strings_file)" ]
}
gitleaks_binary() {   # the scanner's path when one resolves and is executable; nothing otherwise, status 0 either way
    local gl
    gl="${ROMP_GITLEAKS:-$(command -v gitleaks || true)}"
    if [ -n "$gl" ] && [ -x "$gl" ]; then printf '%s' "$gl"; fi
}
credential_scan_armed() {
    [ -z "${ROMP_NO_GITLEAKS:-}" ] && [ -n "$(gitleaks_binary)" ]
}

# A clone that carries a replace ref is refused before either scan runs (the
# header's premise): under a replacement, what a scan reads and what the push
# transfers can differ, and the push is refused rather than scanned. Only where
# a scan would otherwise run: the refusal exists because a replace ref makes
# the scanned bytes diverge from the transferred bytes, so a CLEAN REPORT would
# be false; where neither scan runs there is no report and nothing false to
# prevent, and a clone that never asked for either scan is unaffected (the
# header). Each ref is named; GIT_REPLACE_REF_BASE moves the namespace git
# reads, so the same variable says where to look. A listing that failed refuses
# too: whether the reads and the push agree is then unknown.
refuse_replace_refs() {
    local rc=0 found ref
    identifier_scan_armed || credential_scan_armed || return 0
    found=$(git for-each-ref --format='%(refname)' "${GIT_REPLACE_REF_BASE:-refs/replace/}") || rc=$?
    [ "$rc" -eq 0 ] || unscanned "the REPLACE REFS of this clone could not be listed (git for-each-ref exited $rc), so whether the scans read what the push transfers is unknown"
    [ -n "$found" ] || return 0
    while IFS= read -r ref; do
        echo "romp pre-push: this clone carries a replace ref ($ref): under it what a scan reads and what the push transfers can differ, so the push is refused rather than scanned" >&2
    done <<< "$found"
    echo "  Delete it (git replace -d <object>) and push again, or push from a clone that carries none." >&2
    failed_scan=1
}

# The blobs the identifier scan reads whose PATH's diff attribute hides them
# (the header): the tip's regular files and each new commit's post-image
# regular files. A deletion has nothing to read; a symlink's target is read
# whole by the tip pass and printed by the diff whatever its attribute (checked
# by execution, 2026-09-21); a gitlink is no blob. The listings are read with
# -z into a scratch directory, so every path reaches check-attr byte for byte
# (a quoted path would ask about a file that does not exist, which reads as
# unspecified), and one check-attr answers for all of them, from the same
# sources git grep and diff-tree consult here: unset (a -diff line, the binary
# macro) hides; a driver name hides when diff.<driver>.binary is true (read
# once per driver); set and unspecified do not. A hidden path's blob is then
# read (cat-file) and judged by git's own byte rule with no diff machinery: a
# NUL in the first 8000 bytes is binary, and passes as binaries always have;
# anything else is text the scan could not see, named with the tip or the
# commit and the attribute, and the push is refused rather than scanned. An
# empty blob hides nothing and passes. A read that fails (a listing, the
# check-attr, a cat-file, the scratch directory) refuses as unscanned, naming
# the read; whatever was listed is still judged. The tip is not listed again
# when its first listing (the symlink pass) failed or found no tree: the
# failure is reported there once, and a pushed object that peels to a blob has
# no path an attribute could name.
refuse_hidden_paths() {   # <local_ref> <local_sha> <revs> <tip listed: 1 or 0>
    local local_ref="$1" local_sha="$2" revs="$3" tip_listed="$4"
    local rc rev entry meta path mode blob place fields k attr value how drivers counts bytes nuls
    if [ -z "$scratch" ]; then
        scratch=$(mktemp -d "${TMPDIR:-/tmp}/romp-pre-push.XXXXXX") \
            || { scratch=""; unscanned "the DIFF ATTRIBUTES of the paths $local_ref (${local_sha:0:10}) publishes could not be checked (no scratch directory: mktemp failed)"; return 0; }
    fi
    : > "$scratch/entries"      # "<tip, or the commit's sha>\t<blob>\t<path>", one per NUL
    if [ "$tip_listed" -ne 0 ]; then
        rc=0; git ls-tree -r -z "$local_sha" > "$scratch/listing" || rc=$?
        [ "$rc" -eq 0 ] || unscanned "the TREE of the tip of $local_ref (${local_sha:0:10}) could not be listed for the DIFF ATTRIBUTE check (git ls-tree exited $rc)"
        while IFS= read -r -d '' entry; do
            meta=${entry%%$'\t'*}; path=${entry#*$'\t'}
            mode=${meta%% *}; blob=${meta##* }
            case "$mode" in 100644|100755) printf 'tip\t%s\t%s\0' "$blob" "$path" >> "$scratch/entries" ;; esac
        done < "$scratch/listing"
    fi
    for rev in $revs; do
        rc=0; git diff-tree -r --raw --no-renames --root -c -z --no-commit-id "$rev" > "$scratch/listing" || rc=$?
        [ "$rc" -eq 0 ] || unscanned "the CHANGED PATHS of commit ${rev:0:10} could not be listed for the DIFF ATTRIBUTE check (git diff-tree exited $rc)"
        # Two records per entry: ":<modes> <shas> <status>" (a merge's combined
        # line has one more mode, sha and leading colon per parent; the
        # post-image mode and sha come last of their kind) and then the path.
        while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
            k=${meta%%[^:]*}; k=${#k}
            # shellcheck disable=SC2206  # the record is deliberately word-split
            fields=($meta)
            mode=${fields[k]}; blob=${fields[2 * k + 1]}
            case "$mode" in 100644|100755) printf '%s\t%s\t%s\0' "$rev" "$blob" "$path" >> "$scratch/entries" ;; esac
        done < "$scratch/listing"
    done
    [ -s "$scratch/entries" ] || return 0
    while IFS= read -r -d '' entry; do printf '%s\0' "${entry#*$'\t'*$'\t'}"; done < "$scratch/entries" > "$scratch/paths"
    rc=0; git check-attr --stdin -z diff < "$scratch/paths" > "$scratch/attrs" || rc=$?
    if [ "$rc" -ne 0 ]; then
        unscanned "the DIFF ATTRIBUTES of the paths $local_ref (${local_sha:0:10}) publishes could not be read (git check-attr exited $rc)"
        return 0
    fi
    # One answer per path asked, in order: "<path>\0diff\0<value>\0", read in
    # step with the entries so each answer meets its blob and place.
    drivers=""
    exec 3< "$scratch/entries"
    while IFS= read -r -d '' path && IFS= read -r -d '' attr && IFS= read -r -d '' value; do
        IFS= read -r -d '' entry <&3 || entry=""
        if [ "$attr" != diff ] || [ "$path" != "${entry#*$'\t'*$'\t'}" ]; then
            unscanned "the DIFF ATTRIBUTES of the paths $local_ref (${local_sha:0:10}) publishes could not be read (git check-attr answered out of step with the paths asked)"
            break
        fi
        case "$value" in
            unspecified|set) continue ;;
            unset) how="unset" ;;
            *)  case " $drivers " in
                    *" $value=true "*)  ;;
                    *" $value=false "*) continue ;;
                    *)  if [ "$(git config --type=bool "diff.$value.binary" 2>/dev/null || true)" = true ]; then
                            drivers="$drivers $value=true"
                        else
                            drivers="$drivers $value=false"; continue
                        fi ;;
                esac
                how="diff=$value, binary" ;;
        esac
        place=${entry%%$'\t'*}; blob=${entry#*$'\t'}; blob=${blob%%$'\t'*}
        # The first 8000 bytes, counted with their NULs; the rest is drained so
        # the cat-file is never cut off mid-write (its status is the pipe's).
        rc=0; counts=$(git cat-file blob "$blob" | { head -c 8000 | LC_ALL=C od -An -v -tu1 | awk '{ for (i = 1; i <= NF; i++) { b++; if ($i == 0) z++ } } END { print b + 0, z + 0 }'; cat > /dev/null; }) || rc=$?
        if [ "$rc" -ne 0 ]; then
            if [ "$place" = tip ]; then
                unscanned "the CONTENT of $path at the tip of $local_ref (${local_sha:0:10}), which its diff attribute ($how) hides from the identifier scan, could not be read (git cat-file exited $rc)"
            else
                unscanned "the CONTENT of $path in commit ${place:0:10}, which its diff attribute ($how) hides from the identifier scan, could not be read (git cat-file exited $rc)"
            fi
            continue
        fi
        read -r bytes nuls <<< "$counts"
        if [ "$bytes" -eq 0 ] || [ "$nuls" -gt 0 ]; then
            continue        # empty: nothing hidden; a NUL: binary, which the scan never read
        fi
        if [ "$place" = tip ]; then
            echo "romp pre-push: $path at the tip of $local_ref (${local_sha:0:10}) is text that its diff attribute ($how) hides from the identifier scan, so the push is refused rather than scanned" >&2
        else
            echo "romp pre-push: $path in commit ${place:0:10} is text that its diff attribute ($how) hides from the identifier scan, so the push is refused rather than scanned" >&2
        fi
        hidden_paths=1
        failed_scan=1
    done < "$scratch/attrs"
    exec 3<&-
}

# ── identifiers ───────────────────────────────────────────────────────────
scan_identifiers() {
    local strings_file line grep_args local_ref local_sha _remote_ref remote_sha lines role email obj tagger chosen
    local rc out errs hits listing links link blob link_path target revs rev n msg addrs inner kind tip_listed
    strings_file="$(private_strings_file)"
    identifier_scan_armed || return 0

    # Banned strings: strip comments and surrounding whitespace, drop blanks. The
    # `|| [ -n "$line" ]`: a last line with no trailing newline (an editor that
    # adds none, a printf that wrote the file) comes back from read with status 1
    # and the line in hand, and a plain `while read` dropped it: the entry on
    # that line was scanned for by nothing, and a one-entry file so written armed
    # no scan at all, nothing printed either way (found by execution, 2026-09-21).
    grep_args=()
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [ -n "$line" ] && grep_args+=(-e "$line")
    done < "$strings_file"
    [ ${#grep_args[@]} -gt 0 ] || return 0
    chosen="$(chosen_emails)"      # the same for every commit in the push: read once

    while read -r local_ref local_sha _remote_ref remote_sha; do
        [ -n "${local_sha:-}" ] || continue
        [ "$local_sha" = "$zero" ] && continue          # deleting a remote ref pushes nothing

        # The tip's tree. -I skips binaries; -l lists files. The status and the
        # error stream are read apart from the hits: git grep exits 1 for no match
        # and above 1 when it could not scan (a git that would not run, a killed
        # process, an argument list too long, a partial clone whose promisor is
        # unreachable), and a blob it cannot read it reports on stderr and skips,
        # exiting 1 (or 0, listing the files it did read), so a corrupt store made
        # the leaking file a clean one. Every hit is "<sha>:<path>", or the bare
        # "<sha>" when the pushed object peels to a blob (a tag of a blob, which
        # git grep reads as one file); any other line is an error, echoed under
        # the report. Found by execution (2026-09-20):
        # with a git grep exiting 2, and again with the leaking file's blob
        # missing, a tip whose tree carried a denylist string passed. --no-color:
        # with color.ui or color.grep set to always, git wraps each hit line in
        # colour codes even off a terminal, and a coloured hit is not
        # "<sha>:<path>": it read as an error line, and a real hit was reported
        # as a broken scanner (2026-09-21).
        rc=0; out=$(git grep --no-color -i -I -l -F "${grep_args[@]}" "$local_sha" -- 2>&1) || rc=$?
        hits=$(printf '%s\n' "$out" | grep -E "^$local_sha(:|\$)" || true)
        errs=$(printf '%s\n' "$out" | grep -Ev "^$local_sha(:|\$)" | grep . || true)
        if [ "$rc" -gt 1 ] || [ -n "$errs" ]; then
            unscanned "the CONTENT of the tip of $local_ref (${local_sha:0:10}) could not be fully scanned (git grep exited $rc)"
            [ -z "$errs" ] || printf '%s\n' "$errs" | sed 's/^/  /' >&2
        fi
        if [ -n "$hits" ]; then
            echo "romp pre-push: the tip of $local_ref (${local_sha:0:10}) would publish a personal identifier in:" >&2
            echo "$hits" | sed "s/^$local_sha:/  /" >&2
            blocked_ids=1
        fi

        # The tip's symlinks. git grep reads regular-file blobs only, so a link whose
        # TARGET holds a string is invisible to the grep above. A committed link's
        # target is its blob content, so read each 120000 entry's blob itself. Not
        # hypothetical: a `node_modules -> /home/<user>/code/romp/...` link, made to
        # run the extension tests in a worktree and swept up by a broad `git add`,
        # reached a public branch past a git grep of its tree, and a reviewer found
        # it, not the hook. An ls-tree line is "<mode> <type> <sha>\t<path>". The
        # listing is captured before the grep so a failed ls-tree has a road of its
        # own: piped straight into grep, the listing's failure was grep's no-match,
        # and a tree that could not be listed read as a tree with no symlinks (found
        # by execution, 2026-09-20: with one subtree object missing, ls-tree listed
        # the link and exited 1, the pipeline took that status, and a real push
        # published the branch). A failed listing refuses the push as unscanned;
        # whatever it did list is still read, so a link it named is still named.
        # A pushed object that peels to a BLOB (a tag of a blob) has no tree to
        # list: the listing is absent, not unreadable, and the content scan above
        # read the blob itself. The peel-type read is made only when the listing
        # failed, and its own failure refuses like any other.
        tip_listed=1            # read again with -z by refuse_hidden_paths; not when this listing failed or found no tree
        listing=$(git ls-tree -r "$local_sha" 2>/dev/null) || {
            tip_listed=0
            if [ "$(git cat-file -t "${local_sha}^{}" 2>/dev/null || true)" = blob ]; then
                listing=""
            else
                unscanned "the SYMLINKS of the tip of $local_ref (${local_sha:0:10}) could not be listed"
            fi
        }
        if links=$(printf '%s\n' "$listing" | grep '^120000 '); then
            while IFS= read -r link; do
                blob=${link#* * }; blob=${blob%%[[:space:]]*}
                link_path=${link#*$'\t'}
                # A blob that cannot be read is reported the same way, and its target
                # counts as empty so the loop goes on to the next link (under set -e a
                # bare failed substitution would end the hook before its verdict).
                target=$(git cat-file -p "$blob" 2>/dev/null) \
                    || { target=""; unscanned "the SYMLINK TARGET of $link_path at the tip of $local_ref (${local_sha:0:10}) could not be read"; }
                if printf '%s' "$target" | grep -qi -F "${grep_args[@]}"; then
                    echo "romp pre-push: the tip of $local_ref (${local_sha:0:10}) would publish a personal identifier" >&2
                    echo "  in the SYMLINK TARGET of $link_path -> $target" >&2
                    blocked_ids=1
                fi
            done <<< "$links"
        fi

        # The lines each commit new to the remote adds. Each per-commit read below
        # (the parent count and the diff, the addresses, the message) is captured with its status before
        # the grep or the loop that judges it: piped straight in, a diff-tree or log
        # that failed was the grep's no-match or a loop with nothing to read, a
        # commit that added, said and was stamped with nothing (found by execution,
        # 2026-09-20: each let its commit through a real push, git's error line the
        # only sign). A failed read names the commit and the read (unscanned) and
        # the scan goes on; whatever the read did print is still judged, so a hit
        # ahead of the failure is still named. An empty diff or message (an empty
        # commit, a merge with no line of its own) prints nothing and exits 0:
        # absent, not unreadable. git's own error line is not captured: it prints
        # ahead of the romp line, and message text cannot carry it.
        # shellcheck disable=SC2046  # the range is deliberately word-split
        revs=$(git rev-list $(rev_range "$local_sha" "$remote_sha") 2>/dev/null \
               || git rev-list "$local_sha")
        for rev in $revs; do
            rc=0; n=$(parent_count "$rev") || rc=$?
            [ "$rc" -eq 0 ] || unscanned "the ADDED LINES of commit ${rev:0:10} could not be read (git rev-list --parents exited $rc)"
            rc=0; out=$(added_lines "$rev" "$n") || rc=$?
            [ "$rc" -eq 0 ] || unscanned "the ADDED LINES of commit ${rev:0:10} could not be read (git diff-tree exited $rc)"
            if hits=$(printf '%s\n' "$out" | grep -i -F "${grep_args[@]}" | cut -f1 | sort -u) && [ -n "$hits" ]; then
                echo "romp pre-push: commit ${rev:0:10} ADDS a personal identifier in:" >&2
                echo "$hits" | sed 's/^/  /' >&2
                blocked_ids=1
            fi
            # The addresses it is stamped with: the domain of each one the clone did
            # not choose. `${email##*@}` is the whole string for an address with no @,
            # which git never stamps; such an address is read whole. Captured in
            # this shell rather than read through a process substitution: bash gives
            # the loop no status for one, and a counter set inside it is lost with
            # its subshell. A herestring of an empty capture is one empty line.
            rc=0; addrs=$(stamped_addresses "$rev" "$chosen") || rc=$?
            [ "$rc" -eq 0 ] || unscanned "the ADDRESSES of commit ${rev:0:10} could not be read (git log exited $rc)"
            while IFS=$'\t' read -r role email; do
                [ -n "$email" ] || continue
                if printf '%s' "${email##*@}" | grep -qi -F "${grep_args[@]}"; then
                    echo "romp pre-push: commit ${rev:0:10} is $role as <$email>, an address this clone is not configured to use, whose domain carries a personal identifier" >&2
                    blocked_ids=1
                    blocked_addresses=1
                fi
            done <<< "$addrs"
            # Its message, subject and body, like lines of content. -n so the report
            # can point at the line (1 is the subject) without echoing the string;
            # --no-show-signature so the message is all it reads (stamped_addresses).
            # Captured first; a substitution drops trailing newlines only, so the
            # numbering from the subject is the pipe's.
            rc=0; msg=$(git log -1 --no-show-signature --format=%B "$rev") || rc=$?
            [ "$rc" -eq 0 ] || unscanned "the MESSAGE of commit ${rev:0:10} could not be read (git log exited $rc)"
            if hits=$(printf '%s\n' "$msg" | grep -in -F "${grep_args[@]}" | cut -d: -f1) && [ -n "$hits" ]; then
                lines=$(printf '%s\n' "$hits" | tr '\n' ,); lines=${lines%,}
                echo "romp pre-push: the MESSAGE of commit ${rev:0:10} carries a personal identifier on line $lines (line 1 is the subject)" >&2
                blocked_ids=1
                blocked_messages=1
            fi
        done

        # The paths a diff attribute hides from the two content checks above
        # (the header): refused rather than scanned, whatever they carry.
        refuse_hidden_paths "$local_ref" "$local_sha" "$revs" "$tip_listed"

        # An annotated tag's own tagger and message (the header note): the pushed
        # object, peeled tag by tag down to the commit, which the loop above read.
        # The tagger's address is read as a commit's are (not when the clone chose
        # it, its domain otherwise) and the message like a commit's. The type read
        # that opens the peel, and the one after each step, is captured apart from
        # the loop's test: read as "not a tag" when it failed, it left a tag unpeeled
        # and unscanned. A type or field whose read fails is reported (type_unread,
        # tag_unread) and refuses the push; its value still counts as empty so the
        # peel ends, and under set -e a bare failed substitution would end the hook
        # before its verdict.
        obj="$local_sha"
        kind="$(git cat-file -t "$obj" 2>/dev/null)" || { kind=""; type_unread "$local_ref" "$obj"; }
        while [ "$kind" = tag ]; do
            tagger="$(tag_field "$obj" tagger 2>/dev/null)" || { tagger=""; tag_unread "$local_ref" "$obj" TAGGER; }
            email=""
            case "$tagger" in *"<"*">"*) email="${tagger#*<}"; email="${email%%>*}";; esac
            if [ -n "$email" ] && ! is_chosen "$email" "$chosen" && printf '%s' "${email##*@}" | grep -qi -F "${grep_args[@]}"; then
                echo "romp pre-push: tag $local_ref (${obj:0:10}) is tagged as <$email>, an address this clone is not configured to use, whose domain carries a personal identifier" >&2
                blocked_ids=1
                blocked_addresses=1
                blocked_tags=1
            fi
            # The message is captured before the grep so a failed read has a road of
            # its own: piped straight into grep, the read's failure was grep's no-match.
            msg="$(tag_message "$obj" 2>/dev/null)" || { msg=""; tag_unread "$local_ref" "$obj" MESSAGE; }
            if hits=$(printf '%s\n' "$msg" | grep -in -F "${grep_args[@]}" | cut -d: -f1) && [ -n "$hits" ]; then
                lines=$(printf '%s\n' "$hits" | tr '\n' ,); lines=${lines%,}
                echo "romp pre-push: the MESSAGE of tag $local_ref (${obj:0:10}) carries a personal identifier on line $lines" >&2
                blocked_ids=1
                blocked_messages=1
                blocked_tags=1
            fi
            inner="$(tag_field "$obj" object 2>/dev/null)" || { inner=""; tag_unread "$local_ref" "$obj" OBJECT "which ends the peel here"; }
            obj="$inner"
            [ -n "$obj" ] || break      # the OBJECT read failed, reported above: nothing to peel to
            kind="$(git cat-file -t "$obj" 2>/dev/null)" || { kind=""; type_unread "$local_ref" "$obj"; }
        done
    done <<< "$refs"
    [ -z "$scratch" ] || rm -rf -- "$scratch"      # the exact minted path, never a glob (the header's residual)

    if [ "$hidden_paths" -ne 0 ]; then
        # The attribute is the cause, so the advice says what to do about the
        # attribute: drop it, or keep the file text on purpose with a diff line
        # that outranks it (a later line in the same .gitattributes, a file git
        # reads ahead of the one carrying the -diff; .git/info/attributes
        # outranks the tree's files, so a -diff there is changed there). A
        # rename or copy of such a file is refused the same way, on purpose: its
        # bytes reach the remote under the new path. A refusal a contributor
        # cannot act on is a reason to bypass the hook (2026-09-21).
        echo "  Remove the diff attribute for each path named (the -diff line or binary macro in .gitattributes, .git/info/attributes or the file core.attributesFile names, or the driver's diff.<driver>.binary), or keep the file text on purpose with an explicit \"<path> diff\" line (a later line in .gitattributes overrides a -diff inherited from a broader pattern or from core.attributesFile; a -diff in .git/info/attributes outranks the tree's files and is changed there), then push again." >&2
        echo "  A rename or copy of such a file is content too: its bytes reach the remote under the new path, so the refusal is about the attribute, not the rename." >&2
    fi
    if [ "$blocked_ids" -ne 0 ]; then
        echo "" >&2
        echo "romp pre-push: BLOCKED — a banned string from $strings_file is in a pushed commit." >&2
        echo "  Replace it with synthetic data (see CONTRIBUTING.md), then push again." >&2
        echo "  If the string is only in an INTERMEDIATE commit, squash or rewrite the branch." >&2
        echo "  If the tip only INHERITS a string an older commit added, merge the main that has since redacted it." >&2
        echo "  If the named commit is already on some remote, this clone has not fetched it: fetch, then push again." >&2
        if [ "$blocked_addresses" -ne 0 ]; then
            echo "  An address this clone is not configured to use, with a banned string in its domain, is refused on every commit it stamps:" >&2
            echo "    if it is yours, say so (git config --global user.email <address>) and push again;" >&2
            echo "    if git filled it from the hostname (an unset user.email gets <login>@<hostname>), set yours, add user.useConfigOnly true" >&2
            echo "    so git never fills it again, and rewrite the named commits, e.g. git rebase <base> --exec 'git commit --amend --no-edit --reset-author'." >&2
        fi
        if [ "$blocked_messages" -ne 0 ]; then
            echo "  A commit MESSAGE is never redacted forward: rewrite the named commit (git commit --amend for the tip, a reword rebase with git rebase -i <base> for an older one) and push again." >&2
        fi
        if [ "$blocked_tags" -ne 0 ]; then
            echo "  An annotated TAG's tagger and message are the tag object's own: re-create it under your configured address, with a clean message (git tag -f -a <name> <commit>), and push it again." >&2
        fi
    fi
}

# ── credentials ───────────────────────────────────────────────────────────
# gitleaks (ROMP_GITLEAKS, else the first on PATH) over the commits this push
# publishes: the same range per ref as the identifier scan, so a secret that is
# already on a remote does not refuse every later push, and a secret in an
# intermediate commit whose tip is clean is still caught.
#
# The commits gitleaks COUNTS over a range, derived the way it counts them, so
# the count it reports can be checked (scan_credentials). gitleaks reads
# `git log -p -U0` over the range and counts a commit once it has scanned one
# hunk of one file that is not a deletion: its "N commits scanned" is the
# distinct commits among the fragments it scanned, and its own debug note says
# the number can be smaller than expected "due to commits with no additions".
# So an empty commit, a deletion, a mode-only change and an empty new file count
# for nothing, and `git rev-list --count` over-counts every one of them.
#
# Derived from the OBJECTS, not from a patch: a count read from the same
# `git log -p` stream gitleaks reads shared every transform of that stream (the
# header) and agreed with an emptied scan. Here rev-list names every commit in
# the range with its first parent (the commits gitleaks' log walks), one
# diff-tree --raw lists each commit's changed paths against that parent (a root
# against the empty tree) with their blob shas, without rename detection, diff
# drivers, attributes or colour, and one cat-file reads the sizes of the blobs
# whose size decides. A commit has content when one entry that is not a
# deletion gives the patch a hunk: a gitlink whose sha changed (a `Subproject
# commit` line either way), a modified blob whose sha changed (a mode-only
# change keeps the sha and prints no hunk; a file emptied prints one), or a new
# or type-changed path whose blob is not empty (an empty new file or link prints
# no hunk). gitleaks' git is given --text and --no-renames (gitleaks_args), so a
# binary file is diffed as text and a pure rename as a deletion and an addition,
# and both count here as their bytes say; checked by execution against gitleaks
# 8.28.0 and 8.30.1 over the commit shapes in the round's log (2026-09-21).
# --stdin: one diff-tree for the whole range; a merge fed with its first parent
# alone is diffed against that parent. A blob cat-file cannot find fails the
# count (missing), as does any of the three reads failing: refused (the caller),
# never counted as 0. The cost is three git reads per pushed ref, whatever the
# range's size.
scannable_commits() {   # <rev-list argument list>
    local raw sizes
    raw=$(git rev-list --parents "$@" | awk '{ print ($2 == "" ? $1 : $1 " " $2) }' \
          | git diff-tree --stdin -r --raw --no-renames --root) || return $?
    sizes=$(printf '%s\n' "$raw" | awk '/^:/ && $2 != "160000" && ($5 == "A" || $5 == "T") { print $4 }' | sort -u \
            | git cat-file --batch-check='%(objectname) %(objectsize)') || return $?
    printf '%s\n%s\n' "$sizes" "$raw" | awk '
        !/^:/ && NF == 2 && $2 == "missing" { print "fatal: blob " $1 " is missing" > "/dev/stderr"; bad = 1; exit 3 }
        !/^:/ && NF == 2                     { size[$1] = $2; next }
        !/^:/ && NF == 1                     { c = $1; next }
        /^:/ && $5 != "D" && !(c in seen) {
            if ($2 == "160000")              hit = ($3 != $4)
            else if ($5 == "A" || $5 == "T") hit = (size[$4] > 0)
            else                             hit = ($3 != $4)
            if (hit) { seen[c] = 1; n++ }
        }
        END { if (!bad) print n + 0 }'
}

# gitleaks' argument list, built in ONE place: the invocation in scan_credentials
# and tests/pre-push-hook.bats's scan_direct, which reads this function out of
# this file, call the scanner with the same words by construction. The range
# comes first in --log-opts and --diff-merges=first-parent next, the order
# tests/install-sh.bats pins by substring.
# -v prints the file, line and rule; without it gitleaks reports only a COUNT,
# which says a push was refused but not what to fix. --redact keeps the secret
# itself out of terminal scrollback: the location is what a fix needs, and the
# value has to be rotated anyway. --exit-code 2 tells a finding apart from
# gitleaks failing (exit 1: an unreadable config, say); both refuse the push,
# with different advice. --diff-merges=first-parent: `gitleaks git` runs
# `git log -p`, which shows NO diff for a merge commit by default, so a secret
# introduced during a conflict resolution (in neither parent, only the merge
# tree) would be scanned by nothing; the first-parent diff of each merge
# surfaces exactly that content, and non-merges are unaffected. The rest ask
# git for a plain stream, each outranking the config key it neutralises in
# every scope (the header): --no-color (color.ui, color.diff: gitleaks finds no
# file header in a coloured patch); --no-textconv (a diff.<driver>.textconv
# named by a .gitattributes entry rewrites the text gitleaks scans);
# --text (a -diff attribute, or core.bigFileThreshold, makes git call a file
# binary and print no hunk for it); --no-renames (diff.renames: a pure rename
# is a deletion and an addition, whatever the key says, as scannable_commits
# counts it); --submodule=short and --ignore-submodules=none (diff.submodule,
# diff.ignoreSubmodules: a gitlink change stays one hunk); --no-show-signature
# (log.showSignature writes gpg's report into the stream); --pretty=medium and
# --date=default (format.pretty, log.date: gitleaks parses the default header);
# --root (log.showRoot set to false hides a root commit's diff, so the scanner
# read one commit fewer with no error line).
gitleaks_args() {   # <root> <range> [<config option>...]: fills GL_ARGS
    local root="$1" range="$2"
    shift 2
    # --root outranks log.showRoot=false (verified by execution) and travels on the scanner's command line, so a scanner git that does not inherit the hook's environment still reads it.
    GL_ARGS=(git "$root" --no-banner --redact -v --exit-code 2 "$@"
        "--log-opts=$range --diff-merges=first-parent --no-color --no-textconv --text --no-renames --submodule=short --ignore-submodules=none --no-show-signature --pretty=medium --date=default --root")
}

scan_credentials() {
    local gl root cfg range rc local_ref local_sha _remote_ref remote_sha log plain err expected reported
    if ! credential_scan_armed; then
        [ -n "${ROMP_NO_GITLEAKS:-}" ] && return 0     # a skip asked for: silent
        # No binary. Loud rather than silent, but not a blocker: requiring an
        # install to push would break every clone that never wanted the
        # scanner, and CI scans the full history regardless.
        echo "romp pre-push: gitleaks not installed, pushing WITHOUT a secret scan." >&2
        echo "  Install it (brew install gitleaks, or the release .github/workflows/ci.yml pins)." >&2
        echo "  ROMP_GITLEAKS names a binary that is not on PATH; ROMP_NO_GITLEAKS=1 silences this." >&2
        return 0
    fi
    gl="$(gitleaks_binary)"

    root="$(git rev-parse --show-toplevel)"
    # The repo's rules, named explicitly: without --config gitleaks reads a
    # GITLEAKS_CONFIG from the environment before the source root, so a
    # developer's own config (for a pre-commit hook of theirs, say) would
    # replace the repo's. A tree without the file scans under the default rules.
    cfg=()
    [ -f "$root/.gitleaks.toml" ] && cfg=(--config "$root/.gitleaks.toml")

    while read -r local_ref local_sha _remote_ref remote_sha; do
        [ -n "${local_sha:-}" ] || continue
        [ "$local_sha" = "$zero" ] && continue      # deleting a remote ref pushes nothing
        # The range has to RESOLVE in this clone before gitleaks sees it: handed
        # a sha git cannot find (a force-push over a remote tip nobody fetched),
        # gitleaks' git log fails, and the identifier scan falls back to
        # everything the pushed tip reaches; so does this one. That is all this
        # probe covers. What gitleaks did with the range it was given (a git
        # that ran but failed, or wrote to stderr; a log that came up short) is
        # read from its own log after the scan, below, not from its exit status.
        range="$(rev_range "$local_sha" "$remote_sha")"
        # shellcheck disable=SC2086  # the range is deliberately word-split
        git rev-list $range >/dev/null 2>&1 || range="$local_sha"
        # The commits gitleaks should count over that range, read before the scan
        # so a range this git cannot read is refused on a line of its own.
        # shellcheck disable=SC2086  # the range is deliberately word-split
        rc=0; expected=$(scannable_commits $range) || { rc=$?; expected=""; }
        if [ "$rc" -ne 0 ]; then
            unscanned "the COMMITS of $local_ref (${local_sha:0:10}) could not be counted for the credential scan (a git read exited $rc)"
            failed_creds=1
        fi
        # The argument list is gitleaks_args' (the options and why, there).
        # ${cfg[@]+...}: an empty array expands to nothing under set -u in
        # every bash, the 3.2 that macOS ships included.
        # gitleaks' stdout (the findings, under -v) goes to stderr as it is
        # written; its stderr, the log, is captured and shown after it, because
        # the verdict is read from the log (the header): gitleaks logs its git's
        # stderr at ERR and then reports the commits it did read as if the scan
        # were whole. The colour codes it writes even off a terminal are stripped
        # from the copy that is read, not from the copy shown.
        gitleaks_args "$root" "$range" ${cfg[@]+"${cfg[@]}"}
        rc=0
        log=$( { "$gl" "${GL_ARGS[@]}" 2>&1 1>&3; } 3>&2 ) || rc=$?
        [ -z "$log" ] || printf '%s\n' "$log" >&2
        case $rc in
            0) ;;
            2) blocked_creds=1 ;;
            *) failed_scan=1; failed_creds=1 ;;
        esac
        # A scan gitleaks reports (exit 0 or 2) is whole only on its own evidence:
        # no line at its ERR level (`<time> ERR <message>`; its git's stderr
        # comes back as `[git] <line>`), and a reported count equal to the
        # hook's. An absent count line is no evidence either. Both refuse as
        # unscanned, with the scanner's advice; a finding beside them still
        # prints its own.
        if [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ]; then
            plain=$(printf '%s\n' "$log" | sed $'s/\e\\[[0-9;]*m//g')
            err=$(printf '%s\n' "$plain" | awk '$2 == "ERR" { sub(/^[^ ]+ ERR /, ""); print; exit }')
            if [ -n "$err" ]; then
                unscanned "the CREDENTIAL scan of $local_ref (${local_sha:0:10}) did not complete: gitleaks logged an error ($err)"
                failed_creds=1
            fi
            reported=$(printf '%s\n' "$plain" | awk '$2 == "INF" && $4 == "commits" && $5 == "scanned." { print $3; exit }')
            if [ -z "$reported" ]; then
                unscanned "the CREDENTIAL scan of $local_ref (${local_sha:0:10}) reported no commit count, so what it read is unknown"
                failed_creds=1
            elif [ -n "$expected" ] && [ "$reported" != "$expected" ]; then
                unscanned "the CREDENTIAL scan of $local_ref (${local_sha:0:10}) covered $reported of the $expected commits with content to scan"
                failed_creds=1
                # A count that came up SHORT with log.showRoot false in the
                # clone's configuration (showroot_configured) and a root commit
                # in the range (the header): the --root option gitleaks_args
                # passes outranks the key, so the scanner's git did not honour
                # it and the key is what hid the diff; a refusal a contributor
                # cannot act on is a defect.
                # shellcheck disable=SC2086  # the range is deliberately word-split
                if [ "$reported" -lt "$expected" ] 2>/dev/null && [ "$showroot_configured" = false ] \
                    && [ -n "$(git rev-list --max-parents=0 $range 2>/dev/null || true)" ]; then
                    echo "romp pre-push: log.showRoot is false in this clone's configuration and the scanner's git did not honour the --root option the hook passes on its log, which hides a root commit's diff; set the key to true (git config log.showRoot true) or unset it and push again, or ROMP_NO_GITLEAKS=1 skips the credential scan for this one push" >&2
                fi
            fi
        fi
    done <<< "$refs"

    if [ "$blocked_creds" -ne 0 ]; then
        echo "" >&2
        echo "romp pre-push: BLOCKED. gitleaks found a credential in a pushed commit." >&2
        echo "  Treat it as compromised the moment it exists in a commit: ROTATE it, then remove it." >&2
        echo "  Removing it in a NEW commit is not enough; the old commit still carries it." >&2
        echo "  A false positive belongs in .gitleaks.toml, narrowly, with a reason." >&2
    fi
    if [ "$failed_creds" -ne 0 ]; then
        echo "" >&2
        echo "romp pre-push: BLOCKED. gitleaks could not scan; its error is above." >&2
        echo "  The push is refused rather than published unscanned. Fix the scanner or its config, or set ROMP_NO_GITLEAKS=1 for one push." >&2
    fi
}

refuse_replace_refs
scan_identifiers
scan_credentials

# Both scans have reported; one bypass line, then the verdict.
if [ "$blocked_ids" -ne 0 ] || [ "$blocked_creds" -ne 0 ] || [ "$failed_scan" -ne 0 ]; then
    echo "  To bypass for one push (you are sure it is fine): git push --no-verify" >&2
    exit 1
fi
exit 0
