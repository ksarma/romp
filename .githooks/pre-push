            FILENAME == ARGV[3] { gone[$0] = 1; next }
            FILENAME == ARGV[4] { link[$0] = 1; next }
            FILENAME == ARGV[5] { typed[$0] = 1; next }
            FILENAME == ARGV[6] { p = substr($0, 4); seent[p] = 1; if (substr($0, 1, 1) == "b") bint[p] = 1; next }
            FILENAME == ARGV[7] { tip[$0] = 1; next }
            { i = index($0, "\t"); blob = substr($0, 1, i - 1); path = substr($0, i + 1)
