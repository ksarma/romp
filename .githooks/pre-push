            if [ "$place" = tip ]; then
                echo "romp pre-push: $path at the tip of $local_ref (${local_sha:0:10}) is text that its diff attribute ($how) hides from the identifier scan, so the push is refused rather than scanned" >&2
            else
                echo "romp pre-push: $path in commit ${place:0:10} is text that its diff attribute ($how) hides from the identifier scan, so the push is refused rather than scanned" >&2
            fi
        else
            size=$(git cat-file -s "$blob" 2>/dev/null || echo unknown)
            threshold=$(git config core.bigFileThreshold 2>/dev/null || true)
            # No attribute: for a commit's changed file (not a symlink, judged by
            # its own bytes; not a type change or a merge's rename candidate,
            # +typed, judged by the addition of the new object alone), the
            # PREVIOUS version's first 8000 bytes are read as the blob's were
            # above, key or no key, since a pre-image binary by its bytes makes
            # the pair binary whatever the key says and the diff prints no text
            # for the new version (the header); a merge's combined patch prints
            # Binary the same way when a parent's version is, so each parent's
            # version is read in turn, the count the one the caller read
            # (pcount), never the listing's shape. For a one-parent commit the
            # version in its parent, at the path the diff read the change from:
            # for a rename the old path, re-derived here from the commit's raw
            # listing with -M (an R row's two path records), never carried in
            # the rows or the entries, since a path may hold a tab. For the
            # report alone, like the attribute: a read that fails or a path with
            # no previous version (an addition, a root commit) leaves the
            # two-fact line, where the key is the candidate cause. A NUL found
            # names the previous version as the cause (the parent, or the old
            # path, named where it is not the commit's own path), with the two
            # facts beside it where the key is set; the key's advice is for the
            # two-fact lines alone, since raising the key lifts nothing here
            # (with the key set, the line named the key's facts and its remedy
            # while the certain cause went unnamed; the round 3 auditor,
            # 2026-09-22; a merge's line named the key's facts and remedy with
            # no cause and no fetch remedy, and a rename's the rename clause and
            # the key's remedy, the round 4 refuters 2026-09-22).
            prior=0; where=""
            if [ "$place" != tip ] && [ "$islink" -eq 0 ] && [ "$typed" -eq 0 ]; then
                k=$(LC_ALL=C awk -v r="$place" '$1 == r { print $2; exit }' "$scratch/pcount")
                if [ -z "$k" ] || [ -n "${k//[0-9]/}" ]; then k=0; fi
                if [ "$k" -eq 1 ]; then
                    prev=$path
                    if [ -n "$renamed" ]; then
                        prev=""; rc=0; git diff-tree -r --raw -M -z --root --no-commit-id "$place" > "$scratch/renames" 2>/dev/null || rc=$?
                        if [ "$rc" -eq 0 ]; then
                            while IFS= read -r -d '' meta && IFS= read -r -d '' rsrc; do
                                case "${meta##* }" in R*|C*) IFS= read -r -d '' rdst || rdst=""; [ "$rdst" != "$path" ] || prev=$rsrc ;; esac
                            done < "$scratch/renames"
                        fi
                    fi
                    if [ -n "$prev" ]; then
                        rc=0; counts=$(git cat-file blob "$place^:$prev" 2>/dev/null | { head -c 8000 | LC_ALL=C od -An -v -tu1 | awk '{ for (i = 1; i <= NF; i++) { b++; if ($i == 0) z++ } } END { print b + 0, z + 0 }'; cat > /dev/null; }) || rc=$?
                        if [ "$rc" -eq 0 ]; then read -r bytes nuls <<< "$counts"; case "$nuls" in ''|*[!0-9]*) ;; 0) ;; *) prior=1 ;; esac; fi
                        [ "$prior" -eq 0 ] || [ "$prev" = "$path" ] || where=" (at $prev, the path the diff read it from)"
                    fi
                elif [ "$k" -gt 1 ]; then
                    for ((i = 1; i <= k; i++)); do
                        rc=0; counts=$(git cat-file blob "$place^$i:$path" 2>/dev/null | { head -c 8000 | LC_ALL=C od -An -v -tu1 | awk '{ for (i = 1; i <= NF; i++) { b++; if ($i == 0) z++ } } END { print b + 0, z + 0 }'; cat > /dev/null; }) || rc=$?
                        [ "$rc" -eq 0 ] || continue
                        read -r bytes nuls <<< "$counts"
                        case "$nuls" in ''|*[!0-9]*) ;; 0) ;; *) prior=1; where=" in parent $i of the merge"; break ;; esac
                    done
                fi
            fi
            if [ "$prior" -ne 0 ]; then
                facts=""; [ -z "$threshold" ] || facts=" whatever the key says (the blob is $size bytes; core.bigFileThreshold is $threshold in this clone's configuration)"
                echo "romp pre-push: $path in commit ${place:0:10} is text that git calls binary although $says, so no attribute of its path accounts for the verdict; the previous version of the file$where is binary by its bytes (a NUL in its first 8000), which made git print no text diff for the change$facts, and the identifier scan could not read the new text, so the push is refused rather than scanned" >&2
                hidden_prior=1
            elif [ "$place" = tip ]; then
                echo "romp pre-push: $path at the tip of $local_ref (${local_sha:0:10}) is text that git calls binary although $says, so no attribute of its path accounts for the verdict (the blob is $size bytes; core.bigFileThreshold is ${threshold:-not set} in this clone's configuration); the identifier scan did not read it, so the push is refused rather than scanned" >&2
                hidden_unnamed=1
            else
                echo "romp pre-push: $path in commit ${place:0:10} is text that git calls binary although $says, so no attribute of its path accounts for the verdict$renamed (the blob is $size bytes; core.bigFileThreshold is ${threshold:-not set} in this clone's configuration); the identifier scan did not read it, so the push is refused rather than scanned" >&2
                hidden_unnamed=1
            fi
        fi
        hidden_paths=1
        failed_scan=1
    done < "$scratch/entries"
}

# ── identifiers ───────────────────────────────────────────────────────────
scan_identifiers() {
    local strings_file line grep_args local_ref local_sha _remote_ref remote_sha lines role email obj tagger chosen
    local rc out errs hits listing links link blob link_path target revs rev n msg addrs inner kind tip_listed tip_entries rev_counts
    strings_file="$(private_strings_file)"
    identifier_scan_armed || return 0

    # Banned strings: strip comments and surrounding whitespace, drop blanks. The
    # `|| [ -n "$line" ]`: a last line with no trailing newline (an editor that
    # adds none, a printf that wrote the file) comes back from read with status 1
    # and the line in hand, and a plain `while read` dropped it: the entry on
    # that line was scanned for by nothing, and a one-entry file so written armed
    # no scan at all, nothing printed either way (found by execution, 2026-09-21).
    grep_args=()
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [ -n "$line" ] && grep_args+=(-e "$line")
    done < "$strings_file"
    [ ${#grep_args[@]} -gt 0 ] || return 0
    chosen="$(chosen_emails)"      # the same for every commit in the push: read once

    while read -r local_ref local_sha _remote_ref remote_sha; do
        [ -n "${local_sha:-}" ] || continue
        [ "$local_sha" = "$zero" ] && continue          # deleting a remote ref pushes nothing

        # The tip's tree. -I skips binaries; -l lists files. The status and the
        # error stream are read apart from the hits: git grep exits 1 for no match
        # and above 1 when it could not scan (a git that would not run, a killed
        # process, an argument list too long, a partial clone whose promisor is
        # unreachable), and a blob it cannot read it reports on stderr and skips,
        # exiting 1 (or 0, listing the files it did read), so a corrupt store made
        # the leaking file a clean one. Every hit is "<sha>:<path>", or the bare
        # "<sha>" when the pushed object peels to a blob (a tag of a blob, which
        # git grep reads as one file); any other line is an error, echoed under
        # the report. Found by execution (2026-09-20):
        # with a git grep exiting 2, and again with the leaking file's blob
        # missing, a tip whose tree carried a denylist string passed. --no-color:
        # with color.ui or color.grep set to always, git wraps each hit line in
        # colour codes even off a terminal, and a coloured hit is not
        # "<sha>:<path>": it read as an error line, and a real hit was reported
        # as a broken scanner (2026-09-21).
        rc=0; out=$(git grep --no-color -i -I -l -F "${grep_args[@]}" "$local_sha" -- 2>&1) || rc=$?
        hits=$(printf '%s\n' "$out" | grep -E "^$local_sha(:|\$)" || true)
        errs=$(printf '%s\n' "$out" | grep -Ev "^$local_sha(:|\$)" | grep . || true)
        if [ "$rc" -gt 1 ] || [ -n "$errs" ]; then
            unscanned "the CONTENT of the tip of $local_ref (${local_sha:0:10}) could not be fully scanned (git grep exited $rc)"
            [ -z "$errs" ] || printf '%s\n' "$errs" | sed 's/^/  /' >&2
        fi
        if [ -n "$hits" ]; then
            echo "romp pre-push: the tip of $local_ref (${local_sha:0:10}) would publish a personal identifier in:" >&2
            echo "$hits" | sed "s/^$local_sha:/  /" >&2
            blocked_ids=1
        fi

        # The tip's symlinks. git grep reads regular-file blobs only, so a link whose
        # TARGET holds a string is invisible to the grep above. A committed link's
        # target is its blob content, so read each 120000 entry's blob itself. Not
        # hypothetical: a `node_modules -> /home/<user>/code/romp/...` link, made to
        # run the extension tests in a worktree and swept up by a broad `git add`,
        # reached a public branch past a git grep of its tree, and a reviewer found
        # it, not the hook. An ls-tree line is "<mode> <type> <sha>\t<path>". The
        # listing is captured before the grep so a failed ls-tree has a road of its
        # own: piped straight into grep, the listing's failure was grep's no-match,
        # and a tree that could not be listed read as a tree with no symlinks (found
        # by execution, 2026-09-20: with one subtree object missing, ls-tree listed
        # the link and exited 1, the pipeline took that status, and a real push
        # published the branch). A failed listing refuses the push as unscanned;
        # whatever it did list is still read, so a link it named is still named.
        # A pushed object that peels to a BLOB (a tag of a blob) has no tree to
        # list: the listing is absent, not unreadable, and the content scan above
        # read the blob itself. The peel-type read is made only when the listing
        # failed, and its own failure refuses like any other.
        tip_listed=1            # read again with -z by refuse_hidden_paths; not when this listing failed or found no tree
        listing=$(git ls-tree -r "$local_sha" 2>/dev/null) || {
            tip_listed=0
            if [ "$(git cat-file -t "${local_sha}^{}" 2>/dev/null || true)" = blob ]; then
                listing=""
            else
                unscanned "the SYMLINKS of the tip of $local_ref (${local_sha:0:10}) could not be listed"
            fi
        }
        # Its entry count, for the -z listing refuse_hidden_paths makes of the same
        # tree to agree with (the header's second class). grep -c over the lines,
        # never wc -l over the printf: an empty listing is one empty line to wc.
        tip_entries=$(printf '%s\n' "$listing" | grep -c .) || true
        if links=$(printf '%s\n' "$listing" | grep '^120000 '); then
            while IFS= read -r link; do
                blob=${link#* * }; blob=${blob%%[[:space:]]*}
                link_path=${link#*$'\t'}
                # A blob that cannot be read is reported the same way, and its target
                # counts as empty so the loop goes on to the next link (under set -e a
                # bare failed substitution would end the hook before its verdict).
                target=$(git cat-file -p "$blob" 2>/dev/null) \
                    || { target=""; unscanned "the SYMLINK TARGET of $link_path at the tip of $local_ref (${local_sha:0:10}) could not be read"; }
                if printf '%s' "$target" | grep -qi -F "${grep_args[@]}"; then
                    echo "romp pre-push: the tip of $local_ref (${local_sha:0:10}) would publish a personal identifier" >&2
                    echo "  in the SYMLINK TARGET of $link_path -> $target" >&2
                    blocked_ids=1
                fi
            done <<< "$links"
        fi

        # The lines each commit new to the remote adds. Each per-commit read below
        # (the parent count and the diff, the addresses, the message) is captured with its status before
        # the grep or the loop that judges it: piped straight in, a diff-tree or log
        # that failed was the grep's no-match or a loop with nothing to read, a
        # commit that added, said and was stamped with nothing (found by execution,
        # 2026-09-20: each let its commit through a real push, git's error line the
        # only sign). A failed read names the commit and the read (unscanned) and
        # the scan goes on; whatever the read did print is still judged, so a hit
        # ahead of the failure is still named. An empty diff or message (an empty
        # commit, a merge with no line of its own) prints nothing and exits 0:
        # absent, not unreadable. git's own error line is not captured: it prints
        # ahead of the romp line, and message text cannot carry it.
        # shellcheck disable=SC2046  # the range is deliberately word-split
        revs=$(git rev-list $(rev_range "$local_sha" "$remote_sha") 2>/dev/null \
               || git rev-list "$local_sha")
        rev_counts=""           # "<sha> <parent count>" per line, for refuse_hidden_paths: the count read here decides a merge there, not a listing's shape
        for rev in $revs; do
            rc=0; n=$(parent_count "$rev") || rc=$?
            [ "$rc" -eq 0 ] || unscanned "the ADDED LINES of commit ${rev:0:10} could not be read (git rev-list --parents exited $rc)"
            rev_counts="$rev_counts$rev $n"$'\n'
            rc=0; out=$(added_lines "$rev" "$n") || rc=$?
            [ "$rc" -eq 0 ] || unscanned "the ADDED LINES of commit ${rev:0:10} could not be read (git diff-tree exited $rc)"
            if hits=$(printf '%s\n' "$out" | grep -i -F "${grep_args[@]}" | cut -f1 | sort -u) && [ -n "$hits" ]; then
                echo "romp pre-push: commit ${rev:0:10} ADDS a personal identifier in:" >&2
                echo "$hits" | sed 's/^/  /' >&2
                blocked_ids=1
            fi
            # The addresses it is stamped with: the domain of each one the clone did
            # not choose. `${email##*@}` is the whole string for an address with no @,
            # which git never stamps; such an address is read whole. Captured in
            # this shell rather than read through a process substitution: bash gives
            # the loop no status for one, and a counter set inside it is lost with
            # its subshell. A herestring of an empty capture is one empty line.
            rc=0; addrs=$(stamped_addresses "$rev" "$chosen") || rc=$?
            [ "$rc" -eq 0 ] || unscanned "the ADDRESSES of commit ${rev:0:10} could not be read (git log exited $rc)"
            while IFS=$'\t' read -r role email; do
                [ -n "$email" ] || continue
                if printf '%s' "${email##*@}" | grep -qi -F "${grep_args[@]}"; then
                    echo "romp pre-push: commit ${rev:0:10} is $role as <$email>, an address this clone is not configured to use, whose domain carries a personal identifier" >&2
                    blocked_ids=1
                    blocked_addresses=1
                fi
            done <<< "$addrs"
            # Its message, subject and body, like lines of content. -n so the report
            # can point at the line (1 is the subject) without echoing the string;
            # --no-show-signature so the message is all it reads (stamped_addresses).
            # Captured first; a substitution drops trailing newlines only, so the
            # numbering from the subject is the pipe's.
            rc=0; msg=$(git log -1 --no-show-signature --format=%B "$rev") || rc=$?
            [ "$rc" -eq 0 ] || unscanned "the MESSAGE of commit ${rev:0:10} could not be read (git log exited $rc)"
            if hits=$(printf '%s\n' "$msg" | grep -in -F "${grep_args[@]}" | cut -d: -f1) && [ -n "$hits" ]; then
                lines=$(printf '%s\n' "$hits" | tr '\n' ,); lines=${lines%,}
                echo "romp pre-push: the MESSAGE of commit ${rev:0:10} carries a personal identifier on line $lines (line 1 is the subject)" >&2
                blocked_ids=1
                blocked_messages=1
            fi
        done

        # The blobs the two content checks above skipped as binary while their
        # bytes are text (the header): refused rather than scanned, whatever
        # they carry.
        refuse_hidden_paths "$local_ref" "$local_sha" "$rev_counts" "$tip_listed" "$tip_entries"

        # An annotated tag's own tagger and message (the header note): the pushed
        # object, peeled tag by tag down to the commit, which the loop above read.
        # The tagger's address is read as a commit's are (not when the clone chose
        # it, its domain otherwise) and the message like a commit's. The type read
        # that opens the peel, and the one after each step, is captured apart from
        # the loop's test: read as "not a tag" when it failed, it left a tag unpeeled
        # and unscanned. A type or field whose read fails is reported (type_unread,
        # tag_unread) and refuses the push; its value still counts as empty so the
        # peel ends, and under set -e a bare failed substitution would end the hook
        # before its verdict.
        obj="$local_sha"
        kind="$(git cat-file -t "$obj" 2>/dev/null)" || { kind=""; type_unread "$local_ref" "$obj"; }
        while [ "$kind" = tag ]; do
            tagger="$(tag_field "$obj" tagger 2>/dev/null)" || { tagger=""; tag_unread "$local_ref" "$obj" TAGGER; }
            email=""
            case "$tagger" in *"<"*">"*) email="${tagger#*<}"; email="${email%%>*}";; esac
            if [ -n "$email" ] && ! is_chosen "$email" "$chosen" && printf '%s' "${email##*@}" | grep -qi -F "${grep_args[@]}"; then
                echo "romp pre-push: tag $local_ref (${obj:0:10}) is tagged as <$email>, an address this clone is not configured to use, whose domain carries a personal identifier" >&2
                blocked_ids=1
                blocked_addresses=1
                blocked_tags=1
            fi
            # The message is captured before the grep so a failed read has a road of
            # its own: piped straight into grep, the read's failure was grep's no-match.
            msg="$(tag_message "$obj" 2>/dev/null)" || { msg=""; tag_unread "$local_ref" "$obj" MESSAGE; }
            if hits=$(printf '%s\n' "$msg" | grep -in -F "${grep_args[@]}" | cut -d: -f1) && [ -n "$hits" ]; then
                lines=$(printf '%s\n' "$hits" | tr '\n' ,); lines=${lines%,}
                echo "romp pre-push: the MESSAGE of tag $local_ref (${obj:0:10}) carries a personal identifier on line $lines" >&2
                blocked_ids=1
                blocked_messages=1
                blocked_tags=1
            fi
            inner="$(tag_field "$obj" object 2>/dev/null)" || { inner=""; tag_unread "$local_ref" "$obj" OBJECT "which ends the peel here"; }
            obj="$inner"
            [ -n "$obj" ] || break      # the OBJECT read failed, reported above: nothing to peel to
            kind="$(git cat-file -t "$obj" 2>/dev/null)" || { kind=""; type_unread "$local_ref" "$obj"; }
        done
    done <<< "$refs"
    [ -z "$scratch" ] || rm -rf -- "$scratch"      # the exact minted path, never a glob (the header's residual)

    if [ "$hidden_paths" -ne 0 ]; then
        # The attribute is the cause, so the advice says what to do about the
        # attribute: drop it, or keep the file text on purpose with a diff line
        # that outranks it (a later line in the same .gitattributes, a file git
        # reads ahead of the one carrying the -diff; .git/info/attributes
        # outranks the tree's files, so a -diff there is changed there). A
        # rename or copy of such a file is refused the same way, on purpose: its
        # bytes reach the remote under the new path. A refusal a contributor
        # cannot act on is a reason to bypass the hook (2026-09-21). Where a line
        # named no attribute, the cause is elsewhere: the one key git has today
        # is named, with the facts the line printed and the remedy, and the
        # explicit diff line above outranks that key too. Where a line named
        # the previous version's bytes, no attribute and no key is the cause
        # and the scan cannot read the change: the remedy is the range's (a
        # commit some remote holds is out of range once that remote is
        # fetched), and a new commit of the shape has the bypass alone.
        echo "  Remove the diff attribute for each path named (the -diff line or binary macro in .gitattributes, .git/info/attributes or the file core.attributesFile names, or the driver's diff.<driver>.binary), or keep the file text on purpose with an explicit \"<path> diff\" line (a later line in .gitattributes overrides a -diff inherited from a broader pattern or from core.attributesFile; a -diff in .git/info/attributes outranks the tree's files and is changed there), then push again." >&2
        echo "  A rename or copy of such a file is content too: its bytes reach the remote under the new path, so the refusal is about the attribute, not the rename." >&2
        if [ "$hidden_unnamed" -ne 0 ]; then
            echo "  Where a line names no attribute, a configuration key can be what makes git call the file binary: core.bigFileThreshold makes it call every blob over that size binary (the line shows the key's value here and the blob's size), so raise the key above the size or unset it (git config --unset core.bigFileThreshold) and push again; the explicit \"<path> diff\" line above outranks the key as well for a regular file (a one-parent commit's diff applies no attribute to a symbolic link's target, so for such a link the key is the remedy)." >&2
        fi
        if [ "$hidden_prior" -ne 0 ]; then
            echo "  Where a line names the previous version's bytes as the cause, the hook scans only commits new to every fetched remote: if the commit is already on some remote, fetch that remote first and push again, or push from a clone that has fetched it. A commit of this shape that no remote holds yet is refused the same way, since the scan cannot read its new text; check that text yourself before using the bypass below." >&2
        fi
    fi
    if [ "$blocked_ids" -ne 0 ]; then
        echo "" >&2
        echo "romp pre-push: BLOCKED — a banned string from $strings_file is in a pushed commit." >&2
        echo "  Replace it with synthetic data (see CONTRIBUTING.md), then push again." >&2
        echo "  If the string is only in an INTERMEDIATE commit, squash or rewrite the branch." >&2
        echo "  If the tip only INHERITS a string an older commit added, merge the main that has since redacted it." >&2
        echo "  If the named commit is already on some remote, this clone has not fetched it: fetch, then push again." >&2
        if [ "$blocked_addresses" -ne 0 ]; then
            echo "  An address this clone is not configured to use, with a banned string in its domain, is refused on every commit it stamps:" >&2
            echo "    if it is yours, say so (git config --global user.email <address>) and push again;" >&2
            echo "    if git filled it from the hostname (an unset user.email gets <login>@<hostname>), set yours, add user.useConfigOnly true" >&2
            echo "    so git never fills it again, and rewrite the named commits, e.g. git rebase <base> --exec 'git commit --amend --no-edit --reset-author'." >&2
        fi
        if [ "$blocked_messages" -ne 0 ]; then
            echo "  A commit MESSAGE is never redacted forward: rewrite the named commit (git commit --amend for the tip, a reword rebase with git rebase -i <base> for an older one) and push again." >&2
        fi
        if [ "$blocked_tags" -ne 0 ]; then
            echo "  An annotated TAG's tagger and message are the tag object's own: re-create it under your configured address, with a clean message (git tag -f -a <name> <commit>), and push it again." >&2
        fi
    fi
}

# ── credentials ───────────────────────────────────────────────────────────
# gitleaks (ROMP_GITLEAKS, else the first on PATH) over the commits this push
# publishes: the same range per ref as the identifier scan, so a secret that is
# already on a remote does not refuse every later push, and a secret in an
# intermediate commit whose tip is clean is still caught.
#
# The commits gitleaks COUNTS over a range, derived the way it counts them, so
# the count it reports can be checked (scan_credentials). gitleaks reads
# `git log -p -U0` over the range and counts a commit once it has scanned one
# hunk of one file that is not a deletion: its "N commits scanned" is the
# distinct commits among the fragments it scanned, and its own debug note says
# the number can be smaller than expected "due to commits with no additions".
# So an empty commit, a deletion, a mode-only change and an empty new file count
# for nothing, and `git rev-list --count` over-counts every one of them.
#
# Derived from the OBJECTS, not from a patch: a count read from the same
# `git log -p` stream gitleaks reads shared every transform of that stream (the
# header) and agreed with an emptied scan. Here rev-list names every commit in
# the range with its first parent (the commits gitleaks' log walks), one
# diff-tree --raw lists each commit's changed paths against that parent (a root
# against the empty tree) with their blob shas, without rename detection, diff
# drivers, attributes or colour, and one cat-file reads the sizes of the blobs
# whose size decides. A commit has content when one entry that is not a
# deletion gives the patch a hunk: a gitlink whose sha changed (a `Subproject
# commit` line either way), a modified blob whose sha changed (a mode-only
# change keeps the sha and prints no hunk; a file emptied prints one), or a new
# or type-changed path whose blob is not empty (an empty new file or link prints
# no hunk). gitleaks' git is given --text and --no-renames (gitleaks_args), so a
# binary file is diffed as text and a pure rename as a deletion and an addition,
# and both count here as their bytes say; checked by execution against gitleaks
# 8.28.0 and 8.30.1 over the commit shapes in the round's log (2026-09-21).
# --stdin: one diff-tree for the whole range; a merge fed with its first parent
# alone is diffed against that parent. A blob cat-file cannot find fails the
# count (missing), as does any of the three reads failing: refused (the caller),
# never counted as 0. The cost is three git reads per pushed ref, whatever the
# range's size.
scannable_commits() {   # <rev-list argument list>
    local raw sizes
    raw=$(git rev-list --parents "$@" | awk '{ print ($2 == "" ? $1 : $1 " " $2) }' \
          | git diff-tree --stdin -r --raw --no-renames --root) || return $?
    sizes=$(printf '%s\n' "$raw" | awk '/^:/ && $2 != "160000" && ($5 == "A" || $5 == "T") { print $4 }' | sort -u \
            | git cat-file --batch-check='%(objectname) %(objectsize)') || return $?
    printf '%s\n%s\n' "$sizes" "$raw" | awk '
        !/^:/ && NF == 2 && $2 == "missing" { print "fatal: blob " $1 " is missing" > "/dev/stderr"; bad = 1; exit 3 }
        !/^:/ && NF == 2                     { size[$1] = $2; next }
        !/^:/ && NF == 1                     { c = $1; next }
        /^:/ && $5 != "D" && !(c in seen) {
            if ($2 == "160000")              hit = ($3 != $4)
            else if ($5 == "A" || $5 == "T") hit = (size[$4] > 0)
            else                             hit = ($3 != $4)
            if (hit) { seen[c] = 1; n++ }
        }
        END { if (!bad) print n + 0 }'
}

# gitleaks' argument list, built in ONE place: the invocation in scan_credentials
# and tests/pre-push-hook.bats's scan_direct, which reads this function out of
# this file, call the scanner with the same words by construction. The range
# comes first in --log-opts and --diff-merges=first-parent next, the order
# tests/install-sh.bats pins by substring.
# -v prints the file, line and rule; without it gitleaks reports only a COUNT,
# which says a push was refused but not what to fix. --redact keeps the secret
# itself out of terminal scrollback: the location is what a fix needs, and the
# value has to be rotated anyway. --exit-code 2 tells a finding apart from
# gitleaks failing (exit 1: an unreadable config, say); both refuse the push,
# with different advice. --diff-merges=first-parent: `gitleaks git` runs
# `git log -p`, which shows NO diff for a merge commit by default, so a secret
# introduced during a conflict resolution (in neither parent, only the merge
# tree) would be scanned by nothing; the first-parent diff of each merge
# surfaces exactly that content, and non-merges are unaffected. The rest ask
# git for a plain stream, each outranking the config key it neutralises in
# every scope (the header): --no-color (color.ui, color.diff: gitleaks finds no
# file header in a coloured patch); --no-textconv (a diff.<driver>.textconv
# named by a .gitattributes entry rewrites the text gitleaks scans);
# --text (a -diff attribute, or core.bigFileThreshold, makes git call a file
# binary and print no hunk for it); --no-renames (diff.renames: a pure rename
# is a deletion and an addition, whatever the key says, as scannable_commits
# counts it); --submodule=short and --ignore-submodules=none (diff.submodule,
# diff.ignoreSubmodules: a gitlink change stays one hunk); --no-show-signature
# (log.showSignature writes gpg's report into the stream); --pretty=medium and
# --date=default (format.pretty, log.date: gitleaks parses the default header);
# --root (log.showRoot set to false hides a root commit's diff, so the scanner
# read one commit fewer with no error line).
gitleaks_args() {   # <root> <range> [<config option>...]: fills GL_ARGS
    local root="$1" range="$2"
    shift 2
    # --root outranks log.showRoot=false (verified by execution) and travels on the scanner's command line, so a scanner git that does not inherit the hook's environment still reads it.
    GL_ARGS=(git "$root" --no-banner --redact -v --exit-code 2 "$@"
        "--log-opts=$range --diff-merges=first-parent --no-color --no-textconv --text --no-renames --submodule=short --ignore-submodules=none --no-show-signature --pretty=medium --date=default --root")
}

scan_credentials() {
    local gl root cfg range rc local_ref local_sha _remote_ref remote_sha log plain err expected reported
    if ! credential_scan_armed; then
        [ -n "${ROMP_NO_GITLEAKS:-}" ] && return 0     # a skip asked for: silent
        # No binary. Loud rather than silent, but not a blocker: requiring an
        # install to push would break every clone that never wanted the
        # scanner, and CI scans the full history regardless.
        echo "romp pre-push: gitleaks not installed, pushing WITHOUT a secret scan." >&2
        echo "  Install it (brew install gitleaks, or the release .github/workflows/ci.yml pins)." >&2
        echo "  ROMP_GITLEAKS names a binary that is not on PATH; ROMP_NO_GITLEAKS=1 silences this." >&2
        return 0
    fi
    gl="$(gitleaks_binary)"

    root="$(git rev-parse --show-toplevel)"
    # The repo's rules, named explicitly: without --config gitleaks reads a
    # GITLEAKS_CONFIG from the environment before the source root, so a
    # developer's own config (for a pre-commit hook of theirs, say) would
    # replace the repo's. A tree without the file scans under the default rules.
    cfg=()
    [ -f "$root/.gitleaks.toml" ] && cfg=(--config "$root/.gitleaks.toml")

    while read -r local_ref local_sha _remote_ref remote_sha; do
        [ -n "${local_sha:-}" ] || continue
        [ "$local_sha" = "$zero" ] && continue      # deleting a remote ref pushes nothing
        # The range has to RESOLVE in this clone before gitleaks sees it: handed
        # a sha git cannot find (a force-push over a remote tip nobody fetched),
        # gitleaks' git log fails, and the identifier scan falls back to
        # everything the pushed tip reaches; so does this one. That is all this
        # probe covers. What gitleaks did with the range it was given (a git
        # that ran but failed, or wrote to stderr; a log that came up short) is
        # read from its own log after the scan, below, not from its exit status.
        range="$(rev_range "$local_sha" "$remote_sha")"
        # shellcheck disable=SC2086  # the range is deliberately word-split
        git rev-list $range >/dev/null 2>&1 || range="$local_sha"
        # The commits gitleaks should count over that range, read before the scan
        # so a range this git cannot read is refused on a line of its own.
        # shellcheck disable=SC2086  # the range is deliberately word-split
        rc=0; expected=$(scannable_commits $range) || { rc=$?; expected=""; }
        if [ "$rc" -ne 0 ]; then
            unscanned "the COMMITS of $local_ref (${local_sha:0:10}) could not be counted for the credential scan (a git read exited $rc)"
            failed_creds=1
        fi
        # The argument list is gitleaks_args' (the options and why, there).
        # ${cfg[@]+...}: an empty array expands to nothing under set -u in
        # every bash, the 3.2 that macOS ships included.
        # gitleaks' stdout (the findings, under -v) goes to stderr as it is
        # written; its stderr, the log, is captured and shown after it, because
        # the verdict is read from the log (the header): gitleaks logs its git's
        # stderr at ERR and then reports the commits it did read as if the scan
        # were whole. The colour codes it writes even off a terminal are stripped
        # from the copy that is read, not from the copy shown.
        gitleaks_args "$root" "$range" ${cfg[@]+"${cfg[@]}"}
        rc=0
        log=$( { "$gl" "${GL_ARGS[@]}" 2>&1 1>&3; } 3>&2 ) || rc=$?
        [ -z "$log" ] || printf '%s\n' "$log" >&2
        case $rc in
            0) ;;
            2) blocked_creds=1 ;;
            *) failed_scan=1; failed_creds=1 ;;
        esac
        # A scan gitleaks reports (exit 0 or 2) is whole only on its own evidence:
        # no line at its ERR level (`<time> ERR <message>`; its git's stderr
        # comes back as `[git] <line>`), and a reported count equal to the
        # hook's. An absent count line is no evidence either. Both refuse as
        # unscanned, with the scanner's advice; a finding beside them still
        # prints its own.
        if [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ]; then
            plain=$(printf '%s\n' "$log" | sed $'s/\e\\[[0-9;]*m//g')
            err=$(printf '%s\n' "$plain" | awk '$2 == "ERR" { sub(/^[^ ]+ ERR /, ""); print; exit }')
            if [ -n "$err" ]; then
                unscanned "the CREDENTIAL scan of $local_ref (${local_sha:0:10}) did not complete: gitleaks logged an error ($err)"
                failed_creds=1
            fi
            reported=$(printf '%s\n' "$plain" | awk '$2 == "INF" && $4 == "commits" && $5 == "scanned." { print $3; exit }')
            if [ -z "$reported" ]; then
                unscanned "the CREDENTIAL scan of $local_ref (${local_sha:0:10}) reported no commit count, so what it read is unknown"
                failed_creds=1
            elif [ -n "$expected" ] && [ "$reported" != "$expected" ]; then
                unscanned "the CREDENTIAL scan of $local_ref (${local_sha:0:10}) covered $reported of the $expected commits with content to scan"
                failed_creds=1
                # A count that came up SHORT while log.showRoot is false in the
                # clone's configuration (showroot_configured) and a root commit is
                # in the range (the header): two observed facts, stated as such.
                # The key is one CANDIDATE cause: a scanner git that did not
                # honour the --root option gitleaks_args passes would have the
                # root's diff hidden by the key; a log shortened for any other
                # reason meets the same two facts (by execution, a --max-count or
                # --skip on the scanner's log), so the line neither asserts the
                # option went unhonoured nor promises that the key's remedy lifts
                # the refusal. A refusal a contributor cannot act on is a defect,
                # so the remedy for the candidate is still given.
                # shellcheck disable=SC2086  # the range is deliberately word-split
                if [ "$reported" -lt "$expected" ] 2>/dev/null && [ "$showroot_configured" = false ] \
                    && [ -n "$(git rev-list --max-parents=0 $range 2>/dev/null || true)" ]; then
                    echo "romp pre-push: the scanner covered fewer commits than the push has content for while log.showRoot is false in this clone's configuration and the range holds a root commit; if the scanner's git did not honour the --root option the hook passes on its log, that key is what hid the root commit's diff: set it to true (git config log.showRoot true) or unset it and push again, or ROMP_NO_GITLEAKS=1 skips the credential scan for this one push" >&2
                fi
            fi
        fi
    done <<< "$refs"

    if [ "$blocked_creds" -ne 0 ]; then
        echo "" >&2
        echo "romp pre-push: BLOCKED. gitleaks found a credential in a pushed commit." >&2
        echo "  Treat it as compromised the moment it exists in a commit: ROTATE it, then remove it." >&2
        echo "  Removing it in a NEW commit is not enough; the old commit still carries it." >&2
        echo "  A false positive belongs in .gitleaks.toml, narrowly, with a reason." >&2
    fi
    if [ "$failed_creds" -ne 0 ]; then
        echo "" >&2
        echo "romp pre-push: BLOCKED. gitleaks could not scan; its error is above." >&2
        echo "  The push is refused rather than published unscanned. Fix the scanner or its config, or set ROMP_NO_GITLEAKS=1 for one push." >&2
    fi
}

refuse_replace_refs
scan_identifiers
scan_credentials

# Both scans have reported; one bypass line, then the verdict.
if [ "$blocked_ids" -ne 0 ] || [ "$blocked_creds" -ne 0 ] || [ "$failed_scan" -ne 0 ]; then
    echo "  To bypass for one push (you are sure it is fine): git push --no-verify" >&2
    exit 1
fi
exit 0
