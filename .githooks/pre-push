        # patch owed and did not print when it has none. A candidate the diff
        # read as a rename is marked (+rename)
        # so the line can say the earlier path counted; a one-parent commit's
        # symlink is marked (+link) so the line reads no attribute; a path
        # judged as the addition of its new object (+typed: a type change, a
        # merge's rename candidate) reads no previous version, since the
        # addition verdict alone decided it. One a read
        # did not answer for is a short read (awk exits 3 for the pair
        # numstats or the combined patch, 4 for the addition numstat), refused
        # as unscanned when every read exited 0: a read that failed on its
        # status was refused above, once, and is not refused again for the
        # rows it lost.
        rc=0; LC_ALL=C awk -v rev="$rev" -v merge="$merge" '
            FILENAME == ARGV[1] { p = substr($0, 4); seenm[p] = 1; if (substr($0, 1, 1) == "b") binm[p] = 1; if (substr($0, 1, 1) == "t") hunk[p] = 1; if (substr($0, 2, 1) == "r") ren[p] = 1; next }
