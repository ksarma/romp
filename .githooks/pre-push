                    echo "romp pre-push: commit ${rev:0:10} ADDS a personal identifier in:" >&2
                    while IFS= read -r line; do printf '  %s\n' "$line" >&2; done <<< "$hits"
                    blocked_ids=1
                fi
            else
                unscanned "the ADDED LINES of commit ${rev:0:10} could not be read (no scratch directory for the capture: mktemp failed)"
            fi
            # The addresses it is stamped with, one line per role as "<role>\t<address>"
            # (authored and committed, whether or not the two are the same), and the
            # domain of each one the clone did not choose. `${email##*@}` is the whole
            # string for an address with no @, which git never stamps; such an
            # address is read whole. An empty address is skipped (there is nothing
            # to publish in `<>`), and so is a chosen one (is_chosen).
            # --no-show-signature here and on the message read below: with
            # log.showSignature set, git log prints a signed commit's verification
            # report (the signer's name or address among it) ahead of whatever the
            # format asks for. Read as part of the message, that refused a clean
            # signed commit whose signer is on the denylist, as the author's own
            # name and address are, and numbered a real hit's line from the report's
            # first line rather than the subject. The flag keeps both reads to the
            # commit's own fields. The log is captured in this shell (never a
            # process substitution, which gives the loop no status and loses a
            # counter set inside it) and its answer judged against the format asked
            # for: the two role lines, so an exit-0 answer of any other shape is
            # short, refused as unscanned naming it, and then a TAIL marker (a
            # newline, the word end, a tab and the commit's own name, which no
            # address can hold), as the message log asks for one: an answer that
            # holds the two roles and does not END with the tail marker is short
            # too, refused naming its last line, since the role lines bound the
            # answer's start alone (a log cut inside the committed address, exit
            # 0, passed a banned domain through a real push; the r8b2 audit,
            # 2026-09-23). Whatever was printed is judged either way, the tail
            # marker set aside. A herestring of an empty capture is one empty line.
            judged_read gate="the ADDRESSES log of a commit" 0 "the ADDRESSES of commit ${rev:0:10} could not be read (git log exited {rc})" -- git log -1 --no-show-signature --format='authored%x09%ae%ncommitted%x09%ce%nend%x09%H' "$rev" || :
            addrs=$read_out
            if [ "$read_rc" -eq 0 ]; then
                case "$addrs" in
                    authored$'\t'*$'\n'committed$'\t'*$'\n'end$'\t'"$rev") ;;
                    authored$'\t'*$'\n'committed$'\t'*) unscanned "the ADDRESSES of commit ${rev:0:10} were read short (git log exited 0 and answered \"${addrs##*$'\n'}\" on its last line, not the tail marker line the format asks for after the two roles)" ;;
                    *) unscanned "the ADDRESSES of commit ${rev:0:10} could not be read (git log exited 0 and answered \"$addrs\", not the two stamped roles)" ;;
                esac
            fi
            addrs=${addrs%$'\n'end$'\t'"$rev"}      # the tail marker is no address
            # The addresses on descriptor 7, never stdin, as the refs and the links
            # are read: the loop runs a tool (the domain grep, through judged_read),
            # and a loop that reads its list on stdin runs none, directly, through
            # judged_read or through a function of this file (round 9b; the loop
            # census in tests/pre-push-hook.bats holds every loop to that).
            while IFS=$'\t' read -r -u 7 role email; do
                [ -n "$email" ] || continue
                is_chosen "$email" "$chosen" && continue
                if judged_read own="the ADDRESS DOMAIN grep" 0,1 "the ADDRESS <$email> of commit ${rev:0:10} could not be grepped (grep exited {rc})" -- grep -qi -F "${grep_args[@]}" <<< "${email##*@}" && [ "$read_rc" -eq 0 ]; then
                    # The cause that leads is the one the reads established: with
                    # the chosen-addresses read failed (chosen_unread, refused
                    # above), whether the clone chose the address is unknown, and
                    # "not configured to use" would be a false cause with an
                    # inapplicable remedy (round 7b; the same for the tag below).
                    if [ "$chosen_unread" -ne 0 ]; then
                        echo "romp pre-push: commit ${rev:0:10} is $role as <$email>: whether this clone is configured to use that address could not be read (git config --get-all user.email exited $chosen_unread, refused above), and its domain carries a personal identifier" >&2
                    else
                        echo "romp pre-push: commit ${rev:0:10} is $role as <$email>, an address this clone is not configured to use, whose domain carries a personal identifier" >&2
                    fi
                    blocked_ids=1
                    blocked_addresses=1
                fi
            done 7<<< "$addrs"
            # Its message, subject and body, like lines of content. -n so the report
            # can point at the line (1 is the subject) without echoing the string;
            # --no-show-signature so the message is all it reads (above). Captured
            # first; a substitution drops trailing newlines only, so the numbering
            # from the subject is the grep's (message_hit_lines). The format asks
            # for TWO MARKER lines, one ahead of the message (the word message, a
            # tab and the commit's own name; %B after a newline) and one after it
            # (a newline, the word end, a tab and the name), the sibling facts for
            # the log's answer (the header's second class), as the addresses log
            # asks for its two role lines: an exit-0 answer not beginning with the
            # head marker is short, refused as unscanned naming the read and its
            # first line (a git log exiting 0 and printing nothing was read as an
            # empty message and published a banned subject through a real push;
            # the round 6 refuters, 2026-09-22), and one that begins with it and
            # does not END with the tail marker is short too, refused naming its
            # last line, since a head marker bounds the answer's start alone (a
            # log answering the marker and the subject, exit 0, passed the body
            # unread through a real push; the round 7 refuter, 2026-09-23). The
            # message is the text between the markers, its trailing newlines
            # dropped as the substitution dropped them (%B keeps the message's
            # own), so a commit whose message is empty reads as empty, the
            # object's own answer. The commit object's size cannot stand as the
            # fact: a commit object always has bytes, and an empty message is
            # legitimate. Whatever the read printed is grepped either way, so a
            # hit ahead of a failure is still named, numbered from the subject.
            judged_read gate="the MESSAGE log of a commit" 0 "the MESSAGE of commit ${rev:0:10} could not be read (git log exited {rc})" -- git log -1 --no-show-signature --format='message%x09%H%n%B%nend%x09%H' "$rev" || :
            case "$read_out" in
                message$'\t'"$rev"$'\n'*$'\n'end$'\t'"$rev")
                    msg=${read_out#message$'\t'"$rev"$'\n'}; msg=${msg%$'\n'end$'\t'"$rev"}
                    while [ "${msg%$'\n'}" != "$msg" ]; do msg=${msg%$'\n'}; done ;;
                message$'\t'"$rev"|message$'\t'"$rev"$'\n'*)                   # the head marker with no tail: a short answer
                    msg=${read_out#message$'\t'"$rev"}; msg=${msg#$'\n'}
                    [ "$read_rc" -ne 0 ] || unscanned "the MESSAGE of commit ${rev:0:10} was read short (git log exited 0 and answered \"${read_out##*$'\n'}\" on its last line, not the tail marker line the format asks for after the message)" ;;
                *) msg=$read_out
                   [ "$read_rc" -ne 0 ] || unscanned "the MESSAGE of commit ${rev:0:10} could not be read (git log exited 0 and answered \"${read_out%%$'\n'*}\" on its first line, not the marker line the format asks for ahead of the message)" ;;
            esac
            if message_hit_lines "the MESSAGE of commit ${rev:0:10}" "$msg"; then
                echo "romp pre-push: the MESSAGE of commit ${rev:0:10} carries a personal identifier on line $lines (line 1 is the subject)" >&2
                blocked_ids=1
                blocked_messages=1
            fi
        done

        # The blobs the two content checks above skipped as binary while their
        # bytes are text (the header): refused rather than scanned, whatever
        # they carry.
        refuse_hidden_paths "$local_ref" "$local_sha" "$rev_counts" "$tip_listed" "$tip_entries"

        # An annotated tag's own tagger and message (the header note): the pushed
        # object, peeled tag by tag down to the commit, which the loop above read.
        # The tagger's address is read as a commit's are (not when the clone chose
        # it, its domain otherwise) and the message like a commit's. The type read
        # that opens the peel, and the one after each step, is captured apart from
        # the loop's test: read as "not a tag" when it failed, it left a tag unpeeled
        # and unscanned. A type read that fails is reported (type_unread) and refuses
        # the push, and so is the object read below (its own clause, naming the
        # three fields it carries); the fields then count as empty so the peel
        # ends, and under set -e a bare failed substitution would end the hook
        # before its verdict.
        obj="$local_sha"
        object_type "$local_ref" "$obj"
        while [ "$kind" = tag ]; do
            # The tag OBJECT, read ONCE (cat-file -p prints a tag object as it is
            # stored, byte for byte) into a scratch file and parsed here by the
            # shell: the header to the first BLANK line (the object and tagger
            # lines among it, the first of each kept), the message the rest, its
            # trailing newlines dropped as a substitution's are. No awk or tr
            # stands between the object and the three checks (an awk exiting 0
            # printing nothing for a field read as an absent tagger and an absent
            # message, and published both through real pushes; the round 6
            # refuters, 2026-09-22). EVERY capture is judged against the object's
            # SIZE (cat-file -s) by its own BYTE COUNT (wc -c, through the helper),
            # the header's second class: cat-file -p prints a tag object as its
            # raw bytes, so the two numbers agree for every whole read, an empty
            # message's included, and a capture of fewer bytes is a short read,
            # refused naming both numbers (until round 8 the size was asked only
            # for an EMPTY capture, and a cat-file -p exiting 0 after the header
            # and the blank line alone was parsed as a tag with no message and
            # published through a real push; the round 7 refuters, 2026-09-23); a
            # failed read is refused by the helper naming the three fields it
            # carries. Either refusal ends the peel.
            tagger=""; msg=""; inner=""; tag_read=0
            if ! make_scratch; then
                unscanned "the OBJECT of tag $local_ref (${obj:0:10}), its tagger and its message could not be read (no scratch directory for the capture: mktemp failed), which ends the peel here"
            elif judged_read gate="the OBJECT of a tag" 0 "the OBJECT of tag $local_ref (${obj:0:10}), its tagger and its message could not be read (git cat-file -p exited {rc}), which ends the peel here" -q -o "$scratch/tag" -- git cat-file -p "$obj"; then
                if judged_read gate="the SIZE of a tag object" 0 "the OBJECT of tag $local_ref (${obj:0:10}) was captured while its SIZE could not be read (git cat-file -s exited {rc}), so whether the read is whole is unknown, which ends the peel here" -q -- git cat-file -s "$obj"; then
                    size=$read_out
                    if judged_read gate="the BYTE COUNT of a tag capture" 0 "the OBJECT of tag $local_ref (${obj:0:10}) was captured while the capture's BYTE COUNT could not be read (wc exited {rc}), so whether the read is whole is unknown, which ends the peel here" -- wc -c < "$scratch/tag"; then
                        count=${read_out//[[:space:]]/}
                        if [ -z "$size" ] || [ -n "${size//[0-9]/}" ] || [ -z "$count" ] || [ -n "${count//[0-9]/}" ]; then
                            unscanned "the OBJECT of tag $local_ref (${obj:0:10}) was captured while its SIZE reads \"$size\" (git cat-file -s) and the capture's BYTE COUNT \"$count\" (wc -c), not two counts, so whether the read is whole is unknown, which ends the peel here"
                        elif [ "$count" -ne "$size" ]; then
                            unscanned "the OBJECT of tag $local_ref (${obj:0:10}) was read short (git cat-file -p exited 0 and its capture holds $count bytes where git cat-file -s gives the object's size as $size), which ends the peel here"
                        else
                            tag_read=1          # whole, an object of no bytes (none git would call a tag) included: parsed below, where an absent object line ends the peel
                        fi
                    fi
                fi
            fi
            if [ "$tag_read" -ne 0 ]; then
                hdr=1
                while IFS= read -r line || [ -n "$line" ]; do
                    if [ "$hdr" -ne 0 ]; then
                        # The header ends at the first BLANK line, one with no non-blank
                        # byte (the awk this parse replaced ended it at !NF; an empty-line
                        # test here read a hand-built tag's whitespace-only terminator as
                        # a header line and its message as more of them, and published a
                        # banned message through a real push; the round 7 refuter,
                        # 2026-09-23).
                        case "$line" in *[![:blank:]]*) ;; *) hdr=0; continue ;; esac
                        case "$line" in
                            "object "*) [ -n "$inner" ] || inner=${line#object } ;;
                            "tagger "*) [ -n "$tagger" ] || tagger=${line#tagger } ;;
                        esac
                    else
                        msg="$msg$line"$'\n'
                    fi
                done < "$scratch/tag"
                while [ "${msg%$'\n'}" != "$msg" ]; do msg=${msg%$'\n'}; done
            fi
            email=""
            case "$tagger" in *"<"*">"*) email="${tagger#*<}"; email="${email%%>*}";; esac
            if [ -n "$email" ] && ! is_chosen "$email" "$chosen" \
                && judged_read own="the ADDRESS DOMAIN grep" 0,1 "the TAGGER ADDRESS <$email> of tag $local_ref (${obj:0:10}) could not be grepped (grep exited {rc})" -- grep -qi -F "${grep_args[@]}" <<< "${email##*@}" && [ "$read_rc" -eq 0 ]; then
                if [ "$chosen_unread" -ne 0 ]; then
                    echo "romp pre-push: tag $local_ref (${obj:0:10}) is tagged as <$email>: whether this clone is configured to use that address could not be read (git config --get-all user.email exited $chosen_unread, refused above), and its domain carries a personal identifier" >&2
                else
                    echo "romp pre-push: tag $local_ref (${obj:0:10}) is tagged as <$email>, an address this clone is not configured to use, whose domain carries a personal identifier" >&2
                fi
                blocked_ids=1
                blocked_addresses=1
                blocked_tags=1
                blocked_tag_addresses=1
            fi
            # The message, parsed from the same capture above, like a commit's.
            if message_hit_lines "the MESSAGE of tag $local_ref (${obj:0:10})" "$msg"; then
                echo "romp pre-push: the MESSAGE of tag $local_ref (${obj:0:10}) carries a personal identifier on line $lines" >&2
                blocked_ids=1
                blocked_messages=1
                blocked_tag_messages=1
                blocked_tags=1
            fi
            # The OBJECT field names what the tag points at, and the type read said
            # this object is a tag, so an object read whole with no such line is a
            # short answer (a tag object always carries one), refused as unscanned
            # naming the read; either way an absent field ends the peel.
            if [ "$tag_read" -ne 0 ] && [ -z "$inner" ]; then
                unscanned "the OBJECT field of tag $local_ref (${obj:0:10}) is absent (git cat-file -p exited 0 and printed a tag object with no object line) while its type read as tag, which ends the peel here"
            fi
            obj="$inner"
            [ -n "$obj" ] || break      # the OBJECT read failed, answered short or carries no object line, reported above: nothing to peel to
            object_type "$local_ref" "$obj"
        done
    done 5<<< "$refs"

    if [ "$hidden_paths" -ne 0 ]; then
        # Each remedy prints only where a refused line named its cause (or, for
        # the attribute, could not read it): a remedy for a cause no line named
        # is the first thing the pusher reads and the wrong one (on the shape
        # the header discloses, the attribute paragraph led while every line
        # said no attribute accounted for the verdict; the round 4 refuter,
        # 2026-09-22). Where a line named the attribute, the advice says what to
        # do about it: drop it, or keep the file text on purpose with a diff
        # line that outranks it (a later line in the same .gitattributes, a
        # file git reads ahead of the one carrying the -diff;
        # .git/info/attributes outranks the tree's files, so a -diff there is
        # changed there). A rename or copy of such a file is refused the same
        # way, on purpose: its bytes reach the remote under the new path. A
        # refusal a contributor cannot act on is a reason to bypass the hook
        # (2026-09-21). Where a line named no attribute, the cause is
        # elsewhere: the one key git has today is named, with the facts the
        # line printed and the remedy, and the explicit diff line outranks that
        # key too, said in this paragraph's own words, since the attribute's
        # paragraph is not there to point at. Where a line could not read the
        # attribute, either may be the cause and both paragraphs print. Where a
        # line named the previous version's bytes, no attribute and no key is
        # the cause and the scan cannot read the change: two remedies, the
        # range's (a commit some remote holds is out of range once that remote
        # is fetched) and, for a new commit of the shape, an explicit diff
        # attribute on the PREVIOUS version's path (the old path for a rename),
        # under which git treats that version as text whatever its bytes and
        # prints the change for the scan to read (by execution, the round 5
        # refuter, 2026-09-22), named ahead of the bypass it is safer than;
        # the attribute paragraph above is not that remedy (it removes a -diff
        # a line named), so the second line says it in its own words.
        if [ "$hidden_attr" -ne 0 ]; then
            echo "  Remove the diff attribute for each path named (the -diff line or binary macro in .gitattributes, .git/info/attributes or the file core.attributesFile names, or the driver's diff.<driver>.binary), or keep the file text on purpose with an explicit \"<path> diff\" line (a later line in .gitattributes overrides a -diff inherited from a broader pattern or from core.attributesFile; a -diff in .git/info/attributes outranks the tree's files and is changed there), then push again." >&2
            echo "  A rename or copy of such a file is content too: its bytes reach the remote under the new path, so the refusal is about the attribute, not the rename." >&2
        fi
        if [ "$hidden_unnamed" -ne 0 ]; then
            echo "  Where a line names no attribute, a configuration key can be what makes git call the file binary: core.bigFileThreshold makes it call every blob over that size binary (the line shows the key's value here and the blob's size), so raise the key above the size or unset it (git config --unset core.bigFileThreshold) and push again, or keep the file text on purpose with an explicit \"<path> diff\" line in .gitattributes, which outranks the key for a regular file (a one-parent commit's diff applies no attribute to a symbolic link's target, so for such a link the key is the remedy)." >&2
        fi
        if [ "$hidden_prior" -ne 0 ]; then
            echo "  Where a line names the previous version's bytes as the cause, the hook scans only commits new to every fetched remote: if the commit is already on some remote, fetch that remote first and push again, or push from a clone that has fetched it. A commit of this shape that no remote holds yet is refused the same way, since the scan cannot read its new text." >&2
            echo "  For a commit of that shape, set the diff attribute on the PREVIOUS version's path: an explicit \"<path> diff\" line in .gitattributes, for the old path where the line names one and for the file's own path otherwise. git then treats that version as text whatever its bytes, so the diff prints the change and the scan reads it; push again. That is safer than the bypass below, which publishes the new text unread." >&2
        fi
    fi
    if [ "$blocked_ids" -ne 0 ]; then
        echo "" >&2
        echo "romp pre-push: BLOCKED — a banned string from $strings_file is in a pushed commit." >&2
        echo "  Replace it with synthetic data (see CONTRIBUTING.md), then push again." >&2
        echo "  If the string is only in an INTERMEDIATE commit, squash or rewrite the branch." >&2
        echo "  If the tip only INHERITS a string an older commit added, merge the main that has since redacted it." >&2
        echo "  If the named commit is already on some remote, this clone has not fetched it: fetch, then push again." >&2
        # The address remedies name causes the chosen-addresses read establishes
        # (the address is the pusher's own; git filled it from the hostname), so
        # with that read failed (chosen_unread) they are unknown and none prints:
        # the paragraph leads with the failed read and its remedy, and keeps its
        # general rule, and the tag's remedy below waits the same way for a tag
        # refused on its tagger's address (until round 8b the say-so line and
        # the bullets printed beside a failed read, whose repair they could not
        # replace; the round 7 refuters, 2026-09-23). The tag's remedy is keyed
        # per cause, not per push: a tag refused on its message is re-created
        # with a clean message whatever the read says, so that remedy prints
        # whenever a tag message is refused, without the configured address
        # while the read failed, and the tag paragraph's first sentence alone
        # prints only for tags refused on their tagger's address alone beside a
        # failed read (round 8b's flag set it for the whole push, so a tag
        # refused on its message lost its remedy once another tag of the push
        # was refused on its tagger; the round 8 refuter, 2026-09-24).
        if [ "$blocked_addresses" -ne 0 ]; then
            if [ "$chosen_unread" -ne 0 ]; then
                echo "  The addresses this clone is configured to use could not be read (git config --get-all user.email exited $chosen_unread, refused above), so whether it chose each address named is unknown: run git config --get-all user.email yourself to see git's own error, repair that read and push again; configuring an address changes nothing until then." >&2
                echo "  An address this clone is not configured to use, with a banned string in its domain, is refused on every commit it stamps." >&2
            else
                echo "  An address this clone is not configured to use, with a banned string in its domain, is refused on every commit it stamps:" >&2
                echo "    if it is yours, say so (git config --global user.email <address>) and push again;" >&2
                echo "    if git filled it from the hostname (an unset user.email gets <login>@<hostname>), set yours, add user.useConfigOnly true" >&2
                echo "    so git never fills it again, and rewrite the named commits, e.g. git rebase <base> --exec 'git commit --amend --no-edit --reset-author'." >&2
            fi
        fi
        if [ "$blocked_messages" -ne 0 ]; then
            echo "  A commit MESSAGE is never redacted forward: rewrite the named commit (git commit --amend for the tip, a reword rebase with git rebase -i <base> for an older one) and push again." >&2
        fi
        if [ "$blocked_tags" -ne 0 ]; then
            if [ "$blocked_tag_messages" -ne 0 ] && [ "$chosen_unread" -ne 0 ]; then
                echo "  An annotated TAG's tagger and message are the tag object's own: re-create it with a clean message (git tag -f -a <name> <commit>), and push it again." >&2
            elif [ "$blocked_tag_messages" -eq 0 ] && [ "$chosen_unread" -ne 0 ] && [ "$blocked_tag_addresses" -ne 0 ]; then
                echo "  An annotated TAG's tagger and message are the tag object's own." >&2
            else
                echo "  An annotated TAG's tagger and message are the tag object's own: re-create it under your configured address, with a clean message (git tag -f -a <name> <commit>), and push it again." >&2
            fi
        fi
    fi
}

# ── credentials ───────────────────────────────────────────────────────────
# gitleaks (ROMP_GITLEAKS, else the first on PATH) over the lines the commits
# this push publishes add: the same commits per ref as the identifier scan,
# through the same listing (list_commits), so a secret that is already on a
# remote does not refuse every later push, and a secret in an intermediate
# commit whose tip is clean is still caught. The hook reads those lines
# itself (credential_feed) and gitleaks scans exactly the bytes it wrote
# (scanner_run), running no git; the header's credential paragraph says why,
# and what it costs.
#
# The credential feed of the push: ONE git diff-tree over every commit the
# ref loop listed, each fed twice (<rev>, then <rev> <rev>, the commit as its
# own parent), so --always prints the commit's name ahead of its diff and
# again after it, for the empty diff: the head marker and the tail marker.
# Each option is explicit, so no configuration key moves the read: -p -U0,
# the added lines alone; -r, into subtrees; -M, a rename by its edits; -c, a
# merge by the lines in none of its parents (a combined hunk carries one
# column per parent, the hunk header's @ count less one); --root, a root
# commit against the empty tree (plumbing reads no log.showRoot); --text,
# every blob of a root or one-parent commit as text, whatever its bytes, its
# path's diff attribute or core.bigFileThreshold say (a merge's combined diff
# applies git's binary verdict whatever --text says: below); --no-color,
# --no-textconv and --no-ext-diff (color.ui and color.diff, a textconv
# driver, an external diff); --ignore-submodules=none and --submodule=short
# (a gitlink change stays its Subproject line); and git -c
# core.quotePath=true, which sets on the command line the key that shapes a
# path's text, so each path comes in git's quoted form whatever the clone
# sets and no key moves the paths either (under core.quotePath=false a name
# with a byte over 127 printed raw, and pnpm-loc<U+212A>.yaml, the Kelvin
# sign in place of lock's k, a name the path-scoped selection below takes and
# gitleaks' case-folding allowlist skips, refused a clean push on that run's
# figure; the round 9d audit, 2026-09-24). tr maps NUL to 0x01, byte for
# byte, ahead of the awk: an awk that ends a record at a NUL would lose the
# rest of the line while every count stayed consistent, and no default rule
# names either byte. The awk reads the list file diff-tree reads (through the
# environment, never a -v operand: awk escape-processes a -v value, and a
# path may carry a backslash pair), checks each commit's head marker in the
# order fed and its tail marker, and compares names as strings ($0 "" == sha:
# two all-digit names compare as numbers otherwise); a commit two refs share
# is fed twice and its lines written once (the seen set). Each file's added
# lines in one commit start a new piece, a file named by its sequence number
# in the piece directory, whose first line holds ~; a piece holds at most CAP
# bytes, and the line that would pass it starts a new piece that first
# repeats the last V bytes of the file's lines (the ring keeps whole lines,
# the oldest cut to its tail); a line longer than LW = CAP - V - 4 bytes is
# cut into windows of LW bytes starting every LW - V, each after the first a
# piece of its own (the piecing is CRED_PIECES_AWK, below, which blob_pieces
# shares). The index names each piece's commit and file (the path as git
# quotes it, without git's trailing tab after a name holding a space), with a
# closing field of its own, so a line cut inside is not used. A file the
# path-scoped run selects (its name's suffix, less the names gitleaks' global
# path allowlist skips: the header) is listed again, piece by piece, in the
# second index under its copy's name: the piece's number and the suffix the
# selection matched, lower-cased (12.yaml, 12.p12), or nuget.config alone,
# which its piece's directory keeps apart, never a name taken from the path
# (until round 10b the copy took the path's quoted basename, escapes kept,
# and a selected file whose quoted basename passed 255 bytes ended the hook
# on a clean push with bash's File name too long line and no romp line; the
# round 9 refuters, 2026-09-25); then the name of its SECOND copy, for the
# probe run (the header): romp-copy-, the piece's number spelled in letters
# (a to j for 0 to 9: 12 is bc), a dot when the suffix holds none at its
# start, and the suffix as the file spells it, case kept (src/NuGet.Config's
# is romp-copy-bc.NuGet.Config); then the rule that suffix's files answer to
# (pkcs12-file, nuget-config-password, kubernetes-secret-yaml,
# hashicorp-tf-password or freemius-secret-key); and the bytes of its pieces
# are counted apart.
# Inside a commit, between its two name lines, the awk accounts for every
# line, by the lines this diff-tree prints (derived by running it over root,
# one-parent and merge commits, renames with and without edits, mode and type
# changes, empty files, symlinks, a gitlink added, changed and removed, a
# missing final newline, quoted, spaced and tab names and a three-parent
# octopus; git 2.43.0). It READS a diff header, the +++ target a header just
# opened, a hunk header inside a section (1 to 63 columns: a commit of 64 or
# more parents is refused apart, parent_counts) and a content line, its
# columns all + (in a commit two refs share, recognized and not written
# again). It RECOGNIZES AND IGNORES, between a header and its first hunk, the
# --- source line and the index, old mode, new mode, mode, new file mode,
# deleted file mode, similarity index, rename from and rename to lines, and
# inside a hunk the no-newline notice and a line whose columns are a run of
# -, + and space not all + (a context, removed or added-against-one-parent
# line, which the content rule skips on purpose). And in a diff --combined
# section it ROUTES the line Binary files differ: a merge's combined diff
# applies git's binary verdict whatever --text says (combine-diff.c computes
# it without reading the text flag), printing that line and no hunk for a
# path git calls binary in the result or in any parent, so the awk writes the
# merge and the path the section's header names (git's quoted form) to the
# binary file, a line each, counted in the record, and scan_credentials reads
# that path whole from the merge's result blob (merge_binary_reads; the cost,
# in the header: a merge whose binary path holds a credential a remote already
# published refuses the push). Any other line is foreign: a copy or
# dissimilarity line, which only -C and -B print; a bare Subproject line; a
# Binary notice in a diff --git section, which --text keeps a real git from
# printing, or in a combined section with no path; anything else. The feed
# cannot account for what a foreign line stands for, so it refuses the push
# naming the commit (until round 10 the awk passed every line it did not
# read, and a credential in a merge's binary path was published with every
# count agreeing; the round 9 refuters, 2026-09-25). The record is one line: a
# word that says where the read fell short (unmarked <n>, untailed <n>, short
# <done>, foreign <n> <commit>, or nolist, the list file unread), or five
# counts (commits read whole, pieces, bytes written, bytes of the path-scoped
# pieces, binary notices routed). The awk keeps draining after a bad marker
# or a foreign line, so diff-tree is never cut off mid-write and the record
# names the cause rather than a SIGPIPE status. Its status, under pipefail,
# is diff-tree's, tr's or the awk's (a kill included).
# The piecing, one awk text for the two reads that write pieces
# (credential_feed's awk, from the feed's added lines, and blob_pieces', from
# a merge's binary path read whole), so both cut, replay and index alike: the
# constants CAP, V and LW, put (a line written and counted), the ring (keep
# and forget), newpiece (the ~ line, the index lines, the replay), emit (a
# line, or the windows of a long one), shut, choose, the path-scoped
# selection by a path's basename (the header), and letters, a piece's number
# spelled for its second copy's name. Each awk program is this text followed
# by its own rules.
CRED_PIECES_AWK='
        function pieces_begin() {
            bytes = 0; pbytes = 0; pieces = 0; cur = ""; curq = 0; q = 0; rh = 1; rt = 0; rb = 0
            CAP = 98304; V = 16384; LW = CAP - V - 4
        }
        function put(s,   k) { print s > cur; k = length(s) + 1; pb += k; bytes += k }
        function forget() { for (; rh <= rt; rh++) delete rl[rh]; rh = rt + 1; rb = 0 }
        function keep(s) { rl[++rt] = s; rb += length(s) + 1
            while (rt > rh && rb - length(rl[rh]) - 1 >= V) { rb -= length(rl[rh]) + 1; delete rl[rh]; rh++ } }
        function shut() { if (cur != "") { close(cur); if (curq) pbytes += pb } }
        function newpiece(replay,   i, s, x) {
            shut()
            cur = dir "/" (++pieces); pb = 0; curq = q; put("~")
            printf "%d\t%s\t%s\t.\n", pieces, sha, f >> idx
            if (q) printf "%d\t%s\t%s\t%s\t.\n", pieces, (sfx == "nuget.config" ? sfx : pieces sfx), "romp-copy-" letters(pieces) (substr(osfx, 1, 1) == "." ? "" : ".") osfx, srule >> pidx
            if (replay) { x = rb - V; for (i = rh; i <= rt; i++) { s = rl[i]; if (i == rh && x > 0) s = substr(s, x + 1); put(s) } }
        }
        function emit(t,   L, s, w) {
            L = length(t)
            if (L <= LW) { if (pb + L + 1 > CAP) newpiece(1); put(t); keep(t); return }
            for (s = 1; ; s += LW - V) {
                w = substr(t, s, LW)
                if (s == 1) { if (pb + length(w) + 1 > CAP) newpiece(1) } else newpiece(0)
                put(w); if (s + LW > L) break
            }
            forget(); keep(w)
        }
        function choose(p) {
            f = p; base = f
            if (substr(base, 1, 1) == "\"") { base = substr(base, 2); sub(/"$/, "", base) }
            sub(/.*\//, "", base); lb = tolower(base)
            q = (lb ~ /(\.p12|\.pfx|nuget\.config|\.yaml|\.yml|\.tf|\.hcl|\.php)$/) && base !~ /gitleaks\.toml/ && lb !~ /verification-metadata\.xml|database.refactorlog/ && lb != "pnpm-lock.yaml"
            sfx = ""; osfx = ""; srule = ""
            if (q && match(lb, /(\.p12|\.pfx|nuget\.config|\.yaml|\.yml|\.tf|\.hcl|\.php)$/)) { sfx = substr(lb, RSTART); osfx = substr(base, RSTART) }
            if (sfx == ".p12" || sfx == ".pfx") srule = "pkcs12-file"
            else if (sfx == "nuget.config") srule = "nuget-config-password"
            else if (sfx == ".yaml" || sfx == ".yml") srule = "kubernetes-secret-yaml"
            else if (sfx == ".tf" || sfx == ".hcl") srule = "hashicorp-tf-password"
            else if (sfx == ".php") srule = "freemius-secret-key"
        }
        function letters(n,   s, i) { n = n ""; s = ""; for (i = 1; i <= length(n); i++) s = s substr("abcdefghij", substr(n, i, 1) + 1, 1); return s }'
credential_feed() {   # <list file> <record file> <piece directory> <index file> <path-scoped index file> <binary paths file>
    git -c core.quotePath=true diff-tree --stdin -p -U0 -r -M -c --root --always --text --no-color --no-textconv --no-ext-diff --ignore-submodules=none --submodule=short < "$1" \
    | LC_ALL=C tr '\000' '\001' \
    | LC_ALL=C ROMP_LIST_FILE=$1 ROMP_RECORD_FILE=$2 ROMP_PIECE_DIR=$3 ROMP_INDEX_FILE=$4 ROMP_PATH_INDEX_FILE=$5 ROMP_BINARY_FILE=$6 awk "$CRED_PIECES_AWK"'
        BEGIN {
            list = ENVIRON["ROMP_LIST_FILE"]; rec = ENVIRON["ROMP_RECORD_FILE"]; dir = ENVIRON["ROMP_PIECE_DIR"]
            idx = ENVIRON["ROMP_INDEX_FILE"]; pidx = ENVIRON["ROMP_PATH_INDEX_FILE"]; bin = ENVIRON["ROMP_BINARY_FILE"]
            while ((r = (getline l < list)) > 0) if (index(l, " ") == 0) want[++nwant] = l ""
            if (r < 0) bad = "nolist"
            close(list)
            pieces_begin(); done = 0; state = 0; nbin = 0
            pluses = "++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"
        }
        bad != ""                        { next }
        state == 0 {
            if (done >= nwant || $0 "" != want[done + 1]) { bad = "unmarked " (done + 1); next }
            sha = $0 ""; state = 1; hdr = 0; n = 0; kind = ""; hp = ""; f = ""; base = ""; q = 0; open = 0
            skip = (sha in seen); seen[sha] = 1; next
        }
        $0 "" == sha                     { state = 0; done++; next }
        /^diff --git /                   { hdr = 1; kind = "git"; hp = ""; n = 0; f = ""; base = ""; q = 0; open = 0; next }
        /^diff --combined /              { hdr = 1; kind = "combined"; hp = substr($0, 17); n = 0; f = ""; base = ""; q = 0; open = 0; next }
        hdr && /^\+\+\+ / {
            f = substr($0, 5); sub(/\t$/, "", f)
            if (substr(f, 1, 2) == "b/") f = substr(f, 3)
            else if (substr(f, 1, 3) == "\"b/") f = "\"" substr(f, 4)
            choose(f); next
        }
        hdr && /^(--- |index |old mode |new mode |mode |new file mode |deleted file mode |similarity index |rename from |rename to )/ { next }
        hdr && kind == "combined" && hp != "" && $0 == "Binary files differ" {
            if (!skip) { printf "%s\t%s\t.\n", sha, hp >> bin; nbin++ }
            next
        }
        kind != "" && /^@/ {
            match($0, /^@+/); n = RLENGTH - 1
            if (n < 1 || n > 63) { bad = "foreign " (done + 1) " " sha; next }
            hdr = 0; plus = substr(pluses, 1, n); next
        }
        !hdr && n > 0 && $0 == "\\ No newline at end of file" { next }
        !hdr && n > 0 && substr($0, 1, n) == plus {
            if (!skip) { if (!open) { open = 1; forget(); newpiece(0) } emit(substr($0, n + 1)) }
            next
        }
        !hdr && n > 0 { pre = substr($0, 1, n); if (length(pre) == n && pre !~ /[^-+ ]/) next }
        { bad = "foreign " (done + 1) " " sha }
        END {
            shut()
            if (bad != "")          print bad > rec
            else if (state != 0)    print "untailed " (done + 1) > rec
            else if (done != nwant) print "short " done > rec
            else                    print done, pieces, bytes, pbytes, nbin > rec
        }'
}

# A merge's binary path read whole (merge_binary_reads, the header): the
# blob's bytes, NUL mapped to 0x01 as the feed maps them, pieced exactly as
# the feed pieces a file's added lines (CRED_PIECES_AWK: each piece opens
# with the ~ line and holds at most CAP bytes, a continuation replays the
# last V bytes, a line longer than LW is cut into overlapping windows),
# numbered after the pieces already written, indexed to the merge and the
# path, and listed in the path-scoped index when choose takes the path's
# name. Why pieces and not the blob as one file: gitleaks reads a file of
# more than 100,000 bytes in chunks, so a credential across its cut
# published (a 140,000-byte merged path with the token at byte 124,990), and
# it skips a file that opens with an archive or document signature, so a
# clean merge of a zip or a pdf path was refused on the byte figure (the
# round 9 rulings, 2026-09-25). The group appends one newline after
# cat-file's answer, only when cat-file exited 0, so the stream always ends
# with a newline the blob did not have: the awk drops the empty last line
# that newline makes, or keeps a last line the blob left without one (read
# as a line and a newline, as the feed reads a missing final newline), and
# the bytes it read are the blob's size and one when cat-file answered
# whole, so any cut, the last byte of a blob with no final newline included,
# counts short. The record: four counts (bytes read, pieces written, bytes
# written, bytes of those pieces the path-scoped index lists). Its status,
# under pipefail, is cat-file's, tr's or the awk's.
blob_pieces() {   # <blob> <record file> <piece directory> <index file> <path-scoped index file> <merge> <path, as git quotes it> <pieces already written>
    { git cat-file -p "$1" && printf '\n'; } \
    | LC_ALL=C tr '\000' '\001' \
    | LC_ALL=C ROMP_BLOB_RECORD_FILE=$2 ROMP_PIECE_DIR=$3 ROMP_INDEX_FILE=$4 ROMP_PATH_INDEX_FILE=$5 ROMP_BLOB_MERGE=$6 ROMP_BLOB_PATH=$7 ROMP_BLOB_PIECES=$8 awk "$CRED_PIECES_AWK"'
        BEGIN {
            rec = ENVIRON["ROMP_BLOB_RECORD_FILE"]; dir = ENVIRON["ROMP_PIECE_DIR"]
            idx = ENVIRON["ROMP_INDEX_FILE"]; pidx = ENVIRON["ROMP_PATH_INDEX_FILE"]
            pieces_begin(); first = ENVIRON["ROMP_BLOB_PIECES"] + 0; pieces = first
            sha = ENVIRON["ROMP_BLOB_MERGE"] ""; choose(ENVIRON["ROMP_BLOB_PATH"] "")
            got = 0; held = 0; open = 0
        }
        function line(t) { if (!open) { open = 1; forget(); newpiece(0) } emit(t) }
        { got += length($0) + 1; if (held) line(last); last = $0; held = 1 }
        END {
            if (held && last != "") line(last)
            shut()
            print got, pieces - first, bytes, pbytes > rec
        }'
}

# The parent count of every commit the credential scan feeds (the header: a
# commit of 64 or more parents refuses the push, since git's combined diff
# cannot show the lines such a merge adds): ONE rev-list over the list file,
# --no-walk=unsorted, so each commit is answered once, in the order given, a
# repeat dropped, in a format of three lines per commit: the header rev-list
# prints ahead of a format (commit <name>), the parents, and the name again,
# the tail marker. The awk reads the list file rev-list reads (through the
# environment, as the feed's awk does), drops repeats the same way, and
# checks each commit's header and its tail in the order given, so a cut
# inside a commit's parents loses its tail and is refused; it prints each
# commit of 64 or more parents with its count, and records one line: a word
# that says where the read fell short (unmarked <n>, untailed <n>, short
# <done>, or nolist), or three counts (commits read whole, lines of the list
# read, commits of 64 or more parents printed), which scan_credentials
# compares with the count it fed and the lines it read back. Its status,
# under pipefail, is rev-list's or the awk's.
parent_counts() {   # <list file: one commit per line> <record file>: prints "<commit> <parent count>" for each commit of 64 or more parents
    git rev-list --no-walk=unsorted --stdin --format='%P%n%H' < "$1" \
    | LC_ALL=C ROMP_REVS_FILE=$1 ROMP_COUNTS_FILE=$2 awk '
        BEGIN {
            list = ENVIRON["ROMP_REVS_FILE"]; rec = ENVIRON["ROMP_COUNTS_FILE"]; listed = 0
            while ((r = (getline l < list)) > 0) { listed++; if (!((l "") in seen)) { seen[l ""] = 1; want[++nwant] = l "" } }
            if (r < 0) bad = "nolist"
            close(list); done = 0; state = 0; big = 0
        }
        bad != ""  { next }
        state == 0 { if (done >= nwant || ($0 "") != ("commit " want[done + 1])) { bad = "unmarked " (done + 1); next } state = 1; next }
        state == 1 { np = split($0, w, " "); state = 2; next }
        {
            if (($0 "") != want[done + 1]) { bad = "untailed " (done + 1); next }
            if (np >= 64) { print want[done + 1], np; big++ }
            done++; state = 0
        }
        END {
            if (bad != "")          print bad > rec
            else if (state != 0)    print "untailed " (done + 1) > rec
            else if (done != nwant) print "short " done > rec
            else                    print done, listed, big > rec
        }'
}

# gitleaks' argument list, built in ONE place for every run, in the order
# tests/install-sh.bats pins by substring (--redact -v). dir . is the
# directory mode over the directory the scanner runs in (scanner_run changes
# into it), so each finding's File is a path relative to it: a piece's
# number, a copy's piece number and its name (12/12.yaml), or in the probe
# run a probe (12/12.yaml) or a second copy (romp-copy-bc.yaml). -v prints each
# finding's file, line and rule (here the piece and a line within it: the hook
# names the commit and the file itself); without it gitleaks reports only a
# COUNT.
# --redact keeps the secret itself out of terminal scrollback: the location is
# what a fix needs, and the value has to be rotated anyway. --no-color keeps
# the log lines the hook reads plain. --exit-code 2 tells a finding apart
# from gitleaks failing (exit 1: an unreadable config, say); both refuse the
# push, with different advice. The template report is the attribution's
# input: one line per finding, its file, its rule and a terminator
# (--report-template alone is refused by both versions, which ask for the
# format by name too). The caller's options follow: the reader's copy of
# the config, and for the path-scoped and probe runs their --enable-rule.
gitleaks_args() {   # <template> <report> [<option>...]: fills GL_ARGS
    local tpl="$1" rep="$2"
    shift 2
    GL_ARGS=(dir . --no-banner --redact -v --no-color --exit-code 2 -f template --report-template "$tpl" -r "$rep" "$@")
}

# The scanner's version (the header's credential paragraph): gitleaks 8.25.0
# or later, read once, where a scan would run (scan_credentials asks it ahead
# of the first scanner run and nowhere else, so a push with nothing to scan
# needs no gitleaks). The floor has two reasons: the options the hook passes
# need 8.24.0 (-f template with --report-template since 8.21.3, the byte
# figure it logs since 8.21.4, the pkcs12-file rule the additive run enables
# since 8.24.0), and this repository's .gitleaks.toml uses the [[allowlists]]
# form, which 8.24.0 and 8.24.3 ignore (a push carrying RFC 6455's published
# example key was refused under them) and 8.25.0 is the first to read as
# written (the round 9 rulings, 2026-09-25, each release run against the
# hook: below 8.21.3 every push with content was refused on an unknown flag,
# with gitleaks' own line and no floor named). gitleaks version answers a
# release's dotted version on one line (8.30.1), a leading v taken too, three
# numbers of at most nine digits. An answer that is empty, cut (fewer than
# three numbers), or not that shape (a build from source answers "version is
# set by build process"), and a version below the floor, each refuse the push
# as a scan that cannot run, one line naming what was found, the floor and
# the three remedies. Status 0 when the scan may run; 1 when refused here
# (failed_creds set, and failed_scan by unscanned).
scanner_version() {   # <gitleaks>
    local gl="$1" v re='^v?([0-9]{1,9})\.([0-9]{1,9})\.([0-9]{1,9})$' fix="the credential scan needs gitleaks 8.25.0 or later: upgrade it, point ROMP_GITLEAKS at another binary, or set ROMP_NO_GITLEAKS=1 for one push"
    if ! judged_read gate="the VERSION of the scanner" 0 "the VERSION of gitleaks ($gl) could not be read (gitleaks version exited {rc}), so whether it can run the scan is unknown; $fix" -- "$gl" version; then
        failed_creds=1; return 1
    fi
    v=$read_out
    if [ -z "$v" ]; then
        unscanned "the VERSION of gitleaks ($gl) answered nothing (gitleaks version exited 0), where a release answers its dotted version, so whether it can run the scan is unknown; $fix"
        failed_creds=1; return 1
    fi
    if ! [[ "$v" =~ $re ]]; then
        unscanned "the VERSION of gitleaks ($gl) answered \"${v//$'\n'/ }\" (gitleaks version exited 0), not a dotted version such as 8.30.1, so whether it can run the scan is unknown; $fix"
        failed_creds=1; return 1
    fi
    if [ $((10#${BASH_REMATCH[1]})) -lt 8 ] || { [ $((10#${BASH_REMATCH[1]})) -eq 8 ] && [ $((10#${BASH_REMATCH[2]})) -lt 25 ]; }; then
        unscanned "gitleaks $v ($gl) is older than 8.25.0, so the scan cannot run; $fix"
        failed_creds=1; return 1
    fi
    return 0
}

# The config the scanner runs are handed, and a name for it (the header; the
# coordinator's decisions 5 and 6 on the round 10 rulings, 2026-09-26), read
# where a scan would run (scan_credentials calls it after the version gate,
# ahead of the first scanner run). The population is gitleaks' own order: the
# work tree's .gitleaks.toml (git runs the hook at the work tree's root,
# githooks(5), and the file is named by its physical path, the string git
# rev-parse --show-toplevel gives), or with none the file GITLEAKS_CONFIG
# names, or GITLEAKS_CONFIG_TOML's text, each with every file its [extend]
# chain names; with none of the three gitleaks reads its default, which is
# never read here (the additive run owns its five paths), and cfg_name says
# so. Every scanner run is handed the reader's own COPY of what it read, with
# --config (the owner's call, ruled 2026-09-26): each file of the chain
# copied line for line into the scratch directory (creds.cfg.0.toml and on),
# its [extend] path made absolute, so the reader's verdict and the
# scanner's input are the same bytes (until round 11b gitleaks read the files
# itself, and a file changed between the reader's read and gitleaks' went
# unseen; the r11a audit). --config outranks GITLEAKS_CONFIG and
# GITLEAKS_CONFIG_TOML (executed, 8.28.0 and 8.30.1), so a developer's own
# config (for a pre-commit hook of theirs, say) cannot replace the repo's.
# Each file is read by the shell, one line at a time on descriptor 7, and
# parsed by the tl_ helpers below, no tool between the file and the verdict;
# its bytes as read are compared with its BYTE COUNT (wc -c, config_bytes,
# through judged_read), so a read cut short, or a NUL byte (which the shell's
# read drops and TOML allows nowhere), refuses; GITLEAKS_CONFIG_TOML's text
# is the shell's own and has no count to read. A [[rules]] table carrying a
# path key (the rule's own path condition, not an allowlist's paths) refuses
# the push, one line per rule naming its id and the file: the scan reads the
# pushed lines as pieces named by number, and gitleaks evaluates a rule's
# path against a piece's name, where it never fires (the round 10 checkers,
# 2026-09-26: four such rules each published a credential until round 11,
# which the hook's scan over real paths, before round 9, refused). Two path
# values are exempt, each on a path key standing alone (romp-manager's
# rulings, 2026-09-26): on one of the five path-scoped rules, a one-line
# literal string, or basic one with no escape, whose text is byte for byte
# the hook's own entry for that rule's id (tl_default_path: the path
# gitleaks' default config gives the rule, the path the additive run's
# copies meet), so a config copied from gitleaks' default passes and the
# additive run applies exactly that path; and on any rule, the empty string
# in basic or literal quotes, which gitleaks reads as no condition, so the
# scan of record reads the rule on every piece. Any other path text refuses,
# a copied default's path written with an escape among them. A construct the
# reader does not parse refuses naming it and its line, as does a file it
# cannot open. These refusals come before either scanner run, and each line
# says the scan follows once the config is fixed: a scan under a config the
# hook has refused would be read under the wrong rules. An [extend] path is
# read against gitleaks' working directory, which was the work tree's root
# while the hook ran gitleaks there, before round 9; the scanner runs from
# the scratch directory since, so a relative path is resolved against the
# directory git runs the hook in, as gitleaks resolved it then, at every
# level (the extended file's own [extend] too, as gitleaks reads it), and
# the copy names it absolutely (until round 11 a relative extend refused
# every push with content on gitleaks' own FTL line, where the hook before
# round 9 passed); a relative GITLEAKS_CONFIG is resolved the same way.
# gitleaks 8.28.0 and 8.30.1 follow two levels of [extend] and ignore a path
# at the third, which is refused here rather than followed, a visible
# refusal of a rare shape: a later gitleaks that followed it would read rules
# the reader never saw.
# Status 0 when the scan may run; 1 when refused here (failed_creds set, and
# failed_scan by unscanned).
gitleaks_config() {   # sets cfg and cfg_name, the caller's
    local LC_ALL=C wt d k n f p l nb count opened tl_n=0 fixed="no scanner run was made, and the scan follows once the config is fixed"
    local tl_i=0 tl_end=0 tl_ln=0 tl_rest="" tl_what="" tl_str="" tl_plain=0 tl_q="" tl_low="" tl_ext="" tl_extln=-1 tl_hit=0 tl_dpath=""
    local -a tl_all tl_segs chain_file chain_shown chain_short chain_start chain_end chain_extln chain_nonl copy
    cfg=(); cfg_name="the default config gitleaks embeds"
    wt=$(pwd -P)
    if [ -f .gitleaks.toml ]; then
        chain_file=("$wt/.gitleaks.toml"); chain_short=(.gitleaks.toml); chain_shown=(".gitleaks.toml (the work tree's)")
        cfg_name="the work tree's .gitleaks.toml"
    elif [ -n "${GITLEAKS_CONFIG:-}" ]; then
        f=$GITLEAKS_CONFIG
        case "$f" in /*) ;; *) f="$wt/$f" ;; esac
        chain_file=("$f"); chain_short=("$GITLEAKS_CONFIG"); chain_shown=("$GITLEAKS_CONFIG (the file GITLEAKS_CONFIG names)")
        cfg_name="the file GITLEAKS_CONFIG names ($GITLEAKS_CONFIG)"
    elif [ -n "${GITLEAKS_CONFIG_TOML:-}" ]; then
        chain_file=(""); chain_short=(GITLEAKS_CONFIG_TOML); chain_shown=("GITLEAKS_CONFIG_TOML's text")
        cfg_name="GITLEAKS_CONFIG_TOML's text"
    else
        return 0
    fi
    tl_all=()
    for d in 0 1 2; do
        f=${chain_file[d]}
        chain_start[d]=$tl_n
        # The one open (judged_read's shape): bash's own line for a failed
        # open prints ahead of the refusal.
        opened=1
        if [ -z "$f" ]; then { exec 7<<< "$GITLEAKS_CONFIG_TOML"; } || opened=0; else { exec 7< "$f"; } || opened=0; fi
        if [ "$opened" -eq 0 ]; then
            unscanned "the gitleaks config ${chain_shown[d]} could not be opened for reading, so whether a rule in it carries a path condition is unknown; make it readable, or set ROMP_NO_GITLEAKS=1 for one push; $fixed"
            failed_creds=1; return 1
        fi
        nb=0; l=""; chain_nonl[d]=0
        while IFS= read -r -u 7 l; do tl_all+=("$l"); tl_n=$((tl_n + 1)); nb=$((nb + ${#l} + 1)); done
        if [ -n "$l" ]; then tl_all+=("$l"); tl_n=$((tl_n + 1)); nb=$((nb + ${#l})); chain_nonl[d]=1; fi
        exec 7<&-
        chain_end[d]=$tl_n
        if [ -n "$f" ]; then
            if ! judged_read gate="the BYTE COUNT of a gitleaks config file" 0 "the gitleaks config ${chain_shown[d]} was read by the shell while its BYTE COUNT could not be read (wc exited {rc}), so whether the read is whole is unknown" -- config_bytes "$f"; then
                failed_creds=1; return 1
            fi
            count=${read_out//[[:space:]]/}
            if [ -z "$count" ] || [ -n "${count//[0-9]/}" ]; then
                unscanned "the gitleaks config ${chain_shown[d]} was read by the shell ($nb bytes) while its BYTE COUNT reads \"$count\" (wc -c), not a count, so whether the read is whole is unknown"
                failed_creds=1; return 1
            fi
            if [ "$count" != "$nb" ]; then
                unscanned "the gitleaks config ${chain_shown[d]} was read short (the shell read $nb bytes of the $count wc -c counts: a read cut short, or a NUL byte, which the shell's read drops and TOML allows nowhere); $fixed"
                failed_creds=1; return 1
            fi
        fi
        tl_i=${chain_start[d]}; tl_end=${chain_end[d]}
        if ! tl_file "${chain_shown[d]}"; then
            unscanned "line $((tl_ln - chain_start[d] + 1)) of the gitleaks config ${chain_shown[d]} holds $tl_what, which the hook's reader does not parse, so whether a rule there carries a path condition is unknown; rewrite it with [[rules]] and [extend] tables, plain keys and closed strings, or set ROMP_NO_GITLEAKS=1 for one push; $fixed"
            failed_creds=1; return 1
        fi
        chain_extln[d]=$tl_extln
        [ -n "$tl_ext" ] || break
        if [ "$d" -eq 2 ]; then
            unscanned "line $((tl_extln - chain_start[d] + 1)) of the gitleaks config ${chain_shown[d]} names a third level of [extend] ($tl_ext), which gitleaks 8.28.0 and 8.30.1 ignore and the hook's reader does not read; remove it, or set ROMP_NO_GITLEAKS=1 for one push; $fixed"
            failed_creds=1; return 1
        fi
        case "$tl_ext" in /*) p=$tl_ext ;; *) p="$wt/$tl_ext" ;; esac
        chain_file[d + 1]=$p; chain_short[d + 1]=$tl_ext; chain_shown[d + 1]="$tl_ext (the [extend] of ${chain_short[d]})"
    done
    if [ "$tl_hit" -ne 0 ]; then failed_creds=1; return 1; fi
    # The copy of the chain, the config every scanner run is handed: each
    # file's lines as the shell read them, a missing final newline kept
    # missing, its [extend] path line replaced by the next copy's absolute
    # path as a basic string (a backslash and a double quote escaped), the
    # last file copied whole, so a copy is its file byte for byte but for
    # that one line; each written by one redirect of two printfs chained, the
    # lines and the last line, its status read.
    k=${#chain_start[@]}
    # shellcheck disable=SC2089,SC2090  # the replaced line is TOML text: its quotes are data
    for ((d = 0; d < k; d++)); do
        copy=("${tl_all[@]:${chain_start[d]}:$((chain_end[d] - chain_start[d]))}")
        if [ "$d" -lt $((k - 1)) ]; then
            p="$scratch/creds.cfg.$((d + 1)).toml"; p=${p//\\/\\\\}; p=${p//\"/\\\"}
            copy[chain_extln[d] - chain_start[d]]="path = \"$p\""
        fi
        n=${#copy[@]}; l=""; [ "$n" -eq 0 ] || l=${copy[n - 1]}
        if ! { { [ "$n" -le 1 ] || printf '%s\n' "${copy[@]:0:n-1}"; } && { [ "$n" -eq 0 ] || if [ "${chain_nonl[d]}" -eq 0 ]; then printf '%s\n' "$l"; else printf '%s' "$l"; fi; }; } > "$scratch/creds.cfg.$d.toml"; then
            unscanned "the copy of the gitleaks config ${chain_shown[d]}, the config the scanner is handed, could not be written to the scratch directory"
            failed_creds=1; return 1
        fi
    done
    cfg=(--config "$scratch/creds.cfg.0.toml")
    return 0
}
# The five path-scoped rules' paths, the hook's own table (romp-manager's
# rulings, 2026-09-26): each text as gitleaks' default config gives it, the
# same five in 8.28.0 and 8.30.1 (read from the config each binary embeds,
# 2026-09-26), and each the path the additive run's copies meet (the
# header). The reader exempts one of these rules' path keys when its text is
# this entry byte for byte (gitleaks_config).
tl_default_path() {   # <rule id>: tl_dpath the entry; status 1 for an id that is none of the five
    case "$1" in
        pkcs12-file) tl_dpath='(?i)(?:^|\/)[^\/]+\.p(?:12|fx)$' ;;
        nuget-config-password) tl_dpath='(?i)nuget\.config$' ;;
        kubernetes-secret-yaml) tl_dpath='(?i)\.ya?ml$' ;;
        hashicorp-tf-password) tl_dpath='(?i)\.(?:tf|hcl)$' ;;
        freemius-secret-key) tl_dpath='(?i)\.php$' ;;
        *) tl_dpath=""; return 1 ;;
    esac
}
# The byte count of a config file, for the gate above: a function handed to
# judged_read whole, so a file the redirect cannot open is a status the set
# refuses, never a command not run.
config_bytes() {   # <file>
    wc -c < "$1"
}
# The reader's helpers. Their state is gitleaks_config's locals, read and set
# through bash's dynamic scope: tl_all (the chain's lines), tl_i and tl_end
# (the next line of the current file, and one past its last), tl_ln (the
# current line), tl_rest (what is left of it to parse), tl_what (the construct
# that could not be parsed), tl_segs (the key just parsed), tl_str, tl_plain
# and tl_q (a value's text, 1 when it is a one-line string with no escape,
# and its form: basic or literal for such a string, mlliteral for a
# triple-single-quoted one on one line, empty otherwise), tl_ext and
# tl_extln (the [extend] path and its line), tl_hit (a rule with a path key
# reported), tl_dpath (tl_default_path's entry). The grammar is TOML's as
# gitleaks reads it (go-toml under viper, probed on 8.28.0 and 8.30.1): viper
# lower-cases every key, and its decoder matches a name in any case, Unicode
# folding included ([["rule<U+017F>"]] defines rules; a quoted key spelling
# path with a Unicode escape is a path). A quoted dotted key is split at its
# dots at the top level (a quoted "allowlist.regexes" there is the global
# allowlist's regexes) but not inside a [[rules]] element, where it stays one
# key that gitleaks ignores (executed, 8.28.0 and 8.30.1: the rule's finding
# was reported under the quoted key and excused under the bare dotted one;
# the r11a audit, 2026-09-26). The reader splits a quoted key at its dots
# everywhere, so inside a rule table its split can only over-refuse (a quoted
# "path.x" read as a path key: a visible refusal, never a miss). So a key is
# compared lower-cased, a quoted one split at its dots, and a quoted key
# holding an escape or a byte outside printable ASCII is refused; [rules] as
# a single table defines one rule, and rules as a key an inline table or
# array of them (both read by execution).
tl_line() {   # moves to the next line of the current file: tl_rest its text, one trailing CR dropped (TOML's CRLF); status 1 at the file's end
    [ "$tl_i" -lt "$tl_end" ] || return 1
    tl_ln=$tl_i; tl_rest=${tl_all[tl_i]%$'\r'}; tl_i=$((tl_i + 1))
}
tl_ws() {   # drops the spaces and tabs tl_rest starts with
    tl_rest=${tl_rest#"${tl_rest%%[![:blank:]]*}"}
}
tl_gap() {   # inside an array: drops spaces, tabs, comments and line ends up to the next token; status 1 at the file's end
    while :; do
        tl_ws
        case "$tl_rest" in
            ''|'#'*) tl_line || return 1 ;;
            *) return 0 ;;
        esac
    done
}
tl_lower() {   # <text>: tl_low, the text with its ASCII capitals lowered
    local s=$1 c t up=ABCDEFGHIJKLMNOPQRSTUVWXYZ lo=abcdefghijklmnopqrstuvwxyz
    tl_low=""
    while [ -n "$s" ]; do
        c=${s:0:1}; s=${s:1}
        case "$c" in [A-Z]) t=${up%%"$c"*}; c=${lo:${#t}:1} ;; esac
        tl_low=$tl_low$c
    done
}
tl_key() {   # parses a key, dotted or not, at the start of tl_rest: tl_segs its segments lower-cased, a quoted one split at its dots, as gitleaks splits one at the top level (inside a rule table gitleaks keeps it whole, so the split there only over-refuses); status 1, tl_what set, when it is no key the reader reads
    local seg quoted re_bare='^([A-Za-z0-9_-]+)(.*)$' re_basic='^"([^"]*)"(.*)$' re_lit="^'([^']*)'(.*)\$" re_odd='[^ -~]'
    tl_segs=()
    while :; do
        tl_ws
        quoted=1
        if [[ "$tl_rest" =~ $re_bare ]]; then
            seg=${BASH_REMATCH[1]}; tl_rest=${BASH_REMATCH[2]}; quoted=0
        elif [[ "$tl_rest" =~ $re_basic ]] || [[ "$tl_rest" =~ $re_lit ]]; then
            seg=${BASH_REMATCH[1]}; tl_rest=${BASH_REMATCH[2]}
            case "$seg" in *\\*) tl_what="a quoted key holding an escape"; return 1 ;; esac
            if [[ "$seg" =~ $re_odd ]]; then tl_what="a quoted key holding a byte outside printable ASCII"; return 1; fi
        else
            tl_what="a key it does not read"; return 1
        fi
        if [ "$quoted" -ne 0 ]; then
            while :; do
                tl_lower "${seg%%.*}"; tl_segs+=("$tl_low")
                case "$seg" in *.*) seg=${seg#*.} ;; *) break ;; esac
            done
        else
            tl_lower "$seg"; tl_segs+=("$tl_low")
        fi
        tl_ws
        case "$tl_rest" in .*) tl_rest=${tl_rest#.} ;; *) return 0 ;; esac
    done
}
tl_value() {   # parses one value at the start of tl_rest, reading on across lines where TOML lets one run on (a triple-quoted string, an array): tl_plain 1 and tl_str its text for a one-line string with no escape (tl_q basic or literal), tl_str the text of a triple-single-quoted string closed on its line by three quotes (tl_q mlliteral, tl_plain 0), tl_plain 0 and tl_q empty otherwise; status 1, tl_what set, when it is no value the reader reads
    local re_basic='^"(([^"\\]|\\.)*)"(.*)$' re_lit="^'([^']*)'(.*)\$" re_ml1="^'''([^']*)'''([^'].*)?\$" re_scalar='^[A-Za-z0-9_:.+-]+( [0-9][0-9]:[A-Za-z0-9_:.+-]*)?(.*)$'
    tl_plain=0; tl_str=""; tl_q=""
    tl_ws
    case "$tl_rest" in
        '"""'*) tl_rest=${tl_rest:3}; tl_mlstring basic || return 1 ;;
        "'''"*)
            if [[ "$tl_rest" =~ $re_ml1 ]]; then
                tl_str=${BASH_REMATCH[1]}; tl_rest=${BASH_REMATCH[2]}; tl_q=mlliteral
            else
                tl_rest=${tl_rest:3}; tl_mlstring literal || return 1
            fi ;;
        '"'*)
            if [[ "$tl_rest" =~ $re_basic ]]; then
                tl_str=${BASH_REMATCH[1]}; tl_rest=${BASH_REMATCH[3]}
                case "$tl_str" in *\\*) ;; *) tl_plain=1; tl_q=basic ;; esac
            else
                tl_what="a string that does not close on its line"; return 1
            fi ;;
        "'"*)
            if [[ "$tl_rest" =~ $re_lit ]]; then
                tl_str=${BASH_REMATCH[1]}; tl_rest=${BASH_REMATCH[2]}; tl_plain=1; tl_q=literal
            else
                tl_what="a string that does not close on its line"; return 1
            fi ;;
        '['*) tl_rest=${tl_rest:1}; tl_array || return 1; tl_plain=0; tl_str=""; tl_q="" ;;
        '{'*) tl_rest=${tl_rest:1}; tl_inline || return 1; tl_plain=0; tl_str=""; tl_q="" ;;
        *)
            if [[ "$tl_rest" =~ $re_scalar ]]; then
                tl_rest=${BASH_REMATCH[2]}
            else
                tl_what="a value it does not read"; return 1
            fi ;;
    esac
    return 0
}
tl_mlstring() {   # <basic|literal>: parses a triple-quoted string's text after its opening quotes, across lines, to its closing quotes (three, or four or five when the text ends in one or two quote characters, as TOML reads them); status 1, tl_what set, when the file ends first
    local close open rest
    if [ "$1" = basic ]; then
        close='^(([^"\\]|\\.|"([^"\\]|\\.)|""([^"\\]|\\.))*)("{3,5})(.*)$'; rest=6
        open='^(([^"\\]|\\.|"([^"\\]|\\.)|""([^"\\]|\\.))*)("{1,2})?(\\[[:blank:]]*)?$'
    else
        close="^(([^']|'[^']|''[^'])*)('{3,5})(.*)\$"; rest=4
        open="^(([^']|'[^']|''[^'])*)('{1,2})?\$"
    fi
    while :; do
        if [[ "$tl_rest" =~ $close ]]; then
            tl_rest=${BASH_REMATCH[rest]}
            return 0
        fi
        if ! [[ "$tl_rest" =~ $open ]]; then
            tl_what="a triple-quoted string it cannot delimit"; return 1
        fi
        if ! tl_line; then
            tl_what="a triple-quoted string that does not close"; return 1
        fi
    done
}
tl_array() {   # parses an array's values after its opening bracket, across lines, to its closing bracket; status 1, tl_what set, when it is no array the reader reads
    tl_gap || { tl_what="an array that does not close"; return 1; }
    case "$tl_rest" in ']'*) tl_rest=${tl_rest:1}; return 0 ;; esac
    while :; do
        tl_value || return 1
        tl_gap || { tl_what="an array that does not close"; return 1; }
        case "$tl_rest" in
            ','*)
                tl_rest=${tl_rest:1}
                tl_gap || { tl_what="an array that does not close"; return 1; }
                case "$tl_rest" in ']'*) tl_rest=${tl_rest:1}; return 0 ;; esac ;;
            ']'*) tl_rest=${tl_rest:1}; return 0 ;;
            *) tl_what="an array it does not read"; return 1 ;;
        esac
    done
}
tl_inline() {   # parses an inline table's keys and values after its opening brace, to its closing brace, no line end between them outside a value (TOML 1.0; go-toml refuses one there too); status 1, tl_what set, when it is no inline table the reader reads
    tl_ws
    case "$tl_rest" in '}'*) tl_rest=${tl_rest:1}; return 0 ;; esac
    while :; do
        tl_key || return 1
        tl_ws
        case "$tl_rest" in '='*) tl_rest=${tl_rest:1} ;; *) tl_what="an inline table it does not read"; return 1 ;; esac
        tl_value || return 1
        tl_ws
        case "$tl_rest" in
            ','*) tl_rest=${tl_rest:1} ;;
            '}'*) tl_rest=${tl_rest:1}; return 0 ;;
            *) tl_what="an inline table it does not read"; return 1 ;;
        esac
    done
}
tl_file() {   # <the file's name, for its lines>: parses the current file's lines, one refusal per [[rules]] table carrying a path key the reader does not exempt (tl_rule_end); tl_ext and tl_extln its [extend] path and that line, when it names one; status 1, tl_what and tl_ln set, when a line holds a construct the reader does not parse
    local ctx=top rid="" rpath=0 rpv="" rpk="" hk hdr kln s
    local -a segs
    tl_ext=""; tl_extln=-1
    while tl_line; do
        tl_ws
        case "$tl_rest" in
            ''|'#'*) continue ;;
            '[['*) tl_rest=${tl_rest:2}; hk='[[' ;;
            '['*) tl_rest=${tl_rest:1}; hk='[' ;;
            *) hk="" ;;
        esac
        if [ -n "$hk" ]; then
            tl_key || return 1
            tl_ws
            case "$hk:$tl_rest" in
                '[[:]]'*) tl_rest=${tl_rest:2} ;;
                '[:]'*) tl_rest=${tl_rest:1} ;;
                *) tl_what="a table header it does not read"; return 1 ;;
            esac
            tl_ws
            case "$tl_rest" in ''|'#'*) ;; *) tl_what="more after a table header on its line"; return 1 ;; esac
            tl_rule_end "$1"
            hdr=""; for s in "${tl_segs[@]}"; do hdr="$hdr${hdr:+.}$s"; done
            case "$hk$hdr" in
                '[extend') ctx=extend ;;
                '[rules'|'[[rules') ctx=rule; rid=""; rpath=0; rpv=""; rpk="" ;;
                '[rules.allowlist'|'[[rules.allowlist'|'[rules.allowlists'|'[[rules.allowlists'|'[rules.required'|'[[rules.required') ctx=sub ;;
                '[allowlist'|'[[allowlist'|'[allowlists'|'[[allowlists') ctx=sub ;;
                *) s=${tl_all[tl_ln]%$'\r'}; tl_what="the table header ${s#"${s%%[![:blank:]]*}"}"; return 1 ;;
            esac
            continue
        fi
        kln=$tl_ln
        tl_key || return 1
        segs=("${tl_segs[@]}")
        tl_ws
        case "$tl_rest" in '='*) tl_rest=${tl_rest:1} ;; *) tl_what="a line that is no key and value, table header or comment"; return 1 ;; esac
        tl_value || return 1
        tl_ws
        case "$tl_rest" in ''|'#'*) ;; *) tl_what="more after a value on its line"; return 1 ;; esac
        case "$ctx:${segs[0]}" in
            top:rules) tl_ln=$kln; tl_what="the rules written as a key (rules = ...: an inline table or array of them)"; return 1 ;;
            top:extend) tl_ln=$kln; tl_what="the [extend] table written as a key"; return 1 ;;
            extend:path)
                if [ "${#segs[@]}" -ne 1 ] || [ "$tl_plain" -ne 1 ]; then tl_ln=$kln; tl_what="an [extend] path that is not a one-line string with no escape"; return 1; fi
                if [ "$tl_extln" -ge 0 ]; then tl_ln=$kln; tl_what="a second [extend] path"; return 1; fi
                tl_ext=$tl_str; tl_extln=$kln ;;
            rule:path)
                rpath=$((rpath + 1)); rpv=$tl_str; rpk=""
                [ "${#segs[@]}" -ne 1 ] || rpk=$tl_q ;;
            rule:id) if [ "${#segs[@]}" -eq 1 ] && [ "$tl_plain" -eq 1 ]; then rid=$tl_str; fi ;;
        esac
    done
    tl_rule_end "$1"
    return 0
}
tl_rule_end() {   # <the file's name>: the table just ended (tl_file's ctx, rid, rpath, rpv and rpk: the path keys seen, the last one's text and its form, empty for a dotted key), refused when it is a rule carrying a path key the reader does not exempt (gitleaks_config: an empty basic or literal string on any rule, or tl_default_path's entry on one of the five)
    if [ "$ctx" != rule ] || [ "$rpath" -eq 0 ]; then return 0; fi
    if [ "$rpath" -eq 1 ]; then
        case "$rpk" in basic|literal) if [ -z "$rpv" ]; then rpath=0; return 0; fi ;; esac
        case "$rpk" in basic|literal|mlliteral) if tl_default_path "$rid" && [ "$rpv" = "$tl_dpath" ]; then rpath=0; return 0; fi ;; esac
    fi
    unscanned "rule ${rid:-with no id} of the gitleaks config $1 carries a path condition (a path key), which the credential scan cannot apply: it reads the pushed lines as pieces named by number, not by their files' paths; a rule without a path condition is scanned, so remove the condition, or set ROMP_NO_GITLEAKS=1 for one push; $fixed"
    tl_hit=1; rpath=0
}

# One run of the scanner over a directory the hook wrote (the pieces, the
# path-scoped copies, or the probe run's probes and second copies), from
# inside that directory, so gitleaks finds no .gitleaksignore of the work
# tree (it reads one from its working directory whatever -i says) and no
# config but the copy gitleaks_config wrote and names with --config (the
# reader's own bytes), or with no config to copy its default (the directory
# holds no .gitleaks.toml, and GITLEAKS_CONFIG and GITLEAKS_CONFIG_TOML are
# unset or empty then); its verdict is
# read from its exit and its log (the header): 0 clean and 2 a finding are
# judged further, anything else is a failed scan with the scanner's advice.
# Its log, its stderr, is captured and read twice through judged_read: the
# ERR line (any line at gitleaks' ERR level refuses) and the byte figure (the
# one "scanned ~N bytes" line, compared with the bytes written: none, two, or
# another number refuses naming both). Each awk strips colour codes itself:
# --no-color makes gitleaks' lines plain, but a line logged before the flag
# takes effect stays coloured. Two modes. names, the scan of record and the
# additive run: its findings (its stdout, under -v) go to stderr as they are
# written, its log is shown after them, and on exit 2 each finding is named,
# for the report alone, from the report (a file, a rule and a terminator per
# line) and the index the caller read into ix_sha and ix_path (the caller's),
# the piece being the File's leading digits, the whole run before its first
# slash (a copy lives in its piece's directory, whatever its own name); a
# line cut inside, or naming no piece, is skipped, a line printed once for
# the push (seen_lines, the caller's, so a credential two runs find is named
# once), and a report naming fewer findings than the log counts says so.
# probe, the probe run (the header): every probe is a finding, so its
# findings are never shown (its stdout goes to /dev/null) and exit 2 sets
# nothing; its log is shown only when the run fails (an exit other than 0 or
# 2, which is named, an ERR line, or a byte figure missing, repeated or
# another number), after the refusal; the caller judges its report
# (probe_check) when it exits 0 or 2. Sets blocked_creds, failed_scan,
# failed_creds and run_rc (the scanner's exit), the caller's.
scanner_run() {   # <gitleaks> <the scan's name, for its lines> <directory> <bytes written there, or empty when the feed was refused> <report file> <names|probe> [<scanner option>...]
    local gl="$1" what="$2" dir="$3" want="$4" rep="$5" mode="$6" rc log err got start rule term piece line_out nrec leaks judged=$unscanned_n
    shift 6
    : > "$rep"
    gitleaks_args "$scratch/creds.template" "$rep" "$@"
    rc=0
    # The probe run's findings, its stdout, are the probes: for its one
    # statement stderr is /dev/null, so 3>&2 sends them there, restored after.
    [ "$mode" != probe ] || exec 8>&2 2>/dev/null
    # outside judged_read: the scanner's own exit, judged with its log against the bytes the feed wrote.
    log=$( { cd "$dir" && "$gl" "${GL_ARGS[@]}" < /dev/null 2>&1 1>&3; } 3>&2 ) || rc=$?
    [ "$mode" != probe ] || exec 2>&8 8>&-
    [ -z "$log" ] || [ "$mode" = probe ] || printf '%s\n' "$log" >&2
    case $rc in
        0) ;;
        2) [ "$mode" = probe ] || blocked_creds=1 ;;
        *)
            [ "$mode" != probe ] || unscanned "$what exited $rc, neither 0 (clean) nor 2 (a finding), so what it read is unknown; its log follows"
            failed_scan=1; failed_creds=1 ;;
    esac
    if [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ]; then
        # The ERR line's awk answers a WORD whatever the log holds: none for a
        # log with no ERR line, or error, a tab and the first such line, so an
        # empty or cut-short answer is neither and is refused naming the read
        # (round 8b3: read as own= until then, an awk silent here published a
        # credential beside a scanner that logged an error).
        err=""
        if judged_read gate="the ERR line of the scanner log" 0 "$what could not be judged: its log could not be read for an error line (awk exited {rc})" -- awk '{ gsub(/\033\[[0-9;]*m/, "") } $2 == "ERR" { sub(/^[^ ]+ ERR /, ""); print "error\t" $0; found = 1; exit } END { if (!found) print "none" }' <<< "$log"; then
            case "$read_out" in
                none) ;;
                error$'\t'?*) err=${read_out#error$'\t'} ;;
                *) unscanned "$what could not be judged: its log's error-line read answered \"$read_out\" (awk exited 0), neither the word none nor an error line"; failed_creds=1 ;;
            esac
        else
            failed_creds=1
        fi
        if [ -n "$err" ]; then
            unscanned "$what did not complete: gitleaks logged an error ($err)"
            failed_creds=1
        fi
        # The byte figure's awk answers bytes, a tab and the one figure's
        # digits, or lines, a tab and the count of such lines when it is not
        # one: 0 is a scanner that logged no figure, 2 a second figure.
        got=""
        if judged_read gate="the BYTE COUNT line of the scanner log" 0 "$what could not be judged: its log could not be read for the bytes it scanned (awk exited {rc})" -- awk '{ gsub(/\033\[[0-9;]*m/, "") } $2 == "INF" && $3 == "scanned" && $4 ~ /^~[0-9]+$/ && $5 == "bytes" { k++; b = substr($4, 2) } END { if (k == 1) print "bytes\t" b; else print "lines\t" k + 0 }' <<< "$log"; then
            case "$read_out" in
                bytes$'\t'[0-9]*)
                    got=${read_out#bytes$'\t'}
                    case "$got" in *[!0-9]*) unscanned "$what could not be judged: its byte-count read answered \"$read_out\" (awk exited 0), not a count"; failed_creds=1; got="" ;; esac ;;
                lines$'\t'[0-9]*) unscanned "$what reported ${read_out#lines$'\t'} byte-count lines where it writes one, so what it read is unknown"; failed_creds=1 ;;
                *) unscanned "$what could not be judged: its byte-count read answered \"$read_out\" (awk exited 0), neither a byte count nor a count of such lines"; failed_creds=1 ;;
            esac
        else
            failed_creds=1
        fi
        if [ -n "$got" ] && [ -n "$want" ] && [ "$got" != "$want" ]; then
            if [ "$mode" = probe ]; then
                unscanned "$what read $got of the $want bytes written for it (its probes and the second copies of the added lines)"
            else
                unscanned "$what read $got of the $want bytes of added lines it was fed"
            fi
            failed_creds=1
        fi
    fi
    run_rc=$rc
    if [ "$rc" -eq 2 ] && [ "$mode" != probe ]; then
        nrec=0
        while IFS=$'\t' read -r -u 6 start rule term; do
            [ "$term" = . ] || continue
            piece=${start%%/*}
            case "$piece" in ''|*[!0-9]*) continue ;; esac
            nrec=$((nrec + 1))
            credential_line "$piece" "$rule"
        done 6< "$rep"
        leaks=""
        [[ "$log" =~ leaks\ found:\ ([0-9]+) ]] && leaks=${BASH_REMATCH[1]}
        if [ -n "$leaks" ] && [ "$nrec" -lt "$leaks" ]; then
            echo "romp pre-push: $what logged $leaks findings and its report names $nrec, so the commit and file of the rest are not named above" >&2
        fi
    fi
    if [ "$mode" = probe ] && [ "$unscanned_n" -ne "$judged" ] && [ -n "$log" ]; then printf '%s\n' "$log" >&2; fi
}
# A finding named with its commit and file, from the index the caller read
# into ix_sha and ix_path, printed once for the push: the overlap can find one
# token twice, and two runs one credential (the additive run and the probe
# run's second copy), so seen_lines, the caller's, holds each line printed.
credential_line() {   # <piece> <rule>
    local line_out
    if [ -n "${ix_sha[$1]:-}" ]; then
        line_out="romp pre-push: commit ${ix_sha[$1]:0:10} ADDS a credential ($2) in: ${ix_path[$1]}"
    else
        line_out="romp pre-push: a pushed commit ADDS a credential ($2), whose commit and file could not be named"
    fi
    case "$seen_lines" in
        *"$line_out"$'\n'*) ;;
        *) echo "$line_out" >&2; seen_lines="$seen_lines$line_out"$'\n' ;;
    esac
}

# The probe check (the header's probe paragraph): ONE awk over the
# path-scoped index and the probe run's report, so no process runs per
# piece. The index gives each selected piece its copy's name (its probe sits
# at <piece>/<name>, the path the additive run scans), its second copy's name
# (at the probe run's root) and its rule; a report line is a file, a rule
# and a terminator. A probe is NAMED when the report holds its file under its
# own rule: the file and the rule, never the file alone (with every rule on,
# a yaml probe was named under generic-api-key while a per-rule allowlist had
# dropped kubernetes-secret-yaml there; the round 10 checkers, 2026-09-26). A
# line at a second copy is a finding in the piece's own bytes. Any other
# line, one cut inside among them, names neither. The answer, in this order:
# one line per selected piece (named <piece>, or missing <piece> <rule>
# <copy's name>), one per finding at a second copy (found <piece> <rule>),
# one per other line (foreign <the line>), and last a closing line of counts
# (end <pieces> <findings> <other lines>), which the caller compares with the
# lines it read of each kind and with the pieces it wrote probes for, so an
# answer cut anywhere loses its close or disagrees with it. Its status, the
# awk's.
probe_check() {   # <path-scoped index file> <the probe run's report file>
    LC_ALL=C awk -F '\t' '
        FILENAME == ARGV[1] {
            if ($5 != "." || $1 !~ /^[0-9]+$/) next
            np++; pp[np] = $1; pr[np] = $4; pc[np] = $1 "/" $2; at[pc[np]] = np; sec[$3] = np; next
        }
        $3 == "." && ($1 in at)  { if ($2 == pr[at[$1]]) named[at[$1]] = 1; next }
        $3 == "." && ($1 in sec) { found[++nf] = pp[sec[$1]] "\t" $2; next }
        { other[++nx] = $0 }
        END {
            for (k = 1; k <= np; k++) if (named[k]) print "named\t" pp[k]; else print "missing\t" pp[k] "\t" pr[k] "\t" pc[k]
            for (k = 1; k <= nf; k++) print "found\t" found[k]
            for (k = 1; k <= nx; k++) print "foreign\t" other[k]
            print "end\t" np + 0 "\t" nf + 0 "\t" nx + 0
        }' "$1" "$2"
}

# A merge's binary paths (the header's credential paragraph): each merge and
# path the feed's awk routed to the binary file, read WHOLE from the merge's
# own version of the path by three judged reads. The merge's combined raw
# listing (git diff-tree -c --raw, read once per merge, WITHOUT -z: its path
# field is git's quoted form, the form the section's header gave, and the
# two are compared as strings, one stated rule; a -z listing gives the raw
# path, which never equals a quoted one, so a clean merge of a binary path
# git quotes would be refused): the recorded path must name exactly one
# record, whose last object name before the status letters is the result
# blob and whose last mode before the object names is the result's mode, and
# no record or two refuse naming the read. The blob's size (git cat-file -s),
# a digit run. Its bytes (blob_pieces), whose count of bytes read must be the
# size and one, the newline blob_pieces appends. A zero result blob (the
# merge deletes the path) and a gitlink (mode 160000: a commit, no blob of
# its own) transfer no bytes of their own and are skipped. The pieces are
# numbered after the feed's, and their bytes are added to the figures the
# scanner runs are checked against. Called with the count of routed paths
# the feed recorded, compared with the lines read back. A content read that
# fails, or records no four counts, leaves the pieces' numbering unknown, so
# the paths after it are not read, and no figure is compared (the push is
# refused already). Sets rpieces, rbytes, rpbytes and failed_creds, the
# caller's.
merge_binary_reads() {   # <count of routed paths the feed recorded>
    local want="$1" seen_n=0 bsha bpath bterm lsha="" lread=0 listing="" line matches k rmode rblob size brec bgot bp bb bpb rest
    local -a words
    while IFS=$'\t' read -r -u 6 bsha bpath bterm; do
        [ "$bterm" = . ] || continue
        seen_n=$((seen_n + 1))
        if [ "$bsha" != "$lsha" ]; then
            lsha=$bsha; lread=0; listing=""
            if judged_read gate="the RESULT listing of a merge" 0 "the RESULT listing of merge ${bsha:0:10}, whose binary paths the credential scan reads whole, could not be read (git diff-tree exited {rc})" -- git -c core.quotePath=true diff-tree -c --raw --no-commit-id --no-abbrev "$bsha"; then
                listing=$read_out; lread=1
            fi
        fi
        if [ "$lread" -eq 0 ]; then failed_creds=1; continue; fi
        matches=0; rmode=""; rblob=""
        while IFS= read -r line; do
            case "$line" in *$'\t'*) ;; *) continue ;; esac
            [ "${line#*$'\t'}" = "$bpath" ] || continue
            matches=$((matches + 1))
            read -r -a words <<< "${line%%$'\t'*}"
            k=${#words[@]}
            if [ "$k" -ge 7 ] && [ $((k % 2)) -eq 1 ]; then rmode=${words[$(( (k - 1) / 2 - 1 ))]}; rblob=${words[$((k - 2))]}; fi
        done <<< "$listing"
        if [ "$matches" -ne 1 ]; then
            unscanned "the RESULT listing of merge ${bsha:0:10} names $matches records for $bpath, a path its combined diff calls binary, where a merge's listing holds one (git diff-tree exited 0), so that path cannot be read whole for the credential scan"
            failed_creds=1; continue
        fi
        case "$rmode" in [0-7][0-7][0-7][0-7][0-7][0-7]) ;; *) rblob="" ;; esac
        case "$rblob" in ''|*[!0-9a-f]*) rblob="" ;; *) [ "${#rblob}" -eq "${#bsha}" ] || rblob="" ;; esac
        if [ -z "$rblob" ]; then
            unscanned "the RESULT listing of merge ${bsha:0:10} answered a record for $bpath that names no result mode and blob (git diff-tree exited 0), so that path cannot be read whole for the credential scan"
            failed_creds=1; continue
        fi
        [ "$rmode" != 160000 ] || continue              # a gitlink: a commit, no blob of its own to transfer
        [ -n "${rblob//0/}" ] || continue               # the merge deletes the path: nothing transferred
        size=""
        judged_read gate="the SIZE of a merge's binary blob" 0 "the SIZE of $bpath in merge ${bsha:0:10}, a path the credential scan reads whole, could not be read (git cat-file -s exited {rc})" -- git cat-file -s "$rblob" || { failed_creds=1; continue; }
        size=$read_out
        if [ -z "$size" ] || [ -n "${size//[0-9]/}" ]; then
            unscanned "the SIZE of $bpath in merge ${bsha:0:10}, a path the credential scan reads whole, could not be read (git cat-file -s exited 0 and answered \"$size\", not a count)"
            failed_creds=1; continue
        fi
        : > "$scratch/creds.brecord"
        if ! judged_read gate="the CONTENT of a merge's binary blob" 0 "the CONTENT of $bpath in merge ${bsha:0:10} could not be read whole for the credential scan (a stage of git cat-file -p, tr and awk exited {rc})" -- blob_pieces "$rblob" "$scratch/creds.brecord" "$scratch/creds.d" "$scratch/creds.index" "$scratch/creds.pindex" "$bsha" "$bpath" "$rpieces"; then
            failed_creds=1; rbytes=""; rpbytes=""; return 0
        fi
        brec=""
        { IFS= read -r brec || :; } < "$scratch/creds.brecord"
        bgot=""; bp=""; bb=""; bpb=""; rest=""
        read -r bgot bp bb bpb rest <<< "$brec" || :
        case "$bgot:$bp:$bb:$bpb:${rest:+x}" in
            *[!0-9:]*|:*|*::*)
                unscanned "the CONTENT of $bpath in merge ${bsha:0:10} could not be read whole for the credential scan (its awk exited 0 and recorded \"$brec\", not four counts)"
                failed_creds=1; rbytes=""; rpbytes=""; return 0 ;;
        esac
        rpieces=$((rpieces + bp))
        if [ -n "$rbytes" ]; then rbytes=$((rbytes + bb)); rpbytes=$((rpbytes + bpb)); fi
        if [ "$bgot" -ne $((size + 1)) ]; then
            unscanned "the CONTENT of $bpath in merge ${bsha:0:10} was read short for the credential scan (git cat-file -p exited 0 and answered $((bgot - 1)) bytes of the $size its SIZE read names)"
            failed_creds=1
        fi
    done 6< "$scratch/creds.binary"
    if [ "$seen_n" -ne "$want" ]; then
        unscanned "the binary paths the CREDENTIAL FEED of the push routed were read back short ($seen_n of the $want its awk recorded), so the rest cannot be read whole"
        failed_creds=1
    fi
}

# The credential scan (the header's paragraph): the ref loop lists each
# pushed ref's commits through list_commits and appends each commit twice to
# the feed's list and once to the parent counts' list, one redirect each for
# the whole loop; then the parent counts (parent_counts, judged as the PARENT
# COUNTS read: its status, then its record, the list's lines read against the
# count fed, each commit of 64 or more parents refused by name); then ONE
# feed over the push (credential_feed, judged as the CREDENTIAL FEED read:
# its status, then its record, the commits read whole against the count fed,
# a foreign line refused naming its commit); then, when the feed's record is
# whole, each merge's binary path it routed, read whole (merge_binary_reads);
# then the scan of record over the pieces, and when the push adds a file the
# path-scoped rules name, the additive run over its copies and the probe run
# over its probes and second copies (scanner_run, each judged by its exit,
# its ERR line and its byte figure; the probe run's report by probe_check).
# The scanner runs unless the feed wrote nothing (no new commit, or commits
# that add no line: 0 bytes and no piece); after a feed refused as short it
# still runs over the pieces written, for their findings, with no figure to
# compare. Ahead of its first run the scanner's version is read
# (scanner_version), then the config (gitleaks_config), and a version older
# than 8.25.0, an answer that is no version, or a config the reader refuses,
# refuses the push with no run made; a push the scanner would not run over
# reads neither.
scan_credentials() {
    local gl local_ref local_sha _remote_ref remote_sha revs rev peeled peeled_read nfed record n what
    # shellcheck disable=SC2034  # cfg_name: set by gitleaks_config, for the lines that name the config the runs read
    local rdone rpieces rbytes rpbytes rbin rest piece fsha fpath fterm data pdone plisted pbig nbig pcount scanning sbytes step pk cfg_name=""
    local sname prule qtext qbytes qn qwant qv qp_pkcs qp_nuget qp_k8s qp_tf qp_php kind qa qb qc qd qnamed qmiss qfound qother qend seen_lines="" run_rc=0
    local -a cfg=() ix_sha ix_path pdirs
    if ! credential_scan_armed; then
        [ -n "${ROMP_NO_GITLEAKS:-}" ] && return 0     # a skip asked for: silent
        # No binary. Loud rather than silent, but not a blocker: requiring an
        # install to push would break every clone that never wanted the
        # scanner, and CI scans the full history regardless.
        echo "romp pre-push: gitleaks not installed, pushing WITHOUT a secret scan." >&2
        echo "  Install gitleaks 8.25.0 or later (brew install gitleaks, or the release .github/workflows/ci.yml pins)." >&2
        echo "  ROMP_GITLEAKS names a binary that is not on PATH; ROMP_NO_GITLEAKS=1 silences this." >&2
        return 0
    fi
    gl="$(gitleaks_binary)"
    case "$gl" in /*) ;; *) gl="$(pwd -P)/$gl" ;; esac        # scanner_run runs it from another directory
    if ! make_scratch; then
        unscanned "the CREDENTIAL FEED of the push could not be written (mktemp failed to make a scratch directory for it)"
        failed_creds=1
    else
        # The refs on descriptor 5, never stdin, as in scan_identifiers: a
        # tool the loop runs that read its stdin would take the refs after the
        # current one, and no scan would read them (a git silent with exit 0
        # on the range probe this loop ran until round 9, reading its stdin,
        # published a second ref's credential through a real push; round 8b).
        : > "$scratch/creds.list"; : > "$scratch/creds.revs"
        nfed=0
        while read -r -u 5 local_ref local_sha _remote_ref remote_sha; do
            [ -n "${local_sha:-}" ] || continue
            [ "$local_sha" = "$zero" ] && continue      # deleting a remote ref pushes nothing
            peeled=""; peeled_read=0; revs=""
            list_commits "$local_ref" "$local_sha" "$remote_sha" credential || { failed_creds=1; continue; }
            for rev in $revs; do
                printf '%s\n%s %s\n' "$rev" "$rev" "$rev"
                printf '%s\n' "$rev" >&4
                nfed=$((nfed + 1))
            done >> "$scratch/creds.list" 4>> "$scratch/creds.revs"
        done 5<<< "$refs"
        mkdir "$scratch/creds.d" "$scratch/creds.p" "$scratch/creds.q"
        : > "$scratch/creds.index"; : > "$scratch/creds.pindex"; : > "$scratch/creds.record"; : > "$scratch/creds.binary"; : > "$scratch/creds.parents"
        # The parent counts (parent_counts): a commit of 64 or more parents
        # refuses the push by name, since git's combined diff cannot show the
        # lines such a merge adds (the header); the lines of the list read are
        # compared with the count fed, and the commits printed with the count
        # the awk recorded.
        if [ "$nfed" -gt 0 ]; then
            if judged_read gate="the PARENT COUNTS of the pushed commits" 0 "the PARENT COUNTS of the pushed commits could not be read for the credential scan (a stage of git rev-list and awk exited {rc})" -- parent_counts "$scratch/creds.revs" "$scratch/creds.parents"; then
                record=""
                { IFS= read -r record || :; } < "$scratch/creds.parents"
                case "$record" in
                    "unmarked "*)
                        unscanned "the PARENT COUNTS of the pushed commits were read short for the credential scan (git rev-list exited 0 and did not open commit ${record#unmarked } of those it was given with the line naming it, the header its format prints)"
                        failed_creds=1 ;;
                    "untailed "*)
                        unscanned "the PARENT COUNTS of the pushed commits were read short for the credential scan (git rev-list exited 0 and did not close commit ${record#untailed } of those it was given with the line naming it again, the tail marker its format asks for after the parents)"
                        failed_creds=1 ;;
                    "short "*)
                        unscanned "the PARENT COUNTS of the pushed commits were read short for the credential scan (git rev-list exited 0 and ended after ${record#short } of the commits it was given)"
                        failed_creds=1 ;;
                    *)
                        pdone=""; plisted=""; pbig=""; rest=""
                        read -r pdone plisted pbig rest <<< "$record" || :
                        case "$pdone:$plisted:$pbig:${rest:+x}" in
                            *[!0-9:]*|:*|*::*)
                                unscanned "the PARENT COUNTS of the pushed commits could not be read for the credential scan (its awk exited 0 and recorded \"$record\", not three counts)"
                                failed_creds=1 ;;
                            *)
                                nbig=0
                                while read -r fsha pcount; do
                                    [ -n "$fsha" ] || continue
                                    nbig=$((nbig + 1))
                                    unscanned "the ADDED LINES of commit ${fsha:0:10} cannot be read for the credential scan: it has $pcount parents, and git's combined diff of a merge of 64 or more parents prints no hunk for the lines it adds, or prints them with a space in their last column"
                                    failed_creds=1
                                done <<< "$read_out"
                                if [ "$plisted" -ne "$nfed" ]; then
                                    unscanned "the PARENT COUNTS of the pushed commits were read short for the credential scan (its awk read $plisted of the $nfed lines of its list)"
                                    failed_creds=1
                                elif [ "$nbig" -ne "$pbig" ]; then
                                    unscanned "the PARENT COUNTS of the pushed commits were read short for the credential scan (its awk recorded $pbig commits of 64 or more parents and printed $nbig)"
                                    failed_creds=1
                                fi ;;
                        esac ;;
                esac
            else
                failed_creds=1
            fi
        fi
        rbytes=""; rpbytes=""; rbin=""
        if [ "$nfed" -eq 0 ]; then
            rbytes=0; rpbytes=0
        elif judged_read gate="the CREDENTIAL FEED of the push" 0 "the CREDENTIAL FEED of the push could not be read (a stage of git diff-tree, tr and awk exited {rc})" -- credential_feed "$scratch/creds.list" "$scratch/creds.record" "$scratch/creds.d" "$scratch/creds.index" "$scratch/creds.pindex" "$scratch/creds.binary"; then
            record=""
            { IFS= read -r record || :; } < "$scratch/creds.record"
            case "$record" in
                "foreign "*)
                    n=${record#foreign }; fsha=${n#* }; n=${n%% *}
                    unscanned "the CREDENTIAL FEED of the push could not be read whole (git diff-tree exited 0 and printed a line inside commit $n of the $nfed it was given, ${fsha:0:10}, that is none of the shapes the feed reads or recognizes, so what that line stands for went unread)"
                    failed_creds=1 ;;
                "unmarked "*)
                    n=${record#unmarked }
                    if [ "$n" -gt "$nfed" ] 2>/dev/null; then
                        what="printed a line after the tail marker of the last of the $nfed commits it was given"
                    else
                        what="did not open commit $n of the $nfed it was given with the line naming it, the marker --always asks for ahead of each diff"
                    fi
                    unscanned "the CREDENTIAL FEED of the push was read short (git diff-tree exited 0 and $what)"
                    failed_creds=1 ;;
                "untailed "*)
                    unscanned "the CREDENTIAL FEED of the push was read short (git diff-tree exited 0 and did not close commit ${record#untailed } of the $nfed it was given with the line naming it again, the tail marker its second --stdin line asks for)"
                    failed_creds=1 ;;
                "short "*)
                    unscanned "the CREDENTIAL FEED of the push was read short (git diff-tree exited 0 and ended after ${record#short } of the $nfed commits it was given)"
                    failed_creds=1 ;;
                *)
                    rdone=""; rpieces=""; rbytes=""; rpbytes=""; rbin=""; rest=""
                    read -r rdone rpieces rbytes rpbytes rbin rest <<< "$record" || :
                    case "$rdone:$rpieces:$rbytes:$rpbytes:$rbin:${rest:+x}" in
                        *[!0-9:]*|:*|*::*)
                            unscanned "the CREDENTIAL FEED of the push could not be read (its awk exited 0 and recorded \"$record\", not five counts)"
                            failed_creds=1; rbytes=""; rpbytes="" ;;
                        *)
                            if [ "$rdone" -ne "$nfed" ]; then
                                unscanned "the CREDENTIAL FEED of the push was read short (its awk recorded $rdone commits read whole of the $nfed it was given)"
                                failed_creds=1; rbytes=""; rpbytes=""
                            fi ;;
                    esac ;;
            esac
        else
            failed_creds=1
        fi
        # Each merge's binary path the feed routed, read whole
        # (merge_binary_reads), when the feed's record is whole: its pieces
        # join the index and the figures before either is read below.
        if [ -n "$rbytes" ] && [ -n "$rbin" ] && [ "$rbin" -gt 0 ]; then
            merge_binary_reads "$rbin"
        fi
        # The index, read once by the shell: each piece's commit and file, for
        # the lines that name a finding (scanner_run).
        ix_sha=(); ix_path=()
        while IFS=$'\t' read -r -u 6 piece fsha fpath fterm; do
            [ "$fterm" = . ] || continue
            case "$piece" in ''|*[!0-9]*) continue ;; esac
            ix_sha[piece]=$fsha; ix_path[piece]=$fpath
        done 6< "$scratch/creds.index"
        printf '{{range .}}{{.File}}\t{{.RuleID}}\t.\n{{end}}' > "$scratch/creds.template"
        # The scanner's version (scanner_version) is read here, where a scan
        # runs, and nowhere else: a push with nothing to scan needs no
        # gitleaks, whatever its version (the round 9 rulings, 2026-09-25);
        # then the config (gitleaks_config), read and judged here for the same
        # reason, which refuses a rule carrying a path condition, and a
        # construct it cannot read, with no run made.
        scanning=0
        if [ "$rbytes" = 0 ] && [ ! -e "$scratch/creds.d/1" ]; then
            :                                           # nothing written: nothing to scan
        elif scanner_version "$gl" && gitleaks_config; then
            scanning=1
            # Every run is handed cfg, the reader's own copy of the config it
            # read and judged (gitleaks_config): the work tree's
            # .gitleaks.toml, the file GITLEAKS_CONFIG names or
            # GITLEAKS_CONFIG_TOML's text, with its [extend] chain, copied
            # into the scratch directory line for line, each extend path
            # made absolute, so the reader's verdict and the scanner's input
            # are the same bytes whatever changes the files after the read;
            # with no config at all, nothing, and gitleaks reads its default
            # (cfg_name names which, for the lines).
            scanner_run "$gl" "the CREDENTIAL scan" "$scratch/creds.d" "$rbytes" "$scratch/creds.report" names ${cfg[@]+"${cfg[@]}"}
        fi
        # The additive run (the header): each piece the second index names,
        # copied under the name that index gives it (the piece's number and
        # the suffix the selection matched, or nuget.config alone) into a
        # directory of its own (the piece's number), by the shell alone (read
        # and printf under LC_ALL=C, which keep every byte: a piece holds no
        # NUL), and scanned with the five path-scoped rules alone; its figure
        # is compared with the bytes of those pieces the feed's awk recorded,
        # so a copy written short is refused there. Then the PROBE run (the
        # header's probe paragraph), because gitleaks evaluates every
        # path-keyed element of the config against the copy's name, not the
        # file's path: a per-rule or targeted path allowlist, in either
        # condition, or a rule's own path, that treats the copy's name
        # differently from the path changes the rule's verdict in the copy
        # without skipping it, so the figure agrees (the round 10 rulings,
        # 2026-09-26). The config is the one every run reads, the reader's
        # copy of the work tree's .gitleaks.toml and its [extend] chain, or
        # of the file GITLEAKS_CONFIG names or GITLEAKS_CONFIG_TOML's text
        # (gitleaks' default, with none of those; its five rules carry no
        # path allowlist). In one more directory, for each selected piece: a
        # PROBE at the copy's exact name (<piece>/<name>), a short text its
        # rule reports under the default rules, and a SECOND COPY of the piece
        # at the directory's root under the name the index gives it
        # (romp-copy-<letters><suffix>, no digit and no directory). One more
        # scanner run over it, with the same five rules alone and the same
        # config, its figure checked against the probes' bytes and the
        # copies'; its exit 2 is expected, and its findings are never shown.
        # probe_check then reads its report: a probe not named under its own
        # rule refuses (the config drops that rule at the copy's name), and a
        # finding at a second copy refuses as a credential, named by commit
        # and file (credential_line; blocked_creds is set there alone). Every
        # write is a builtin and the check one awk, so the probe run adds one
        # scanner run and one awk per push with a selected file, no process
        # per piece, and its directories join the additive run's mkdir
        # batches below. The directories are made a
        # bounded number at a time, never one mkdir for every piece: past the
        # system's argument limit that one mkdir failed (E2BIG, status 126),
        # and set -e ended the hook with bash's line and no romp line on a
        # clean push (until round 10b; the round 9 refuters, 2026-09-25). Each
        # mkdir takes as many as fit in 64 KB at the scratch path's length in
        # bytes, half the 128 KB Linux allows any exec's arguments however low
        # the stack limit. That length is counted under LC_ALL=C: in a UTF-8
        # locale ${#scratch} counts characters, and until round 10b2 a scratch
        # path named past ASCII made a batch larger in bytes than it was
        # counted, so under a low stack limit mkdir could fail on Argument
        # list too long, a clean push refused with no romp line (the r10b
        # audit, 2026-09-25: a TMPDIR of three 80-character runs of CJK
        # characters, ulimit -s 512). A mkdir that fails ends the hook under
        # set -e, as every writer in the scratch directory does (the header's
        # scratch paragraph).
        if [ "$scanning" -eq 1 ] && [ -s "$scratch/creds.pindex" ]; then
            pdirs=()
            while IFS=$'\t' read -r -u 6 piece fpath sname prule fterm; do
                [ "$fterm" = . ] || continue
                case "$piece" in ''|*[!0-9]*) continue ;; esac
                pdirs+=("$scratch/creds.p/$piece" "$scratch/creds.q/$piece")
            done 6< "$scratch/creds.pindex"
            sbytes=$(LC_ALL=C; printf '%s' "${#scratch}")
            step=$(( 65536 / (sbytes + 32) )); [ "$step" -ge 1 ] || step=1
            pk=0
            while [ "$pk" -lt "${#pdirs[@]}" ]; do
                mkdir -- "${pdirs[@]:pk:step}"
                pk=$((pk + step))
            done
            # The probes' texts, one per rule, assembled here so the hook's own
            # text holds none (each ASCII, so ${#qtext} counts its bytes; each
            # clear of the default config's value allowlists, stopwords and
            # entropy floors, so only the repository's own allowlists can drop
            # one). generic-api-key also catches the yaml probe's data key when
            # every rule runs, which is why the run enables the five alone and
            # the check counts a probe under its own rule only.
            printf -v qv '%s%s' Rq7Zp2Wx9Kd4 Tm8Vb3Nc
            qp_pkcs="romp probe"$'\n'
            printf -v qp_nuget '<add key="Clear%sPassword" value="%s" />\n' Text "$qv"
            printf -v qp_k8s 'kind: Sec%s\ndata:\n  api_tok%s: %s\n' ret en "$qv"
            printf -v qp_tf 'administrator_login_pass%s = "%s"\n' word rq7zp2wx9kd4tm8v
            printf -v qp_php "'secret_%s' => 'sk_%s%s'\n" key "$qv" Hy6Jf1Lg9
            qbytes=0; qn=0
            while IFS=$'\t' read -r -u 6 piece fpath sname prule fterm; do
                [ "$fterm" = . ] || continue
                case "$piece" in ''|*[!0-9]*) continue ;; esac
                data=""
                LC_ALL=C IFS= read -r -d '' data < "$scratch/creds.d/$piece" || :
                LC_ALL=C printf '%s' "$data" > "$scratch/creds.p/$piece/$fpath"
                LC_ALL=C printf '%s' "$data" > "$scratch/creds.q/$sname"
                case "$prule" in
                    pkcs12-file) qtext=$qp_pkcs ;;
                    nuget-config-password) qtext=$qp_nuget ;;
                    kubernetes-secret-yaml) qtext=$qp_k8s ;;
                    hashicorp-tf-password) qtext=$qp_tf ;;
                    freemius-secret-key) qtext=$qp_php ;;
                    *) qtext="" ;;                              # no rule: an empty probe, which no rule names, so the check refuses
                esac
                printf '%s' "$qtext" > "$scratch/creds.q/$piece/$fpath"
                qbytes=$((qbytes + ${#qtext})); qn=$((qn + 1))
            done 6< "$scratch/creds.pindex"
            # handed the same cfg as the scan of record (gitleaks_config; the comment there)
            scanner_run "$gl" "the CREDENTIAL scan under the path-scoped rules" "$scratch/creds.p" "$rpbytes" "$scratch/creds.preport" names ${cfg[@]+"${cfg[@]}"} --enable-rule pkcs12-file,nuget-config-password,kubernetes-secret-yaml,hashicorp-tf-password,freemius-secret-key
            qwant=""; [ -z "$rpbytes" ] || qwant=$((qbytes + rpbytes))
            scanner_run "$gl" "the PROBE run of the path-scoped copies" "$scratch/creds.q" "$qwant" "$scratch/creds.qreport" probe ${cfg[@]+"${cfg[@]}"} --enable-rule pkcs12-file,nuget-config-password,kubernetes-secret-yaml,hashicorp-tf-password,freemius-secret-key
            if [ "$run_rc" -eq 0 ] || [ "$run_rc" -eq 2 ]; then
                if judged_read gate="the PROBE CHECK of the path-scoped copies" 0 "the PROBE CHECK of the path-scoped copies could not be read (awk exited {rc}), so whether the config drops a path-scoped rule at a copy's name is unknown" -- probe_check "$scratch/creds.pindex" "$scratch/creds.qreport"; then
                    qnamed=0; qmiss=0; qfound=0; qother=0; qend=""; qd=0
                    while IFS=$'\t' read -r kind qa qb qc; do
                        case "$kind" in
                            named) qnamed=$((qnamed + 1)) ;;
                            missing)
                                qmiss=$((qmiss + 1))
                                qa=${ix_path[qa]:-}; [ -n "$qa" ] || qa="a path whose name is unknown"
                                unscanned "the config the scan read ($cfg_name) dropped $qb's probe at $qc, the name the scan gives the copy of $qa, so the scan cannot check $qa under $qb; the hook cannot tell which entry of the config dropped the probe, or whether $qa itself gets the same verdict; excuse a false alarm by its value with a regex or stopword allowlist instead of a path, keep $qb's default path, or set ROMP_NO_GITLEAKS=1 for one push"
                                failed_creds=1 ;;
                            found) qfound=$((qfound + 1)); credential_line "$qa" "$qb"; blocked_creds=1 ;;
                            foreign)
                                qother=$((qother + 1))
                                unscanned "the report of the PROBE run of the path-scoped copies holds a line that names neither a probe nor a second copy the hook wrote (${qa}${qb:+ $qb}${qc:+ $qc}), so what the run read is unknown"
                                failed_creds=1 ;;
                            end) qend="$qa $qb $qc" ;;
                            *) qd=$((qd + 1)) ;;
                        esac
                    done <<< "$read_out"
                    if [ -z "$qend" ]; then
                        unscanned "the PROBE CHECK of the path-scoped copies answered no closing line of counts (awk exited 0), so which probes the scan named is unknown"
                        failed_creds=1
                    elif [ "$qend" != "$qn $qfound $qother" ] || [ $((qnamed + qmiss)) -ne "$qn" ] || [ "$qd" -ne 0 ]; then
                        unscanned "the PROBE CHECK of the path-scoped copies was read short (its closing line reads \"$qend\", for pieces, findings at a second copy and other lines, where the shell wrote $qn probes and read $((qnamed + qmiss)) probe lines, $qfound findings, $qother other lines and $qd lines of no kind)"
                        failed_creds=1
                    fi
                else
                    failed_creds=1
                fi
            fi
        fi
    fi

    if [ "$blocked_creds" -ne 0 ]; then
        echo "" >&2
        echo "romp pre-push: BLOCKED. gitleaks found a credential in a pushed commit." >&2
        echo "  Treat it as compromised the moment it exists in a commit: ROTATE it, then remove it." >&2
        echo "  Removing it in a NEW commit is not enough; the old commit still carries it." >&2
        echo "  A false positive belongs in .gitleaks.toml, narrowly, by exact value, with a reason." >&2
    fi
    if [ "$failed_creds" -ne 0 ]; then
        echo "" >&2
        echo "romp pre-push: BLOCKED. gitleaks could not scan; its error is above." >&2
        echo "  The push is refused rather than published unscanned. Fix the scanner (gitleaks 8.25.0 or later) or its config, or set ROMP_NO_GITLEAKS=1 for one push." >&2
    fi
}

refuse_replace_refs
scan_identifiers
scan_credentials

# Both scans have reported; one bypass line, then the verdict.
if [ "$blocked_ids" -ne 0 ] || [ "$blocked_creds" -ne 0 ] || [ "$failed_scan" -ne 0 ]; then
    echo "  To bypass for one push (you are sure it is fine): git push --no-verify" >&2
    exit 1
fi
exit 0
