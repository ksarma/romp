        # one included, since the listing is checked against them below before
        # a commit with no post-image is passed over: an emptied listing names
        # no post-image either, and passing on that alone was the hole.
        numstat_ok=1
        : > "$scratch/rows"; : > "$scratch/rows2"
        if [ "$merge" -ne 0 ]; then
            # A merge: the combined patch, the read the scan makes for one, read
            # again and parsed section by section (combined_rows). Its rename
            # candidates, the post-images whose blob some parent holds under a
            # path the merge lacks, are judged as the addition of their new
            # path by the third numstat below where the patch printed nothing
            # for them (a pure rename, the one change it prints nothing for); a
            # post-image the patch printed nothing for that is no rename is a
            # short read. The candidates come from the merge's deletions
            # against EACH parent (-m: one raw listing per parent, read apart
            # from the combined one), since the combined listing names a
            # deletion only when every parent held the path: content two
            # parents held under two paths, moved to a third with both gone,
            # is a deletion against each parent alone, and the patch prints
            # nothing for it (-M pairs it with an identical blob in every
            # parent), so it was no candidate and was refused as unscanned
            # (the round 3 auditor, 2026-09-22). A listing that fails refuses
            # as unscanned and stands the short arm down for this commit; one
            # that answers short leaves such a path a short read, the safe
            # side.
            rc=0; git diff-tree -p -r -M -c --root --no-commit-id --no-color "$rev" > "$scratch/patch" || rc=$?
