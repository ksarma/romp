                unscanned "the JOIN of commit ${rev:0:10}'s verdicts could not be made for the BINARY VERDICT check (its pipeline exited $rc and its awk recorded \"$count\" as the count of candidate rows it printed, not a count, so whether every candidate was appended is unknown)"
            elif [ "$appended" -ne "$count" ]; then
                unscanned "the JOIN of commit ${rev:0:10}'s verdicts appended $appended candidate rows for the BINARY VERDICT check where its awk recorded $count printed (its pipeline exited $rc), so the join answered short"
            fi
        fi
        if { [ "$rc" -eq 3 ] || [ "$rc" -eq 4 ]; } && [ "$numstat_ok" -ne 0 ]; then
            # A short read: 3 for a pair numstat or the combined patch, 4 for the
            # addition numstat, the FIRST post-image met no verdict for in the
            # short file.
            path=""; { IFS= read -r path || :; } < "$scratch/short"     # the first post-image the join met no verdict for (the file is made per commit above, so this is never a read of a missing file); empty when the join recorded none
            [ -n "$path" ] || path="a path the join did not record (it exited $rc)"
            if [ "$merge" -eq 0 ]; then
                unscanned "the BINARY VERDICTS of commit ${rev:0:10} could not be read (git diff-tree --numstat answered for fewer paths than the commit changes and printed no verdict for $path)"
            elif [ "$rc" -eq 4 ]; then
                unscanned "the BINARY VERDICTS of commit ${rev:0:10} could not be read (git diff-tree --numstat against the empty tree answered for fewer paths than the merge renames and printed no verdict for $path)"
            else
                unscanned "the BINARY VERDICTS of commit ${rev:0:10} could not be read (git diff-tree -p -c, the merge's combined patch, printed no verdict for $path, a path the merge changes)"
            fi
        fi
    done 3<<< "$revs"
    [ -s "$scratch/entries" ] || return 0
    # The entries are read on descriptor 6, never stdin: every tool the loop
    # runs (the byte judge, the report's reads) inherits stdin, and one that
    # read it would take the entries after its own, which no verdict would
    # then judge (the header: a git silent on an empty blob's read, the blob's
    # own answer, that read its stdin left a hidden file unjudged and
    # published it; round 8b).
    while IFS= read -r -u 6 -d '' entry; do
        place=${entry%%$'\t'*}; blob=${entry#*$'\t'}; blob=${blob%%$'\t'*}; path=${entry#*$'\t'*$'\t'}
        typed=0; case "$place" in *+typed) place=${place%+typed}; typed=1 ;; esac
        islink=0; case "$place" in *+link) place=${place%+link}; islink=1 ;; esac
        renamed=""; case "$place" in *+rename) place=${place%+rename}; renamed=" (the diff read it as a rename, so the attribute of the path it came from counted too)" ;; esac
        if [ "$place" = tip ]; then at="at the tip of $local_ref (${local_sha:0:10})"; else at="in commit ${place:0:10}"; fi
        # The first 8000 bytes, counted with their NULs; the rest is drained so
        # the cat-file is never cut off mid-write (its status is the pipe's).
        if [ "$place" = tip ]; then
            judged_read gate="the BYTE COUNTS of a hidden blob" 0 "the CONTENT of $path at the tip of $local_ref (${local_sha:0:10}), which git calls binary and the identifier scan therefore skipped, could not be read (git cat-file exited {rc})" -- byte_counts "$blob" || continue
        else
            judged_read gate="the BYTE COUNTS of a hidden blob" 0 "the CONTENT of $path in commit ${place:0:10}, which git calls binary and the identifier scan therefore skipped, could not be read (git cat-file exited {rc})" -- byte_counts "$blob" || continue
        fi
        counts=$read_out
        # The two counts are runs of digits before -eq reads them, and a count
        # of ZERO bytes is empty content only when the blob is empty (the
        # header's second class): a cat-file that exits 0 and prints nothing, or
        # an od that fails inside the group (whose status is the drain's), leaves
        # awk a count of zero for a blob with bytes, and the blob passed as
        # empty. The size is read apart (cat-file -s), and a size that is not
        # zero, or could not be read, refuses the push as unscanned naming both.
        read -r bytes nuls <<< "$counts"
        if [ -z "$bytes" ] || [ -n "${bytes//[0-9]/}" ] || [ -z "$nuls" ] || [ -n "${nuls//[0-9]/}" ]; then
            unscanned "the CONTENT of $path $at, which git calls binary and the identifier scan therefore skipped, could not be counted (od and awk answered \"$counts\", not two counts)"
            continue
        fi
        if [ "$bytes" -eq 0 ]; then
            if judged_read gate="the SIZE of a hidden blob" 0 "the CONTENT of $path $at, which git calls binary and the identifier scan therefore skipped, was read as 0 bytes while its SIZE could not be read (git cat-file -s exited {rc}), so whether the blob is empty is unknown" -q -- git cat-file -s "$blob"; then
                size=$read_out
                if [ -z "$size" ] || [ -n "${size//[0-9]/}" ]; then
                    unscanned "the CONTENT of $path $at, which git calls binary and the identifier scan therefore skipped, was read as 0 bytes while its SIZE reads \"$size\" (git cat-file -s), not a size, so whether the blob is empty is unknown"
                elif [ "$size" -ne 0 ]; then
                    unscanned "the CONTENT of $path $at, which git calls binary and the identifier scan therefore skipped, was read as 0 bytes while git cat-file -s gives its size as $size bytes, so the read answered short (git cat-file blob exited 0)"
                fi
            fi
            continue        # empty (the size agrees): nothing hidden
        fi
        [ "$nuls" -eq 0 ] || continue       # a NUL: binary, which the scan never read
        # Text git called binary. The report's label comes from the path's diff
        # attribute, read for this line alone (the header: never a decision); a
        # one-parent commit's symlink reads none, since the pairwise diff applies
        # none to it (a merge's combined patch does, so a merge's link is
        # labelled as a file is). The line's tail is keyed on the read's
        # outcome: a read that answered says whether an attribute accounts for
        # the verdict, and a read that failed (a status, no answer, an answer
        # about another path) says that it could not be read and that whether
        # an attribute accounts for the verdict is unknown, keeps the two facts
        # and has both remedies print (the tail claimed what the failed read
        # could not establish; the round 4 refuter, 2026-09-22).
        # outside judged_read: every read from here to the refused line (the
        # attribute, the driver's key, the size and the threshold, the parent
        # count and the rename source, the previous version's bytes) is for the
        # REPORT alone, on a push refused already by the verdict above: a read
        # that fails leaves the line with fewer facts and says so where the
        # tail depends on it (the attribute), and none decides anything, so a
        # refusal for one would name a second cause on a refused push.
        how=""; says=""; accounts="so no attribute of its path accounts for the verdict"; unread=0
        if [ "$islink" -ne 0 ]; then
            says="it is a symbolic link, whose target this read judges by its size and bytes and by no attribute of the path"
        else
            rc=0; git check-attr -z diff -- "$path" > "$scratch/attr" 2>/dev/null || rc=$?     # outside judged_read: for the report (above)
            if [ "$rc" -ne 0 ]; then
                says="its diff attribute could not be read (git check-attr exited $rc)"; accounts="so whether an attribute of its path accounts for the verdict is unknown"; unread=1
            else
                { IFS= read -r -d '' apath && IFS= read -r -d '' attr && IFS= read -r -d '' value; } < "$scratch/attr" || { apath=""; attr=""; value=""; }
                if [ -z "$apath$attr$value" ]; then
                    says="its diff attribute could not be read (git check-attr answered nothing for the path asked)"; accounts="so whether an attribute of its path accounts for the verdict is unknown"; unread=1
                elif [ "$apath" != "$path" ] || [ "$attr" != diff ] || [ -z "$value" ]; then
                    says="its diff attribute could not be read (git check-attr answered out of step with the path asked)"; accounts="so whether an attribute of its path accounts for the verdict is unknown"; unread=1
                elif [ "$(git config --type=bool "diff.$value.binary" 2>/dev/null || true)" = true ]; then     # outside judged_read: for the report (above)
                    how="diff=$value, binary"
                elif [ "$value" = unset ]; then
                    how="unset"
                else
                    says="its diff attribute reads $value"
                fi
            fi
        fi
        if [ -n "$how" ]; then
            if [ "$place" = tip ]; then
                echo "romp pre-push: $path at the tip of $local_ref (${local_sha:0:10}) is text that its diff attribute ($how) hides from the identifier scan, so the push is refused rather than scanned" >&2
            else
                echo "romp pre-push: $path in commit ${place:0:10} is text that its diff attribute ($how) hides from the identifier scan, so the push is refused rather than scanned" >&2
            fi
            hidden_attr=1
        else
            size=$(git cat-file -s "$blob" 2>/dev/null || echo unknown)          # outside judged_read: for the report (above)
            threshold=$(git config core.bigFileThreshold 2>/dev/null || true)    # outside judged_read: for the report (above)
            # No attribute: for a commit's changed file (not a symlink, judged by
            # its own bytes; not a type change or a merge's rename candidate the
            # patch printed no section for, +typed, each judged by the addition
            # of the new object alone), the
            # PREVIOUS version's first 8000 bytes are read as the blob's were
            # above, key or no key, since a pre-image binary by its bytes makes
            # the pair binary whatever the key says and the diff prints no text
            # for the new version (the header); a merge's combined patch prints
            # Binary the same way when a parent's version is, so each parent's
            # version is read in turn, the count the one the caller read
            # (pcount), never the listing's shape. For a one-parent commit the
            # version in its parent, at the path the diff read the change from:
            # for a rename the old path, re-derived here from the commit's raw
            # listing with -M (an R row's two path records), never carried in
            # the rows or the entries, since a path may hold a tab. For the
            # report alone, like the attribute: a read that fails or a path with
            # no previous version (an addition, a root commit) leaves the
            # two-fact line, where the key is the candidate cause. A NUL found
            # names the previous version as the cause (the parent, or the old
            # path, named where it is not the commit's own path), with the two
            # facts beside it where the key is set; the key's advice is for the
            # two-fact lines alone, since raising the key lifts nothing here
            # (with the key set, the line named the key's facts and its remedy
            # while the certain cause went unnamed; the round 3 auditor,
            # 2026-09-22; a merge's line named the key's facts and remedy with
            # no cause and no fetch remedy, and a rename's the rename clause and
            # the key's remedy, the round 4 refuters 2026-09-22). The counters
            # choose the advice: a two-fact line has the key's (hidden_unnamed)
            # and, where the attribute could not be read, the attribute's too
            # (hidden_attr), since either may be the cause; a line naming the
            # previous version has the fetch remedy and the attribute line
            # (hidden_prior), whatever the attribute read did: the key lifts
            # nothing there, but an explicit `diff` attribute on the PREVIOUS
            # version's path (the old path for a rename; the file's own path
            # otherwise, a merge's parents' included) makes git treat that
            # version as text whatever its bytes, so the diff prints the change
            # and the scan reads it (by execution, the round 5 refuter,
            # 2026-09-22; this comment had claimed no attribute lifts such a
            # pair). The attribute paragraph (hidden_attr) is not that remedy,
            # since it removes a -diff a line named as the cause, and a line
            # naming the previous version named its bytes: withheld there.
            prior=0; where=""
            if [ "$place" != tip ] && [ "$islink" -eq 0 ] && [ "$typed" -eq 0 ]; then
                k=$(LC_ALL=C awk -v r="$place" '$1 == r { print $2; exit }' "$scratch/pcount")     # outside judged_read: for the report (above)
                if [ -z "$k" ] || [ -n "${k//[0-9]/}" ]; then k=0; fi
                if [ "$k" -eq 1 ]; then
                    prev=$path
                    if [ -n "$renamed" ]; then
                        prev=""; rc=0; git diff-tree -r --raw -M -z --root --no-commit-id "$place" > "$scratch/renames" 2>/dev/null || rc=$?     # outside judged_read: for the report (above)
                        if [ "$rc" -eq 0 ]; then
                            while IFS= read -r -d '' meta && IFS= read -r -d '' rsrc; do
                                case "${meta##* }" in R*|C*) IFS= read -r -d '' rdst || rdst=""; [ "$rdst" != "$path" ] || prev=$rsrc ;; esac
                            done < "$scratch/renames"
                        fi
                    fi
                    if [ -n "$prev" ]; then
                        rc=0; counts=$(git cat-file blob "$place^:$prev" 2>/dev/null | { head -c 8000 | LC_ALL=C od -An -v -tu1 | awk '{ for (i = 1; i <= NF; i++) { b++; if ($i == 0) z++ } } END { print b + 0, z + 0 }'; cat > /dev/null; }) || rc=$?     # outside judged_read: for the report (above)
                        if [ "$rc" -eq 0 ]; then read -r bytes nuls <<< "$counts"; case "$nuls" in ''|*[!0-9]*) ;; 0) ;; *) prior=1 ;; esac; fi
                        [ "$prior" -eq 0 ] || [ "$prev" = "$path" ] || where=" (at $prev, the path the diff read it from)"
                    fi
                elif [ "$k" -gt 1 ]; then
                    for ((i = 1; i <= k; i++)); do
                        rc=0; counts=$(git cat-file blob "$place^$i:$path" 2>/dev/null | { head -c 8000 | LC_ALL=C od -An -v -tu1 | awk '{ for (i = 1; i <= NF; i++) { b++; if ($i == 0) z++ } } END { print b + 0, z + 0 }'; cat > /dev/null; }) || rc=$?     # outside judged_read: for the report (above)
                        [ "$rc" -eq 0 ] || continue
                        read -r bytes nuls <<< "$counts"
                        case "$nuls" in ''|*[!0-9]*) ;; 0) ;; *) prior=1; where=" in parent $i of the merge"; break ;; esac
                    done
                fi
            fi
            if [ "$prior" -ne 0 ]; then
                facts=""; [ -z "$threshold" ] || facts=" whatever the key says (the blob is $size bytes; core.bigFileThreshold is $threshold in this clone's configuration)"
                echo "romp pre-push: $path in commit ${place:0:10} is text that git calls binary although $says, $accounts; the previous version of the file$where is binary by its bytes (a NUL in its first 8000), which made git print no text diff for the change$facts, and the identifier scan could not read the new text, so the push is refused rather than scanned" >&2
                hidden_prior=1
            elif [ "$place" = tip ]; then
                echo "romp pre-push: $path at the tip of $local_ref (${local_sha:0:10}) is text that git calls binary although $says, $accounts (the blob is $size bytes; core.bigFileThreshold is ${threshold:-not set} in this clone's configuration); the identifier scan did not read it, so the push is refused rather than scanned" >&2
                hidden_unnamed=1
            else
                echo "romp pre-push: $path in commit ${place:0:10} is text that git calls binary although $says, $accounts$renamed (the blob is $size bytes; core.bigFileThreshold is ${threshold:-not set} in this clone's configuration); the identifier scan did not read it, so the push is refused rather than scanned" >&2
                hidden_unnamed=1
            fi
            [ "$prior" -ne 0 ] || [ "$unread" -eq 0 ] || hidden_attr=1
        fi
        hidden_paths=1
        failed_scan=1
    done 6< "$scratch/entries"
}

# ── identifiers ───────────────────────────────────────────────────────────
# The type the pushed object PEELS to (blob, tree or commit; cat-file -t on
# <sha>^{}), read once per ref and only when a read needs it: the symlink pass
# when its listing exited 128 (a blob has no tree to list), and the commit
# listing when it answered nothing (a blob or a tree names no commit, so the
# empty listing is the object's own). Any answer outside the object types
# refuses the push as unscanned naming the read and the answer, and leaves
# peeled empty, which every caller reads as "not a blob": the safe side. Sets
# peeled and peeled_read, the caller's.
peel_type() {   # <local_ref> <local_sha>
    [ "$peeled_read" -eq 0 ] || return 0
    peeled_read=1; peeled=""
    judged_read gate="the TYPE of the object the tip peels to" 0 "the TYPE of the object the tip of $1 (${2:0:10}) peels to could not be read (git cat-file -t exited {rc})" -q -- git cat-file -t "$2^{}" || return 0
    case "$read_out" in
        blob|tree|commit) peeled=$read_out ;;
        *) unscanned "the TYPE of the object the tip of $1 (${2:0:10}) peels to was read as \"$read_out\" (git cat-file -t exited 0), not an object type" ;;
    esac
}
# The TYPE of the object a ref pushes, and of each object the peel below
# reaches: read through judged_read (a failure refused with type_unread's
# clause) and its answer judged in this shell, never a subshell, against the
# four object types, since a type is never an object's own empty answer: an
# answer outside them refuses the push as unscanned naming the read and the
# answer (a cat-file -t answering nothing with a clean status read as "not a
# tag" and published a banned tagger through a real push; the round 5
# refuters, 2026-09-22). The shape is judged only on a read that exited 0, so
# a failed read is refused once; either way kind is left empty, which ends
# the peel. Sets kind, the caller's.
object_type() {   # <local_ref> <sha>
    kind=""
    judged_read gate="the TYPE of a pushed object" 0 "$(type_unread "$1" "$2")" -q -- git cat-file -t "$2" || return 0
    case "$read_out" in
        blob|tree|commit|tag) kind=$read_out ;;
        *) unscanned "the TYPE of the object $1 pushes (${2:0:10}) was read as \"$read_out\" (git cat-file -t exited 0), not an object type, so whether it is an annotated tag is unknown" ;;
    esac
}
# The line numbers of the hits in a message (a commit's, a tag's), for the
# report: the grep's status through judged_read (0 a hit, 1 none, anything
# else refused as unscanned naming the subject), -n numbering the lines from
# the subject, and the numbers joined with commas into lines, the caller's.
# The grep's own status is the sibling fact for its answer (the header's
# second class): exit 0 is a match, so a match that printed no line is a short
# answer, refused as unscanned naming the subject (a grep exiting 0 printing
# nothing published a commit and a tag through real pushes; the round 6
# refuters, 2026-09-22). -a reads the message as text whatever its bytes:
# under a UTF-8 locale GNU grep calls a line holding a byte that is no UTF-8
# binary, and without -a a match on such a line is a "binary file matches"
# note on stderr and no line on stdout, exit 0, so a banned string beside a
# stray byte was read as no hit (the round 6 refuters, with the real grep and
# no shim; the empty-answer refusal above stays as the backstop). Called as a
# condition: status 0 when the message carries a hit.
message_hit_lines() {   # <subject: "the MESSAGE of commit <sha>" or "the MESSAGE of tag <ref> (<sha>)"> <message>
    local hit
    lines=""
    judged_read gate="the MESSAGE grep" 0,1 "$1 could not be grepped (grep exited {rc})" -- grep -in -a -F "${grep_args[@]}" <<< "$2" || return 1
    [ "$read_rc" -eq 0 ] || return 1
    if [ -z "$read_out" ]; then
        unscanned "$1 was grepped with no hit line listed (grep exited 0, a match, and printed no line), so the answer is short"
        return 1
    fi
    while IFS= read -r hit; do lines="$lines${hit%%:*},"; done <<< "$read_out"
    lines=${lines%,}
    [ -n "$lines" ]
}
scan_identifiers() {
    local strings_file line grep_args local_ref local_sha _remote_ref remote_sha lines role email obj tagger chosen chosen_unread
    local rc errs hits listing link blob link_path target size revs rev n msg addrs inner kind tip_listed tip_entries rev_counts
    local peeled peeled_read fell_back agreed paths count linecount tag_read hdr
    local -a words
    strings_file="$(private_strings_file)"
    identifier_scan_armed || return 0

    # Banned strings: strip comments and surrounding whitespace, drop blanks. The
    # `|| [ -n "$line" ]`: a last line with no trailing newline (an editor that
    # adds none, a printf that wrote the file) comes back from read with status 1
    # and the line in hand, and a plain `while read` dropped it: the entry on
    # that line was scanned for by nothing, and a one-entry file so written armed
    # no scan at all, nothing printed either way (found by execution, 2026-09-21).
    grep_args=()
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [ -n "$line" ] && grep_args+=(-e "$line")
    done < "$strings_file"
    [ ${#grep_args[@]} -gt 0 ] || return 0
    chosen_emails                  # the same for every commit in the push: read once, in the shell (it sets chosen and chosen_unread)

    # The refs on descriptor 5, never stdin, and the links below on 6: every
    # tool the loop runs inherits stdin, and one that read it would take the
    # refs after the current one, which no scan would then read (the header:
    # an awk silent with exit 0 that read its stdin during the first ref of a
    # two-ref push published the second; round 8b).
    while read -r -u 5 local_ref local_sha _remote_ref remote_sha; do
        [ -n "${local_sha:-}" ] || continue
        [ "$local_sha" = "$zero" ] && continue          # deleting a remote ref pushes nothing

        # The tip's tree. -I skips binaries; -l lists files. The status and the
        # error stream are read apart from the hits: git grep exits 1 for no match
        # and above 1 when it could not scan (a git that would not run, a killed
        # process, an argument list too long, a partial clone whose promisor is
        # unreachable), and a blob it cannot read it reports on stderr and skips,
        # exiting 1 (or 0, listing the files it did read), so a corrupt store made
        # the leaking file a clean one. Every hit is "<sha>:<path>", or the bare
        # "<sha>" when the pushed object peels to a blob (a tag of a blob, which
        # git grep reads as one file); any other line is an error, echoed under
        # the report. Found by execution (2026-09-20):
        # with a git grep exiting 2, and again with the leaking file's blob
        # missing, a tip whose tree carried a denylist string passed. --no-color:
        # with color.ui or color.grep set to always, git wraps each hit line in
        # colour codes even off a terminal, and a coloured hit is not
        # "<sha>:<path>": it read as an error line, and a real hit was reported
        # as a broken scanner (2026-09-21).
        # The hit lines and the error lines are told apart here, line by line,
        # and the grep's own status is the sibling fact for its answer: exit 0
        # is a match, so a match that printed no hit line is a short answer,
        # refused as unscanned.
        peeled=""; peeled_read=0
        judged_read gate="the CONTENT grep of the tip" 0,1 "the CONTENT of the tip of $local_ref (${local_sha:0:10}) could not be fully scanned (git grep exited {rc})" -e -- git grep --no-color -i -I -l -F "${grep_args[@]}" "$local_sha" -- || :
        rc=$read_rc; hits=""; errs=""
        while IFS= read -r line; do
            case "$line" in
                "$local_sha:"*|"$local_sha") hits="$hits$line"$'\n' ;;
                '') ;;
                *) errs="$errs$line"$'\n' ;;
            esac
        done <<< "$read_out"
        hits=${hits%$'\n'}; errs=${errs%$'\n'}
        if [ "$rc" -le 1 ] && [ -n "$errs" ]; then
            unscanned "the CONTENT of the tip of $local_ref (${local_sha:0:10}) could not be fully scanned (git grep exited $rc)"
        fi
        if [ -n "$errs" ]; then
            while IFS= read -r line; do printf '  %s\n' "$line" >&2; done <<< "$errs"
        fi
        if [ "$rc" -eq 0 ] && [ -z "$hits" ]; then
            unscanned "the CONTENT of the tip of $local_ref (${local_sha:0:10}) was scanned with no hit listed (git grep exited 0, a match, and printed no hit line), so the answer is short"
        fi
        if [ -n "$hits" ]; then
            echo "romp pre-push: the tip of $local_ref (${local_sha:0:10}) would publish a personal identifier in:" >&2
            while IFS= read -r line; do
                case "$line" in "$local_sha:"*) printf '  %s\n' "${line#"$local_sha:"}" >&2 ;; *) printf '%s\n' "$line" >&2 ;; esac
            done <<< "$hits"
            blocked_ids=1
        fi

        # The tip's symlinks. git grep reads regular-file blobs only, so a link whose
        # TARGET holds a string is invisible to the grep above. A committed link's
        # target is its blob content, so read each 120000 entry's blob itself. Not
        # hypothetical: a `node_modules -> /home/<user>/code/romp/...` link, made to
        # run the extension tests in a worktree and swept up by a broad `git add`,
        # reached a public branch past a git grep of its tree, and a reviewer found
        # it, not the hook. An ls-tree line is "<mode> <type> <sha>\t<path>". The
        # listing is captured before the grep so a failed ls-tree has a road of its
        # own: piped straight into grep, the listing's failure was grep's no-match,
        # and a tree that could not be listed read as a tree with no symlinks (found
        # by execution, 2026-09-20: with one subtree object missing, ls-tree listed
        # the link and exited 1, the pipeline took that status, and a real push
        # published the branch). A failed listing refuses the push as unscanned;
        # whatever it did list is still read, so a link it named is still named.
        # A pushed object that peels to a BLOB (a tag of a blob) has no tree to
        # list: the listing is absent, not unreadable, and the content scan above
        # read the blob itself. The peel-type read is made only when the listing
        # failed, and its own failure refuses like any other.
        tip_listed=1            # read again with -z by refuse_hidden_paths; not when this listing failed or found no tree
        # The listing's expected set is 0 and 128: ls-tree exits 128 for a pushed
        # object that peels to a blob ("not a tree object"), which has no tree to
        # list, and the peeled type then decides whether that is the case; any
        # other status is refused here, and whatever was listed is still read. An
        # empty listing under exit 0 is judged here against the SIZE of the tip's
        # tree (cat-file -s on the tree the pushed object peels to), the header's
        # second class: the empty tree, size 0, is the one tree with no entry, so
        # any other size is a listing that answered short, refused naming the
