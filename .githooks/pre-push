#!/usr/bin/env bash
# romp pre-push hook: refuse to publish a commit that carries a personal
# identifier or a credential.
#
# The repo may go public and history is permanent, so both scans read the
# COMMITS BEING PUSHED — not the working tree, which is not what gets published
# and which hides a leak buried in an intermediate commit whose tip is clean.
# Two scanners, because they catch opposite kinds of thing:
#
#   identifiers   strings only YOU can enumerate (names, hostnames, vault
#                 names), read from ~/.config/romp/private-strings.txt.
#   credentials   strings NOBODY can enumerate in advance — a token's text is
#                 unknown until it leaks — matched by gitleaks' rules, tuned by
#                 the repo's .gitleaks.toml.
#
# Both stay out of the way when unconfigured: no denylist file, no identifier
# scan; no gitleaks binary, a one-line notice and no credential scan (CI runs
# the same scan over the full history, so nothing goes unscanned for long). The
# hook is symlinked into the SHARED git hooks dir by install.sh, so it fires
# from every worktree, and reading its inputs from $HOME and $PATH rather than
# from the tree arms every worktree equally.
#
# Env: ROMP_PRIVATE_STRINGS (denylist path), ROMP_GITLEAKS (binary path),
# ROMP_NO_GITLEAKS=1 (skip the credential scan and its notice).
# Bypass everything for one push with `git push --no-verify`.
set -euo pipefail

# git feeds the ref list on stdin and both scans need it, so read it once.
# $1 is the remote being pushed to (a name, or a bare URL when pushing by URL).
refs="$(cat)"
remote="${1:-}"
zero=0000000000000000000000000000000000000000
blocked_ids=0
blocked_creds=0

# The commits THIS push publishes for one ref: what the remote does not already
# have. "Already has" means reachable from ANY of the remote's refs as this clone
# last fetched them (refs/remotes/<remote>/*), not only from the ref being pushed.
# The difference is a branch that merged main: its range holds main's commits,
# every one of them on the remote already through main. Scanning those refuses
# the push over a string that main itself published, and a leak already on the
# remote is fixed FORWARD, on main (redact, push main) — not by blocking every
# branch that merged main before the redaction (2026-09-06: two identifiers added
# to the denylist sat in main's history, and every branch that had merged main
# was refused over main's own commits). The exclusion is
# scoped to the remote being pushed to: a commit only another remote has is still
# new to this one. With no remote-tracking refs for the remote (never fetched, or
# a push to a bare URL) the exclusion matches nothing and the range falls back to
# everything the remote ref lacks — for a new ref, the whole history.
rev_range() {   # <local_sha> <remote_sha> → a rev-list argument list
    local args="$1 --not"
    [ "$2" = "$zero" ] || args="$args $2"
    [ -z "$remote" ] || args="$args --remotes=$remote"
    printf '%s' "$args"
}

# ── identifiers ───────────────────────────────────────────────────────────
# Two checks per pushed ref, both about what THIS push changes on the remote:
#
#   the tip's tree    the content the push exposes. A banned string anywhere in
#                     it — a regular file, or a symlink's target — refuses the
#                     push.
#   each new commit   the lines it ADDS against its first parent. A string
#                     introduced in an intermediate commit and removed by a
#                     later one is still caught, and the commit named; a commit
#                     whose tree merely INHERITS a string an older commit put
#                     there is not. Every commit on every branch cut from main
#                     between a leak landing and its redaction inherits it that
#                     way, and the per-commit TREE scan this replaced refused
#                     them all (2026-09-06), when the only exposure any of them
#                     could add was its tip.

# The lines a commit adds, one per line as "<path>\t<text>": its diff against
# its first parent (for a merge, the same first-parent diff gitleaks is told to
# take below; for a root commit, against the empty tree). A new symlink shows
# up here too — a link's target is its blob content, so it is an added line.
added_lines() {   # <rev>
    local parent
    { if parent=$(git rev-parse -q --verify "$1^" 2>/dev/null); then
          git diff-tree -p -r -M --no-color "$parent" "$1"
      else
          git diff-tree -p -r -M --no-color --root "$1"
      fi; } | awk '/^\+\+\+ b\//{f=substr($0,7); next} /^\+\+\+ /{f=$0; next} /^\+/{print f "\t" substr($0,2)}'
}

scan_identifiers() {
    local strings_file line rev revs hits local_ref local_sha remote_sha
    strings_file="${ROMP_PRIVATE_STRINGS:-${XDG_CONFIG_HOME:-$HOME/.config}/romp/private-strings.txt}"
    [ -f "$strings_file" ] || return 0

    # Banned strings: strip comments and surrounding whitespace, drop blanks.
    local grep_args=()
    while IFS= read -r line; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [ -n "$line" ] && grep_args+=(-e "$line")
    done < "$strings_file"
    [ ${#grep_args[@]} -gt 0 ] || return 0

    while read -r local_ref local_sha _remote_ref remote_sha; do
        [ -n "${local_sha:-}" ] || continue
        [ "$local_sha" = "$zero" ] && continue      # deleting a remote ref pushes nothing

        # The tip's tree. -I skips binaries; -l lists files.
        if hits=$(git grep -i -I -l -F "${grep_args[@]}" "$local_sha" -- 2>/dev/null) && [ -n "$hits" ]; then
            echo "romp pre-push: the tip of $local_ref (${local_sha:0:10}) would publish a personal identifier in:" >&2
            echo "$hits" | sed "s/^$local_sha:/  /" >&2
            blocked_ids=1
        fi
        # SYMLINKS are invisible to git grep — it searches regular-file blobs only, so a link
        # whose TARGET is a home path sails straight through the scan above. That is not
        # hypothetical: a `node_modules -> /home/<user>/code/romp/...` link created to run the
        # extension tests in a worktree was swept up by `git add -A` and pushed to a public
        # branch, and the upstream maintainer found it, not this hook (2026-08-13). A symlink's
        # target IS its content once committed, so scan those blobs directly.
        if links=$(git ls-tree -r "$local_sha" 2>/dev/null | grep '^120000 '); then
            while IFS= read -r link; do
                [ -n "$link" ] || continue
                lsha=${link#* * }; lsha=${lsha%%[[:space:]]*}
                lpath=${link#*$'\t'}
                ltarget=$(git cat-file -p "$lsha" 2>/dev/null)
                if printf '%s' "$ltarget" | grep -qi -F "${grep_args[@]}"; then
                    echo "romp pre-push: the tip of $local_ref (${local_sha:0:10}) would publish a personal identifier" >&2
                    echo "  in the SYMLINK TARGET of $lpath -> $ltarget" >&2
                    blocked_ids=1
                fi
            done <<< "$links"
        fi

        # The lines each commit new to the remote adds.
        # shellcheck disable=SC2046  # the range is deliberately word-split
        revs=$(git rev-list $(rev_range "$local_sha" "$remote_sha") 2>/dev/null \
               || git rev-list "$local_sha")
        for rev in $revs; do
            if hits=$(added_lines "$rev" | grep -i -F "${grep_args[@]}" | cut -f1 | sort -u) && [ -n "$hits" ]; then
                echo "romp pre-push: commit ${rev:0:10} ADDS a personal identifier in:" >&2
                echo "$hits" | sed 's/^/  /' >&2
                blocked_ids=1
            fi
        done
    done <<< "$refs"

    if [ "$blocked_ids" -ne 0 ]; then
        echo "" >&2
        echo "romp pre-push: BLOCKED — a banned string from $strings_file is in a pushed commit." >&2
        echo "  Replace it with synthetic data (see CONTRIBUTING.md), then push again." >&2
        echo "  If the string is only in an INTERMEDIATE commit, squash or rewrite the branch." >&2
        echo "  If the tip only INHERITS a string an older commit added and main has since redacted, merge main." >&2
    fi
}

# ── credentials ───────────────────────────────────────────────────────────
scan_credentials() {
    [ -n "${ROMP_NO_GITLEAKS:-}" ] && return 0

    local gl root cfg range
    gl="${ROMP_GITLEAKS:-$(command -v gitleaks || true)}"
    if [ -z "$gl" ] || [ ! -x "$gl" ]; then
        # Loud rather than silent, but not a blocker: requiring an install to
        # push would break every clone that never wanted the scanner, and CI
        # scans the full history regardless.
        echo "romp pre-push: gitleaks not installed — pushing WITHOUT a secret scan." >&2
        echo "  Install it (brew install gitleaks / see .github/workflows/ci.yml) or set ROMP_NO_GITLEAKS=1." >&2
        return 0
    fi

    root="$(git rev-parse --show-toplevel)"
    cfg=()
    [ -f "$root/.gitleaks.toml" ] && cfg=(--config "$root/.gitleaks.toml")

    while read -r _local_ref local_sha _remote_ref remote_sha; do
        [ -n "${local_sha:-}" ] || continue
        [ "$local_sha" = "$zero" ] && continue
        range="$(rev_range "$local_sha" "$remote_sha")"
        # -v is what prints the file, line and rule; without it gitleaks reports
        # only a COUNT, which tells you a push was refused but not what to fix.
        # --redact keeps the secret itself out of terminal scrollback — the
        # location is what a fix needs, and the value has to be rotated anyway.
        # --diff-merges=first-parent: `gitleaks git` runs `git log -p`, which shows
        # NO diff for a merge commit by default, so a secret introduced during a
        # conflict resolution (present in neither parent, only the merge tree) is
        # scanned by nothing. The first-parent diff of each merge surfaces exactly
        # that content; non-merges are unaffected (found on re-review 2026-08-06).
        if ! "$gl" git "$root" --no-banner --redact -v --exit-code 1 \
                "${cfg[@]}" --log-opts="$range --diff-merges=first-parent" >&2; then
            blocked_creds=1
        fi
    done <<< "$refs"

    if [ "$blocked_creds" -ne 0 ]; then
        echo "" >&2
        echo "romp pre-push: BLOCKED — gitleaks found a credential in a pushed commit." >&2
        echo "  Treat it as compromised the moment it exists in a commit: ROTATE it, then remove it." >&2
        echo "  Removing it in a NEW commit is not enough — the old commit still carries it." >&2
        echo "  A false positive belongs in .gitleaks.toml, narrowly, with a reason." >&2
    fi
}

scan_identifiers
scan_credentials

if [ "$blocked_ids" -ne 0 ] || [ "$blocked_creds" -ne 0 ]; then
    echo "  To bypass for one push (you are sure it is fine): git push --no-verify" >&2
    exit 1
fi
exit 0
