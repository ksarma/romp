        # of ZERO bytes is empty content only when the blob is empty (the
        # header's second class): a cat-file that exits 0 and prints nothing, or
        # an od that fails inside the group (whose status is the drain's), leaves
        # awk a count of zero for a blob with bytes, and the blob passed as
        # empty. The size is read apart (cat-file -s), and a size that is not
        # zero, or could not be read, refuses the push as unscanned naming both.
        read -r bytes nuls <<< "$counts"
