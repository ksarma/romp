                    unscanned "the CHANGED PATHS of commit ${rev:0:10} were listed short for the BINARY VERDICT check (git diff-tree --raw -c exited 0 and its listing lacks $path, a path the merge's combined patch printed a section for)"
                else
                    unscanned "the CHANGED PATHS of commit ${rev:0:10} were listed short for the BINARY VERDICT check (git diff-tree --raw exited 0 and its listing lacks $path, a path git diff-tree --numstat answered for)"
                fi
            fi
