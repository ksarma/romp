                rc=0; numstat_rows "$scratch/rows3" --no-renames "$empty_tree" "$rev" -- "${tpaths[@]}" || rc=$?
                [ "$rc" -eq 0 ] || { numstat_ok=0; unscanned "the BINARY VERDICTS of commit ${rev:0:10} could not be read (git diff-tree --numstat against the empty tree exited $rc)"; }
            fi
        fi
        rc=0; as_lines "$scratch/post" "$scratch/gone" "$scratch/rows" "$scratch/rows2" "$scratch/links" "$scratch/tpaths" "$scratch/rows3" "$scratch/listed" || rc=$?
        if [ "$rc" -eq 1 ]; then
            unscanned "a path commit ${rev:0:10} changes holds a newline, which the BINARY VERDICT check cannot judge"
            continue
        elif [ "$rc" -ne 0 ]; then
            unscanned "the LISTINGS of commit ${rev:0:10} could not be rewritten for the BINARY VERDICT check ($rewrite_failure)"
            continue
        fi
