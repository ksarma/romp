#!/usr/bin/env bash
# romp pre-push hook: refuse to publish a commit that carries a personal
# identifier or a credential.
#
# The repo may go public and history is permanent, so both scans read the
# COMMITS BEING PUSHED (not the working tree). Two scanners, because they catch
# opposite kinds of thing:
#
#   identifiers   strings only YOU can enumerate (names, hostnames, vault
#                 names), read from ~/.config/romp/private-strings.txt: one
#                 banned string per line, `#` comments and blank lines ignored,
#                 matched case-insensitively. With no such file the scan stays
#                 out of your way, so on a clone that never set one up (any
#                 contributor's machine) it is a no-op.
#   credentials   strings NOBODY can enumerate in advance (a token's text is
#                 unknown until it leaks), matched by gitleaks' rules, tuned by
#                 the repo's .gitleaks.toml. With no gitleaks binary the scan
#                 prints a notice and stands down; CI runs the same scan over
#                 the full history, so nothing goes unscanned for long.
#
# The identifier scan makes four checks per pushed ref, all about what THIS
# push changes on the remote:
#
#   the tip's tree    the content the push exposes. A banned string anywhere in
#                     it, in a regular file or a symlink's target, refuses the
#                     push.
#   each new commit   the lines it ADDS: against its parent, or for a merge the
#                     lines in none of its parents. A string introduced in an
#                     intermediate commit and removed by a later one is still
#                     caught, and the commit named; a commit whose tree merely
#                     INHERITS a string an older commit put there is not, and
#                     neither is a merge that brought one in from a parent the
#                     remote already has. Every commit on every branch cut from
#                     main between a string landing there and its redaction
#                     inherits it that way, and a per-commit TREE scan refuses
#                     them all, over files the branch never touched, when the
#                     only exposure any of them could add is its tip.
#   each new commit   the ADDRESSES it is authored and committed under: the part
#                     after the @, grepped like a line of content. A commit is
#                     published with its metadata, and the two checks above read
#                     none of it. A clone with no user.email set in any scope has
#                     git stamp <login>@<hostname -f> on every commit it makes,
#                     and a machine's name and its domain suffix are exactly the
#                     strings a denylist holds: such an address rode a branch's
#                     commits and a pushed merge through both content checks and
#                     gitleaks (2026-09-09). The domain only: the login and the
#                     names are the author's own, on the denylist too (a FILE
#                     must not carry them) and on every commit they make. And
#                     only for an address the clone is NOT configured to publish
#                     under (user.email in any scope, or GIT_AUTHOR_EMAIL,
#                     GIT_COMMITTER_EMAIL or EMAIL in the environment): the
#                     chosen address is the author's to publish whatever it says,
#                     and its domain may well be their own name. An unset
#                     user.email chooses nothing, which is the case this check
#                     is for.
#   each new commit   its MESSAGE, subject and body, grepped like lines of
#                     content. Metadata too, and the place a commit describing a
#                     fix names the path that failed or the machine it failed
#                     on. A string a FILE carries has a forward remedy once it
#                     is out (redact it in a later commit, push); a string a
#                     message carries has none, only a rewrite of the commit
#                     takes it back, so the push is the last check before it is
#                     out for good. The whole denylist, the author's own name
#                     included: the message is text they typed, and a file
#                     naming them is refused on the same ground. Only what THIS
#                     push publishes, like the other per-commit checks: a message
#                     a remote already holds is refused to no purpose.
#   an annotated tag  its OWN tagger and message, under the two checks above.
#                     Every other read here peels a tag to the commit it names
#                     (git grep, rev-list and log take a tag as that commit), so
#                     the tag object's metadata was read by nothing, and a
#                     `git push --tags` from a clone with no user.email stamps
#                     the tagger the way it stamps a committer. The tag object
#                     is read whenever its ref is pushed: a remote holding it at
#                     this sha would not be updating the ref, and one holding it
#                     at another sha is receiving a new object. A tag of a tag
#                     is peeled one object at a time.
#
# A read the hook cannot COMPLETE is not an empty result. The tip's content scan,
# its symlink listing, each link's target, an object's type, a tag's fields and
# each new commit's parent count, added lines, addresses and message are git
# reads whose output the checks above grep, and a read that FAILED (git's
# status, or an error line) leaves the push part-scanned: what went unread may
# be exactly the string the scan exists for. Each such read reports one line
# naming the ref or the commit and the read, and refuses the push as unscanned,
# as a gitleaks that cannot scan does; an ABSENT value (a tag with no message, a
# tree with no links, a commit whose diff or message is empty) reads as empty
# and passes. Found by execution (2026-09-20), one read at a time, each letting
# a dirty tip, tag or commit through a real push with nothing printed but git's
# own error line where it printed one; the per-commit diff failed that way with
# the real git once the added file's blob was gone from the store.
# Two classes of fail-open are closed that way, and the guarantee is stated per
# class. The STATUS-KEYED class: a read whose failure returns a non-zero status
# (or prints an error line), refused as above on every read the hook makes.
# The EXIT-0 EMPTY-OR-SHORT-ANSWER class: a read that exits 0 with an empty or
# a short answer the check would read as "nothing to judge" (a listing with no
# entry, a rewrite with no bytes, a count of zero). It has no status to read,
# so it is closed by a second read already in hand that the answer must agree
# with, and a disagreement refuses the push as unscanned, naming the read and
# both answers. The reads gated that way, all in the binary-verdict check
# (refuse_hidden_paths): the numstats and the combined patch against the paths
# a commit changes (round 3: a post-image no verdict answers for is a short
# read); check-attr's answer against the path asked; the per-commit
# changed-path listing against the paths its verdicts name; each scratch
# listing's rewrite against its input's bytes (as_lines); the tip's listing
# against the symlink pass's listing of the same tree and the grep's read
# list; and the byte judge's count against the blob's size. The content reads
# themselves (the tip's grep, the added-lines diff, the address and message
# logs, a tag's fields) have empty answers that are the object's own (a clean
# tree, a commit adding no line, a tag with no message) and no second read to
# check them against: those pass as absent, as the paragraph above says, and a
# git that exits 0 while printing nothing there is outside this guarantee.
#
# Both content checks read what git calls TEXT: the tip's grep skips a blob
# git calls binary (-I), and the per-commit diff prints no line for one. git
# calls a blob binary by its bytes (a NUL in the first 8000), by its PATH's
# diff attribute (a `-diff` line or the `binary` macro, in .gitattributes,
# .git/info/attributes or the file core.attributesFile names, or a diff driver
# whose diff.<driver>.binary is true), by its SIZE (a blob over
# core.bigFileThreshold, in the diff and not in the grep), and by whatever rule
# a later git adds. A text file git calls binary is read by neither check, and
# real pushes published a banned string in one under a -diff attribute, in
# one over the size key, in a symlink's target over the size key and in a
# merge's own symlink target under a -diff attribute, the denylist armed and
# nothing printed (2026-09-21).
# The hook keeps no such list: it reads GIT'S OWN VERDICT from the read each
# half makes (refuse_hidden_paths, the rule refuse_replace_refs set: refuse
# rather than scan). For the tip, the same git grep -I, asked to list the
# non-empty files it READ (-l with an empty pattern): a regular file of the
# tip's tree that it did not list is one it skipped (a symlink's target is
# read by the symlink pass, by cat-file, whatever any key says). For each new
# commit, the verdict of the read the scan makes, for every post-image whose
# object is a BLOB, a regular file or a symlink (a gitlink is a commit; a
# symlink's target is a blob under the size key like any other, and a real
# push published a banned string in one over the key, added in a middle
# commit, 2026-09-21), less one whose blob the TIP's tree holds under any
# path: that blob is the tip half's to judge, read by its grep or its symlink
# pass or refused as hidden there, so the per-commit road reaches only
# content absent from the tip (a clean big text file added at the tip under
# the size key was refused on the commit line while the tip's grep had read
# it, and a hit at the tip carried a second, commit-level line for the same
# bytes; the round 3 auditors, 2026-09-21). For a commit with ONE parent, git
# diff-tree --numstat over the pair the per-commit diff reads (-M): a
# post-image git reports as binary (a dash for each count) is one the diff
# printed no hunk for: the diff's Binary line and the numstat's dashes agree
# on every blob with bytes, and an empty blob passes either way (an empty
# blob under such a rule is the one pair the numstat calls binary while the
# diff prints its header alone; it is a candidate here and passes as empty
# below, the outcome the diff's own). Three changes
# the diff prints otherwise are judged as it prints them: a PURE rename,
# which the diff prints nothing for (the same blob under a new path), as the
# addition of its new path (--numstat --no-renames), the rule the rename
# refusal set, so the explicit diff line the advice names lifts it for the
# new path; a TYPE change (a file replaced by a symlink, or a symlink by a
# file), which the diff prints as a deletion and an addition judged alone
# while the pair's stat is binary when either side is, as the addition of
# its new object (a numstat of the empty tree against the commit's tree for
# that path); and a MODE-ONLY change (the same blob under a new mode), which
# the diff prints as its mode lines with no hunk and no Binary line while the
# pair's stat calls an unchanged blob binary when it is over the size key or
# holds a NUL (a dash for each count either way), not at all:
# nothing new reaches the remote, and the blob was judged where it was added.
# For a MERGE, the combined patch itself (git diff-tree -p -c, the read the
# scan makes for one, read again and parsed section by section), since it
# judges by a rule of its own that no verdict against each parent
# reproduces: it applies no size rule, and it applies a path's diff attribute
# to a symlink as the pairwise diff does not. A path whose section prints
# "Binary files differ" is one the patch printed no hunk for; a path it
# prints a hunk for was read; a path it prints nothing for whose blob some
# parent holds under a path the merge lacks is a pure rename (the patch
# prints nothing for a path -M pairs with an identical blob in every
# parent), judged as the addition of its new path as a one-parent commit's
# is, the candidates read from the merge's deletions against EACH parent:
# the combined listing names a deletion only when every parent held the
# path, so content two parents held under two paths, moved to a third with
# both gone, met no candidate and was refused as unscanned (the round 3
# auditor, 2026-09-22); a path whose section is the header
# alone (an added empty file prints its header, no hunk and no Binary line)
# and that is no rename is a candidate like a Binary one, judged by its bytes
# below, where an empty blob passes (an evil merge adding an empty file, gone
# at the tip, was refused as unscanned for that header; the round 3 auditor,
# 2026-09-22) and a non-empty blob would be refused as hidden, an arm no
# shape found reaches, since a header-only section for a blob with bytes is
# a mode change over content some parent holds, at the path (set aside as
# unchanged) or under another (a rename candidate); a path with no section
# at all that is no rename is a short read, refused as unscanned (a per-parent
# listing that answered short leaves such a path there too, the safe side).
# Judged against each parent
# instead, a merge's own symlink at a path under a -diff attribute, the
# string in its target, gone at the tip, was PUBLISHED by a real push (the
# patch hid it, the pairwise verdicts did not), and a big text file the
# merge resolved was refused as hidden while the patch had printed its hunk
# (the round 3 auditors, 2026-09-21). The scope of the derivation is the
# scope of the reads themselves: a rule that hides a blob from the grep or
# the diff hides it from the grep or diff the derivation asks too, so a key
# found tomorrow is covered today, and a rule that reaches one half and not
# the other (the size key, which the grep ignores) refuses in that half
# alone. Each blob so named is then
# judged by git's byte rule with no diff machinery (cat-file): a NUL in the
# first 8000 bytes is binary, and passes as binaries always have, so a
# repository marking its images binary is not refused; an empty blob hides
# nothing; anything else is text the scan could not see, named with the tip
# or the commit, and the push is refused rather than scanned. The line quotes
# the path's diff attribute (one check-attr per refused path, for the report
# and never for the decision: `set` and `unspecified` are check-attr's reserved
# words and also names a driver may take, and a verdict read from the value
# missed a driver so named) and, where no attribute accounts for the verdict,
# the blob's size and the clone's core.bigFileThreshold, as facts a reader
# needs and not as a cause, or, for a changed file, the previous version's
# bytes (in a one-parent commit's parent, at the path the diff read it from
# when it read the change as a rename; in any parent of a merge, for a path
# whose combined section printed Binary; never for a type change or a rename
# candidate, judged by the addition of the new object alone) where a NUL
# among them is the cause, key or no
# key (either side binary makes the pair binary), the two facts kept beside
# that cause where the key is set and the key's advice not printed for it,
# since raising the key lifts nothing there (with the key set the line named
# the key's facts and the key's remedy while the certain cause went unnamed;
# the round 3 auditor, 2026-09-22); an explicit `diff` attribute outranks
# the key in every read, so the
# remedy the advice names works for it too. Reading such a file from the
# objects instead of refusing is the longer fix, not this one. One shape
# refused that way is disclosed here with its remedy: a one-parent commit
# that turns a file binary by its bytes into a TEXT file. The diff prints
# "Binary files differ" for the pair (either side binary makes the pair
# binary), so the new text was read by neither check and the commit is
# refused as hidden, its line naming the previous version's bytes as the
# cause; a merge whose result is such a text file while a parent's version is
# binary is refused the same way, its line naming that parent's version (the
# combined patch prints Binary for it too), and so is a one-parent commit
# that renames the file in the same change, its line naming the path the
# diff read it from. Three commits in this repository's own history have that shape (a
# source file that once held a raw NUL byte, replaced by a text version): a
# clone that has fetched any remote excludes them from every range, and a
# clone with no remote-tracking refs pushing the history as a new ref is
# refused on them, so the remedy is to fetch first, or to push from a clone
# that has (found by the round 3 fixer's whole-history run, 2026-09-22).
# The check's NUL-delimited listings live in a scratch directory under TMPDIR
# (mktemp -d, prefix romp-pre-push.), removed by its exact minted path when the
# identifier scan ends: a hard kill between the minting and the removal leaves
# it behind, bounded by its living under TMPDIR with that prefix, so a reader
# can find and remove it. The listings are joined line by line, so a path
# holding a newline byte (legal to git, seen nowhere) refuses the push as
# unscanned rather than be judged by nothing.
#
# The credential scan reads the same new commits, each merge by its
# first-parent diff, and refuses the push on a hit. A range this clone cannot
# resolve (a force-push over a remote tip nobody fetched) sends both scans over
# everything the pushed tip reaches. That scan has one read of its own INSIDE
# gitleaks, whose exit status does not carry it: gitleaks runs `git log -p`
# itself, and any stderr line from that git it does not allowlist (the
# rename-detection warnings, the auto-gc notice) makes it log the line at its
# ERR level, drop the rest of the scan, report the commits it did read, say no
# leaks were found and exit 0, whether or not git failed. So exit 0 is read as
# "no finding reported", never as "scanned": the hook reads gitleaks' log, and
# refuses the push as unscanned on any ERR line, and separately when the commit
# count gitleaks reports is not the hook's own count of the commits with content
# to scan. Two conditions, because either alone has a hole: a log that came up
# short writes no ERR line, and a discarded scan can still report the whole
# count. Found by execution (2026-09-21): a git that wrote one benign line to
# stderr, and one that handed gitleaks a commit fewer, each let two live
# credentials through a real push with nothing printed, on a clone with the
# denylist armed. The hook's count is derived from the OBJECTS (rev-list,
# diff-tree --raw, cat-file; scannable_commits), never from the patch stream
# gitleaks reads: a count read from that same stream agreed with the scan under
# every transform of the stream, since a transform empties both alike. Six were
# found in two rounds (2026-09-21): colour (color.ui or color.diff set to
# always), a textconv driver and a -diff attribute named in .gitattributes, each
# of which published a credential with the hook reporting clean; and
# format.pretty, log.date and log.showSignature, which refused clean pushes.
# gitleaks' git is asked for a plain stream (the options in gitleaks_args, each
# outranking the config key it neutralises) so a clean push agrees. log.showRoot
# set to false (it hides a root commit's diff from git log -p) is neutralised
# the same way, by --root on the scanner's log, the shape --pretty and --date
# take: the option outranks the key in every scope and travels on the scanner's
# command line, so a scanner git that does not inherit the hook's environment
# still reads it. A scanner whose git does not honour that option, or any other
# count that comes up short, refuses on the count as before; when the short
# count meets the key false in the clone's configuration and a root commit in
# the range, the refusal states those two facts and names the key as a
# CANDIDATE cause, with the key's remedy for that case: a scanner git that did
# not honour the option would have the root's diff hidden by the key, and a log
# shortened for any other reason meets the same two facts, so the line asserts
# neither that the option went unhonoured nor that setting the key lifts the
# refusal. The two halves differ in kind: the credential half's own count is
# derived from the objects and no configuration touches it, while the
# identifier half reads a log and diff stream and is config-dependent by
# construction, as the scanner inside the credential half is. What can hide a
# blob from its two content reads is closed by a derived property rather than
# key by key (refuse_hidden_paths: git's own verdict against the blob's bytes,
# which covers the diff attribute and core.bigFileThreshold today and a key
# found tomorrow the same day, in a one-parent commit's diff and in a merge's
# combined patch alike); the scanner's log is hardened key by key as
# keys are found (log.showRoot, by --root on the scanner's log; another key
# another day), and so are the identifier half's other reads (colour on its
# grep, the signature report on its log, each by the option that outranks the
# key). Reading the identifier half's input from the objects is the long fix,
# not taken in this fold.
#
# Both scans read the objects at the pushed shas, on the premise that what they
# read is what the push transfers. A replace ref (git replace) breaks it: every
# read follows the substitute while the push transfers the original, and a real
# push published a banned string and a credential at the pushed sha with both
# scans reading clean (2026-09-21). So every git the hook runs, gitleaks' own
# included, runs with replacement OFF (GIT_NO_REPLACE_OBJECTS), and a clone that
# carries any replace ref at all is refused before either scan
# (refuse_replace_refs): a scan under replacement cannot vouch for the bytes
# pushed. Only where a scan would otherwise run, though: the refusal exists
# because a replace ref makes the scanned bytes diverge from the transferred
# bytes, so a CLEAN REPORT would be false; where no scan runs (no denylist
# file, and gitleaks skipped or absent) there is no report and nothing false to
# prevent, and a clone that never asked for either scan is unaffected, as
# CLAUDE.md promises. The two arming tests (identifier_scan_armed,
# credential_scan_armed) are the ones the scans' own early returns read, so the
# gate and the scans agree on whether a scan is ARMED. The gate is per clone,
# not per ref: a push a scan would read nothing of (a deletion of a remote ref
# alone, which both scans skip before reading a byte; a denylist holding only
# comments, which arms a scan that greps for nothing) is refused under a
# replace ref too, the safe side, and moving the gate into the two per-ref
# loops would refuse twice.
#
# Why pushed commits rather than a working-tree scan: the hook is symlinked into
# the SHARED git hooks dir (by install.sh), so it fires from every worktree —
# but a working-tree scan is only as good as the tree you happen to push from,
# and an untracked scanner script exists in only one worktree. Reading the
# denylist from $HOME and reading the pushed shas arms every worktree equally.
#
# Env: ROMP_PRIVATE_STRINGS (denylist path), ROMP_GITLEAKS (scanner binary),
# ROMP_NO_GITLEAKS=1 (skip the credential scan and its notice).
# Bypass a false positive from either scan with `git push --no-verify`.
set -euo pipefail
# Replacement off for every git below, gitleaks' own included (the header's
# premise): the scans read the objects the push transfers, never a substitute.
export GIT_NO_REPLACE_OBJECTS=1
# The value this clone's configuration gives log.showRoot, for the refusal arm
# in scan_credentials (the header): a plain read, so the arm can name the key
# when a short count meets it false. The key itself is neutralised on the
# scanner's command line (--root, in gitleaks_args), not here: beyond the
# replacement switch above, the hook sets nothing for the gits it runs.
showroot_configured=$(git config --type=bool log.showRoot 2>/dev/null || true)

# git feeds the ref list on stdin and both scans need it, so read it once.
refs="$(cat)"
zero=0000000000000000000000000000000000000000
blocked_ids=0
blocked_addresses=0     # a subset of blocked_ids, with a remedy of its own
blocked_messages=0      # likewise a subset of blocked_ids, with a remedy of its own
blocked_tags=0          # an annotated tag's own tagger or message: one of the two above, with a remedy of its own
blocked_creds=0
failed_scan=0           # a read or scan that could not complete: refused as unscanned (unscanned, the gitleaks arm)
failed_creds=0          # a subset of failed_scan: gitleaks itself could not scan, with advice of its own
hidden_paths=0          # a subset of failed_scan: git calls a text file binary and the identifier scan skipped it, with a remedy of its own
hidden_unnamed=0        # a subset of hidden_paths: no diff attribute accounts for the verdict, so the advice names the configuration key too
hidden_prior=0          # a subset of hidden_paths: a changed file whose previous version (in the commit's parent, at the path a rename came from, or in any parent of a merge) is binary by its bytes, with the fetch remedy
scratch=""              # a directory for the NUL-delimited listings the binary-verdict check reads (refuse_hidden_paths); made on first use, removed by scan_identifiers
rewrite_failure=""      # as_lines' report when it returns 2: the tool that failed and its status, for the caller's unscanned line

# The commits THIS push publishes for one ref: what no remote already has.
# "Already has" means reachable from the remote ref's current value or from ANY
# remote-tracking ref this clone holds (refs/remotes/*, as last fetched) — every
# remote's, not only the pushed-to remote's or the ref being pushed. The
# difference from the ref's plain update range is a branch that merged main: its
# range holds main's commits, every one of them published already through main.
# Scanning those refuses the push over a string that main itself published, and a
# string already on a remote is fixed FORWARD, on main (redact, push main) — not
# by blocking every branch that merged main before the redaction. Every remote
# counts because that remedy exists only for a commit no remote has yet: in a
# clone with a fork and the project it forked from, a clean branch cut from the
# project's main is pushed to the fork as a new ref, and an exclusion scoped to
# the fork left the project's own commits in the range — one named as adding a
# string the project had since redacted, which no rewrite of the branch could
# fix (the #968 review). With no remote-tracking refs at all (never fetched) the
# exclusion matches nothing and the range falls back to everything the remote
# ref lacks — for a new ref, the whole history.
rev_range() {   # <local_sha> <remote_sha> → a rev-list argument list
    local args="$1 --not --remotes"
    [ "$2" = "$zero" ] || args="$args $2"
    printf '%s' "$args"
}

# The lines a commit adds, one per line as "<path>\t<text>". A commit with one
# parent: its diff against that parent (a root commit, against the empty tree).
# A merge: the combined diff against ALL its parents (-c), keeping only the lines
# in NONE of them — a conflict resolution, a line typed into the merge — which is
# what the merge itself adds. A diff against the first parent alone named a merge
# of main, taken while main carried a string, as adding it: the content came in
# through the second parent, which the remote already had, and the branch's tip
# was clean (the #968 review). In a combined diff every content line carries one
# column per parent, and a line in no parent has a `+` in each; -c also omits a
# file that matches any parent outright, which holds no such line. -M keeps a
# rename from re-adding every line of the file. A new symlink shows up here too:
# a link's target is its blob content, so it is an added line. The path comes
# from the `+++ b/<path>` header, read only between a `diff --git` or
# `diff --combined` line and the first hunk: inside a hunk, a line that begins
# with `+++ ` is added content (`++ b/x` as written) and belongs to the current
# file. Two reads, made apart by the caller so a refusal can name the one that
# failed: the parent count (parent_count; rev-list's status through pipefail; a
# failure there leaves n empty, which awk reads as 1, and a merge's combined
# diff is read in one column: over-scan, but a read that failed all the same)
# and the diff (added_lines, whose status is the diff-tree's through pipefail).
parent_count() {   # <rev>
    git rev-list --parents -n 1 "$1" | awk '{ print NF - 1 }'
}
added_lines() {   # <rev> <parent count>
    git diff-tree -p -r -M -c --root --no-commit-id --no-color "$1" | awk -v n="$2" '
        BEGIN { if (n < 1) n = 1; for (i = 0; i < n; i++) plus = plus "+" }
        /^diff --(git|combined) /        { hdr = 1; next }
        hdr && /^\+\+\+ b\//             { f = substr($0, 7); next }
        hdr && /^\+\+\+ /                { f = $0; next }
        /^@@/                            { hdr = 0; next }
        !hdr && substr($0, 1, n) == plus { print f "\t" substr($0, n + 1) }'
}

# The addresses this clone publishes under BY CHOICE: user.email from any config
# scope (an includeIf's included, as git resolves it for this repository) and the
# environment's overrides, one per line. An unset user.email contributes nothing,
# so on a clone that never set one every stamped address is checked. Blank lines
# are harmless: a non-empty address never matches one whole.
chosen_emails() {
    git config --get-all user.email 2>/dev/null || true
    printf '%s\n' "${GIT_AUTHOR_EMAIL:-}" "${GIT_COMMITTER_EMAIL:-}" "${EMAIL:-}"
}

# Whether an address is one this clone chose: matched whole, case-insensitively.
is_chosen() {   # <address> <chosen addresses, one per line>
    printf '%s\n' "$2" | grep -qixF -e "$1"
}

# The addresses a commit is stamped with that this clone did not choose, one
# line per role as "<role>\t<address>", authored and committed, whether or not
# the two addresses are the same. An empty address is skipped (there is nothing
# to publish in `<>`), and so is a chosen one.
#
# --no-show-signature here and on the message read below: with log.showSignature
# set, git log prints a signed commit's verification report (the signer's name
# or address among it) ahead of whatever the format asks for. Read as part of the
# message, that refused a clean signed commit whose signer is on the denylist,
# as the author's own name and address are, and numbered a real hit's line from
# the report's first line rather than the subject. The flag keeps both reads to
# the commit's own fields.
#
# The log is captured before the loop, so the function's status is the log's:
# piped into the loop, a log that failed was a commit stamped with no address.
stamped_addresses() {   # <rev> <chosen addresses, one per line>
    local role email stamped
    stamped=$(git log -1 --no-show-signature --format='authored%x09%ae%ncommitted%x09%ce' "$1") || return $?
    while IFS=$'\t' read -r role email; do
        [ -n "$email" ] || continue
        is_chosen "$email" "$2" && continue
        printf '%s\t%s\n' "$role" "$email"
    done <<< "$stamped"
}

# One header field of an annotated tag object (`tagger`, `object`), or its
# message: the header ends at the first empty line and the message is the rest
# (a signed tag's signature included; it is text like any other). awk reads the
# whole object before either function prints.
tag_field() {   # <tag_sha> <field>
    git cat-file -p "$1" | awk -v f="$2" 'BEGIN { hdr = 1 }
        hdr && !NF { hdr = 0; next }
        hdr && !seen && $1 == f { seen = 1; sub(/^[^ ]+ /, ""); print }'
}
tag_message() {   # <tag_sha>
    git cat-file -p "$1" | awk 'BEGIN { hdr = 1 } hdr && !NF { hdr = 0; next } !hdr { print }'
}

# A read that FAILED (git's status, or an error it printed; an absent field or an
# empty tree prints nothing and exits 0): the push is then only part-scanned, and
# what went unread may be exactly the string the scan exists for. Report it and
# refuse the push as unscanned, the road the credential scan takes when gitleaks
# cannot run. Found by execution (2026-09-20), with each such read counted as
# empty instead: a `cat-file -p` that failed while `cat-file -t` still said tag
# published a tag whose tagger domain was on the denylist; a git grep exiting 2,
# an ls-tree that failed after listing the link, a link blob that would not read
# and a failed type read each published a tip that inherited main's leak; nothing
# printed, every counter at zero. A per-commit diff-tree or log that failed (a
# shim; the diff-tree with the real git too, the added file's blob gone from the
# store) published a commit that added a banned line, one authored under a banned
# domain and one whose message named a banned host, git's own error line the only
# sign: piped into the grep or the loop that judged it, the read's failure was a
# no-match. Each caller says what could not be read; the tail and the counter are
# the same for all. The credential scan's read inside gitleaks is judged the same
# way, from gitleaks' own log (scan_credentials).
unscanned() {   # <what could not be read, as a clause>
    echo "romp pre-push: $1; the scan is incomplete, so the push is refused" >&2
    failed_scan=1
}
tag_unread() {   # <local_ref> <tag_sha> <FIELD> [<consequence>]
    unscanned "the $3 of tag $1 (${2:0:10}) could not be read${4:+, $4}"
}
# The TYPE read decides whether there is a tag to scan at all, on the pushed
# object and on each one the peel reaches; read as "not a tag" when it failed, it
# left the tag unpeeled and unscanned. A branch is pushed through this read too,
# so the line names the object the ref pushes, not "the tag".
type_unread() {   # <local_ref> <sha>
    unscanned "the TYPE of the object $1 pushes (${2:0:10}) could not be read, so whether it is an annotated tag is unknown"
}
# Whether each scan WOULD run: the identifier scan when the denylist file exists
# (ROMP_PRIVATE_STRINGS, else the XDG default), the credential scan when it is
# not skipped (ROMP_NO_GITLEAKS) and a gitleaks binary resolves and is
# executable (ROMP_GITLEAKS, else the first on PATH). Each scan's own early
# return reads its predicate, and so does refuse_replace_refs, so the gate and
# the scans agree on whether a scan is armed; the gate is per clone (its own
# note). The predicates decide only whether a scan runs: an empty denylist arms
# a scan that greps for nothing, and a skipped or absent scanner keeps its
# silence or its notice in scan_credentials. Each is called as a condition (an
# `if`, an `||`), where set -e does not act on it.
private_strings_file() {
    printf '%s' "${ROMP_PRIVATE_STRINGS:-${XDG_CONFIG_HOME:-$HOME/.config}/romp/private-strings.txt}"
}
identifier_scan_armed() {
    [ -f "$(private_strings_file)" ]
}
gitleaks_binary() {   # the scanner's path when one resolves and is executable; nothing otherwise, status 0 either way
    local gl
    gl="${ROMP_GITLEAKS:-$(command -v gitleaks || true)}"
    if [ -n "$gl" ] && [ -x "$gl" ]; then printf '%s' "$gl"; fi
}
credential_scan_armed() {
    [ -z "${ROMP_NO_GITLEAKS:-}" ] && [ -n "$(gitleaks_binary)" ]
}

# A clone that carries a replace ref is refused before either scan runs (the
# header's premise): under a replacement, what a scan reads and what the push
# transfers can differ, and the push is refused rather than scanned. Only where
# a scan would otherwise run: the refusal exists because a replace ref makes
# the scanned bytes diverge from the transferred bytes, so a CLEAN REPORT would
# be false; where neither scan runs there is no report and nothing false to
# prevent, and a clone that never asked for either scan is unaffected (the
# header). The gate is per CLONE: armed on the two predicates alone, read once
# ahead of the per-ref loops, and refusing on any replace ref the clone holds,
# whether or not the replaced object is in the push. So a push a scan would
# read nothing of (a deletion of a remote ref alone, which both scans skip
# before reading a byte; a denylist of comments alone, which arms a scan that
# greps for nothing) is refused under a replace ref too. Fail-safe, and left so
# on purpose: the per-ref reads live in two loops, one per scan, and a gate
# inside them would refuse twice and list the refs twice. Each ref is named;
# GIT_REPLACE_REF_BASE moves the namespace git reads, so the same variable says
# where to look. A listing that failed refuses too: whether the reads and the
# push agree is then unknown.
refuse_replace_refs() {
    local rc=0 found ref
    identifier_scan_armed || credential_scan_armed || return 0
    found=$(git for-each-ref --format='%(refname)' "${GIT_REPLACE_REF_BASE:-refs/replace/}") || rc=$?
    [ "$rc" -eq 0 ] || unscanned "the REPLACE REFS of this clone could not be listed (git for-each-ref exited $rc), so whether the scans read what the push transfers is unknown"
    [ -n "$found" ] || return 0
    while IFS= read -r ref; do
        echo "romp pre-push: this clone carries a replace ref ($ref): under it what a scan reads and what the push transfers can differ, so the push is refused rather than scanned" >&2
    done <<< "$found"
    echo "  Delete it (git replace -d <object>) and push again, or push from a clone that carries none." >&2
    failed_scan=1
}

# The scratch listings are NUL-delimited (a path may hold any byte but NUL and
# the slash); the joins in refuse_hidden_paths read them line by line, so each
# is first checked to hold no newline byte, then rewritten with a newline for
# each NUL. A path with a newline (legal to git, seen nowhere) fails the check,
# and the caller refuses the push as unscanned rather than judge it by nothing.
# Each test and each rewrite reads its own status: a tr that failed on one file
# and ran on the next would otherwise hand a join an empty rewrite with no
# status to read (the tip judging nothing; a commit passing unjudged), the
# function's status being its LAST file's alone, and the newline count read a
# failed pipeline as zero. A tool that failed is status 2, apart from the
# newline case, with the tool and its status in rewrite_failure for the
# caller's line (the count's pipeline status is the failing stage's, pipefail).
# Each ANSWER is read as well as each status (the header's second class): a tr
# that exits 0 and writes nothing, or too little, would hand a join an empty
# or truncated rewrite under a clean status, so the rewrite's byte count is
# compared with its input's (wc -c on each; a newline for each NUL keeps the
# count), and every count, the newline count first, must be a run of digits
# before any arithmetic reads it, since bash reads an empty operand as zero,
# the count of a clean file (a wc answering nothing passed the newline test).
# A count that is not a number, or a rewrite whose count differs from its
# input's, is status 2 with the rewrite and both raw answers in
# rewrite_failure.
as_lines() {   # <file>...: rewrites each as <file>.nl; status 1 when one holds a newline, 2 when a test, a rewrite or a count failed or answered short (rewrite_failure says which)
    local f n a b rc
    for f in "$@"; do
        rc=0; n=$(tr -cd '\n' < "$f" | wc -c) || rc=$?
        [ "$rc" -eq 0 ] || { rewrite_failure="the newline test's tr or wc exited $rc"; return 2; }
        case "${n//[[:space:]]/}" in ''|*[!0-9]*) rewrite_failure="the newline test's wc answered \"$n\" for ${f##*/}, not a count"; return 2 ;; esac
        [ "${n//[[:space:]]/}" -eq 0 ] || return 1
        rc=0; tr '\0' '\n' < "$f" > "$f.nl" || rc=$?
        [ "$rc" -eq 0 ] || { rewrite_failure="tr exited $rc"; return 2; }
        rc=0; a=$(wc -c < "$f") || rc=$?
        [ "$rc" -eq 0 ] || { rewrite_failure="the byte count's wc exited $rc for ${f##*/}"; return 2; }
        rc=0; b=$(wc -c < "$f.nl") || rc=$?
        [ "$rc" -eq 0 ] || { rewrite_failure="the byte count's wc exited $rc for the rewrite of ${f##*/}"; return 2; }
        case "${a//[[:space:]]/}" in ''|*[!0-9]*) rewrite_failure="the byte count's wc answered \"$a\" for ${f##*/}, not a count"; return 2 ;; esac
        case "${b//[[:space:]]/}" in ''|*[!0-9]*) rewrite_failure="the byte count's wc answered \"$b\" for the rewrite of ${f##*/}, not a count"; return 2 ;; esac
        [ "${a//[[:space:]]/}" -eq "${b//[[:space:]]/}" ] || { rewrite_failure="the rewrite of ${f##*/} wrote ${b//[[:space:]]/} bytes for ${a//[[:space:]]/} read; tr exited 0"; return 2; }
    done
}

# One numstat, as NUL-delimited rows "<b or t><r or .>\t<path>": b for a
# dash in each count (git's word that it printed no hunk: binary), t
# otherwise; r when the row was a rename (its old and new path follow the
# counts as two more records; the new path is the one kept). The arguments
# after the output file are diff-tree's: -M --root <rev> for a one-parent
# commit against its parent, or two trees and a pathspec. The status is
# git's.
numstat_rows() {   # <out> <diff-tree arguments...>
    local out=$1 rc=0 row name kind
    shift
    git diff-tree -r --numstat -z --no-commit-id "$@" > "$out.raw" || rc=$?
    : > "$out"
    while IFS= read -r -d '' row; do
        name=${row#*$'\t'*$'\t'}; kind=.
        if [ -z "$name" ]; then IFS= read -r -d '' _ || true; IFS= read -r -d '' name || name=""; kind=r; fi
        case "$row" in -$'\t'-$'\t'*) printf 'b%s\t%s\0' "$kind" "$name" ;; *) printf 't%s\t%s\0' "$kind" "$name" ;; esac >> "$out"
    done < "$out.raw"
    return "$rc"
}

# A merge's combined patch (the file given: diff-tree -p -c, the read the scan
# makes for a merge, captured by the caller with its status), as NUL-delimited
# rows "<b, t or e>.\t<path>", one per section: a `diff --combined` header and
# what follows it to the next header. b for a "Binary files differ" line
# (git's word that it printed no hunk), t for a hunk (an @@ line), e for a
# header alone (an added empty file, which has no hunk; a mode change over
# content some parent had at the path, set aside as unchanged before the
# join, or under another, a rename candidate there). A line inside a hunk
# begins with one column per parent (a space, a plus or a minus), so a
# header, a Binary line or a hunk line is
# never mistaken for content, and the Binary line is read in the header
# alone, as added_lines reads the +++ line. The header's path is unquoted as
# git quotes it: a path with a byte git escapes (a quote, a backslash, a
# control character; any byte over 127 unless core.quotePath is false) is
# printed in double quotes with C escapes, and a plain one bare, so a plain
# path is taken whole (a leading or trailing space included) and a quoted one
# has its escapes undone byte by byte. Any other `diff --` header ends a
# section and owns none, so a path under one meets no row and is refused as
# unscanned by the join.
combined_rows() {   # <patch file>
    LC_ALL=C awk '
        BEGIN { esc["a"] = 7; esc["b"] = 8; esc["t"] = 9; esc["n"] = 10; esc["v"] = 11; esc["f"] = 12; esc["r"] = 13 }
        function unquote(s,    out, n, i, c, d, v, k) {
            if (substr(s, 1, 1) != "\"") return s
            out = ""; n = length(s); i = 2
            while (i <= n) {
                c = substr(s, i, 1)
                if (c == "\"") break
                if (c != "\\") { out = out c; i++; continue }
                i++; d = substr(s, i, 1)
                if (d ~ /^[0-7]$/) {
                    v = 0; k = 0
                    while (k < 3 && substr(s, i, 1) ~ /^[0-7]$/) { v = v * 8 + substr(s, i, 1); i++; k++ }
                    out = out sprintf("%c", v); continue
                }
                out = out ((d in esc) ? sprintf("%c", esc[d]) : d)
                i++
            }
            return out
        }
        function flush() { if (path != "") printf "%s.\t%s%c", kind, path, 0; path = "" }
        /^diff --combined / { flush(); path = unquote(substr($0, 17)); kind = "e"; hdr = 1; next }
        /^diff --cc /       { flush(); path = unquote(substr($0, 11)); kind = "e"; hdr = 1; next }
        /^diff --/          { flush(); hdr = 0; next }
        hdr && /^Binary files / { kind = "b"; next }
        /^@@/               { if (hdr && path != "") kind = "t"; hdr = 0; next }
        END { flush() }' "$1"
}

# The blobs the identifier scan's two content reads SKIPPED as binary while
# their bytes are text (the header): judged by git's own verdict from each
# read, never by a rule of the hook's. The tip: the tree's regular files
# (ls-tree -r -z -l; a symlink's target is read whole by the symlink pass, by
# cat-file, whatever any attribute or key says, checked by execution
# 2026-09-21, and a gitlink is no blob) less the non-empty files the same git
# grep -I lists as READ (-l with an empty pattern, under the binary rule the
# content grep applies), the empty ones set aside by their size. Each new
# commit: the post-image BLOBS of its changed-path listing (--raw --no-renames
# -c, so a rename is a deletion and an addition, and a merge lists the paths
# that differ from every parent; every path it names, any status and mode, is
# kept as the population its verdicts below must agree with, the header's
# second class: a path a numstat or the combined patch answers for that the
# listing did not name is a listing that answered short, refused as unscanned
# naming the listing and that path, so an emptied listing cannot pass a
# commit as one that changed nothing): a regular file or a symlink (modes 100644,
# 100755 and 120000; a gitlink, 160000, names a commit, and a tree is no
# post-image), less a MODE-ONLY change, whose post-image blob is every
# pre-image blob (the diff prints its mode lines and no hunk and no Binary
# line, so it hid nothing new, while the pair's stat calls an unchanged blob
# over the size key binary: a mode-only change of such a file was refused for
# it, the round 3 auditor 2026-09-21), and less a blob the TIP's tree holds
# under any path (the same ls-tree, its blob shas kept), which is the tip
# half's to judge: its grep read the blob or skipped it and refused it above,
# or its symlink pass read the target, so the per-commit half judges only
# content absent from the tip (a clean big text file added at the tip under
# the size key was refused on the commit line while the tip's grep had read
# it, the round 3 auditors 2026-09-21); when the tip's own reads failed, the
# push is refused as unscanned above and the per-commit half judges every
# candidate, the safe side of a refusal already made. For a commit with ONE
# parent, those that git diff-tree --numstat reports as binary (a dash for
# each count) over the pair the per-commit diff reads (-M, so a renamed file
# is judged with its old path as the diff judges it): the diff's Binary line
# and the numstat's dashes agree on every blob with bytes, so the decision
# is the diff's own, and an empty blob passes either way (an empty blob
# under such a rule is the one pair the numstat calls binary while the diff
# prints its header alone; it is a candidate here and passes as empty at the
# byte stage, the outcome the diff's own). A pure rename (the new path's
# blob among the commit's deletions) is the one pair the diff prints nothing
# for, and is
# judged as the addition of its new path by a second numstat (--no-renames):
# hidden when the new path hides the blob, the rule the rename refusal set,
# and not when an explicit diff line for the new path keeps it text. A TYPE
# change (status T in a one-parent commit's listing: a file replaced by a
# symlink, or the reverse) is the one pair the diff prints as two, a deletion
# and an addition each judged alone, while the pair's stat is binary when
# either side is: it is judged as the addition of its new object by a third
# numstat, the empty tree against the commit's tree for those paths (each a
# :(literal) pathspec, a name and never a pattern), the read the diff makes
# for the addition; judged by the pair, a binary file replaced by a symlink
# was refused as hidden text the diff had printed in full (found by execution
# 2026-09-21). For a MERGE, the combined patch itself (diff-tree -p -c, the
# read the scan makes for one), read again and parsed section by section
# (combined_rows): its verdict follows no pairwise read, since it applies no
# size rule and applies a path's diff attribute to a symlink, which the
# pairwise diff does not. A section printing "Binary files differ" is a path
# the patch printed no hunk for, a candidate; a section with a hunk was read;
# a path with no hunk and no Binary line (no section at all, or the header
# alone) whose blob some parent holds under a path the merge lacks is a pure
# rename, the one change the patch prints nothing for, judged as the
# addition of its new path by the third numstat, as a one-parent commit's
# is (the candidates are read from the merge's deletions against EACH
# parent, diff-tree --raw -m, since the combined listing names a deletion
# only when every parent held the path, and content two parents held under
# two paths, moved to a third with both gone, is a deletion against each
# parent alone: it met no candidate and was refused as unscanned, the round
# 3 auditor 2026-09-22); such a path that is no
# rename is a candidate when its section is the header alone (an added empty
# file prints its header and no hunk, and the byte stage passes an empty
# blob; a non-empty blob so printed is text the patch printed no hunk for,
# refused as hidden), and a verdict the read owed and did not print when it
# has no section at all, refused as unscanned.
# Judged against each parent, a merge's own symlink under -diff, the string
# in its target, gone at the tip, was published by a real push, and a big
# text file resolved in a merge was refused as hidden while the patch had
# printed its hunk (the round 3 auditors, 2026-09-21). A post-image the
# listing names and a numstat does not answer for refuses as unscanned:
# a short answer is not an answer of "text". The listings are read with -z
# into a scratch directory, so every path meets its verdict byte for byte, and
# joined line by line under as_lines' guard. A blob so named is then read
# (cat-file) and judged by git's own byte rule with no diff machinery: a NUL
# in the first 8000 bytes is binary, and passes as binaries always have;
# anything else is text the scan could not see, named with the tip or the
# commit, and the push is refused rather than scanned. An empty blob hides
# nothing and passes. The line quotes the path's diff attribute, one
# check-attr per refused path and for the report alone: `unset` (a -diff line,
# the binary macro) and a driver whose diff.<driver>.binary reads true are
# named as before, the driver first (a driver may be named `unset` too); any
# other answer (unspecified, set, a driver with no such setting; the two
# reserved words are also names a driver may take, so no answer decides
# anything here) names no attribute the hook can point at, and the line states
# the blob's size and the clone's core.bigFileThreshold instead, facts and not
# a cause, unless the file is a changed file whose previous version is binary
# by its bytes (the pair is binary when either side is, whatever the key
# says, so the diff printed no text for the new version; a merge's combined
# patch prints Binary the same way when a parent's version is binary): that
# line names the previous version as the cause, with the two facts beside it
# where the key is set, and the advice names the fetch remedy (the header)
# and not the key's, which lifts nothing there. The previous version is read
# for the report alone, as the attribute is, key or no key: for a one-parent
# commit in its parent, at the path the diff read the change from when it
# read it as a rename (the old path re-derived at report time from the
# commit's raw listing with -M, an R row's two path records, never carried as
# a field of the rows, since a path may hold a tab); for a merge in each
# parent in turn, the parent count the caller read (rev-list --parents), the
# first parent whose version holds a NUL named; never for a type change or a
# merge's rename candidate, judged by the addition of the new object alone,
# where the previous version is no cause. A read that fails, or a path
# with no previous version (an addition, a root commit), leaves the line
# with its two facts. A one-parent commit's symlink reads no attribute (the
# pairwise diff applies none to a symlink) and its line says so, with the
# same two facts; a
# merge's symlink reads its path's attribute as a file does, since the
# combined patch applied it. A read that fails (a listing, the grep, the
# numstats, the combined patch, the empty tree's name, a cat-file, the
# scratch directory, a listing's rewrite for the joins) refuses as
# unscanned, naming the read; whatever was
# listed is still judged; a check-attr that fails or answers about another
# path leaves the refusal standing, the failure in the attribute's place. A
# read that exits 0 and answers SHORT refuses as unscanned too, where a
# second read in hand shows it short (the header's second class), naming the
# read and both answers: the tip's -z listing against the entry count of the
# symlink pass's listing of the same tree (a different number, long or
# short) and against the grep's read list (a file read must be one listed);
# a commit's changed-path listing against the paths its numstats or its
# combined patch name; a listing's rewrite against its input's byte count
# (as_lines); the byte judge's count of zero against the blob's size
# (cat-file -s: an empty answer is empty content only when the blob is). Each
# is gated on the read's own status 0 and, for the listing, on its verdicts
# having exited 0, so a read that failed is refused once, on its status, and
# not again with a wrong cause; whatever was listed is still judged. The
# tip is not listed again when its first listing (the symlink pass) failed or
# found no tree: the failure is reported there once, and a pushed object that
# peels to a blob has no path an attribute could name.
refuse_hidden_paths() {   # <local_ref> <local_sha> <revs: one "<sha> <parent count>" per line> <tip listed: 1 or 0> <the symlink pass's entry count>
    local local_ref="$1" local_sha="$2" revs="$3" tip_listed="$4" tip_entries="$5"
    local rc rev n entry meta path mode blob place fields k i how says size threshold apath attr value counts bytes nuls numstat_ok renamed
    local status unchanged islink merge prior facts empty_tree="" listing_rc count typed prev where rsrc rdst at
    local -a tpaths
    if [ -z "$scratch" ]; then
        scratch=$(mktemp -d "${TMPDIR:-/tmp}/romp-pre-push.XXXXXX") \
            || { scratch=""; unscanned "the BINARY VERDICTS on the paths $local_ref (${local_sha:0:10}) publishes could not be checked (no scratch directory: mktemp failed)"; return 0; }
    fi
    : > "$scratch/entries"      # "<tip, or the commit's sha>\t<blob>\t<path>", one per NUL: the blobs git called binary
    : > "$scratch/tipblobs"     # the blob shas of the tip's tree, one per line: a per-commit candidate among them is the tip half's to judge
    if [ "$tip_listed" -ne 0 ]; then
        listing_rc=0; git ls-tree -r -z -l "$local_sha" > "$scratch/listing" || listing_rc=$?
        [ "$listing_rc" -eq 0 ] || unscanned "the TREE of the tip of $local_ref (${local_sha:0:10}) could not be listed for the BINARY VERDICT check (git ls-tree exited $listing_rc)"
        # The files the tip's grep reads, by the same grep: exit 1 is a tree it
        # read nothing from (empty, or of empty files), not a failure.
        rc=0; git grep --no-color -I -l -z -e '' "$local_sha" -- > "$scratch/read" 2>/dev/null || rc=$?
        if [ "$rc" -gt 1 ]; then
            unscanned "the FILES the grep of the tip of $local_ref (${local_sha:0:10}) reads could not be listed for the BINARY VERDICT check (git grep exited $rc)"
        else
            # The two listings rewritten for the joins: as_lines returns 1 for a
            # path holding a newline and 2 for a test or a rewrite that failed
            # (rewrite_failure says which); either is refused as unscanned rather
            # than judged by an empty rewrite.
            rc=0; as_lines "$scratch/listing" "$scratch/read" || rc=$?
            if [ "$rc" -eq 1 ]; then
                unscanned "a path at the tip of $local_ref (${local_sha:0:10}) holds a newline, which the BINARY VERDICT check cannot judge"
            elif [ "$rc" -ne 0 ]; then
                unscanned "the LISTINGS of the tip of $local_ref (${local_sha:0:10}) could not be rewritten for the BINARY VERDICT check ($rewrite_failure)"
            else
