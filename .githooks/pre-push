            END { if (short) exit short }' "$scratch/rows.nl" "$scratch/rows2.nl" "$scratch/gone.nl" "$scratch/links.nl" "$scratch/tpaths.nl" "$scratch/rows3.nl" "$scratch/tipblobs" "$scratch/post.nl" | tr '\n' '\0' >> "$scratch/entries" || rc=$?
        if [ "$rc" -ne 0 ] && [ "$numstat_ok" -ne 0 ]; then
            if [ "$merge" -eq 0 ]; then
                unscanned "the BINARY VERDICTS of commit ${rev:0:10} could not be read (git diff-tree --numstat answered for fewer paths than the commit changes)"
            elif [ "$rc" -eq 4 ]; then
                unscanned "the BINARY VERDICTS of commit ${rev:0:10} could not be read (git diff-tree --numstat against the empty tree answered for fewer paths than the merge renames)"
            else
                unscanned "the BINARY VERDICTS of commit ${rev:0:10} could not be read (git diff-tree -p -c, the merge's combined patch, printed no verdict for a path the merge changes)"
            fi
