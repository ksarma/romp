        # tree to agree with (the header's second class): the non-empty lines,
        # counted by the loop that reads each 120000 entry (an empty listing is
        # one empty line to the herestring, counted as nothing). That count
        # bounds the listing's END by whole lines alone: a listing cut inside its
        # last line counts that line all the same, so each line must be a WHOLE
        # entry (a mode, a type, an object name, the tab and a path; a cut
        # removes bytes from the end, so a line holding the tab and a path has
        # its object name whole), a line that is none refused as a short listing
        # naming the line (the last line a link cut inside its mode read as no
        # link, its target unread, and the -z listing's count agreed, so a
        # banned target the remote already held published through a real push;
        # round 8b3, 2026-09-23).
        tip_entries=0
        while IFS= read -r -u 6 link; do
            [ -n "$link" ] || continue
            tip_entries=$((tip_entries + 1))
            case "$link" in
                [0-7][0-7][0-7][0-7][0-7][0-7]" "*" "*$'\t'?*) ;;
                *) unscanned "the SYMLINKS of the tip of $local_ref (${local_sha:0:10}) were listed short (git ls-tree -r exited 0 and answered \"$link\" on a line that is no whole entry: a mode, a type, an object name, a tab and a path)"; continue ;;
            esac
