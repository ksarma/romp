            link_path=${link#*$'\t'}
            # The target, with its trailing newlines kept (-k) so a target of a
            # newline alone is not read as empty. A blob that cannot be read is
            # refused, and its target counts as empty so the loop goes on to the
            # next link. EVERY target read under exit 0 is judged against the
            # blob's SIZE (cat-file -s) by its own byte count, the shell's in the
            # C locale (where a character is a byte), the header's second class:
            # cat-file -p prints a blob as its bytes, so the two agree for every
            # whole read, and a size that differs, or could not be read, refuses
            # the tip as unscanned naming the link and both numbers (until round
            # 8b3 the size was asked only for an EMPTY target, the round 5
            # refuters' road, 2026-09-22, and a cat-file -p cut to its first ten
            # bytes with exit 0 published a link the remote already held whose
            # banned string lay past them, through a real push; the r8b2 audit,
            # 2026-09-23). A target holding a NUL byte, which no file system
            # gives a link, counts short here (the substitution drops the byte)
            # and is refused.
            judged_read gate="the SYMLINK TARGET of a link at the tip" 0 "the SYMLINK TARGET of $link_path at the tip of $local_ref (${local_sha:0:10}) could not be read" -q -k -- git cat-file -p "$blob" || :
            target=$read_out
            if [ "$read_rc" -eq 0 ]; then
                target_bytes=$(LC_ALL=C; printf '%s' "${#target}")
                if [ -z "$target" ]; then read_as="as empty"; whole_what=empty; else read_as="as $target_bytes bytes"; whole_what=whole; fi
                if judged_read gate="the SIZE of a symlink target blob" 0 "the SYMLINK TARGET of $link_path at the tip of $local_ref (${local_sha:0:10}) was read $read_as while its SIZE could not be read (git cat-file -s exited {rc}), so whether the target is $whole_what is unknown" -q -- git cat-file -s "$blob"; then
                    size=$read_out
                    if [ -z "$size" ] || [ -n "${size//[0-9]/}" ]; then
                        unscanned "the SYMLINK TARGET of $link_path at the tip of $local_ref (${local_sha:0:10}) was read $read_as while its SIZE reads \"$size\" (git cat-file -s), not a size, so whether the target is $whole_what is unknown"
                    elif [ -z "$target" ] && [ "$size" -ne 0 ]; then
                        unscanned "the SYMLINK TARGET of $link_path at the tip of $local_ref (${local_sha:0:10}) was read as empty while git cat-file -s gives its size as $size bytes, so the read answered short (git cat-file -p exited 0)"
                    elif [ "$size" -ne "$target_bytes" ]; then
                        unscanned "the SYMLINK TARGET of $link_path at the tip of $local_ref (${local_sha:0:10}) was read as $target_bytes bytes while git cat-file -s gives its size as $size bytes, so one of the two reads answered short (git cat-file -p exited 0)"
                    fi
                fi
            fi
            # The grep and the report read the target as a substitution would have
            # given it, without its trailing newlines; the grep's status is read
            # (0 a hit, 1 none, anything else refused as unscanned naming the read).
            while [ "${target%$'\n'}" != "$target" ]; do target=${target%$'\n'}; done
            if judged_read own="the SYMLINK TARGET grep" 0,1 "the SYMLINK TARGET of $link_path at the tip of $local_ref (${local_sha:0:10}) could not be grepped (grep exited {rc})" -- grep -qi -F "${grep_args[@]}" <<< "$target" && [ "$read_rc" -eq 0 ]; then
                echo "romp pre-push: the tip of $local_ref (${local_sha:0:10}) would publish a personal identifier" >&2
                echo "  in the SYMLINK TARGET of $link_path -> $target" >&2
                blocked_ids=1
            fi
        done 6<<< "$listing"

        # The lines each commit new to the remote adds. Each per-commit read below
        # (the parent count and the diff, the addresses, the message) is captured with its status before
        # the grep or the loop that judges it: piped straight in, a diff-tree or log
        # that failed was the grep's no-match or a loop with nothing to read, a
        # commit that added, said and was stamped with nothing (found by execution,
        # 2026-09-20: each let its commit through a real push, git's error line the
        # only sign). A failed read names the commit and the read (unscanned) and
        # the scan goes on; whatever the read did print is still judged, so a hit
        # ahead of the failure is still named. An empty diff or message (an empty
        # commit, a merge with no line of its own) prints nothing and exits 0:
        # absent, not unreadable. git's own error line is not captured: it prints
        # ahead of the romp line, and message text cannot carry it. The added
        # lines are written to a scratch file and grepped there, never captured
        # in a substitution: a substitution drops NUL bytes and prints bash's
        # warning, naming the hook's line and no commit (three commits of this
        # repository's own history, on a real push; the round 4 refuter,
        # 2026-09-22). The grep reads the file as text (-a): a NUL among the
        # lines would otherwise make it call the file binary and print no line
        # for a hit. A scratch directory that cannot be made leaves the lines
        # unread, refused as unscanned naming mktemp.
        # The commits this push publishes: list_commits, shared with the
        # credential scan (the listing, its count and its gates, in its comment).
        list_commits "$local_ref" "$local_sha" "$remote_sha" identifier || :
        rev_counts=""           # "<sha> <parent count>" per line, for refuse_hidden_paths: the count read here decides a merge there, not a listing's shape
        for rev in $revs; do
            # The parent count: rev-list --parents -n 1 prints the commit and then
            # each parent, so the answer's first word is the commit itself, the
            # sibling fact a short answer is judged against once the read exited 0
            # (judged in bash, never inside an awk under pipefail, which reported a
            # rev-list exiting 128 as an empty answer). A failure or a short answer
            # leaves n empty, which added_lines reads as one column (a merge is then
            # over-scanned), and is refused: an empty count beside an empty combined
            # listing read a merge as a one-parent commit and published its hidden
            # file through a real push (the round 5 refuters, 2026-09-22).
            n=""
            if judged_read gate="the PARENT COUNT of a commit" 0 "the ADDED LINES of commit ${rev:0:10} could not be read (git rev-list --parents exited {rc})" -- git rev-list --parents -n 1 "$rev"; then
                read -r -a words <<< "$read_out"
                if [ "${#words[@]}" -ge 1 ] && [ "${words[0]}" = "$rev" ]; then
                    n=$(( ${#words[@]} - 1 ))
                else
                    unscanned "the ADDED LINES of commit ${rev:0:10} could not be read (git rev-list --parents exited 0 and answered \"$read_out\", not the commit and its parents)"
                fi
            fi
            # A merge of 64 or more parents (the header): git's combined diff
            # prints no hunk for the lines it adds at 64 parents and prints each
            # with a space in its last column at 65, so added_lines reads none
            # of them, and a 65-parent merge published a banned line through a
            # real push (the round 9 rulings, 2026-09-25): refused by name. A
            # count cut short of 64 reads such a merge in fewer columns, as the
            # table's row says.
            if [ -n "$n" ] && [ "$n" -ge 64 ]; then
                unscanned "the ADDED LINES of commit ${rev:0:10} cannot be read for the identifier scan: it has $n parents, and git's combined diff of a merge of 64 or more parents prints no hunk for the lines it adds, or prints them with a space in their last column"
            fi
            rev_counts="$rev_counts$rev $n"$'\n'
            if make_scratch; then
                # The diff's awk records the count of lines it printed, in a file
                # emptied here first (the header's second class), and only after
                # the diff's first line named the commit (--always, added_lines):
                # after a read that exited 0, the word unmarked (a git that printed
                # no marker: silent, or answering for no commit) is refused naming
                # the git read, and so is the word untailed (a git whose answer does
                # not end with the commit's name printed again after the diff, the
                # tail marker: an answer cut short; the r8b2 audit, 2026-09-23),
                # no count (an awk that never ran its program) or a
                # count other than the capture's line count (a stage that wrote
                # less) is refused naming the awk and both numbers, where a git and
                # an awk each exiting 0 and printing nothing were read as a commit
                # adding no line and published its banned line through a real push
                # (the round 7 refuters, 2026-09-23; the round 6 refuters,
                # 2026-09-22). The capture's line count is read by wc through the
                # helper, and both counts are runs of digits before the comparison
                # reads them; whatever the diff printed is grepped below either
                # way, so a hit ahead of a failure is still named.
                : > "$scratch/added.count"
                if judged_read gate="the ADDED LINES diff of a commit" 0 "the ADDED LINES of commit ${rev:0:10} could not be read (git diff-tree exited {rc})" -o "$scratch/added" -- added_lines "$rev" "$n" "$scratch/added.count"; then
                    count=""; { IFS= read -r count || :; } < "$scratch/added.count"
                    if [ "$count" = unmarked ]; then
                        unscanned "the ADDED LINES of commit ${rev:0:10} could not be read (git diff-tree exited 0 and printed no line naming the commit, the marker --always asks for ahead of the diff, so the read answered short)"
                    elif [ "$count" = untailed ]; then
                        unscanned "the ADDED LINES of commit ${rev:0:10} were read short (git diff-tree exited 0 and its answer does not end with the line naming the commit, the tail marker its second --stdin line asks for after the diff)"
                    elif [ -z "$count" ] || [ -n "${count//[0-9]/}" ]; then
                        unscanned "the ADDED LINES of commit ${rev:0:10} could not be read (the diff's awk exited 0 and recorded \"$count\" as the count of lines it printed, not a count)"
                    elif judged_read gate="the LINE COUNT of the added lines" 0 "the ADDED LINES of commit ${rev:0:10} could not be counted (wc exited {rc})" -- wc -l < "$scratch/added"; then
                        linecount=${read_out//[[:space:]]/}
                        if [ -z "$linecount" ] || [ -n "${linecount//[0-9]/}" ]; then
                            unscanned "the ADDED LINES of commit ${rev:0:10} could not be counted (wc answered \"$read_out\", not a count)"
                        elif [ "$linecount" -ne "$count" ]; then
                            unscanned "the ADDED LINES of commit ${rev:0:10} were captured short (the diff's awk recorded $count lines printed and the capture holds $linecount; the pipeline exited 0)"
                        fi
                    fi
                fi
                # The grep's status is read (0 a hit, 1 none, anything else refused
                # as unscanned naming the read: a grep exiting 2 left the hits empty
                # and published the commit through a real push; the round 5
                # refuters, 2026-09-22), and is the sibling fact for its answer (the
                # header's second class): exit 0 is a match, so a match that wrote
                # no hit line is a short answer, refused naming the grep before the
                # sort runs (the sort's own line stood for a grep that answered
                # nothing, naming the wrong tool; the round 6 refuter, 2026-09-22).
                # Its hit lines go to a file, never a substitution (a NUL among them
                # would be dropped with a warning); their paths are read from it here
                # and sorted unique for the report, the sort's answer judged against
                # the lines it was given.
                hits=""
                if judged_read gate="the ADDED LINES grep" 0,1 "the ADDED LINES of commit ${rev:0:10} could not be grepped (grep exited {rc})" -o "$scratch/hits" -- grep -a -i -F "${grep_args[@]}" "$scratch/added" && [ "$read_rc" -eq 0 ]; then
                    if [ ! -s "$scratch/hits" ]; then
                        unscanned "the ADDED LINES of commit ${rev:0:10} were grepped with no hit line listed (grep exited 0, a match, and printed no line), so the answer is short"
                    else
                        paths=""
                        while IFS= read -r line; do paths="$paths${line%%$'\t'*}"$'\n'; done < "$scratch/hits"
