            prior=0; where=""
            if [ "$place" != tip ] && [ "$islink" -eq 0 ] && [ "$typed" -eq 0 ]; then
                k=$(LC_ALL=C awk -v r="$place" '$1 == r { print $2; exit }' "$scratch/pcount")     # outside judged_read: for the report (above)
                if [ -z "$k" ] || [ -n "${k//[0-9]/}" ]; then k=0; fi
                if [ "$k" -eq 1 ]; then
                    prev=$path
                    if [ -n "$renamed" ]; then
                        prev=""; rc=0; git diff-tree -r --raw -M -z --root --no-commit-id "$place" > "$scratch/renames" 2>/dev/null || rc=$?     # outside judged_read: for the report (above)
                        if [ "$rc" -eq 0 ]; then
                            while IFS= read -r -d '' meta && IFS= read -r -d '' rsrc; do
                                case "${meta##* }" in R*|C*) IFS= read -r -d '' rdst || rdst=""; [ "$rdst" != "$path" ] || prev=$rsrc ;; esac
                            done < "$scratch/renames"
                        fi
                    fi
                    if [ -n "$prev" ]; then
                        rc=0; counts=$(git cat-file blob "$place^:$prev" 2>/dev/null | { head -c 8000 | LC_ALL=C od -An -v -tu1 | awk '{ for (i = 1; i <= NF; i++) { b++; if ($i == 0) z++ } } END { print b + 0, z + 0 }'; cat > /dev/null; }) || rc=$?     # outside judged_read: for the report (above)
                        if [ "$rc" -eq 0 ]; then read -r bytes nuls <<< "$counts"; case "$nuls" in ''|*[!0-9]*) ;; 0) ;; *) prior=1 ;; esac; fi
                        [ "$prior" -eq 0 ] || [ "$prev" = "$path" ] || where=" (at $prev, the path the diff read it from)"
                    fi
                elif [ "$k" -gt 1 ]; then
                    for ((i = 1; i <= k; i++)); do
                        rc=0; counts=$(git cat-file blob "$place^$i:$path" 2>/dev/null | { head -c 8000 | LC_ALL=C od -An -v -tu1 | awk '{ for (i = 1; i <= NF; i++) { b++; if ($i == 0) z++ } } END { print b + 0, z + 0 }'; cat > /dev/null; }) || rc=$?     # outside judged_read: for the report (above)
                        [ "$rc" -eq 0 ] || continue
                        read -r bytes nuls <<< "$counts"
                        case "$nuls" in ''|*[!0-9]*) ;; 0) ;; *) prior=1; where=" in parent $i of the merge"; break ;; esac
                    done
                fi
            fi
            if [ "$prior" -ne 0 ]; then
                facts=""; [ -z "$threshold" ] || facts=" whatever the key says (the blob is $size bytes; core.bigFileThreshold is $threshold in this clone's configuration)"
                echo "romp pre-push: $path in commit ${place:0:10} is text that git calls binary although $says, $accounts; the previous version of the file$where is binary by its bytes (a NUL in its first 8000), which made git print no text diff for the change$facts, and the identifier scan could not read the new text, so the push is refused rather than scanned" >&2
                hidden_prior=1
            elif [ "$place" = tip ]; then
                echo "romp pre-push: $path at the tip of $local_ref (${local_sha:0:10}) is text that git calls binary although $says, $accounts (the blob is $size bytes; core.bigFileThreshold is ${threshold:-not set} in this clone's configuration); the identifier scan did not read it, so the push is refused rather than scanned" >&2
                hidden_unnamed=1
            else
                echo "romp pre-push: $path in commit ${place:0:10} is text that git calls binary although $says, $accounts$renamed (the blob is $size bytes; core.bigFileThreshold is ${threshold:-not set} in this clone's configuration); the identifier scan did not read it, so the push is refused rather than scanned" >&2
                hidden_unnamed=1
            fi
            [ "$prior" -ne 0 ] || [ "$unread" -eq 0 ] || hidden_attr=1
        fi
        hidden_paths=1
        failed_scan=1
    done 6< "$scratch/entries"
}

# ── identifiers ───────────────────────────────────────────────────────────
# The type the pushed object PEELS to (blob, tree or commit; cat-file -t on
# <sha>^{}), read once per ref and only when a read needs it: the symlink pass
# when its listing exited 128 (a blob has no tree to list), and the commit
# listing when it answered nothing (a blob or a tree names no commit, so the
# empty listing is the object's own). Any answer outside the object types
# refuses the push as unscanned naming the read and the answer, and leaves
# peeled empty, which every caller reads as "not a blob": the safe side. Sets
# peeled and peeled_read, the caller's.
peel_type() {   # <local_ref> <local_sha>
    [ "$peeled_read" -eq 0 ] || return 0
    peeled_read=1; peeled=""
    judged_read gate="the TYPE of the object the tip peels to" 0 "the TYPE of the object the tip of $1 (${2:0:10}) peels to could not be read (git cat-file -t exited {rc})" -q -- git cat-file -t "$2^{}" || return 0
    case "$read_out" in
        blob|tree|commit) peeled=$read_out ;;
        *) unscanned "the TYPE of the object the tip of $1 (${2:0:10}) peels to was read as \"$read_out\" (git cat-file -t exited 0), not an object type" ;;
    esac
}
# The TYPE of the object a ref pushes, and of each object the peel below
# reaches: read through judged_read (a failure refused with type_unread's
# clause) and its answer judged in this shell, never a subshell, against the
# four object types, since a type is never an object's own empty answer: an
# answer outside them refuses the push as unscanned naming the read and the
# answer (a cat-file -t answering nothing with a clean status read as "not a
# tag" and published a banned tagger through a real push; the round 5
# refuters, 2026-09-22). The shape is judged only on a read that exited 0, so
# a failed read is refused once; either way kind is left empty, which ends
# the peel. Sets kind, the caller's.
object_type() {   # <local_ref> <sha>
    kind=""
    judged_read gate="the TYPE of a pushed object" 0 "$(type_unread "$1" "$2")" -q -- git cat-file -t "$2" || return 0
    case "$read_out" in
        blob|tree|commit|tag) kind=$read_out ;;
        *) unscanned "the TYPE of the object $1 pushes (${2:0:10}) was read as \"$read_out\" (git cat-file -t exited 0), not an object type, so whether it is an annotated tag is unknown" ;;
    esac
}
# The line numbers of the hits in a message (a commit's, a tag's), for the
# report: the grep's status through judged_read (0 a hit, 1 none, anything
# else refused as unscanned naming the subject), -n numbering the lines from
# the subject, and the numbers joined with commas into lines, the caller's.
# The grep's own status is the sibling fact for its answer (the header's
# second class): exit 0 is a match, so a match that printed no line is a short
# answer, refused as unscanned naming the subject (a grep exiting 0 printing
# nothing published a commit and a tag through real pushes; the round 6
# refuters, 2026-09-22). -a reads the message as text whatever its bytes:
# under a UTF-8 locale GNU grep calls a line holding a byte that is no UTF-8
# binary, and without -a a match on such a line is a "binary file matches"
# note on stderr and no line on stdout, exit 0, so a banned string beside a
# stray byte was read as no hit (the round 6 refuters, with the real grep and
# no shim; the empty-answer refusal above stays as the backstop). Called as a
# condition: status 0 when the message carries a hit.
message_hit_lines() {   # <subject: "the MESSAGE of commit <sha>" or "the MESSAGE of tag <ref> (<sha>)"> <message>
    local hit
    lines=""
    judged_read gate="the MESSAGE grep" 0,1 "$1 could not be grepped (grep exited {rc})" -- grep -in -a -F "${grep_args[@]}" <<< "$2" || return 1
    [ "$read_rc" -eq 0 ] || return 1
    if [ -z "$read_out" ]; then
        unscanned "$1 was grepped with no hit line listed (grep exited 0, a match, and printed no line), so the answer is short"
        return 1
    fi
    while IFS= read -r hit; do lines="$lines${hit%%:*},"; done <<< "$read_out"
    lines=${lines%,}
    [ -n "$lines" ]
}
# The commits this push publishes for one ref (rev_range), listed alike for
# both scans. The range read's expected set is 0 and 128: a range this clone
# cannot resolve (a force-push over a remote tip nobody fetched) fails with
# 128, and the listing then falls back to everything the pushed tip reaches,
# the header's rule; any other status is refused. An EMPTY listing under exit
# 0 is gated by sibling facts (the header's second class): the type the pushed
# object peels to (a blob or a tree names no commit, so the empty answer is
# the object's own), else some remote-tracking ref must contain the pushed
# commit (for-each-ref --contains: every commit of the range is then one a
# remote already has) OR, for a ref update, the pushed commit must be an
# ancestor of the remote's current one (a rewind publishes nothing new), read
# as the ANSWER of git merge-base, which must be the commit the pushed object
# peels to (the best common ancestor of a commit and a descendant is that
# commit), an answer that is no commit refused naming the read: the
# status-only --is-ancestor answered "ancestor" by exiting 0, so a git silent
# on the listing and on that read published a middle commit's banned line
# through a real push of a ref update (round 8b2, 2026-09-23). The peel is a
# read of its own (git rev-parse --verify on <object>^{commit}), judged a
# whole commit name before merge-base's answer is compared with it, an answer
# that is none refused naming it: merge-base peels an annotated tag and
# answers a commit, and compared with the tag object's own name it refused a
# tag moved to an ancestor, re-created on its commit or replacing a
# lightweight tag there, with a false "not an ancestor" (the round 8 refuters,
# 2026-09-24; round 9a). The OR, since the ancestry alone would refuse a
# fast-forward of commits another remote holds. A listing that answered
# nothing while neither fact holds is refused as unscanned naming the read and
# the empty answer: a rev-list answering nothing with a clean status published
# a middle commit's banned line through a real push, on a new branch and on a
# ref update alike (the round 5 refuters, 2026-09-22). A listing that answered
# SOMETHING is judged at its END by a count read apart (the header's bound):
# git rev-list --count over the same range must equal the listing's line
# count, a count that differs refused as a short listing naming both answers
# (a rev-list cut to its first line, the pushed tip, with exit 0 published a
# middle commit's banned line through real pushes of a ref update and of a new
# branch alike; the r8b2 audit, 2026-09-23); and each line must be a whole
# commit name (a hex run as long as the pushed commit's name), a line that is
# none refused as a short listing naming that line alone.
# Called in each scan's ref loop: it sets revs, the caller's (and peeled and
# peeled_read through peel_type, which each caller resets at the top of its
# loop, never here), names the scan in its lines, and returns 1 when it
# refused, told by unscanned_n (failed_scan may be 1 already), so the
# credential scan skips a ref whose listing refused rather than feed diff-tree
# a cut name; the identifier scan calls it with || : and scans what was
# listed, as it did (under set -e a bare call returning 1 would end the hook).
list_commits() {   # <local_ref> <local_sha> <remote_sha> <scan: identifier or credential, named in the lines>
    local local_ref="$1" local_sha="$2" remote_sha="$3" scan="$4" before=$unscanned_n
    local fell_back revs_rc count_range listed cut_name agreed peel_commit peel_whole rev
    fell_back=0
    # shellcheck disable=SC2046  # the range is deliberately word-split
    judged_read gate="the COMMIT listing of a pushed ref" 0,128 "the COMMITS of $local_ref (${local_sha:0:10}) could not be listed for the $scan scan (git rev-list exited {rc})" -q -- git rev-list $(rev_range "$local_sha" "$remote_sha") || :
    if [ "$read_rc" -eq 128 ]; then
        fell_back=1
        judged_read gate="the COMMIT listing of a pushed ref" 0 "the COMMITS of $local_ref (${local_sha:0:10}) could not be listed for the $scan scan (git rev-list exited {rc})" -- git rev-list "$local_sha" || :
    fi
    revs=$read_out; revs_rc=$read_rc
    if [ "$revs_rc" -eq 0 ] && [ -n "$revs" ]; then
        if [ "$fell_back" -eq 0 ]; then count_range=$(rev_range "$local_sha" "$remote_sha"); else count_range=$local_sha; fi
        # shellcheck disable=SC2086  # the range is deliberately word-split
        if judged_read gate="the COMMIT COUNT of a pushed ref" 0 "the COMMITS of $local_ref (${local_sha:0:10}) could not be counted for the $scan scan (git rev-list --count exited {rc})" -q -- git rev-list --count $count_range; then
            listed=0; cut_name=""
            for rev in $revs; do
                listed=$((listed + 1))
                case "$rev" in *[!0-9a-f]*) cut_name=$rev ;; *) [ "${#rev}" -eq "${#local_sha}" ] || cut_name=$rev ;; esac
            done
            if [ -z "$read_out" ] || [ -n "${read_out//[0-9]/}" ]; then
                unscanned "the COMMITS of $local_ref (${local_sha:0:10}) could not be counted for the $scan scan (git rev-list --count exited 0 and answered \"$read_out\", not a count)"
            elif [ -n "$cut_name" ]; then
                unscanned "the COMMITS of $local_ref (${local_sha:0:10}) were listed short (git rev-list exited 0 and answered \"$cut_name\" on a line that is no whole commit name)"
            elif [ "$listed" -ne "$read_out" ]; then
                unscanned "the COMMITS of $local_ref (${local_sha:0:10}) could not be listed whole for the $scan scan (git rev-list exited 0 and listed $listed where git rev-list --count of the same range counts $read_out, so one of the two answered short)"
            fi
        fi
    elif [ "$revs_rc" -eq 0 ]; then
        peel_type "$local_ref" "$local_sha"
        case "$peeled" in
            blob|tree) ;;           # no commit to list: the object's own empty answer
            *)
                agreed=0
                if judged_read gate="the REMOTE REFS containing the pushed commit" 0 "the COMMITS of $local_ref (${local_sha:0:10}) were listed as none, and whether a remote-tracking ref contains the pushed commit could not be read (git for-each-ref --contains exited {rc})" -- git for-each-ref --format='%(refname)' --contains "$local_sha" refs/remotes/; then
                    [ -z "$read_out" ] || agreed=1
                fi
                if [ "$agreed" -eq 0 ] && [ "$remote_sha" != "$zero" ] && [ "$fell_back" -eq 0 ]; then
                    # The commit the pushed object peels to, the one merge-base's
                    # answer is compared with: read once here, wherever the
                    # ancestry is asked, and judged a whole commit name (hex, as
                    # long as the pushed object's name) before any comparison, an
                    # answer that is none refused naming the read, so an empty peel
                    # never agrees with an empty merge-base answer. A commit peels
                    # to itself, so no type is keyed on.
                    peel_commit=""; peel_whole=0
                    if judged_read gate="the COMMIT the pushed object peels to" 0 "the COMMITS of $local_ref (${local_sha:0:10}) were listed as none, and the commit the pushed object peels to, which the ancestry is compared with, could not be read (git rev-parse --verify exited {rc})" -- git rev-parse --verify "$local_sha^{commit}"; then
                        peel_commit=$read_out
                        case "$peel_commit" in
                            ''|*[!0-9a-f]*) ;;
                            *) [ "${#peel_commit}" -ne "${#local_sha}" ] || peel_whole=1 ;;
                        esac
                        [ "$peel_whole" -ne 0 ] || unscanned "the COMMITS of $local_ref (${local_sha:0:10}) were listed as none, and the commit the pushed object peels to, which the ancestry is compared with, could not be read (git rev-parse --verify exited 0 and answered \"$peel_commit\", not a commit)"
                    fi
                    if [ "$peel_whole" -ne 0 ] && judged_read gate="the ANCESTRY of the pushed commit over the remote commit" 0,1 "the COMMITS of $local_ref (${local_sha:0:10}) were listed as none, and whether the pushed commit is an ancestor of the remote's ${remote_sha:0:10} could not be read (git merge-base exited {rc})" -q -- git merge-base "$local_sha" "$remote_sha"; then
                        if [ "$read_rc" -eq 0 ]; then
                            # Another whole commit name is a real "not an
                            # ancestor", the listing's refusal below; an
                            # answer that is no whole name (empty, not hex, or
                            # a hex run shorter than the pushed commit's
                            # name, one cut short) is refused naming the read.
                            # merge-base peels an annotated tag and answers a
                            # commit, so its answer is compared with the peel.
                            case "$read_out" in
                                "$peel_commit") agreed=1 ;;
                                *[!0-9a-f]*) unscanned "the COMMITS of $local_ref (${local_sha:0:10}) were listed as none, and whether the pushed commit is an ancestor of the remote's ${remote_sha:0:10} could not be read (git merge-base exited 0 and answered \"$read_out\", not a commit)" ;;
                                *) [ "${#read_out}" -eq "${#local_sha}" ] || unscanned "the COMMITS of $local_ref (${local_sha:0:10}) were listed as none, and whether the pushed commit is an ancestor of the remote's ${remote_sha:0:10} could not be read (git merge-base exited 0 and answered \"$read_out\", not a commit)" ;;
                            esac
                        fi
                    fi
                fi
                if [ "$agreed" -eq 0 ]; then
                    if [ "$remote_sha" = "$zero" ]; then
                        unscanned "the COMMITS of $local_ref (${local_sha:0:10}) were listed as none (git rev-list exited 0 and printed nothing) while no remote-tracking ref contains the pushed commit and the ref is new on the remote, so the listing answered short"
                    elif [ "$fell_back" -ne 0 ]; then
                        unscanned "the COMMITS of $local_ref (${local_sha:0:10}) were listed as none (git rev-list exited 0 and printed nothing) while no remote-tracking ref contains the pushed commit and the remote's ${remote_sha:0:10} is not in this clone, so the listing answered short"
                    else
                        unscanned "the COMMITS of $local_ref (${local_sha:0:10}) were listed as none (git rev-list exited 0 and printed nothing) while no remote-tracking ref contains the pushed commit and it is not an ancestor of the remote's ${remote_sha:0:10}, so the listing answered short"
                    fi
                fi
                ;;
        esac
    fi
    [ "$unscanned_n" -eq "$before" ]
}
scan_identifiers() {
    local strings_file line grep_args local_ref local_sha _remote_ref remote_sha lines role email obj tagger chosen chosen_unread
    local rc errs hits listing link blob link_path target size revs rev n msg addrs inner kind tip_listed tip_entries rev_counts
    local peeled peeled_read paths count linecount tag_read hdr
    local target_bytes read_as whole_what
    local -a words
    strings_file="$(private_strings_file)"
    identifier_scan_armed || return 0

    # Banned strings: strip comments and surrounding whitespace, drop blanks. The
    # `|| [ -n "$line" ]`: a last line with no trailing newline (an editor that
    # adds none, a printf that wrote the file) comes back from read with status 1
    # and the line in hand, and a plain `while read` dropped it: the entry on
    # that line was scanned for by nothing, and a one-entry file so written armed
    # no scan at all, nothing printed either way (found by execution, 2026-09-21).
    grep_args=()
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [ -n "$line" ] && grep_args+=(-e "$line")
    done < "$strings_file"
    [ ${#grep_args[@]} -gt 0 ] || return 0
    chosen_emails                  # the same for every commit in the push: read once, in the shell (it sets chosen and chosen_unread)

    # The refs on descriptor 5, never stdin, and the links below on 6: every
    # tool the loop runs inherits stdin, and one that read it would take the
    # refs after the current one, which no scan would then read (the header:
    # an awk silent with exit 0 that read its stdin during the first ref of a
    # two-ref push published the second; round 8b).
    while read -r -u 5 local_ref local_sha _remote_ref remote_sha; do
        [ -n "${local_sha:-}" ] || continue
        [ "$local_sha" = "$zero" ] && continue          # deleting a remote ref pushes nothing

        # The tip's tree. -I skips binaries; -l lists files. The status and the
        # error stream are read apart from the hits: git grep exits 1 for no match
        # and above 1 when it could not scan (a git that would not run, a killed
        # process, an argument list too long, a partial clone whose promisor is
        # unreachable), and a blob it cannot read it reports on stderr and skips,
        # exiting 1 (or 0, listing the files it did read), so a corrupt store made
        # the leaking file a clean one. Every hit is "<sha>:<path>", or the bare
        # "<sha>" when the pushed object peels to a blob (a tag of a blob, which
        # git grep reads as one file); any other line is an error, echoed under
        # the report. Found by execution (2026-09-20):
        # with a git grep exiting 2, and again with the leaking file's blob
        # missing, a tip whose tree carried a denylist string passed. --no-color:
        # with color.ui or color.grep set to always, git wraps each hit line in
        # colour codes even off a terminal, and a coloured hit is not
        # "<sha>:<path>": it read as an error line, and a real hit was reported
        # as a broken scanner (2026-09-21).
        # The hit lines and the error lines are told apart here, line by line,
        # and the grep's own status is the sibling fact for its answer: exit 0
        # is a match, so a match that printed no hit line is a short answer,
        # refused as unscanned.
        peeled=""; peeled_read=0
        judged_read gate="the CONTENT grep of the tip" 0,1 "the CONTENT of the tip of $local_ref (${local_sha:0:10}) could not be fully scanned (git grep exited {rc})" -e -- git grep --no-color -i -I -l -F "${grep_args[@]}" "$local_sha" -- || :
        rc=$read_rc; hits=""; errs=""
        while IFS= read -r line; do
            case "$line" in
                "$local_sha:"*|"$local_sha") hits="$hits$line"$'\n' ;;
                '') ;;
                *) errs="$errs$line"$'\n' ;;
            esac
        done <<< "$read_out"
        hits=${hits%$'\n'}; errs=${errs%$'\n'}
        if [ "$rc" -le 1 ] && [ -n "$errs" ]; then
            unscanned "the CONTENT of the tip of $local_ref (${local_sha:0:10}) could not be fully scanned (git grep exited $rc)"
        fi
        if [ -n "$errs" ]; then
            while IFS= read -r line; do printf '  %s\n' "$line" >&2; done <<< "$errs"
        fi
        if [ "$rc" -eq 0 ] && [ -z "$hits" ]; then
            unscanned "the CONTENT of the tip of $local_ref (${local_sha:0:10}) was scanned with no hit listed (git grep exited 0, a match, and printed no hit line), so the answer is short"
        fi
        if [ -n "$hits" ]; then
            echo "romp pre-push: the tip of $local_ref (${local_sha:0:10}) would publish a personal identifier in:" >&2
            while IFS= read -r line; do
                case "$line" in "$local_sha:"*) printf '  %s\n' "${line#"$local_sha:"}" >&2 ;; *) printf '%s\n' "$line" >&2 ;; esac
            done <<< "$hits"
            blocked_ids=1
        fi

        # The tip's symlinks. git grep reads regular-file blobs only, so a link whose
        # TARGET holds a string is invisible to the grep above. A committed link's
        # target is its blob content, so read each 120000 entry's blob itself. Not
        # hypothetical: a `node_modules -> /home/<user>/code/romp/...` link, made to
        # run the extension tests in a worktree and swept up by a broad `git add`,
        # reached a public branch past a git grep of its tree, and a reviewer found
        # it, not the hook. An ls-tree line is "<mode> <type> <sha>\t<path>". The
        # listing is captured before the grep so a failed ls-tree has a road of its
        # own: piped straight into grep, the listing's failure was grep's no-match,
        # and a tree that could not be listed read as a tree with no symlinks (found
        # by execution, 2026-09-20: with one subtree object missing, ls-tree listed
        # the link and exited 1, the pipeline took that status, and a real push
        # published the branch). A failed listing refuses the push as unscanned;
        # whatever it did list is still read, so a link it named is still named.
        # A pushed object that peels to a BLOB (a tag of a blob) has no tree to
        # list: the listing is absent, not unreadable, and the content scan above
        # read the blob itself. The peel-type read is made only when the listing
        # failed, and its own failure refuses like any other.
        tip_listed=1            # read again with -z by refuse_hidden_paths; not when this listing failed or found no tree
        # The listing's expected set is 0 and 128: ls-tree exits 128 for a pushed
        # object that peels to a blob ("not a tree object"), which has no tree to
        # list, and the peeled type then decides whether that is the case; any
        # other status is refused here, and whatever was listed is still read. An
        # empty listing under exit 0 is judged here against the SIZE of the tip's
        # tree (cat-file -s on the tree the pushed object peels to), the header's
        # second class: the recursive listing omits tree entries, so it answers
        # empty for the empty tree, size 0, and for a tree holding only empty
        # directories, which git's own index never writes; any size but 0 is
        # refused naming the read, the size and both causes, a listing that
        # answered short or such a tree (the latter a disclosed residual: a
        # valid tip of empty directories alone is refused, the round 8
        # refuter, 2026-09-24), and a size that is not a digit run is refused too
        # (a git silent on ls-tree in both its shapes over a tip whose tree held
        # a symlink alone, inherited from a commit the remote holds, passed the
        # tip through a real push: the -z listing of refuse_hidden_paths agreed
        # with this one on zero entries, and the grep's read list, empty for a
        # tree with no regular file with bytes, gated nothing; the round 7
        # refuter, 2026-09-23). Where the -z listing disagrees instead, its
        # entry count refuses there, so both listings at zero is the one road
        # that reaches this read.
        judged_read gate="the SYMLINK listing of the tip" 0,128 "the SYMLINKS of the tip of $local_ref (${local_sha:0:10}) could not be listed" -q -- git ls-tree -r "$local_sha" || :
        listing=$read_out
        if [ "$read_rc" -eq 128 ]; then
            tip_listed=0
            peel_type "$local_ref" "$local_sha"
            if [ "$peeled" = blob ]; then
                listing=""
            else
                unscanned "the SYMLINKS of the tip of $local_ref (${local_sha:0:10}) could not be listed"
            fi
        elif [ "$read_rc" -ne 0 ]; then
            tip_listed=0
        elif [ -z "$listing" ]; then
            if judged_read gate="the SIZE of the tip's tree" 0 "the TREE of the tip of $local_ref (${local_sha:0:10}) was listed as empty while its SIZE could not be read (git cat-file -s exited {rc}), so whether the listing is whole is unknown" -q -- git cat-file -s "$local_sha^{tree}"; then
                size=$read_out
                if [ -z "$size" ] || [ -n "${size//[0-9]/}" ]; then
                    unscanned "the TREE of the tip of $local_ref (${local_sha:0:10}) was listed as empty while its SIZE reads \"$size\" (git cat-file -s), not a size, so whether the listing is whole is unknown"
                elif [ "$size" -ne 0 ]; then
                    unscanned "the TREE of the tip of $local_ref (${local_sha:0:10}) was listed as empty (git ls-tree -r exited 0 and printed no entry) while git cat-file -s gives its tree's size as $size bytes, so either the listing answered short or the tree holds only empty directories, which git's own index never writes"
                fi
            fi
        fi
