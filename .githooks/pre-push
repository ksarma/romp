    done 3<<< "$revs"
    [ -s "$scratch/entries" ] || return 0
    while IFS= read -r -d '' entry; do
        place=${entry%%$'\t'*}; blob=${entry#*$'\t'}; blob=${blob%%$'\t'*}; path=${entry#*$'\t'*$'\t'}
        typed=0; case "$place" in *+typed) place=${place%+typed}; typed=1 ;; esac
        islink=0; case "$place" in *+link) place=${place%+link}; islink=1 ;; esac
        renamed=""; case "$place" in *+rename) place=${place%+rename}; renamed=" (the diff read it as a rename, so the attribute of the path it came from counted too)" ;; esac
        if [ "$place" = tip ]; then at="at the tip of $local_ref (${local_sha:0:10})"; else at="in commit ${place:0:10}"; fi
        # The first 8000 bytes, counted with their NULs; the rest is drained so
        # the cat-file is never cut off mid-write (its status is the pipe's).
        rc=0; counts=$(git cat-file blob "$blob" | { head -c 8000 | LC_ALL=C od -An -v -tu1 | awk '{ for (i = 1; i <= NF; i++) { b++; if ($i == 0) z++ } } END { print b + 0, z + 0 }'; cat > /dev/null; }) || rc=$?
        if [ "$rc" -ne 0 ]; then
            if [ "$place" = tip ]; then
                unscanned "the CONTENT of $path at the tip of $local_ref (${local_sha:0:10}), which git calls binary and the identifier scan therefore skipped, could not be read (git cat-file exited $rc)"
            else
                unscanned "the CONTENT of $path in commit ${place:0:10}, which git calls binary and the identifier scan therefore skipped, could not be read (git cat-file exited $rc)"
            fi
            continue
        fi
