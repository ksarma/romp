            rc=0; size=$(git cat-file -s "$blob" 2>/dev/null) || rc=$?
            if [ "$rc" -ne 0 ]; then
                unscanned "the CONTENT of $path $at, which git calls binary and the identifier scan therefore skipped, was read as 0 bytes while its SIZE could not be read (git cat-file -s exited $rc), so whether the blob is empty is unknown"
            elif [ -z "$size" ] || [ -n "${size//[0-9]/}" ]; then
                unscanned "the CONTENT of $path $at, which git calls binary and the identifier scan therefore skipped, was read as 0 bytes while its SIZE reads \"$size\" (git cat-file -s), not a size, so whether the blob is empty is unknown"
            elif [ "$size" -ne 0 ]; then
                unscanned "the CONTENT of $path $at, which git calls binary and the identifier scan therefore skipped, was read as 0 bytes while git cat-file -s gives its size as $size bytes, so the read answered short (git cat-file blob exited 0)"
            fi
            continue        # empty (the size agrees): nothing hidden
        fi
        [ "$nuls" -eq 0 ] || continue       # a NUL: binary, which the scan never read
        # Text git called binary. The report's label comes from the path's diff
        # attribute, read for this line alone (the header: never a decision); a
        # one-parent commit's symlink reads none, since the pairwise diff applies
        # none to it (a merge's combined patch does, so a merge's link is
        # labelled as a file is).
        how=""; says=""
        if [ "$islink" -ne 0 ]; then
            says="it is a symbolic link, whose target this read judges by its size and bytes and by no attribute of the path"
        else
            rc=0; git check-attr -z diff -- "$path" > "$scratch/attr" 2>/dev/null || rc=$?
            if [ "$rc" -ne 0 ]; then
                says="its diff attribute could not be read (git check-attr exited $rc)"
            else
                { IFS= read -r -d '' apath && IFS= read -r -d '' attr && IFS= read -r -d '' value; } < "$scratch/attr" || { apath=""; attr=""; value=""; }
                if [ -z "$apath$attr$value" ]; then
                    says="its diff attribute could not be read (git check-attr answered nothing for the path asked)"
                elif [ "$apath" != "$path" ] || [ "$attr" != diff ] || [ -z "$value" ]; then
                    says="its diff attribute could not be read (git check-attr answered out of step with the path asked)"
                elif [ "$(git config --type=bool "diff.$value.binary" 2>/dev/null || true)" = true ]; then
                    how="diff=$value, binary"
                elif [ "$value" = unset ]; then
                    how="unset"
                else
                    says="its diff attribute reads $value"
                fi
            fi
        fi
