#!/usr/bin/env bash
# romp-sdk-setup — provision the Claude Agent SDK for romp's non-tmux backend.
#
# Rather than install the SDK into the system python (PEP 668 / externally-managed envs), we keep
# it in a DEDICATED venv under romp's state dir and the kernel adds that venv's site-packages to
# sys.path (see _ensure_sdk_on_path in bin/romp-kernel). The venv is built with the SAME python the
# kernel runs (pick_python below matches bin/romp-serve's), so the ABI matches. Both pickers follow
# the venv's own recorded interpreter once one exists, so a re-run keeps the interpreter and only
# upgrades the SDK; the venv is REBUILT for a different python only when ROMP_PYTHON names one or the
# recorded interpreter is gone, loudly (see below). Idempotent; the tmux backend is unaffected
# whether or not this is run. Re-run to upgrade.
set -euo pipefail
STATE="${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}"
VENV="$STATE/sdkvenv"

# The Agent SDK needs python >= 3.10; some hosts pin the system python3 older (Ubuntu 20.04 = 3.8)
# with a newer one alongside (e.g. a uv-managed 3.12 in ~/.local/bin — probed explicitly because a
# non-login ssh shell doesn't have it on PATH). Order: ROMP_PYTHON, then the interpreter the existing
# venv records, then the newest pythonX.Y found.
# KEEP IN SYNC with bin/romp-serve's pick_python — the kernel must run the interpreter this venv
# is built with.
pick_python() {
    if [[ -n "${ROMP_PYTHON:-}" ]]; then echo "$ROMP_PYTHON"; return; fi
    local v c
    # THE VENV FIRST. bin/romp-sdk-setup builds the SDK venv with the interpreter this function picked at
    # the time, and pyvenv.cfg records it. Running anything else imports 3.X-compiled extensions into a
    # 3.Y process: on 2026-09-06 a `uv python install 3.14` in an unrelated shell put a python3.14 into
    # ~/.local/bin, the next kernel respawn picked it over the venv's 3.12, and every SDK session died at
    # import for two hours while the message blamed a missing install. So a box that HAS a venv runs the
    # venv's interpreter, however old, and the newest-first walk below is only for a box without one
    # (or whose recorded interpreter is gone; then we say so and romp-sdk-setup rebuilds to match).
    # Builtins only in here: the unit tests run it on a bare PATH. Kept in sync with romp-sdk-setup.
    local state="${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}"
    local cfg="$state/sdkvenv/pyvenv.cfg"
    if [[ -r "$cfg" ]]; then
        local key val exe="" home="" ver="" mm=""
        while IFS='=' read -r key val || [[ -n "$key" ]]; do
            key="${key%%[[:space:]]*}"
            val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
            case "$key" in
                executable)           exe="$val" ;;    # python >= 3.11 writes the binary itself
                home)                 home="$val" ;;   # older venvs: the bin dir plus a version line
                version|version_info) ver="$val" ;;    # `version` from venv, `version_info` from uv
            esac
        done < "$cfg"
        [[ "$ver" =~ ^([0-9]+\.[0-9]+) ]] && mm="${BASH_REMATCH[1]}"
        for c in "$exe" "${home:+$home/python$mm}" "${home:+$home/python3}"; do
            [[ -n "$c" && -x "$c" ]] || continue
            if "$c" -c pass >/dev/null 2>&1; then echo "$c"; return; fi
        done
        echo "romp: the SDK venv at $state/sdkvenv was built with ${exe:-${home:-?}/python$mm}, which is gone or will not run; picking the newest python instead. Re-run bin/romp-sdk-setup to rebuild the venv for it." >&2
    fi
    # Newest first. The list has to GROW with each release: a machine whose only python is newer than
    # everything named here falls through to `python3`, which is right when that IS the new one and wrong
    # when python3 points at something ancient. Seen on a 3.14-only box, 2026-07-28.
    for v in 3.14 3.13 3.12 3.11 3.10; do
        for c in "python$v" "$HOME/.local/bin/python$v"; do
            if command -v "$c" >/dev/null 2>&1; then command -v "$c"; return; fi
        done
    done
    command -v python3 || { echo "romp: no python3 on PATH" >&2; exit 1; }
}
PY="$(pick_python)"

pyver() { "$1" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || echo "?"; }
if ! "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)'; then
  echo "romp-sdk-setup: best python found is $PY ($(pyver "$PY")) but claude-agent-sdk needs >= 3.10." >&2
  echo "romp-sdk-setup: install one (e.g. 'uv python install 3.12') and re-run. tmux sessions are unaffected." >&2
  exit 1
fi

# Debian/Ubuntu ship a python3 whose venv module cannot bootstrap pip: ensurepip is split into a
# separate python3-venv package. `python3 -m venv` there still creates bin/python symlinks and THEN
# fails, leaving a pip-less husk.
#
# This used to stop here and tell the user to `sudo apt install python3-venv`. But an installer cannot
# sudo for you, so that turned romp's OWN critical dependency into homework — and the SDK backend is
# what plain `romp new` uses, so a machine that skipped it has a romp that cannot start a session at
# all (the user 2026-07-28, on a python3.14 box: install "succeeded", every session silently swallowed
# its messages). So DON'T stop: build the venv without pip and bootstrap pip into it from PyPA's
# canonical get-pip.py, which needs no root. Only when THAT fails too (offline, no fetcher) do we fall
# back to naming the package. ROMP_GET_PIP_URL overrides the source; ROMP_NO_GET_PIP=1 opts out of the
# fetch entirely for anyone who would rather install the OS package themselves.
GET_PIP_URL="${ROMP_GET_PIP_URL:-https://bootstrap.pypa.io/get-pip.py}"

fetch() {   # $1 url → $2 dest, with whichever fetcher the box has
  if command -v curl >/dev/null 2>&1; then curl -fsSL --max-time 60 "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then wget -qO "$2" "$1"
  else return 1; fi
}

make_venv() {
  if "$PY" -c 'import ensurepip' >/dev/null 2>&1; then
    "$PY" -m venv "$VENV"
    return
  fi
  if [ -n "${ROMP_NO_GET_PIP:-}" ]; then return 1; fi
  echo "romp-sdk-setup: $PY has no 'ensurepip' — bootstrapping pip from $GET_PIP_URL (no sudo needed)"
  "$PY" -m venv --without-pip "$VENV" || return 1
  [ -x "$VENV/bin/python" ] || return 1
  fetch "$GET_PIP_URL" "$VENV/get-pip.py" || return 1
  "$VENV/bin/python" "$VENV/get-pip.py" -q || return 1
  rm -f "$VENV/get-pip.py"
  [ -x "$VENV/bin/pip" ]
}

mkdir -p "$STATE"
# The python X.Y an existing venv was built for: its own python when that still runs, else the
# version pyvenv.cfg recorded (the interpreter may be gone, and "?" would hide what is being replaced).
venv_built_for() {
  local v
  if [ -x "$VENV/bin/python" ]; then
    v="$(pyver "$VENV/bin/python")"
    [ "$v" != "?" ] && { echo "$v"; return; }
  fi
  if [ -r "$VENV/pyvenv.cfg" ]; then
    v="$(sed -n 's/^version[_a-z]* *= *\([0-9]*\.[0-9]*\).*/\1/p' "$VENV/pyvenv.cfg" | head -1)"
    [ -n "$v" ] && { echo "$v"; return; }
  fi
  echo "?"
}
# A venv built with a DIFFERENT python than the kernel will run is worse than none: the kernel imports
# its site-packages in-process, and 3.X-compiled extensions fail to import under 3.Y. Rebuild on
# mismatch. Since pick_python follows the venv's own interpreter, a mismatch here is always a
# deliberate change (ROMP_PYTHON names another interpreter) or a lost one (the recorded interpreter
# is gone), and a kernel already running on the old python keeps working only until it restarts, so
# say what is happening and what has to follow (2026-09-06: a silent mismatch took every SDK session
# down for two hours, with a message that blamed a missing install).
if [ -e "$VENV/pyvenv.cfg" ] || [ -x "$VENV/bin/python" ]; then
  _built="$(venv_built_for)"; _want="$(pyver "$PY")"
  if [ "$_built" != "$_want" ]; then
    echo "romp-sdk-setup: REBUILDING the SDK venv for python $_want ($PY): it was built for python $_built." >&2
    echo "romp-sdk-setup:   The kernel must run python $_want from its next start. If ROMP_PYTHON chose this interpreter, set it where the service reads its environment too (otherwise romp-serve follows the rebuilt venv on its own); then restart romp (romp refresh) once this finishes." >&2
    rm -rf "$VENV"
  fi
fi
# Gate on pip, not just python: a previous run that died mid-bootstrap (see ensurepip above) leaves
# bin/python present but bin/pip absent, and gating on python alone would skip the rebuild forever.
if [ ! -x "$VENV/bin/python" ] || [ ! -x "$VENV/bin/pip" ]; then
  echo "romp-sdk-setup: creating venv at $VENV (python: $PY)"
  rm -rf "$VENV"
  if ! make_venv; then
    # Never leave a pip-less husk behind for the next run to trip over — that husk is what made the
    # earlier failure surface as a bare "No such file or directory" at the pip line.
    rm -rf "$VENV"
    echo "romp-sdk-setup: could not build a venv with pip in it." >&2
    if ! "$PY" -c 'import ensurepip' >/dev/null 2>&1; then
      echo "  $PY has no 'ensurepip', and bootstrapping pip from $GET_PIP_URL did not work (offline?)." >&2
      echo "  Debian/Ubuntu: sudo apt install python$(pyver "$PY")-venv   (or: sudo apt install python3-venv)" >&2
    fi
    echo "  Then re-run: $0" >&2
    echo "  romp still runs without this; only the SDK backend (plain \`romp new\`) is disabled." >&2
    exit 1
  fi
fi
"$VENV/bin/pip" install -q --upgrade pip >/dev/null
"$VENV/bin/pip" install -q --upgrade claude-agent-sdk
"$VENV/bin/python" - <<'PY'
import claude_agent_sdk as m, sys
print("romp-sdk-setup: claude-agent-sdk %s ready (python %s)" % (m.__version__, ".".join(map(str, sys.version_info[:3]))))
PY
echo "romp-sdk-setup: done — the kernel will pick this up automatically (no restart-side config)."
