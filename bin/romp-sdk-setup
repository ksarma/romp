#!/usr/bin/env bash
# romp-sdk-setup — provision the Claude Agent SDK for romp's Claude Code backend, plus the
# `cryptography` package phone and browser notifications need (the kernel's only other dependency).
#
# Rather than install the SDK into the system python (PEP 668 / externally-managed envs), we keep
# it in a DEDICATED venv under romp's state dir and the kernel adds that venv's site-packages to
# sys.path (see _ensure_sdk_on_path in bin/romp-kernel). The venv is built with the SAME python the
# kernel runs (pick_python below matches bin/romp-serve's), so the ABI matches. Both pickers follow
# the venv's own recorded interpreter once one exists, so a re-run keeps the interpreter and only
# installs the SDK; the venv is REBUILT for a different python only when ROMP_PYTHON names one or the
# recorded interpreter is gone, loudly (see below). Idempotent. Re-run after a pull that moves the pin.
#
# The SDK is installed at ONE version, never upgraded open-endedly: kernel/session_host.py imports the SDK's
# private internals (claude_agent_sdk._internal) with no fallback, and a release that moves one fails every
# hosted session launch. Until 2026-09-18 this line ran `pip install --upgrade claude-agent-sdk`, so a routine
# re-run could install that release with nothing here to say so (the box admin's hazard review of the
# pull-in, 2026-09-16). The version is declared once, as SDK_TESTED_VERSION in kernel/session_host.py, beside
# the imports it was verified against; this script reads that line and pins pip to it, and the host refuses to
# start on another version whose internals are gone (see sdk_internals there).
set -euo pipefail
STATE="${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}"
VENV="$STATE/sdkvenv"
# Resolve the repo root through any symlink (matches bin/romp-serve and the other bin/ consumers; regression-2,
# round 1 of the review, 2026-09-18: a bare dirname "$0" resolved the LINK's directory, so a symlinked invocation
# looked for kernel/session_host.py beside the link and died at the sed below).
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
    tgt="$(readlink "$src")"
    case "$tgt" in
        /*) src="$tgt" ;;
        *)  src="$(cd "$(dirname "$src")" && pwd)/$tgt" ;;
    esac
done
ROMP_DIR="$(cd "$(dirname "$src")/.." && pwd)"
SDK_PIN_SOURCE="$ROMP_DIR/kernel/session_host.py"
# The pin read is gated on a readable file and never lets the assignment end the shell (kernel-2, round 1 of the
# review, 2026-09-18): under set -euo pipefail a sed over a missing or unreadable file ended the script here with
# a bare "sed: can't read ..." at exit 2, and the guidance below, which names the line and where it belongs, was
# never reached. sed's own reason still prints (no 2>/dev/null) above the guidance when it fails another way.
SDK_VERSION=""
if [[ -r "$SDK_PIN_SOURCE" ]]; then
    SDK_VERSION="$(sed -n 's/^SDK_TESTED_VERSION = "\([^"]*\)".*$/\1/p' "$SDK_PIN_SOURCE" | head -1 || true)"
fi
if [[ ! "$SDK_VERSION" =~ ^[0-9]+\.[0-9]+ ]]; then
    if [[ ! -r "$SDK_PIN_SOURCE" ]]; then
        echo "romp-sdk-setup: no readable kernel/session_host.py at $SDK_PIN_SOURCE (a partial checkout, or a copy of this script outside one?). The SDK is installed at the version the session host is written against, declared as SDK_TESTED_VERSION in that file; nothing is installed without it." >&2
    else
        echo "romp-sdk-setup: no SDK_TESTED_VERSION line in $SDK_PIN_SOURCE (read: '${SDK_VERSION}'). The SDK is installed at the version the session host is written against, declared on that line; nothing is installed without it." >&2
    fi
    exit 1
fi

# The Agent SDK needs python >= 3.10; some hosts pin the system python3 older (Ubuntu 20.04 = 3.8)
# with a newer one alongside (e.g. a uv-managed 3.12 in ~/.local/bin, probed explicitly because a
# non-login ssh shell doesn't have it on PATH). Order: ROMP_PYTHON (checked to be an executable
# interpreter), then the interpreter the existing venv records (checked to run and to be the recorded
# X.Y and the build its lib directory names), then another python of that same X.Y and build on PATH or
# in ~/.local/bin, then the newest pythonX.Y found.
# KEEP IN SYNC with bin/romp-serve's pick_python, byte for byte (tests/romp-serve.bats diffs the
# copies): the kernel must run the interpreter this venv is built with.
pick_python() {
    if [[ -n "${ROMP_PYTHON:-}" ]]; then
        # The pin is checked, not echoed as-is. A pin naming nothing runnable used to reach romp-serve's
        # exec, which died on bash's own "No such file or directory" with no mention of the pin while the
        # manager crash-looped on it, and romp-sdk-setup called the same pin a too-old python. The docs
        # tell operators to pin ROMP_PYTHON in service.env, so a typo, or an upgrade that removes the
        # pinned interpreter, lands here. A bare command name is looked up on PATH, as the exec would.
        local pin="$ROMP_PYTHON"
        [[ "$pin" == */* ]] || pin="$(type -P "$pin" 2>/dev/null || true)"
        if [[ -z "$pin" || ! -f "$pin" || ! -x "$pin" ]]; then
            echo "romp: ROMP_PYTHON=$ROMP_PYTHON is not an executable interpreter (set in service.env?)" >&2
            exit 1
        fi
        echo "$ROMP_PYTHON"; return
    fi
    local v c
    # THE VENV FIRST. bin/romp-sdk-setup builds the SDK venv with the interpreter this function picked at
    # the time, and pyvenv.cfg records it. Running anything else imports 3.X-compiled extensions into a
    # 3.Y process: on 2026-09-06 a `uv python install 3.14` in an unrelated shell put a python3.14 into
    # ~/.local/bin, the next kernel respawn picked it over the venv's 3.12, and every SDK session died at
    # import for two hours while the message blamed a missing install. So a machine that HAS a venv runs
    # the venv's interpreter, however old, and the newest-first walk below is only for a machine without
    # one (or whose recorded interpreter is gone; then we say so and romp-sdk-setup rebuilds to match).
    # Builtins only in here: the unit tests run it on a bare PATH. This function is kept byte for byte
    # with its copies in bin/romp-serve, bin/romp-sdk-setup and bin/romp-codex-setup (tests/romp-serve.bats
    # diffs the three).
    #
    # A candidate must RUN, and when the cfg names a version it must BE the python the venv was built for:
    # the X.Y the cfg records plus the build, `t` for a free-threaded interpreter, read from the tag venv
    # names lib/ with (lib/python3.14t; the cfg does not say). The kernel keys its venv match on that same
    # tag (_running_python_tag), so a default-build 3.14 handed a 3.14t venv would boot and then refuse the
    # venv as a mismatch. `home` is a directory, and a distro upgrade that removes python3.12 and repoints
    # home/python3 at 3.14 leaves that path present and runnable while the venv's extensions are still
    # 3.12's, the exact failure the recorded interpreter exists to prevent. The check reads
    # sys.version_info and sys.abiflags (builtins only; the build is decided by the flags, never by the
    # file name: uv's free-threaded install has python3.14 as a link to python3.14t), and it is bounded:
    # this is the first place the picker executes a candidate, and an interpreter that blocks (a stalled
    # network mount, a sitecustomize reaching for the network) would otherwise hang the launch with the
    # manager watching a live pid. `timeout 5` where coreutils provides it (a bare test PATH does not);
    # running out the clock counts as not runnable.
    _runs_as() {   # $1 candidate, $2 the X.Y it must be ("" for "runs at all"), $3 the build: "t" or ""
        local -a run=("$1")
        if command -v timeout >/dev/null 2>&1; then run=(timeout 5 "$1"); fi
        if [[ -n "$2" ]]; then
            "${run[@]}" -c "import sys; sys.exit(sys.version_info[:2] != (${2%%.*}, ${2#*.}) or ('t' in getattr(sys, 'abiflags', '')) != bool('${3:-}'))" >/dev/null 2>&1
        else
            "${run[@]}" -c pass >/dev/null 2>&1
        fi
    }
    local state="${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}"
    local cfg="$state/sdkvenv/pyvenv.cfg"
    if [[ -r "$cfg" ]]; then
        local key val exe="" home="" ver="" mm="" abi="" tag=""
        while IFS='=' read -r key val || [[ -n "$key" ]]; do
            key="${key%%[[:space:]]*}"
            val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
            case "$key" in
                executable)           exe="$val" ;;    # python >= 3.11 writes the binary itself
                home)                 home="$val" ;;   # older venvs: the bin dir plus a version line
                version|version_info) ver="$val" ;;    # `version` from venv, `version_info` from uv
            esac
        done < "$cfg"
        [[ "$ver" =~ ^([0-9]+\.[0-9]+) ]] && mm="${BASH_REMATCH[1]}"
        # The build, from the lib directory carrying the cfg's X.Y: lib/python3.14t is a free-threaded
        # venv. A cfg with no such directory reads as the default build, as romp-sdk-setup's
        # venv_built_for reads it.
        if [[ -n "$mm" && ! -d "$state/sdkvenv/lib/python$mm" && -d "$state/sdkvenv/lib/python${mm}t" ]]; then abi="t"; fi
        tag="$mm$abi"
        # The home candidates need the version. Without it `$home/python$mm` is the bare `$home/python`
        # (python2 on many machines) and `$home/python3` can be checked against nothing, so a cfg with a
        # home but no version line (hand-edited or truncated; venv, uv and virtualenv all write one)
        # yields only its `executable`, the recorded binary itself. A tagged venv tries home/python3.14t
        # and then home/python3.14 (a link to the t build in uv's layout; a default build under that name
        # fails the flags check, where it used to be taken silently).
        for c in "$exe" "${mm:+${home:+$home/python$tag}}" "${abi:+${mm:+${home:+$home/python$mm}}}" "${mm:+${home:+$home/python3}}"; do
            [[ -n "$c" && -x "$c" ]] || continue
            if _runs_as "$c" "$mm" "$abi"; then echo "$c"; return; fi
        done
        local rec="${exe:-${home:-?}/python${tag:-?}}"
        # THE SAME BUILD NEXT. The venv's site-packages are ABI-valid for any python of its tag, so another
        # python$tag on PATH or in ~/.local/bin keeps the kernel and the venv agreeing with nothing rebuilt:
        # `executable` is a realpath into a patch-versioned install root (Homebrew's Cellar, a uv
        # per-patch directory), which a patch upgrade removes while `python3.12` on PATH still runs. A
        # tagged venv tries python3.14t first and python3.14 after it; an untagged venv tries python3.14
        # alone, and a free-threaded build under that name is refused. Newest-first is the last resort,
        # and it costs a rebuild.
        if [[ -n "$mm" ]]; then
            local -a same=("python$tag" "$HOME/.local/bin/python$tag")
            [[ -n "$abi" ]] && same+=("python$mm" "$HOME/.local/bin/python$mm")
            for c in "${same[@]}"; do
                c="$(command -v "$c" 2>/dev/null || true)"
                [[ -n "$c" ]] || continue
                if _runs_as "$c" "$mm" "$abi"; then
                    echo "romp: the SDK venv at $state/sdkvenv was built with $rec, which is gone, will not run, or is no longer python $tag; using $c, another python $tag (the same minor and the same build), so the venv still matches." >&2
                    echo "$c"; return
                fi
            done
        fi
        echo "romp: the SDK venv at $state/sdkvenv was built with $rec, which is gone, will not run, or is no longer python ${tag:-?}, and no other python ${tag:-?} was found; picking the newest python instead. Re-run bin/romp-sdk-setup to rebuild the venv for it." >&2
    fi
    # Newest first. The list has to GROW with each release: a machine whose only python is newer than
    # everything named here falls through to `python3`, which is right when that IS the new one and wrong
    # when python3 points at something ancient. Seen on a 3.14-only box, 2026-07-28.
    for v in 3.14 3.13 3.12 3.11 3.10; do
        for c in "python$v" "$HOME/.local/bin/python$v"; do
            if command -v "$c" >/dev/null 2>&1; then command -v "$c"; return; fi
        done
    done
    command -v python3 || { echo "romp: no python3 on PATH" >&2; exit 1; }
}
PY="$(pick_python)"

pyver() { "$1" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || echo "?"; }
# The tag venv names a lib directory with: X.Y, plus `t` for a free-threaded build (lib/python3.14t). The
# rebuild compare below is on this tag, not on X.Y, so a move between a free-threaded build and a default
# one of the same minor rebuilds: the kernel keys its venv match on the same tag (_running_python_tag).
pytag() { "$1" -c 'import sys; print("%d.%d%s" % (sys.version_info[0], sys.version_info[1], "t" if "t" in getattr(sys, "abiflags", "") else ""))' 2>/dev/null || echo "?"; }
if ! "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)'; then
  echo "romp-sdk-setup: best python found is $PY ($(pyver "$PY")) but claude-agent-sdk needs >= 3.10." >&2
  echo "romp-sdk-setup: install one (e.g. 'uv python install 3.12') and re-run." >&2
  exit 1
fi

# Debian/Ubuntu ship a python3 whose venv module cannot bootstrap pip: ensurepip is split into a
# separate python3-venv package. `python3 -m venv` there still creates bin/python symlinks and THEN
# fails, leaving a pip-less husk.
#
# This used to stop here and tell the user to `sudo apt install python3-venv`. But an installer cannot
# sudo for you, so that turned romp's OWN critical dependency into homework — and the SDK backend is
# what plain `romp new` uses, so a machine that skipped it has a romp that cannot start a session at
# all (the user 2026-07-28, on a python3.14 box: install "succeeded", every session silently swallowed
# its messages). So DON'T stop: build the venv without pip and bootstrap pip into it from PyPA's
# canonical get-pip.py, which needs no root. Only when THAT fails too (offline, no fetcher) do we fall
# back to naming the package. ROMP_GET_PIP_URL overrides the source; ROMP_NO_GET_PIP=1 opts out of the
# fetch entirely for anyone who would rather install the OS package themselves.
GET_PIP_URL="${ROMP_GET_PIP_URL:-https://bootstrap.pypa.io/get-pip.py}"

fetch() {   # $1 url → $2 dest, with whichever fetcher the box has
  if command -v curl >/dev/null 2>&1; then curl -fsSL --max-time 60 "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then wget -qO "$2" "$1"
  else return 1; fi
}

make_venv() {
  if "$PY" -c 'import ensurepip' >/dev/null 2>&1; then
    "$PY" -m venv "$VENV"
    return
  fi
  if [ -n "${ROMP_NO_GET_PIP:-}" ]; then return 1; fi
  echo "romp-sdk-setup: $PY has no 'ensurepip' — bootstrapping pip from $GET_PIP_URL (no sudo needed)"
  "$PY" -m venv --without-pip "$VENV" || return 1
  [ -x "$VENV/bin/python" ] || return 1
  fetch "$GET_PIP_URL" "$VENV/get-pip.py" || return 1
  "$VENV/bin/python" "$VENV/get-pip.py" -q || return 1
  rm -f "$VENV/get-pip.py"
  [ -x "$VENV/bin/pip" ]
}

mkdir -p "$STATE"
# The python tag an existing venv was built for, from the venv's own RECORD: the X.Y pyvenv.cfg wrote
# down, plus the abi tag its lib/python3.X{t} directory carries (venv appends `t` for a free-threaded
# build; the cfg does not say). Never the venv's live bin/python. That is a symlink to the base
# interpreter, unversioned when the venv was built under a pin like ROMP_PYTHON=/usr/bin/python3 (the
# form the docs' move recipe invites), and after a distro upgrade repoints python3 it answers the NEW
# version while lib/ is still the old one: compared that way the venv read as a match, no rebuild
# fired, pip ran a 3.14 inside a 3.12 venv, and the session card's remedy (re-run this script) changed
# nothing. "?" when there is no record at all.
venv_built_for() {
  local v="" lib tag
  if [ -r "$VENV/pyvenv.cfg" ]; then
    v="$(sed -n 's/^version[_a-z]* *= *\([0-9]*\.[0-9]*\).*/\1/p' "$VENV/pyvenv.cfg" | head -1)"
  fi
  for lib in "$VENV"/lib/python3.*; do
    [ -d "$lib" ] || continue
    tag="${lib##*/python}"
    if [ -z "$v" ] || [ "${tag%t}" = "$v" ]; then echo "$tag"; return; fi
  done
  echo "${v:-?}"
}
# A venv built with a DIFFERENT python than the kernel will run is worse than none: the kernel imports
# its site-packages in-process, and 3.X-compiled extensions fail to import under 3.Y. Rebuild on
# mismatch. Since pick_python follows the venv's own interpreter, a mismatch here is always a
# deliberate change (ROMP_PYTHON names another interpreter) or a lost one (the recorded interpreter
# is gone), and a kernel already running on the old python keeps working only until it restarts, so
# say what is happening and what has to follow (2026-09-06: a silent mismatch took every SDK session
# down for two hours, with a message that blamed a missing install).
if [ -e "$VENV/pyvenv.cfg" ] || [ -d "$VENV/lib" ] || [ -x "$VENV/bin/python" ]; then
  _built="$(venv_built_for)"; _want="$(pytag "$PY")"
  if [ "$_built" != "$_want" ]; then
    echo "romp-sdk-setup: REBUILDING the SDK venv for python $_want ($PY): it was built for python $_built." >&2
    echo "romp-sdk-setup:   The kernel must run python $_want from its next start. If ROMP_PYTHON chose this interpreter, set it where the service reads its environment too (otherwise romp-serve follows the rebuilt venv on its own); then restart romp (romp refresh) once this finishes." >&2
    rm -rf "$VENV"
  fi
fi
# Gate on pip, not just python: a previous run that died mid-bootstrap (see ensurepip above) leaves
# bin/python present but bin/pip absent, and gating on python alone would skip the rebuild forever.
if [ ! -x "$VENV/bin/python" ] || [ ! -x "$VENV/bin/pip" ]; then
  echo "romp-sdk-setup: creating venv at $VENV (python: $PY)"
  rm -rf "$VENV"
  if ! make_venv; then
    # Never leave a pip-less husk behind for the next run to trip over — that husk is what made the
    # earlier failure surface as a bare "No such file or directory" at the pip line.
    rm -rf "$VENV"
    echo "romp-sdk-setup: could not build a venv with pip in it." >&2
    if ! "$PY" -c 'import ensurepip' >/dev/null 2>&1; then
      echo "  $PY has no 'ensurepip', and bootstrapping pip from $GET_PIP_URL did not work (offline?)." >&2
      echo "  Debian/Ubuntu: sudo apt install python$(pyver "$PY")-venv   (or: sudo apt install python3-venv)" >&2
    fi
    echo "  Then re-run: $0" >&2
    echo "  romp still runs without this; only the SDK backend (plain \`romp new\`) is disabled." >&2
    exit 1
  fi
fi
"$VENV/bin/pip" install -q --upgrade pip >/dev/null
# Pinned (the header says why): `==`, so a re-run moves the venv to the tested version in either direction and
# never past it. The message names the version and where it is declared, so an operator reading the install
# output knows what a later `pip list` should show and where to change it.
echo "romp-sdk-setup: installing claude-agent-sdk==$SDK_VERSION, the version the session host is written against (SDK_TESTED_VERSION in kernel/session_host.py)"
"$VENV/bin/pip" install -q "claude-agent-sdk==$SDK_VERSION"
# cryptography: what phone and browser notifications (Web Push: VAPID signing, payload encryption)
# need on the kernel host, the kernel's one soft dependency beyond the SDK (_push_crypto in
# kernel/kernel.py reads it from this venv). Nothing installed it until 2026-09-14, so a fresh
# install's bell answered every subscribe with the missing package named and no way to get it.
# Its OWN pip run, after the SDK's: a wheel that will not install here (an exotic platform with
# no binary wheel and no Rust toolchain) must not take the SDK backend down with it, so the
# failure is named with the consequence and the command, and this script still exits 0. The
# kernel runs without it; only the notifications to a phone or browser stay off until it is in.
if ! "$VENV/bin/pip" install -q --upgrade cryptography; then
  echo "romp-sdk-setup: could not install 'cryptography' (the line above says why). romp runs without it, but phone and browser notifications stay off until it is installed:  $VENV/bin/pip install cryptography" >&2
fi
# The verify step reads the version THE WAY THE HOST READS IT (extra7-3 and extra8-1, round 3 of the review,
# 2026-09-19): kernel/session_host.py is loaded by path under the venv's python and its installed_sdk_version()
# is called, so the installer and every host launch share one implementation and one preference order (the
# imported module's own __version__ first, the package metadata as the fallback for a package that exports
# none). Until round 3 this step read importlib.metadata alone while the host had moved to the module, so a
# site whose module and dist-info disagree (a checkout or vendored copy ahead of the venv on the import path)
# was reported ready here, at the pin, and then refused or flagged at every host launch. The metadata is still
# read, as a SECOND check with its own words: a venv whose own record names another version is not ready even
# when the module that imports happens to be the pin.
ROMP_SDK_VENV="$VENV" ROMP_SDK_PIN="$SDK_VERSION" ROMP_SDK_PIN_SOURCE="$SDK_PIN_SOURCE" "$VENV/bin/python" - <<'PY'
import importlib.metadata, importlib.util, os, sys
src = os.environ["ROMP_SDK_PIN_SOURCE"]
spec = importlib.util.spec_from_file_location("romp_session_host_verify", src)
host = importlib.util.module_from_spec(spec)
spec.loader.exec_module(host)                        # the host's own reader, not a copy of it
want = os.environ.get("ROMP_SDK_PIN", "")
pyver = ".".join(map(str, sys.version_info[:3]))
try:
    import claude_agent_sdk as m
except Exception as e:                               # the host's next step, the internals import, raises the same
    print("romp-sdk-setup: claude-agent-sdk does not import under the venv's python (%s) after an install of ==%s: %s: %s. pip's output above says why; fix that and re-run." % (pyver, want, type(e).__name__, e), file=sys.stderr)
    sys.exit(1)
where = getattr(m, "__file__", None) or "(a package with no file)"
have = host.installed_sdk_version()                  # what a host launched on this venv would read and compare to the pin
try:
    meta = importlib.metadata.version(host.SDK_DIST)
except importlib.metadata.PackageNotFoundError:
    meta = None
if have is None:
    print("romp-sdk-setup: claude-agent-sdk imports from %s but says no version (no __version__ on the module, no package metadata); the session host would run it as an unknown version and file a problem row at every launch. pip's output above says why; fix that and re-run." % where, file=sys.stderr)
    sys.exit(1)
if want and have != want:
    if meta is not None and meta != have:
        # the split the host's read exists to catch: the module that imports is not the package the venv's metadata describes
        print("romp-sdk-setup: the claude_agent_sdk that imports under the venv's python is %s (from %s) while the venv's package metadata says %s; the session host reads the module, as this check does, so every host launch would run %s and not the %s this script installed. Something ahead of the venv's site on the import path (PYTHONPATH, a checkout, a vendored copy) shadows the install; remove it or point it at the venv, then re-run." % (have, where, meta, have, want), file=sys.stderr)
    else:
        print("romp-sdk-setup: the venv holds claude-agent-sdk %s after an install of ==%s; the session host is written against %s and refuses to start on another version whose internals moved. pip's output above says why; fix that and re-run." % (have, want, want), file=sys.stderr)
    sys.exit(1)
if meta is not None and meta != have:
    # the second check: the module is the pin, the venv's own record is not; the host would run, on a copy that is not this venv's install
    print("romp-sdk-setup: claude_agent_sdk %s imports (from %s), the pinned version, but the venv's package metadata says %s: the module that runs is not the one pip installed here. pip's output above says why the venv holds %s; fix that and re-run." % (have, where, meta, meta), file=sys.stderr)
    sys.exit(1)
mv = getattr(m, "__version__", None)
source = ("the module's __version__" if isinstance(mv, str) and mv else "the package metadata, since the module exports no __version__")
print("romp-sdk-setup: claude-agent-sdk %s ready (python %s), the version kernel/session_host.py is written against, read as the session host reads it (%s, from %s)" % (have, pyver, source, where))
try:
    import cryptography
    print("romp-sdk-setup: cryptography %s ready (phone and browser notifications)" % cryptography.__version__)
except ImportError:
    print("romp-sdk-setup: 'cryptography' does not import from the venv; phone and browser notifications stay off until it does:  %s/bin/pip install cryptography" % os.environ.get("ROMP_SDK_VENV", "<venv>"), file=sys.stderr)
PY
echo "romp-sdk-setup: done — the kernel will pick this up automatically (no restart-side config)."
