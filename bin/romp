print("stages    jobs %s   push %s  (chat %s  feed %s  timeline %s  send %s)   %s"
      % (tuple(share(st[k]) for k in ("jobs", "push", "push.chat", "push.feed", "push.timeline", "push.send")) + (connect,)))
