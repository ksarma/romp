import json, sys
a, b = json.loads(sys.argv[1]), json.loads(sys.argv[2])


def g(d, *ks):
    for k in ks:
        d = d.get(k, {}) if isinstance(d, dict) else {}
    return d if isinstance(d, (int, float)) else 0


def dl(*ks):                      # delta of a counter between the two snapshots
    return g(b, *ks) - g(a, *ks)


if a.get("since") != b.get("since") or g(a, "process", "pid") != g(b, "process", "pid"):
    # the counters live in the kernel process and start over with it: a subtraction across a
    # restart is a page of negative rates that look like measurements
    sys.stderr.write("romp perf: the kernel restarted during the window (pid %d -> %d), so the counters "
                     "reset and there are no rates to print; run it again\n"
                     % (g(a, "process", "pid"), g(b, "process", "pid")))
    sys.exit(1)

dt = max(g(b, "now") - g(a, "now"), 1e-9)
cyc = dl("pusher", "cycles")
cyc_ms = dl("pusher", "cycle_ms_sum")
wakes = dl("pusher", "wakes")
ev, bs = dl("pusher", "wakes_event"), dl("pusher", "wakes_backstop")
held, held_ms, exempt = dl("pusher", "held"), dl("pusher", "held_ms"), dl("pusher", "exempt")
cpu_proc = 100.0 * dl("process", "cpu_s") / dt
cpu_pusher = 100.0 * dl("pusher", "cycle_cpu_ms_sum") / (dt * 1000.0)
cpu_judge = 100.0 * dl("judge", "cpu_ms_sum") / (dt * 1000.0)
# the judge's CPU carries no REPORTED workers' share when the newer snapshot's judge block has no cpu_ms_workers: the
# kernel opens that key when it arms judge.py's worker-CPU sink at load and serves it exactly while its collector holds
# the sink, so a block without it is from a collector that is not the sink now (nothing armed it, or a later kernel
# load displaced it; a test process), and no workers' share lands in that collector from then on. The note means this
# block cannot tell you how much of the window's figure is the share, not that the share is absent from it: a window
# that begins after the displacement has none, a window that straddles it still carries what landed while armed. The
# two lines that print the note say so rather than pass the figure off as measured whole (the review ruling on the
# write-time fold, 2026-09-18; the displaced case from review round 1; review round 2, 2026-09-19, restored this
# hedge, which the sibling copies in kernel.py's docstring and docs/reference.md carry)
_jb = b.get("judge")
workers_note = "" if "cpu_ms_workers" in (_jb if isinstance(_jb, dict) else {}) else " (workers' share not reported)"
up = int(g(b, "uptime_s"))


def hms(sec):
    h, m = divmod(sec // 60, 60)
    return "%dh%02dm" % (h, m) if h else "%dm%02ds" % (m, sec % 60)


def kb(n):                        # bytes over the window as a rate
    return "%.0f KB/s" % (n / 1024.0 / dt) if n < 1024 * 1024 * dt else "%.1f MB/s" % (n / 1048576.0 / dt)


def share(ms):                    # a pusher-owned stage's share of the PUSHER'S cycle time over the window: the numerator is a
    #                               stages_ms row and the divisor the pusher's cycle_ms_sum. The five push numerators (push,
    #                               push.chat, push.feed, push.timeline, push.send) are the pusher's own since 2026-09-18
    #                               (kernel/kernel.py, _PerfStats.stage credits a push stage to the thread that owns the pusher's
    #                               cycle: a connect push's stages, closed on a handler thread under the "connect" mark, ride
    #                               pusher.connectPush.stagesMs and print apart below, and a push stage from a thread that neither
    #                               owns the cycle nor carries the mark counts under stagesForeign, in no share), so no push share
    #                               here counts time the pusher's cycles never spent (before the split the chat share read above
    #                               the push share, or above one hundred percent, while pages reloaded). The sixth numerator,
    #                               stages_ms.jobs, is not routed: stage() adds a bare `jobs` write to the flat row for every
    #                               writer under every mark, and the row is the pusher's because _pusher_cycle_jobs, inside the
    #                               pusher's cycle, is its one writer (tests/test_perf_stats.py holds the call-site count to one)
    return "%3.0f%%" % (100.0 * ms / cyc_ms) if cyc_ms else "  -"


print("romp perf: %.1f s window, kernel up %s, pid %d, romp-perf log %s"
      % (dt, hms(up), g(b, "process", "pid"), "on" if b.get("log") else "off"))
print("process   rss %d MB   threads %d   cpu %.1f%% of one core (pusher %.1f%%, judge %.1f%%%s, other %.1f%%)"
      % (g(b, "process", "rss_kb") // 1024, g(b, "process", "threads"), cpu_proc, cpu_pusher, cpu_judge, workers_note,
         cpu_proc - cpu_pusher - cpu_judge))
pb, pa = (b.get("process") or {}), (a.get("process") or {})
if "allocated_blocks" in pb:
    # the exact memory gauges (M1-lite): levels from the newer snapshot, the window's delta beside the ones
    # whose movement answers the RSS question (blocks flat while rss climbs: the allocator; blocks climbing:
    # an object graph; a cache gauge climbing: that cache). A kernel without them prints neither line.
    def mbk(kb):
        return "%d MB" % (int(kb) // 1024)

    def mbb(nbytes):
        return "%.0f MB" % (nbytes / 1048576.0)

    parts = ["rss %s (%+d MB)" % (mbk(pb.get("rss_kb") or 0), (int(pb.get("rss_kb") or 0) - int(pa.get("rss_kb") or 0)) // 1024)]
    src = pb.get("source")
    if src not in (None, "proc", "task_info"):              # a reader is down: a Mac on its ps fallback, or no current reader at
        parts.append("source %s" % src + (", rss is the peak" if src == "unavailable" else ""))   # all (rss_kb is then the peak)
    if pb.get("rss_anon_kb") is not None:
        parts.append("anon %s" % mbk(pb["rss_anon_kb"]))
    if pb.get("hwm_kb") is not None:
        parts.append("hwm %s" % mbk(pb["hwm_kb"]))
    if pb.get("rss_peak_kb") is not None:                   # macOS: ru_maxrss, the lifetime peak beside the current size (2026-09-18)
        parts.append("peak %s" % mbk(pb["rss_peak_kb"]))
    if pb.get("allocated_blocks") is not None:
        parts.append("blocks %d (%+d)" % (pb["allocated_blocks"], pb["allocated_blocks"] - (pa.get("allocated_blocks") or pb["allocated_blocks"])))
    if pb.get("gc_gen2") is not None:
        parts.append("gc2 %d (%+d)" % (pb["gc_gen2"], pb["gc_gen2"] - (pa.get("gc_gen2") if pa.get("gc_gen2") is not None else pb["gc_gen2"])))
    m, ma = pb.get("malloc"), (pa.get("malloc") or {})
    if isinstance(m, dict):
        parts.append("malloc arena %s, in use %s, free %s (%+.0f MB), mmap %s"
                     % (mbb(m.get("arena", 0)), mbb(m.get("uordblks", 0)), mbb(m.get("fordblks", 0)),
                        (m.get("fordblks", 0) - ma.get("fordblks", m.get("fordblks", 0))) / 1048576.0, mbb(m.get("hblkhd", 0))))
    else:
        parts.append("malloc gauges unavailable")
    print("memory    " + "   ".join(parts))
cb = b.get("caches")
if isinstance(cb, dict):
    def cg(name, k):
        v = (cb.get(name) or {}).get(k)
        return v if isinstance(v, (int, float)) else 0

    def mb(nbytes):
        return "%.1f MB" % (nbytes / 1048576.0)

    print("caches    jsonl %d files / %s / %d records   asm %d   judge parse %d, recon %d, chain %d   parse %d   "
          "chat %d (%s)   usage %d rows   img %d (%s)   links %d + %d   stamps %d   task segs %d   tok %d"
          % (cg("jsonl", "entries"), mb(cg("jsonl", "file_bytes")), cg("jsonl", "records"), cg("asm", "entries"),
             cg("judge_parse", "entries"), cg("judge_recon", "entries"), cg("judge_chain", "entries"), cg("parse", "entries"),
             cg("built_chat", "entries"), mb(cg("built_chat", "ms_bytes")), cg("judge_usage", "rows"),
             cg("img", "entries"), mb(cg("img", "bytes")), cg("path_links", "entries"), cg("space_paths", "entries"),
             cg("session_stamp", "entries"), cg("task_seg", "entries"), cg("session_tok", "entries")))
# held / exempt: the cycles the minimum interval between cycle starts delayed (and the mean delay) and the
# cycles a watched chat tab's live-tail wake ran inside it; an older kernel has neither and prints zeros
print("pusher    %.2f cycles/s   %.2f wakes/s (event %d, backstop %d)   held %d (mean %.0f ms)   exempt %d   busy %.0f%% of wall"
      % (cyc / dt, wakes / dt, ev, bs, held, (held_ms / held) if held else 0.0, exempt, 100.0 * cyc_ms / (dt * 1000.0)))
