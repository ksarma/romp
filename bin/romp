# `romp api-health` — the kernel's API-health signal, verbatim JSON (GET /api-health): per
# (auth label, model family) attempt/response/give-up counts over 60/300/900 s windows and the
# thrash/degraded/recovering state the kernel derives from them. For scripts and consumers that act
# on it (switch a key, hold a job); the kernel holds no policy of its own. Same shape as `sessions`:
# the token on stdin, a dead kernel fails loudly, an unknown flag is refused.
if [[ "${1:-}" == "api-health" ]]; then
    shift
    if [[ $# -gt 0 ]]; then echo "usage: romp api-health" >&2; exit 2; fi
    _kport="${ROMP_KERNEL_PORT:-29855}"
    # The HTTP status rides the reply's last line (-w), so a refusal is reported AS ITSELF. With
    # `curl -f` every non-2xx wore the one "kernel not reachable" message, which hid the route's own
    # 503 (the SDK backend is not up: a signal that does not exist yet, not a kernel that is down),
    # a refused token (401/403) and a kernel that predates the route (404) behind "is romp running?".
    # Only a reply that never came (connection refused, a timeout) is "not reachable".
    _raw="$(_romp_token_cfg | curl -s -m 10 --config - -w '\n%{http_code}' "http://127.0.0.1:$_kport/api-health")" \
        || { echo "romp api-health: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
    _code="${_raw##*$'\n'}"
    _body="${_raw%$'\n'*}"; _body="${_body%$'\n'}"
    case "$_code" in
        2??) printf '%s\n' "$_body"; exit 0 ;;
        503) # the route's own message rides its body as {"error": "..."}: print that, not a guess
             _why="$(printf '%s' "$_body" | python3 -c 'import json, sys; print(json.load(sys.stdin)["error"])' 2>/dev/null)" \
                 || _why="$_body"
             echo "romp api-health: no signal, the kernel answered HTTP 503: $_why" >&2; exit 1 ;;
        401|403) echo "romp api-health: the kernel refused the serve token (HTTP $_code): a stale ROMP_SERVE_TOKEN, or a state dir that is not this kernel's" >&2; exit 1 ;;
        404) echo "romp api-health: this kernel has no /api-health route (HTTP 404): it predates this command, restart romp" >&2; exit 1 ;;
        *)   echo "romp api-health: the kernel answered HTTP $_code on :$_kport" >&2; exit 1 ;;
    esac
fi

# Fork a session into a NEW parallel one (the user 2026-08-19, via the lab workflow: per-stage
# experiment splits were hand-driving the kernel's WS forkSession op — websocket surgery nobody
# should repeat). Rides the kernel's POST /fork, the WS op as a one-shot route beside /new and
# /send: parent untouched, explicit new name, tip fork by default, --at <record-uuid> for a cut
# point, and the fork is discoverable in `romp sessions` the moment this acks.
if [[ "${1:-}" == "fork" ]]; then
    shift
    _fork_usage="usage: romp fork <parent> <new-name> [--at <record-uuid>]"
    parent_arg=""; newname_arg=""; at_arg=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --at) shift
                  if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then echo "$_fork_usage" >&2; exit 2; fi
                  at_arg="$1"; shift ;;
            -*)   echo "$_fork_usage" >&2; exit 2 ;;
            *)    if [[ -z "$parent_arg" ]]; then parent_arg="$1"
                  elif [[ -z "$newname_arg" ]]; then newname_arg="$1"
                  else echo "$_fork_usage" >&2; exit 2; fi
                  shift ;;
        esac
    done
    if [[ -z "$parent_arg" || -z "$newname_arg" ]]; then echo "$_fork_usage" >&2; exit 2; fi
    _tok="$(_romp_token)"
    _kport="${ROMP_KERNEL_PORT:-29855}"
    if [[ -z "$_tok" ]]; then
        echo "romp fork: the kernel isn't running (no serve token). Start romp (the login service, or \`romp up\`) first." >&2
        exit 1
    fi
    _payload="$(python3 -c 'import json,sys; print(json.dumps({"parent": sys.argv[1], "name": sys.argv[2], "at": sys.argv[3]}))' "$parent_arg" "$newname_arg" "$at_arg")"
    _resp="$(_romp_token_cfg | curl -sf -m 30 --config - -X POST "http://127.0.0.1:$_kport/fork" \
                  -H 'Content-Type: application/json' -d "$_payload")" \
        || { echo "romp fork: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
    if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
        echo "romp fork: \"$newname_arg\" branched from \"$parent_arg\" — both continue as separate sessions (see: romp sessions)"
        exit 0
    fi
    _err="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("error") or sys.argv[1])' "$_resp" 2>/dev/null || printf '%s' "$_resp")"
    echo "romp fork: refused — $_err" >&2
    exit 1
fi

# Rename a session (the user 2026-08-23, restructuring another project's sessions): the kernel's
# POST /rename, the exact sibling of `romp fork` — sessions are uuid-keyed with the name as a
# label, so a rename never breaks mailboxes, goals, or history; every surface resyncs.
if [[ "${1:-}" == "rename" ]]; then
    shift
    _rn_usage="usage: romp rename <session> <new-name>"
    if [[ $# -ne 2 || "$1" == -* || "$2" == -* ]]; then echo "$_rn_usage" >&2; exit 2; fi
    _tok="$(_romp_token)"
    _kport="${ROMP_KERNEL_PORT:-29855}"
    if [[ -z "$_tok" ]]; then
        echo "romp rename: the kernel isn't running (no serve token). Start romp (the login service, or \`romp up\`) first." >&2
        exit 1
    fi
    _payload="$(python3 -c 'import json,sys; print(json.dumps({"target": sys.argv[1], "name": sys.argv[2]}))' "$1" "$2")"
    _resp="$(_romp_token_cfg | curl -sf -m 15 --config - -X POST "http://127.0.0.1:$_kport/rename" \
                  -H 'Content-Type: application/json' -d "$_payload")" \
        || { echo "romp rename: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
    if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
        echo "romp rename: \"$1\" is now \"$2\""
        exit 0
    fi
    _err="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("error") or sys.argv[1])' "$_resp" 2>/dev/null || printf '%s' "$_resp")"
    echo "romp rename: refused — $_err" >&2
    exit 1
fi

# Move a session's working directory (the user 2026-09-01: a subproject promoted to its own repo, and
# the session should follow it): the kernel's POST /move, the sibling of `romp rename`. The session
# keeps its conversation, name, mailbox and history; Claude's tools, CLAUDE.md and project settings
# come from the new folder from the next turn on. A relative dir is resolved against THIS shell's
# cwd here (the kernel would otherwise resolve it against its own default directory, which is not
# where the caller stands); `~` is the shell's to expand, and the kernel canonicalises the rest.
if [[ "${1:-}" == "move" ]]; then
    shift
    _mv_usage="usage: romp move <session> <dir>"
    if [[ $# -ne 2 || "$1" == -* || "$2" == -* || -z "$2" ]]; then echo "$_mv_usage" >&2; exit 2; fi
    _mv_dir="$2"
    [[ "$_mv_dir" != /* && "$_mv_dir" != "~"* && "$_mv_dir" != '$'* ]] && _mv_dir="$PWD/$_mv_dir"
    _tok="$(_romp_token)"
    _kport="${ROMP_KERNEL_PORT:-29855}"
    if [[ -z "$_tok" ]]; then
        echo "romp move: the kernel isn't running (no serve token). Start romp (the login service, or \`romp up\`) first." >&2
        exit 1
    fi
    _payload="$(python3 -c 'import json,sys; print(json.dumps({"target": sys.argv[1], "dir": sys.argv[2]}))' "$1" "$_mv_dir")"
    # -m 90: a quiet session's move answers in a second or two, but a DORMANT one is revived first and
    # its CLI has to come up before the request can go out (the kernel waits up to 60s for that)
    _resp="$(_romp_token_cfg | curl -sf -m 90 --config - -X POST "http://127.0.0.1:$_kport/move" \
                  -H 'Content-Type: application/json' -d "$_payload")" \
        || { echo "romp move: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
    if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
        if [[ "$_resp" == *'"queued": true'* || "$_resp" == *'"queued":true'* ]]; then
            echo "romp move: \"$1\" is mid-turn — the move is queued and fires when the turn ends (watch: romp sessions)"
        else
            echo "romp move: \"$1\" now works in $_mv_dir"
        fi
        exit 0
    fi
    _err="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("error") or sys.argv[1])' "$_resp" 2>/dev/null || printf '%s' "$_resp")"
    echo "romp move: refused — $_err" >&2
    exit 1
fi

# Recolor a session's identity color (the user 2026-08-23, via the manager/worker session workflow:
# a manager keeps its worker roster as a session group, all one identity color): the kernel's
# POST /color, the exact sibling of `romp rename` — a names-registry write, so a dormant session
# recolors by sid. With no color argument it READS: the session's current bg and fg off
# GET /sessions, tab-separated, for scripts. A slot number resolves HERE against the
# STATE/palette-colors mirror the kernel rewrites at boot — the same file the launcher assigns
# from, so "slot 3" is the same hex at recolor time as at launch time; a missing mirror is a loud
# error, never a silent fall-back to the hardcoded default set the gear may have switched away
# from. TRAP: the kernel accepts only swatches of KNOWN palettes (the swatch's palette supplies
# the fg word), so an arbitrary hex is refused loudly with the pointer to GET /palette — never
# stored half-styled.
if [[ "${1:-}" == "color" ]]; then
    shift
    _cl_usage="usage: romp color <session> [<#hex|slot>]"
    if [[ $# -lt 1 || $# -gt 2 || "$1" == -* || ( $# -eq 2 && -z "$2" ) ]]; then echo "$_cl_usage" >&2; exit 2; fi
    _tok="$(_romp_token)"
    _kport="${ROMP_KERNEL_PORT:-29855}"
    if [[ -z "$_tok" ]]; then
        echo "romp color: the kernel isn't running (no serve token). Start romp (the login service, or \`romp up\`) first." >&2
        exit 1
    fi
    if [[ $# -eq 1 ]]; then
        _resp="$(_romp_token_cfg | curl -sf -m 10 --config - "http://127.0.0.1:$_kport/sessions")" \
            || { echo "romp color: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
        _pair="$(printf '%s' "$_resp" | python3 -c '
import json, sys
rows = json.load(sys.stdin)
rows = rows.get("sessions", rows) if isinstance(rows, dict) else rows
for r in rows:
    if isinstance(r, dict) and (r.get("name") == sys.argv[1] or r.get("id") == sys.argv[1]):
        print("%s\t%s" % (r.get("bg") or "", r.get("fg") or ""))
        break
' "$1")"
        if [[ -z "$_pair" ]]; then
            echo "romp color: no session named \"$1\" (see: romp sessions)" >&2
            exit 1
        fi
        printf '%s\n' "$_pair"
        exit 0
    fi
    _cl_bg="$2"
    if [[ "$_cl_bg" =~ ^[1-9][0-9]?$ ]]; then    # slots past 9 exist since the palette grew to 12
        #                                            (T164); the awk read below stays the loud floor
        #                                            for a slot the active set lacks
        _palfile="${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}/palette-colors"
        if [[ ! -r "$_palfile" ]]; then
            echo "romp color: no palette mirror at $_palfile — the kernel writes it at boot (is romp running?)" >&2
            exit 1
        fi
        _cl_slot="$_cl_bg"
        _cl_bg="$(awk -F'\t' -v n="$_cl_slot" 'NR == n { print $1 }' "$_palfile")"
        if [[ -z "$_cl_bg" ]]; then
            echo "romp color: the active palette has no slot $_cl_slot (see $_palfile)" >&2
            exit 1
        fi
    fi
    _payload="$(python3 -c 'import json,sys; print(json.dumps({"target": sys.argv[1], "bg": sys.argv[2]}))' "$1" "$_cl_bg")"
    _resp="$(_romp_token_cfg | curl -sf -m 15 --config - -X POST "http://127.0.0.1:$_kport/color" \
                  -H 'Content-Type: application/json' -d "$_payload")" \
        || { echo "romp color: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
    if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
        echo "romp color: \"$1\" is now $_cl_bg"
        exit 0
    fi
    _err="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("error") or sys.argv[1])' "$_resp" 2>/dev/null || printf '%s' "$_resp")"
    echo "romp color: refused — $_err" >&2
    exit 1
fi

# The names registry: the kernel's STATE/names/<sid> record, `name\tcwd\tbg\tfg\temoji`. `romp emoji`
# reads it here so a dormant id answers with the kernel stopped; the split below is tab-exact on purpose.
ROMP_NAMES_DIR="${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}/names"

# Read one names entry into _rf=(name dir bg fg emoji) EXACTLY, empty fields kept. Never `IFS=$'\t' read`
# a record: bash treats tab as IFS whitespace and folds a run of tabs into ONE delimiter, so a record
# with no colors and an emoji (`name\tcwd\t\t\t<emoji>`, a pre-color or Codex launch-error entry the
# kernel labeled by sid) read as bg=<emoji>, and the rewrite stored the emoji as the color
# (review, 2026-09-06).
# Parameter expansion only: no fork, and bash 3.2 (macOS) has no readarray -d.
_romp_split_record() {   # <file> — returns 1 when the file is missing or empty
    local line="" rest i
    _rf=("" "" "" "" "")
    IFS= read -r line < "$1" || [[ -n "$line" ]] || return 1
    rest="$line"
    for i in 0 1 2 3; do
        if [[ "$rest" == *$'\t'* ]]; then
            _rf[$i]="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
        else
            _rf[$i]="$rest"; rest=""
        fi
    done
    _rf[4]="${rest%%$'\t'*}"   # the emoji; a sixth field (none is written) never rides into it
    return 0
}


# A session's tab emoji (the user 2026-09-06): one emoji shown before the name on its tab, so a
# glance tells a session's state or role apart — a moon on the one left running overnight, a flag
# on the release manager. The kernel's POST /emoji, the exact sibling of `romp color`: a
# names-registry write, so a dormant session takes it by sid, and the same validator (exactly one
# emoji, nothing textual) answers every door — the tab menu, the session's own set_emoji tool, and
# this command — so a refusal prints the kernel's one-line reason. With no argument it READS the
# current emoji (an empty line when there is none): an id with a record here straight from the names
# registry — the store the kernel reads too, and the only place a dormant record lives, so that read
# needs no kernel — and anything else (a name, an id an attached machine owns) off the kernel's GET
# /emoji, the read half of the POST, which forwards to the owning kernel the way the POST does. `--clear`
# is the ONLY clear: an empty or blank positional is
# a usage error, never a clear (an unset variable in a script must not wipe a label; `romp color`
# has the same guard).
if [[ "${1:-}" == "emoji" ]]; then
    shift
    _em_usage="usage: romp emoji <session> [<emoji>|--clear]"
    if [[ $# -lt 1 || $# -gt 2 || -z "$1" || "$1" == -* ]]; then echo "$_em_usage" >&2; exit 2; fi
    if [[ $# -eq 2 && "$2" == -* && "$2" != "--clear" ]]; then echo "$_em_usage" >&2; exit 2; fi
    if [[ $# -eq 2 && "$2" != "--clear" && -z "${2//[[:space:]]/}" ]]; then
        echo "romp emoji: an empty emoji is not a clear — use --clear to remove one" >&2
        echo "$_em_usage" >&2; exit 2
    fi
    if [[ $# -eq 1 && "$1" =~ ^[0-9a-fA-F-]{32,36}$ && -f "$ROMP_NAMES_DIR/$1" ]] && _romp_split_record "$ROMP_NAMES_DIR/$1"; then
        # READ by id: straight from the names record — the store the kernel's own GET /sessions `emoji`
        # field is read from, and the only place a dormant session's record lives — so no kernel is
        # needed. This read ran only after GET /sessions had missed, so with the kernel down a dormant
        # id got 'kernel not reachable' though the record held the answer (review round 2, 2026-09-06).
        printf '%s\n' "${_rf[4]}"
        exit 0
    fi
    _tok="$(_romp_token)"
    _kport="${ROMP_KERNEL_PORT:-29855}"
    if [[ -z "$_tok" ]]; then
        echo "romp emoji: the kernel isn't running (no serve token). Start romp (the login service, or \`romp up\`) first." >&2
        exit 1
    fi
    if [[ $# -eq 1 ]]; then
        # READ by name, or by an id with no record here: the kernel's GET /emoji?target=, the read half
        # of the POST the set form uses — it resolves a live name or a sid, and forwards a sid an
        # attached machine owns to that machine's kernel. It replaced a GET /sessions lookup, which
        # lists THIS machine's live sessions only, so an attached machine's session read as 'no session
        # named' right after a set for the same id had succeeded (review round 3, 2026-09-06). The
        # status rides -w, not -f: a 404 is a kernel from before the route, which -f folded into 'not
        # reachable' and sent the user to check a kernel that was up (the `romp perf` precedent).
        _tq="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1")"
        _out="$(_romp_token_cfg | curl -s -m 10 --config - -w '\n%{http_code}' "http://127.0.0.1:$_kport/emoji?target=$_tq")" \
            || { echo "romp emoji: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
        _code="${_out##*$'\n'}"; _resp="${_out%$'\n'*}"
        case "$_code" in
            2??) ;;
            404)     echo "romp emoji: the kernel on :$_kport predates this command's read route (GET /emoji) — restart romp so the kernel matches this command" >&2; exit 1 ;;
            401|403) echo "romp emoji: the kernel on :$_kport refused the serve token (HTTP $_code); is ROMP_KERNEL_PORT pointing at another kernel?" >&2; exit 1 ;;
            *)       echo "romp emoji: the kernel on :$_kport answered HTTP $_code: $_resp" >&2; exit 1 ;;
        esac
        _hit="$(python3 -c '
import json, sys
r = json.loads(sys.argv[1])
if isinstance(r, dict) and r.get("ok"):
    print("found\t%s" % (r.get("emoji") or ""))
else:
    print("error\t%s" % ((r.get("error") if isinstance(r, dict) else "") or sys.argv[1]))
' "$_resp" 2>/dev/null || printf 'error\t%s' "$_resp")"
        if [[ "$_hit" == error* ]]; then
            echo "romp emoji: ${_hit#error	}" >&2
            exit 1
        fi
        printf '%s\n' "${_hit#found	}"
        exit 0
    fi
    _em_val="$2"
    [[ "$_em_val" == "--clear" ]] && _em_val=""
    _payload="$(python3 -c 'import json,sys; print(json.dumps({"target": sys.argv[1], "emoji": sys.argv[2]}, ensure_ascii=False))' "$1" "$_em_val")"
    _resp="$(_romp_token_cfg | curl -sf -m 15 --config - -X POST "http://127.0.0.1:$_kport/emoji" \
                  -H 'Content-Type: application/json; charset=utf-8' -d "$_payload")" \
        || { echo "romp emoji: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
    if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
        # print what the kernel STORED (its reply's `emoji`, trimmed by the validator), not the raw
        # argument; a reply without the field (an older kernel) falls back to the argument
        _em_shown="$(python3 -c 'import json,sys; r = json.loads(sys.argv[1]); print(r["emoji"] if "emoji" in r else sys.argv[2])' "$_resp" "$_em_val" 2>/dev/null || printf '%s' "$_em_val")"
        if [[ -z "$_em_shown" ]]; then
            echo "romp emoji: \"$1\" shows no emoji now"
        else
            echo "romp emoji: \"$1\" now shows $_em_shown"
        fi
        exit 0
    fi
    _err="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("error") or sys.argv[1])' "$_resp" 2>/dev/null || printf '%s' "$_resp")"
    echo "romp emoji: refused — $_err" >&2
    exit 1
fi

# Session tags from the CLI (the user 2026-08-23; renamed from "group" the same day: a tag marks a
# SPECIALIZED session, excluded from the untagged view and shown under its tag — the accurate name.
# The manager/worker workflow keeps its worker roster as a tag, all one identity color, and an agent
# can mint/color/fill a tag programmatically, sessions it just spawned included). Bare / --json READS
# GET /views; bare maps member sids to live names via GET /sessions and prints an unmappable id
# RAW — a dead member is information, not noise. Everything else is POST /tag, the kernel's
# targeted per-tag merge — deliberately NOT the dashboard's setTimelineViews op, which replaces
# the whole blob and would let a stale read clobber the active view and every tag this command
# never looked at (the kernel's _edit_tag comment has the full story). TRAPS: --add/--remove eat
# every following arg up to the next flag, so flag order carries the grouping; members go up as
# live names or raw sids (a dead session rides by sid) and the kernel refuses an unknown name
# loudly rather than minting a member nothing will ever match; "color" and "delete" ride the
# payload only when given — an absent color means keep, "" would mean clear. A bare NAME with no
# edit flag READS that one tag (exit 1 when absent) — creating on a read-shaped call minted
# phantoms from typos. "group" is the pre-rename alias, accepted quietly.
# PR-landing watch (the user 2026-08-24, both teams' surveys): register kernel-owned interest in a
# PR and get ONE [romp] mail when it reaches a terminal state (merged, closed, or a failed check) —
# replacing the mortal `while :; gh pr view; sleep 30` loop that died with every kernel restart.
# The SESSION defaults to the caller (ROMP_SID, spawn-frozen in SDK sessions; --session overrides);
# the REPO defaults to the caller's checkout (gh resolves it from cwd; --repo overrides). Both
# resolve CLIENT-side so the kernel route stays explicit.
if [[ "${1:-}" == "watch" ]]; then
    shift
    _w_usage="usage: romp watch --cmd '<predicate>' [--every <s>] [--timeout <s>] [--note '<what>'] [--session <name>]
       romp watch --list
       romp watch --cancel <id>"
    _w_cmd=""; _w_every=""; _w_timeout=""; _w_note=""; _w_sess=""; _w_list=0; _w_cancel=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --cmd)     shift; [[ $# -eq 0 || -z "$1" ]] && { echo "$_w_usage" >&2; exit 2; }; _w_cmd="$1"; shift ;;
            --every)   shift; [[ $# -eq 0 || ! "$1" =~ ^[0-9]+$ ]] && { echo "$_w_usage" >&2; exit 2; }; _w_every="$1"; shift ;;
            --timeout) shift; [[ $# -eq 0 || ! "$1" =~ ^[0-9]+$ ]] && { echo "$_w_usage" >&2; exit 2; }; _w_timeout="$1"; shift ;;
            --note)    shift; [[ $# -eq 0 ]] && { echo "$_w_usage" >&2; exit 2; }; _w_note="$1"; shift ;;
            --session) shift; [[ $# -eq 0 || -z "$1" || "$1" == -* ]] && { echo "$_w_usage" >&2; exit 2; }; _w_sess="$1"; shift ;;
            --list)    _w_list=1; shift ;;
            --cancel)  shift; [[ $# -eq 0 || -z "$1" ]] && { echo "$_w_usage" >&2; exit 2; }; _w_cancel="$1"; shift ;;
            *)         echo "$_w_usage" >&2; exit 2 ;;
        esac
    done
    _tok="$(_romp_token)"
    _kport="${ROMP_KERNEL_PORT:-29855}"
    if [[ -z "$_tok" ]]; then
        echo "romp watch: the kernel isn't running (no serve token). Start romp first." >&2
        exit 1
    fi
    if [[ "$_w_list" == "1" ]]; then
        _romp_token_cfg | curl -sf -m 15 --config - "http://127.0.0.1:$_kport/watches" \
            | python3 -c 'import json,sys
rows = json.load(sys.stdin).get("watches") or []
if not rows: print("romp watch: nothing registered"); raise SystemExit
for r in rows:
    print("%s  every %ss  timeout %ss  %s" % (r["id"], r["every"], r["timeoutS"], r.get("note") or r["cmd"]))' \
            || { echo "romp watch: kernel not reachable on :$_kport" >&2; exit 1; }
    exit 0
    fi
    if [[ -n "$_w_cancel" ]]; then
        _resp="$(_romp_token_cfg | curl -sf -m 15 --config - -X POST "http://127.0.0.1:$_kport/watch" \
                     -H 'Content-Type: application/json' -d "{\"cancel\": \"$_w_cancel\"}")" \
            || { echo "romp watch: kernel not reachable on :$_kport" >&2; exit 1; }
        [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]] \
            && { echo "romp watch: cancelled $_w_cancel"; exit 0; }
        echo "romp watch: refused — $_resp" >&2; exit 1
    fi
    if [[ -z "$_w_cmd" ]]; then echo "$_w_usage" >&2; exit 2; fi
    _w_who="$_w_sess"
    if [[ -z "$_w_who" ]]; then
        if [[ -z "${ROMP_SID:-}" ]]; then
            echo "romp watch: --session <name> required outside a romp SDK session (ROMP_SID is not set)" >&2
            exit 2
        fi
        _w_who="$ROMP_SID"
    fi
    _w_key="id"; [[ -n "$_w_sess" ]] && _w_key="name"
    _payload="$(python3 -c 'import json,sys
b = {"cmd": sys.argv[1], sys.argv[2]: sys.argv[3]}
if sys.argv[4]: b["every"] = int(sys.argv[4])
if sys.argv[5]: b["timeoutS"] = int(sys.argv[5])
if sys.argv[6]: b["note"] = sys.argv[6]
print(json.dumps(b))' "$_w_cmd" "$_w_key" "$_w_who" "$_w_every" "$_w_timeout" "$_w_note")"
    _resp="$(_romp_token_cfg | curl -sf -m 15 --config - -X POST "http://127.0.0.1:$_kport/watch" \
                  -H 'Content-Type: application/json' -d "$_payload")" \
        || { echo "romp watch: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
    if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
        _wid="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["watch"]["id"])' "$_resp" 2>/dev/null || true)"
        echo "romp watch: registered${_wid:+ ($_wid)} — one mail here when the condition holds or the timeout passes"
        _whint="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("hint") or "")' "$_resp" 2>/dev/null || true)"
        [[ -n "$_whint" ]] && echo "romp watch: heads-up — $_whint" >&2
        exit 0
    fi
    _err="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("error") or sys.argv[1])' "$_resp" 2>/dev/null || printf '%s' "$_resp")"
    echo "romp watch: refused — $_err" >&2
    exit 1
fi

# `romp card --key <key> --title <text> [--body <markdown> | --body-file <path>] [--session <name>] [--attach <path>]
#             [--needs-you] [--expires <seconds>] [--producer <label>]` (T370, plans/notice-cards.md): door three of the
# kernel's post_notice, following `romp watch`'s mechanics exactly: the session defaults to $ROMP_SID under body key id,
# --session sends name, neither outside a session refuses with exit 2; the token and the body go through _romp_token_cfg and
# python3 -c 'import json'; one `romp card: posted` line on success, a `romp card: refused` line naming the error and exit 1.
# The kernel judges the attachment and keeps the card's history; the card is never a way to issue a request (no --action here:
# actions are for producers inside romp, against the kernel's allowlist).
if [[ "${1:-}" == "card" ]]; then
    shift
    _c_usage="usage: romp card --key <key> --title <text> [--body <markdown> | --body-file <path>] [--session <name>]
       [--attach <path>] [--needs-you] [--expires <seconds>] [--producer <label>]
  --key is the card's stable name: a second post under the same key is a REVISION of the card, a different key a new card"
    _c_title=""; _c_body=""; _c_bodyfile=""; _c_sess=""; _c_attach=""; _c_key=""; _c_needs=0; _c_expires=""; _c_prod="cli"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --title)     shift; [[ $# -eq 0 || -z "$1" ]] && { echo "$_c_usage" >&2; exit 2; }; _c_title="$1"; shift ;;
            --body)      shift; [[ $# -eq 0 ]] && { echo "$_c_usage" >&2; exit 2; }; _c_body="$1"; shift ;;
            --body-file) shift; [[ $# -eq 0 || ! -f "$1" ]] && { echo "$_c_usage" >&2; exit 2; }; _c_bodyfile="$1"; shift ;;
            --session)   shift; [[ $# -eq 0 || -z "$1" || "$1" == -* ]] && { echo "$_c_usage" >&2; exit 2; }; _c_sess="$1"; shift ;;
            --attach)    shift; [[ $# -eq 0 || -z "$1" ]] && { echo "$_c_usage" >&2; exit 2; }; _c_attach="$1"; shift ;;
            --key)       shift; [[ $# -eq 0 || -z "$1" ]] && { echo "$_c_usage" >&2; exit 2; }; _c_key="$1"; shift ;;
            --needs-you) _c_needs=1; shift ;;
            --expires)   shift; [[ $# -eq 0 || ! "$1" =~ ^[0-9]+$ ]] && { echo "$_c_usage" >&2; exit 2; }; _c_expires="$1"; shift ;;
            --producer)  shift; [[ $# -eq 0 || -z "$1" ]] && { echo "$_c_usage" >&2; exit 2; }; _c_prod="$1"; shift ;;
            *)           echo "$_c_usage" >&2; exit 2 ;;
        esac
    done
    if [[ -z "$_c_title" || -z "$_c_key" ]]; then echo "$_c_usage" >&2; exit 2; fi   # the key is required: a slug of the title made an edited title a second card (round two, low d)
    if [[ -n "$_c_bodyfile" ]]; then _c_body="$(cat "$_c_bodyfile")"; fi
    _tok="$(_romp_token)"
    _kport="${ROMP_KERNEL_PORT:-29855}"
    if [[ -z "$_tok" ]]; then
        echo "romp card: the kernel isn't running (no serve token). Start romp first." >&2
        exit 1
    fi
    _c_who="$_c_sess"
    if [[ -z "$_c_who" ]]; then
        if [[ -z "${ROMP_SID:-}" ]]; then
            echo "romp card: --session <name> required outside a romp SDK session (ROMP_SID is not set)" >&2
            exit 2
        fi
        _c_who="$ROMP_SID"
    fi
    _c_key_name="id"; [[ -n "$_c_sess" ]] && _c_key_name="name"
    if [[ -n "$_c_attach" && "$_c_attach" != /* ]]; then _c_attach="$(cd "$(dirname "$_c_attach")" 2>/dev/null && pwd)/$(basename "$_c_attach")"; fi
    _payload="$(python3 -c 'import json,sys,time
b = {sys.argv[1]: sys.argv[2], "key": sys.argv[3], "title": sys.argv[4], "producer": sys.argv[8]}
if sys.argv[5]: b["body"] = sys.argv[5]
if sys.argv[6]: b["attachment"] = sys.argv[6]
if sys.argv[7] == "1": b["needsYou"] = True
if sys.argv[9]: b["expiresAt"] = int(time.time()) + int(sys.argv[9])
print(json.dumps(b))' "$_c_key_name" "$_c_who" "$_c_key" "$_c_title" "$_c_body" "$_c_attach" "$_c_needs" "$_c_prod" "$_c_expires")"
    _resp="$(_romp_token_cfg | curl -sf -m 15 --config - -X POST "http://127.0.0.1:$_kport/notice" \
                  -H 'Content-Type: application/json' -d "$_payload")" \
        || { echo "romp card: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
    if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
        _crev="$(python3 -c 'import json,sys; n = json.loads(sys.argv[1]).get("notice") or {}; print("%s rev %s" % (n.get("key"), n.get("rev")))' "$_resp" 2>/dev/null || true)"
        echo "romp card: posted${_crev:+ ($_crev)}: it shows on the feed until you dismiss it, a new revision replaces it, or it expires"
        exit 0
    fi
    _err="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("error") or sys.argv[1])' "$_resp" 2>/dev/null || printf '%s' "$_resp")"
    echo "romp card: refused — $_err" >&2
    exit 1
fi

# `romp login add <label> --cmd '<shell line>' | list | remove <label|id>` (T346; docs/reference.md
# "Several Claude logins"): the stored Claude logins a session can be billed to beside the machine's own. The
# credential lives wherever the user keeps it and nowhere in romp: `add` records a COMMAND that prints the login's
# setup-token on demand (romp only ever runs it, at a session's or a judge's launch, into that one process's environment);
# how the user keeps the token (a secret manager, a private file) is theirs, romp assumes nothing about it (the user
# 2026-09-13: no store's shorthand inside romp). No token is ever read, printed or logged here; the kernel answers from its registry (GET /logins,
# POST /logins {"add"} | {"remove"}).
if [[ "${1:-}" == "login" ]]; then
    shift
    _lg_usage="usage: romp login add <label> --cmd '<shell line that prints the token>' | romp login list | romp login remove <label|id>"
    _lg_sub="${1:-}"; [[ $# -gt 0 ]] && shift
    _tok="$(_romp_token)"
    _kport="${ROMP_KERNEL_PORT:-29855}"
    case "$_lg_sub" in
        list)
            [[ $# -gt 0 ]] && { echo "$_lg_usage" >&2; exit 2; }
            if [[ -z "$_tok" ]]; then echo "romp login: the kernel isn't running (no serve token). Start romp first." >&2; exit 1; fi
            _resp="$(_romp_token_cfg | curl -sf -m 15 --config - "http://127.0.0.1:$_kport/logins")" \
                || { echo "romp login: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
            python3 -c 'import json, sys, time
d = json.loads(sys.argv[1])
m = d.get("machine") or {}
print("machine login: %s" % (m.get("label") or "none signed in"))
rows = d.get("logins") or []
if not rows:
    print("stored logins: none")
    sys.exit(0)
print("stored logins:")
for r in rows:
    note = r.get("why") or ("token expires soon" if r.get("expiresSoon") else "")
    added = r.get("addedAt")
    when = time.strftime("%Y-%m-%d", time.localtime(added)) if isinstance(added, (int, float)) else "?"
    print("  %s  (id %s, added %s%s)" % (r.get("display") or r.get("label") or r.get("id"), r.get("id"), when,
                                        ("; " + note) if note else ""))' "$_resp"
            exit $? ;;
        add)
            _lg_label=""; _lg_cmd=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --cmd)   shift; [[ $# -eq 0 || -z "$1" ]] && { echo "$_lg_usage" >&2; exit 2; }
                             _lg_cmd="$1"; shift ;;
                    -*)      echo "$_lg_usage" >&2; exit 2 ;;
                    *)       [[ -n "$_lg_label" ]] && { echo "$_lg_usage" >&2; exit 2; }
                             _lg_label="$1"; shift ;;
                esac
            done
            [[ -z "$_lg_label" ]] && { echo "$_lg_usage" >&2; exit 2; }
            if [[ -z "$_lg_cmd" ]]; then
                echo "romp login: --cmd '<shell line that prints the token>' is required" >&2
                exit 2
            fi
            if [[ -z "$_tok" ]]; then echo "romp login: the kernel isn't running (no serve token). Start romp first." >&2; exit 1; fi
            _payload="$(python3 -c 'import json, sys
b = {"add": {"label": sys.argv[1], "tokenCmd": sys.argv[2]}}
print(json.dumps(b))' "$_lg_label" "$_lg_cmd")"
            _resp="$(_romp_token_cfg | curl -sf -m 15 --config - -X POST "http://127.0.0.1:$_kport/logins" \
                          -H 'Content-Type: application/json' -d "$_payload")" \
                || { echo "romp login: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
            if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
                echo "romp login: added '$_lg_label'; it is now a Billing choice for new and running sessions"
                exit 0
            fi
            _err="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("error") or sys.argv[1])' "$_resp" 2>/dev/null || printf '%s' "$_resp")"
            echo "romp login: refused: $_err" >&2
            exit 1 ;;
        remove)
            [[ $# -ne 1 || -z "$1" || "$1" == -* ]] && { echo "$_lg_usage" >&2; exit 2; }
            if [[ -z "$_tok" ]]; then echo "romp login: the kernel isn't running (no serve token). Start romp first." >&2; exit 1; fi
            _payload="$(python3 -c 'import json, sys; print(json.dumps({"remove": sys.argv[1]}))' "$1")"
            _resp="$(_romp_token_cfg | curl -sf -m 15 --config - -X POST "http://127.0.0.1:$_kport/logins" \
                          -H 'Content-Type: application/json' -d "$_payload")" \
                || { echo "romp login: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
            if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
                echo "romp login: removed $1"
                exit 0
            fi
            _err="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("error") or sys.argv[1])' "$_resp" 2>/dev/null || printf '%s' "$_resp")"
            echo "romp login: refused: $_err" >&2
            exit 1 ;;
        *)
            echo "$_lg_usage" >&2; exit 2 ;;
    esac
fi

if [[ "${1:-}" == "watch-pr" ]]; then
    shift
    _wp_usage="usage: romp watch-pr <number> [--repo <owner/name>] [--session <name>] [--escalate <session>]"
    _wp_pr=""; _wp_repo=""; _wp_sess=""; _wp_esc=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo)    shift; [[ $# -eq 0 || -z "$1" || "$1" == -* ]] && { echo "$_wp_usage" >&2; exit 2; }
                       _wp_repo="$1"; shift ;;
            --session) shift; [[ $# -eq 0 || -z "$1" || "$1" == -* ]] && { echo "$_wp_usage" >&2; exit 2; }
                       _wp_sess="$1"; shift ;;
            --escalate) shift; [[ $# -eq 0 || -z "$1" || "$1" == -* ]] && { echo "$_wp_usage" >&2; exit 2; }
                       _wp_esc="$1"; shift ;;
            -*)        echo "$_wp_usage" >&2; exit 2 ;;
            *)         [[ -n "$_wp_pr" ]] && { echo "$_wp_usage" >&2; exit 2; }
                       _wp_pr="$1"; shift ;;
        esac
    done
    if [[ -z "$_wp_pr" || ! "$_wp_pr" =~ ^[0-9]+$ ]]; then echo "$_wp_usage" >&2; exit 2; fi
    if [[ -z "$_wp_repo" ]]; then
        _wp_repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
        if [[ -z "$_wp_repo" ]]; then
            echo "romp watch-pr: no --repo given and the current directory has no gh-resolvable repo" >&2
            exit 1
        fi
    fi
    _wp_who="$_wp_sess"
    if [[ -z "$_wp_who" ]]; then
        if [[ -z "${ROMP_SID:-}" ]]; then
            echo "romp watch-pr: --session <name> required outside a romp SDK session (ROMP_SID is not set)" >&2
            exit 2
        fi
        _wp_who="$ROMP_SID"
    fi
    _tok="$(_romp_token)"
    _kport="${ROMP_KERNEL_PORT:-29855}"
    if [[ -z "$_tok" ]]; then
        echo "romp watch-pr: the kernel isn't running (no serve token). Start romp first." >&2
        exit 1
    fi
    _wp_key="id"; [[ -n "$_wp_sess" ]] && _wp_key="name"
    _payload="$(python3 -c 'import json,sys
b = {"pr": int(sys.argv[1]), "repo": sys.argv[2], sys.argv[3]: sys.argv[4]}
if len(sys.argv) > 5 and sys.argv[5]: b["escalate"] = sys.argv[5]
print(json.dumps(b))' \
        "$_wp_pr" "$_wp_repo" "$_wp_key" "$_wp_who" "$_wp_esc")"
    _resp="$(_romp_token_cfg | curl -sf -m 15 --config - -X POST "http://127.0.0.1:$_kport/watch-pr" \
                  -H 'Content-Type: application/json' -d "$_payload")" \
        || { echo "romp watch-pr: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
    if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
        echo "romp watch-pr: watching $_wp_repo#$_wp_pr — one mail here when it lands or fails"
        exit 0
    fi
    _err="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("error") or sys.argv[1])' "$_resp" 2>/dev/null || printf '%s' "$_resp")"
    echo "romp watch-pr: refused — $_err" >&2
    exit 1
fi

if [[ "${1:-}" == "tag" || "${1:-}" == "group" ]]; then
    shift
    _gr_usage="usage: romp tag [--json]
       romp tag <name> [--host <kernel>] [--add <session>...] [--remove <session>...] [--color <#hex>] [--rename <new>] [--delete]"
    _gr_name=""; _gr_json=false; _gr_color=""; _gr_cset=0; _gr_del=0; _gr_host=""; _gr_rename=""
    _gr_add=(); _gr_remove=(); _gr_mode=""; _gr_add_seen=0; _gr_rm_seen=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)   _gr_json=true; _gr_mode=""; shift ;;
            --add)    _gr_add_seen=1; _gr_mode="add"; shift ;;
            --remove) _gr_rm_seen=1; _gr_mode="remove"; shift ;;
            --color)  shift
                      if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then echo "$_gr_usage" >&2; exit 2; fi
                      _gr_color="$1"; _gr_cset=1; _gr_mode=""; shift ;;
            --rename) shift
                      if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then echo "$_gr_usage" >&2; exit 2; fi
                      _gr_rename="$1"; _gr_mode=""; shift ;;
            --host)   shift
                      if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then echo "$_gr_usage" >&2; exit 2; fi
                      _gr_host="$1"; _gr_mode=""; shift ;;
            --delete) _gr_del=1; _gr_mode=""; shift ;;
            -*)       echo "$_gr_usage" >&2; exit 2 ;;
            *)        case "$_gr_mode" in
                          add)    _gr_add+=("$1") ;;
                          remove) _gr_remove+=("$1") ;;
                          *)      if [[ -n "$_gr_name" ]]; then echo "$_gr_usage" >&2; exit 2; fi
                                  _gr_name="$1" ;;
                      esac
                      shift ;;
        esac
    done
    if $_gr_json && [[ -n "$_gr_name" || $_gr_add_seen -eq 1 || $_gr_rm_seen -eq 1 || $_gr_cset -eq 1 || $_gr_del -eq 1 ]]; then
        echo "$_gr_usage" >&2; exit 2
    fi
    if [[ -z "$_gr_name" && ( $_gr_add_seen -eq 1 || $_gr_rm_seen -eq 1 || $_gr_cset -eq 1 || $_gr_del -eq 1 || -n "$_gr_rename" ) ]]; then
        echo "$_gr_usage" >&2; exit 2
    fi
    if [[ -n "$_gr_host" && $_gr_add_seen -eq 0 && $_gr_rm_seen -eq 0 && $_gr_cset -eq 0 && $_gr_del -eq 0 && -z "$_gr_rename" ]]; then
        # v0: --host modifies an EDIT (the target kernel's store, through the tunnel). Reads stay
        # local — the dashboard's view menu already shows the union.
        echo "romp tag: --host goes with an edit (--add/--remove/--color/--delete)" >&2; exit 2
    fi
    if [[ ( $_gr_add_seen -eq 1 && ${#_gr_add[@]} -eq 0 ) || ( $_gr_rm_seen -eq 1 && ${#_gr_remove[@]} -eq 0 ) ]]; then
        echo "$_gr_usage" >&2; exit 2
    fi
    _tok="$(_romp_token)"
    _kport="${ROMP_KERNEL_PORT:-29855}"
    if [[ -z "$_tok" ]]; then
        echo "romp tag: the kernel isn't running (no serve token). Start romp (the login service, or \`romp up\`) first." >&2
        exit 1
    fi
    # One kernel round trip for this verb, the GET of its tag store and the POST of an edit alike:
    # the body on stdout and 0 when the kernel answered 2xx. Never `curl -sf` here: -f folds EVERY
    # non-2xx into the exit a dead kernel gets and throws the body away, so a kernel that ANSWERED —
    # a 503 with {ok:false, retryable, error} while the store cannot be read (a polling peer needs
    # the non-200 to keep its last reading), a 400 with the reason it refused an edit, a 403 for a
    # token it does not hold — read as "not reachable", and the person was told to restart a kernel
    # that was up and explaining itself. The status rides -w and is read here, the way `romp perf`
    # reads its own: a connection failure (curl's own nonzero exit, no status) keeps the "not
    # reachable" line; a non-2xx whose JSON body carries `error` prints the kernel's words (plus
    # "retry" when the body says the fault is retryable and the text does not already say so); a
    # refused token is named as such; anything else prints the status and whatever came with it,
    # never a guess. Exit 1 on every refusal, as the 200 ok:false refusal below exits. With `json`,
    # a JSON refusal body is printed as is on stdout — the same answer a script reads on a 2xx, now
    # saying ok:false and why, so it needs no second parser — and only a non-JSON answer is said as
    # prose on stderr. The body reaches the parser on stdin, never argv: one argument is capped at
    # 128 KB, so a larger answer would have defeated the parse and been echoed whole; and the prose
    # echo shows the first 2 KB with a count of what was cut, since a terminal is not the place for
    # a whole error page.
    _tag_curl() {   # _tag_curl [json] <curl args…>: the 2xx body on stdout, or the failure said and 1
        local _json=0 _out _code _body _line _rc _shown _more
        if [[ "${1:-}" == json ]]; then _json=1; shift; fi
        _out="$(_romp_token_cfg | curl -s --config - -w '\n%{http_code}' "$@")" \
            || { echo "romp tag: kernel not reachable on :$_kport (is romp running?)" >&2; return 1; }
        _code="${_out##*$'\n'}"
        _body="${_out%$'\n'*}"
        case "$_code" in
            2??) if [[ $_json -eq 1 ]]; then printf '%s\n' "$_body"; else printf '%s' "$_body"; fi; return 0 ;;
        esac
        # exits 0 with the line to say for a JSON object carrying `error`; 3 for JSON without one; 1 for a body that is not JSON
        _line="$(printf '%s' "$_body" | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
except Exception:
    sys.exit(1)
e = v.get("error") if isinstance(v, dict) else None
if not e:
    sys.exit(3)
e = str(e)
if v.get("retryable") and "retry" not in e.lower():
    e += " \u2014 retry"
print(e)
' 2>/dev/null)" && _rc=0 || _rc=$?
        if [[ $_json -eq 1 && ( $_rc -eq 0 || $_rc -eq 3 ) ]]; then
            printf '%s\n' "$_body"; return 1
        elif [[ $_rc -eq 0 ]]; then
            echo "romp tag: $_line" >&2; return 1
        fi
        case "$_code" in
            401|403) echo "romp tag: the kernel on :$_kport refused the serve token (HTTP $_code); is ROMP_KERNEL_PORT pointing at another kernel?" >&2 ;;
            *)       if [[ -n "$_body" ]]; then
                         _shown="$(printf '%s' "$_body" | head -c 2048)"
                         _more=$(( $(printf '%s' "$_body" | wc -c) - 2048 ))
                         [[ $_more -gt 0 ]] && _shown+=" ... ($_more more bytes)"
                         echo "romp tag: the kernel on :$_kport answered HTTP $_code: $_shown" >&2
                     else echo "romp tag: the kernel on :$_kport answered HTTP $_code with no explanation" >&2; fi ;;
        esac
        return 1
    }
    if [[ -z "$_gr_name" ]]; then
        if $_gr_json; then
            _tag_curl json -m 10 "http://127.0.0.1:$_kport/views" && exit 0
            exit 1
        fi
        _resp="$(_tag_curl -m 10 "http://127.0.0.1:$_kport/views")" || exit 1
        _rows="$(_romp_token_cfg | curl -sf -m 10 --config - "http://127.0.0.1:$_kport/sessions" 2>/dev/null)" || _rows='[]'
        python3 -c '
import json, sys
v = json.loads(sys.argv[1])
if not isinstance(v, dict):
    v = {}
rows = json.loads(sys.argv[2])
rows = rows.get("sessions", rows) if isinstance(rows, dict) else rows
names = {r.get("id"): r.get("name") for r in rows if isinstance(r, dict)}
def spell(x):
    # canonical (host, sid) pair from a federated kernel, or the legacy plain string
    if isinstance(x, dict):
        h, s = x.get("host") or "", x.get("sid") or ""
        return (h + ":" + s) if h else s
    return x
groups = v.get("tags") or v.get("groups") or []   # older kernel: pre-rename key
act = v.get("active") or "all"
act = {"all": "All", "untagged": "no tags"}.get(act) \
    or next((g.get("name") for g in groups if g.get("id") == act), act)
print("active view: %s" % act)
for g in groups:
    m = [names.get(spell(x)) or spell(x) for x in (g.get("members") or [])]
    print("%s  %s  %d member%s%s" % (g.get("name"), g.get("color") or "(no color)",
                                     len(m), "" if len(m) == 1 else "s",
                                     (": " + ", ".join(m)) if m else ""))
' "$_resp" "$_rows"
        exit 0
    fi
    if [[ $_gr_add_seen -eq 0 && $_gr_rm_seen -eq 0 && $_gr_cset -eq 0 && $_gr_del -eq 0 && -z "$_gr_rename" ]]; then
        # a bare name is a READ of that one group, never a write — POSTing here would CREATE a
        # missing group, so a typo'd "view" would mint a phantom and burn one of the 32 slots
        _resp="$(_tag_curl -m 10 "http://127.0.0.1:$_kport/views")" || exit 1
        _rows="$(_romp_token_cfg | curl -sf -m 10 --config - "http://127.0.0.1:$_kport/sessions" 2>/dev/null)" || _rows='[]'
        if ! python3 -c '
import json, sys
v = json.loads(sys.argv[1])
rows = json.loads(sys.argv[2])
rows = rows.get("sessions", rows) if isinstance(rows, dict) else rows
names = {r.get("id"): r.get("name") for r in rows if isinstance(r, dict)}
def spell(x):
    if isinstance(x, dict):
        h, s = x.get("host") or "", x.get("sid") or ""
        return (h + ":" + s) if h else s
    return x
g = next((g for g in (v.get("tags") or v.get("groups") or []) if isinstance(v, dict) and g.get("name") == sys.argv[3]), None)
if g is None:
    sys.exit(3)
m = [names.get(spell(x)) or spell(x) for x in (g.get("members") or [])]
print("%s  %s  %d member%s%s" % (g.get("name"), g.get("color") or "(no color)",
                                 len(m), "" if len(m) == 1 else "s",
                                 (": " + ", ".join(m)) if m else ""))
' "$_resp" "$_rows" "$_gr_name"; then
            echo "romp tag: no tag named \"$_gr_name\" (see: romp tag)" >&2
            exit 1
        fi
        exit 0
    fi
    _payload="$(python3 -c '
import json, sys
n = int(sys.argv[7])
body = {"name": sys.argv[1], "add": sys.argv[8:8 + n], "remove": sys.argv[8 + n:]}
if sys.argv[2] == "1":
    body["color"] = sys.argv[3]
if sys.argv[4] == "1":
    body["delete"] = True
if sys.argv[5]:
    body["host"] = sys.argv[5]
if sys.argv[6]:
    body["rename"] = sys.argv[6]
print(json.dumps(body))
' "$_gr_name" "$_gr_cset" "$_gr_color" "$_gr_del" "$_gr_host" "$_gr_rename" "${#_gr_add[@]}" \
        "${_gr_add[@]+"${_gr_add[@]}"}" "${_gr_remove[@]+"${_gr_remove[@]}"}")"
    # the same status-reading call as the reads: a 400 with the kernel's reason for refusing the
    # edit, or a 403, is said in its words, never as a kernel that is down
    _resp="$(_tag_curl -m 15 -X POST "http://127.0.0.1:$_kport/tag" \
                  -H 'Content-Type: application/json' -d "$_payload")" || exit 1
    if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
        _rows="$(_romp_token_cfg | curl -sf -m 10 --config - "http://127.0.0.1:$_kport/sessions" 2>/dev/null)" || _rows='[]'
        python3 -c '
import json, sys
resp = json.loads(sys.argv[1])
rows = json.loads(sys.argv[2])
rows = rows.get("sessions", rows) if isinstance(rows, dict) else rows
names = {r.get("id"): r.get("name") for r in rows if isinstance(r, dict)}
if resp.get("deleted"):
    print("romp tag: \"%s\" deleted" % (resp.get("name") or sys.argv[3]))
else:
    g = resp.get("tag") or resp.get("group") or {}   # older kernel: pre-rename key
    m = [names.get(x) or x for x in (g.get("members") or [])]
    nm = g.get("name") or sys.argv[3]
    if m:
        print("romp tag: \"%s\" now: %s" % (nm, ", ".join(m)))
    else:
        print("romp tag: \"%s\" is empty" % nm)
' "$_resp" "$_rows" "$_gr_name"
        exit 0
    fi
    _err="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("error") or sys.argv[1])' "$_resp" 2>/dev/null || printf '%s' "$_resp")"
    echo "romp tag: refused — $_err" >&2
    exit 1
fi

# Bare `romp` — THE front door (the user 2026-07-25: the shortest command does the most common
# thing). Jupyter's flow: print the tokened URL, then TRY to open a browser on it. Both, always —
# the print is the contract (it always works, and you can copy it), the open is the convenience
# (it may not be possible). On a remote/headless box (ssh, no DISPLAY, no opener) it doesn't
# pretend: it prints the URL plus the two ways to actually reach it from your laptop.
if [[ $# -eq 0 ]]; then
    _tok="$(_romp_token)"
    _kport="${ROMP_KERNEL_PORT:-29855}"
    if [[ -z "$_tok" ]]; then
        echo "romp: no serve token yet; the kernel mints it. Is romp running? (the login service starts it; \`romp up\` runs it by hand)" >&2
        exit 1
    fi
    # Two URLs on purpose. The PRINTED one carries the token, because it is the thing you copy to
    # a phone and it lands in your terminal, not in any process's argv. The OPENED one carries a
    # one-time handoff code instead: the opener's argv is world-readable through /proc/<pid>/cmdline
    # for as long as the browser lives, so a token there is full control of every session handed to
    # any other account on the machine (2026-08-05). A code is spent the moment the page loads.
    # No kernel answering /handoff (not up yet, older build) → open the BARE url: an established
    # cookie still carries, and a cold browser lands on the login page, which tells you to run
    # `romp url`. Never fall back to putting the token in argv.
    _url="http://127.0.0.1:$_kport/?token=$_tok"
    # Is this a machine we could plausibly open a browser on? An ssh session or a Linux box with no
    # DISPLAY is headless — opening would silently do nothing, so say so instead of faking success.
    _headless=0
    if [[ -n "${SSH_CONNECTION:-}${SSH_TTY:-}" ]]; then _headless=1; fi
    if [[ "$(uname -s)" != "Darwin" && -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then _headless=1; fi
    echo ""
    echo "    romp dashboard:"
    echo ""
    echo "        $_url"
    echo ""
    if [[ "$_headless" == 1 ]]; then
        echo "    This looks like a remote/headless machine, so no browser was opened."
        echo "    To reach it from your laptop, either:"
        echo "      • attach this host from your laptop's dashboard (network button, bottom right), or"
        echo "      • forward the port:  ssh -N -L $_kport:127.0.0.1:$_kport $(hostname -s 2>/dev/null || echo '<this-host>')"
        echo "        then open the URL above on your laptop."
        echo ""
        exit 0
    fi
    # Minted only now, AFTER the headless early-exit above: a code is single-use with a 300s TTL,
    # so minting one on a box that will never open a browser leaves a live credential nobody spends
    # — and the curl would delay the printed URL, which is the contract on exactly those machines.
    # `|| true` is load-bearing under `set -euo pipefail`: no kernel answering means curl exits
    # non-zero, pipefail propagates it, and the command substitution would kill `romp` outright
    # instead of falling back — which is exactly what a machine whose kernel is not up yet does.
    _code="$(_romp_token_cfg | curl -sf -m 3 --config - "http://127.0.0.1:$_kport/handoff" 2>/dev/null \
             | sed -n 's/.*"code"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' || true)"
    if [[ -n "$_code" ]]; then
        _open_url="http://127.0.0.1:$_kport/?c=$_code"
    else
        _open_url="http://127.0.0.1:$_kport/"
    fi
    # Local machine: try to open it. Never fail the command if the opener is missing — the URL above
    # is the real deliverable (the user always has a working way in).
    # ROMP_OPENER overrides which command opens the URL; set it EMPTY to open nothing
    # (the URL still prints, which is the contract). Set-but-empty and unset differ here,
    # so ${VAR+set} rather than a truthiness check. Tests need this because PATH pruning
    # cannot express "no opener": macOS ships /usr/bin/open, so dropping a stub from PATH
    # leaves the REAL opener behind and the test launches an actual browser.
    if [[ -n "${ROMP_OPENER+set}" ]]; then
        # shellcheck disable=SC2206
        _opener=(${ROMP_OPENER})
    elif command -v open >/dev/null 2>&1; then _opener=(open)
    elif command -v xdg-open >/dev/null 2>&1; then _opener=(xdg-open)
    else _opener=(); fi
    if [[ ${#_opener[@]} -gt 0 ]] && "${_opener[@]}" "$_open_url" >/dev/null 2>&1; then
        echo "    (opened in your browser — the link above still works if it didn't)"
    else
        echo "    (couldn't open a browser automatically — copy the link above)"
    fi
    echo ""
    exit 0
fi

# `romp checkin <host>` / `romp checkout <host>` — publish THIS machine to an attached hub over
# our own outbound ssh (peer-bus check-in, plans/postal-peer-buses.md stage 3), or withdraw it. The
# plumbing behind the network popover's keep-connected checkbox; the host must be attached first.
if [[ "${1:-}" =~ ^(checkin|checkout)$ ]]; then
    _verb="$1"; shift
    _host="${1:-}"
    if [[ -z "$_host" ]]; then echo "usage: romp $_verb <host>" >&2; exit 2; fi
    _kport="${ROMP_KERNEL_PORT:-29855}"
    _on="false"; [[ "$_verb" == "checkin" ]] && _on="true"
    _resp="$(_romp_token_cfg | curl -sf -m 10 --config - -X POST "http://127.0.0.1:$_kport/tunnels/checkin" \
                  -H 'Content-Type: application/json' -d "{\"host\": \"$_host\", \"on\": $_on}")" \
        || { echo "romp $_verb: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
    if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
        echo "romp $_verb: ok ($_host)"
        exit 0
    fi
    echo "romp $_verb: kernel refused: $_resp" >&2
    exit 1
fi

# `romp compact <session> [--wait] [--timeout <s>]` — compact a session's context IN PLACE (Claude's
# /compact semantics: summarize, keep name/uuid/mailbox/watches) through the kernel's POST /compact —
# the sanctioned alternative to end+new for a long-lived session, and the external hand a session
# needs because it cannot /compact ITSELF mid-turn (the user 2026-08-30, via the dashboard team).
# Rides the chat compact button's exact machinery: a turn open → queued, fires ALONE at turn end;
# quiet → compacts now. --wait polls the kernel's own compacting signal (GET /sessions rows) until
# the compaction has STARTED and CLEARED, honest exit 1 on timeout.
if [[ "${1:-}" == "compact" ]]; then
    shift
    _c_usage="usage: romp compact <session> [--wait] [--timeout <s>]"
    _c_who="${1:-}"
    # only the verb's own flags are rejected as a name — send accepts dash-leading names, so compact
    # does too (review find: the sibling convention), while a swapped-order mistake still gets usage
    if [[ -z "$_c_who" || "$_c_who" == "--wait" || "$_c_who" == "--timeout" ]]; then echo "$_c_usage" >&2; exit 2; fi
    shift
    _c_wait=""; _c_to=600
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --wait)    _c_wait=1; shift ;;
            --timeout) shift; [[ $# -eq 0 || ! "$1" =~ ^(0|[1-9][0-9]+|[1-9])$ ]] && { echo "$_c_usage" >&2; exit 2; }
                       _c_to="$1"; shift ;;
            *) echo "$_c_usage" >&2; exit 2 ;;
        esac
    done
    _kport="${ROMP_KERNEL_PORT:-29855}"
    _payload="$(python3 -c 'import json,sys; print(json.dumps({"name": sys.argv[1]}))' "$_c_who")"
    _resp="$(_romp_token_cfg | curl -sf -m 10 --config - -X POST "http://127.0.0.1:$_kport/compact"                   -H 'Content-Type: application/json' -d "$_payload")"         || { echo "romp compact: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
    if [[ "$_resp" != *'"ok": true'* && "$_resp" != *'"ok":true'* ]]; then
        _c_err="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("error") or sys.argv[1])' "$_resp" 2>/dev/null || printf '%s' "$_resp")"
        echo "romp compact: refused — $_c_err" >&2
        exit 1
    fi
    if [[ "$_resp" == *'"queued": true'* || "$_resp" == *'"queued":true'* ]]; then
        _c_queued=1
        echo "romp compact: queued for $_c_who — the session isn't quiet; it fires the moment the current turn ends"
    else
        _c_queued=""
        echo "romp compact: compacting $_c_who now"
    fi
    [[ -z "$_c_wait" ]] && exit 0
    if [[ "$_resp" == *'"remote"'* ]]; then
        # a remote session's compaction runs on ITS kernel; the local /sessions poll below would
        # never see it and report the session dead — refuse the wait honestly instead
        _c_host="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("remote") or "?")' "$_resp" 2>/dev/null || echo "?")"
        echo "romp compact: --wait can't follow a remote session from here (it lives on $_c_host) — the compaction was still requested" >&2
        exit 1
    fi
    # Wait for OUR compaction, not a coincidental one: when queued, arm only after a quiet sample
    # (a compaction already running when we queued is the PRIOR one — ours fires after it).
    # NB the arming is two statements, not a command-substitution assignment: under set -e an
    # assignment adopts the substitution's failing status and kills the script (review find — the
    # queued+--wait path died before its first poll).
    _c_start="$(date +%s)"; _c_seen=""; _c_armed=""
    [[ -n "$_c_queued" ]] || _c_armed=1
    while :; do
        _c_rows="$(_romp_token_cfg | curl -sf -m 5 --config - "http://127.0.0.1:$_kport/sessions")" || _c_rows=""
        if [[ -z "$_c_rows" ]]; then
            _c_state="unknown"                       # a transient kernel blip is not "session gone"
        else
            _c_state="$(python3 -c 'import json,sys
who = sys.argv[2]
try: rows = json.loads(sys.argv[1])
except Exception: rows = None
if rows is None: print("unknown")
else:
    for r in rows:
        if r.get("name") == who or r.get("id") == who:
            print("compacting" if r.get("compacting") else "quiet"); break
    else: print("gone")' "$_c_rows" "$_c_who" 2>/dev/null || echo unknown)"
        fi
        if [[ "$_c_state" == "quiet" && -z "$_c_armed" ]]; then
            _c_armed=1
        elif [[ "$_c_state" == "compacting" && -n "$_c_armed" ]]; then
            _c_seen=1
        elif [[ "$_c_state" == "quiet" && -n "$_c_seen" ]]; then
            echo "romp compact: done — $_c_who compacted ($(( $(date +%s) - _c_start ))s)"
            exit 0
        elif [[ "$_c_state" == "gone" ]]; then
            echo "romp compact: $_c_who is no longer in the session list — it died or was renamed while waiting" >&2
            exit 1
        fi
        if (( $(date +%s) - _c_start >= _c_to )); then
            if [[ -n "$_c_seen" ]]; then
                echo "romp compact: still compacting after ${_c_to}s — check the session" >&2
            else
                echo "romp compact: didn't see the compaction start within ${_c_to}s — it may be queued behind a long turn (a kernel watch on the /sessions compacting field can keep an eye on it)" >&2
            fi
            exit 1
        fi
        sleep 2
    done
fi

# One kernel POST for the session verbs (send, interrupt, end) and for `romp new -m`'s first-message
# leg: the answer lands in _pbody and its status in _pcode, curl's own exit in _pcurl and the wait's
# cap in _pcap. Returns 0 on a 2xx; 1 when the kernel ANSWERED a non-2xx, with the reason in _perr
# (the body's `error` when it carries the routes' JSON error shape, else "the kernel answered HTTP
# <code>: <body>"); 2 when curl never connected (a dead kernel: no status, nothing sent); 3 when curl
# timed out (curl 28) on a kernel that took the request and answered late. The return says what
# HAPPENED, not what curl felt (upstream, 2026-09-12): until then every curl failure wore one message,
# "kernel not reachable", and exit 1, a TIMEOUT included, on a kernel that had already taken the
# request and delivered it but answered late (a boot storm: the minutes after a restart, the box under
# load); a caller that retried on any non-zero exit then re-sent a delivered message every time (one
# wake service sent nine copies of each wake twenty seconds apart after a restart). So a connection
# the kernel never took (curl 7, 6, 52) is 2 and the callers say "not reachable" with the curl code;
# a timeout AFTER the request went out is 3 and the callers say the message may have been delivered
# and not to retry blindly; a refusal the kernel wrote is 1 with its own words. The cap is
# ROMP_KERNEL_HTTP_TIMEOUT_S (default 10 s), so a slow box can widen it and a test can shrink it.
# Never `curl -sf`: -f folded every 4xx into the exit a dead kernel gets and threw the body away, so
# the kernel's 404 for a name no session answers to printed "kernel not reachable" and its reason
# never reached the caller (and without -f curl never returns 22, so no HTTP-error arm is read here).
# The status rides -w and is read here, the perf and tag verbs' pattern (_tag_curl above). One copy
# for both call sites: the -m leg kept its own `curl -sf` after the verbs dropped theirs (review find,
# 2026-09-09). Reads $_kport.
_romp_post() {   # _romp_post <route> <json payload>
    local _out
    _pcap="${ROMP_KERNEL_HTTP_TIMEOUT_S:-10}"
    _pcurl=0
    _out="$(_romp_token_cfg | curl -s -m "$_pcap" --config - -w '\n%{http_code}' -X POST "http://127.0.0.1:$_kport/$1" \
                  -H 'Content-Type: application/json' -d "$2")" || _pcurl=$?   # `|| ...`: survives set -e
    if [[ $_pcurl -eq 28 ]]; then return 3; fi
    if [[ $_pcurl -ne 0 ]]; then return 2; fi
    _pcode="${_out##*$'\n'}"
    _pbody="${_out%$'\n'*}"
    if [[ "$_pcode" == 2?? ]]; then return 0; fi
    _perr="$(python3 -c 'import json, sys
try:
    v = json.loads(sys.argv[1])
except Exception:
    v = None
e = v.get("error") if isinstance(v, dict) else None
print(e if e else "the kernel answered HTTP %s: %s" % (sys.argv[2], sys.argv[1]))' "$_pbody" "$_pcode" 2>/dev/null \
        || printf 'the kernel answered HTTP %s: %s' "$_pcode" "$_pbody")"
    return 1
}

# `romp send|interrupt|end <session> [text]` — headless session control through the kernel HTTP
# API (the kernel owns the transport and routes to whichever backend drives the session, Claude Code or Codex).
# Before this, interrupt/end existed only as browser WS ops: a session could be FED headlessly but
# never STOPPED (2026-07-05). The dashed spellings stay as SILENT aliases (agent-facing text
# delivered before 2026-07-25 names them). Exit 0 only when the kernel acked ok — a dead kernel or
# unknown session fails LOUDLY, never silently.
if [[ "${1:-}" =~ ^(--)?(send|interrupt|end)$ ]]; then
    _verb="${1#--}"; shift
    # one usage string per verb, set once (compact's _c_usage convention): every misuse arm below echoes
    # it to stderr with exit 2, and -h|--help prints it as its first line, so the bare `romp end`, the
    # misplaced-flag arm and --help cannot disagree (review round 2, 2026-09-09: the bare line kept a
    # bare form with a trailing space while --help spelled the full one)
    case "$_verb" in
        send)      _usage="usage: romp send <session> [--tag <label>] <text>" ;;
        interrupt) _usage="usage: romp interrupt <session>" ;;
        end)       _usage="usage: romp end <session>|self [--now|--when-idle]" ;;
    esac

    # `romp send --tag <label> <session> <text>` — the render hint AHEAD of the session name (2026-09-12). Until
    # this line the word `--tag` was taken AS the session name and its label as the text: a timer's ten-minute
    # send went to a session called `--tag` four times in one night, refused into nowhere while the timer read
    # "sent". A verb's own flag is never a session name; the label is checked and appended below with the
    # documented trailing form (`romp send <session> --tag <label> <text>`), which still works.
    _tag=""
    if [[ "$_verb" == "send" && "${1:-}" == "--tag" ]]; then
        _tag="${2:-}"
        [[ -n "$_tag" ]] || { echo "usage: romp send <session> [--tag <label>] <text>" >&2; exit 2; }
        shift 2
    fi
    _who="${1:-}"
    # -h|--help is the verb's own (the up/down arms' convention), so it never reaches the kernel as a
    # session name, and so is one of end's own flags in the session's slot (`romp end --now web`): usage
    # on stderr and exit 2, as `romp compact --wait` answers its misplaced flags, instead of a POST for a
    # session named --now. send's `--tag` never reaches this slot: the pre-parse above takes the leading
    # form as the label (2026-09-12), so `romp send --tag kick web hi` tags the send, and a bare
    # `romp send --tag` is usage there. Every other dash-leading word is a session name and goes to the
    # kernel, which is what compact allows too (`romp end --tag` names a session called --tag).
    case "$_who" in
        --now|--when-idle)
            if [[ "$_verb" == end ]]; then echo "$_usage" >&2; exit 2; fi ;;
        -h|--help)
            echo "$_usage"
            case "$_verb" in
                send)
                    echo "  hand a session a message through the kernel. While the session is busy the message"
                    echo "  queues and delivers when the session is quiet. --tag <label> (one word) shows the text"
                    echo "  as machine-sent under that label instead of as your typed words; pass one from scripts"
                    echo "  and cron. A known session that is not running (an ended Claude Code session addressed by"
                    echo "  id, an ended comment thread by id or name) is refused with the kernel's reason and exit 1;"
                    echo "  the message is not delivered." ;;
                interrupt)
                    echo "  stop the session's current turn (Esc) through the kernel; the session stays open." ;;
                end)
                    echo "  end a session through the kernel, at once by default. --when-idle ends it once its"
                    echo "  current turn settles, so the closing reply lands first. \`self\` names the calling"
                    echo "  session (from inside a session) and defaults to --when-idle; --now overrides that." ;;
            esac
            echo "  An unknown session name exits 1 with the kernel's reason."
            exit 0 ;;
    esac
    if [[ -z "$_who" ]]; then echo "$_usage" >&2; exit 2; fi
    shift
    # `romp end self [--now]` — a session closing ITSELF after finishing its work (the user
    # 2026-08-15: telling a session "close yourself when done" never worked; an agent could only
    # kill its own process, which read as a crash). `self` resolves through ROMP_SID (spawn-frozen
    # by the SDK backend, inherited by every Bash the agent runs). Default is when=idle: the kernel
    # kills at the turn's SETTLE, so the goodbye lands and the judges file the outcome before the
    # clean × death. --now skips the deferral (for any target).
    _when="";
    if [[ "$_verb" == "end" ]]; then
        [[ "$_who" == "self" ]] && _when="idle"
        for _a in "$@"; do
            [[ "$_a" == "--now" ]] && _when=""
            [[ "$_a" == "--when-idle" ]] && _when="idle"
        done
    fi
    _kport="${ROMP_KERNEL_PORT:-29855}"
    if [[ "$_verb" == "send" ]]; then
        # `--tag <label>` — a RENDER HINT for auto-generated text (a kickoff template, a scripted
        # brief): the chat shows a tagged message as machine-sent under that label instead of posing
        # it as the user's typed words (the user 2026-08-15). Sugar for appending the marker comment
        # `<!-- romp-tag: <label> -->` yourself; the label is one word, letters/digits/dashes.
        if [[ "${1:-}" == "--tag" ]]; then       # …or trailing the session name (the leading form set _tag above)
            _tag="${2:-}"
            shift 2 || { echo "$_usage" >&2; exit 2; }
        fi
        _text="$*"
        if [[ -z "$_text" ]]; then echo "$_usage" >&2; exit 2; fi
        if [[ -n "$_tag" ]]; then
            [[ "$_tag" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,23}$ ]] \
                || { echo "romp send: --tag must be one word (letters/digits/dashes, <=24 chars)" >&2; exit 2; }
            _text="$_text"$'\n\n'"<!-- romp-tag: $_tag -->"
        fi
        _payload="$(python3 -c 'import json,sys; print(json.dumps({"name": sys.argv[1], "text": sys.argv[2]}))' "$_who" "$_text")"
    elif [[ "$_verb" == "end" && "$_who" == "self" ]]; then
        if [[ -z "${ROMP_SID:-}" ]]; then
            echo "romp end self: ROMP_SID is not set — 'self' only works from inside a romp SDK session" >&2
            exit 2
        fi
        _payload="$(python3 -c 'import json,sys; d={"id": sys.argv[1]};
import os
w=sys.argv[2]
if w: d["when"]=w
print(json.dumps(d))' "$ROMP_SID" "$_when")"
    else
        _payload="$(python3 -c 'import json,sys; d={"name": sys.argv[1]};
w=sys.argv[2] if len(sys.argv)>2 else ""
if w: d["when"]=w
print(json.dumps(d))' "$_who" "$_when")"
    fi
    # the status is read off the answer (_romp_post above): a dead kernel is "not reachable" with
    # curl's exit code, a kernel that answered a non-2xx is quoted with its reason, exit 1 either way;
    # a kernel that took the request but answered after the cap is exit 3 with the truth, since the
    # message may already have landed and a blind retry re-sends it (the helper's comment says why)
    _rc=0
    _romp_post "$_verb" "$_payload" || _rc=$?
    if [[ $_rc -eq 3 ]]; then
        echo "romp $_verb: the kernel on :$_kport took the request but did not answer within ${_pcap}s" \
             "(mid-restart or under load); it may already have $([[ "$_verb" == send ]] && echo 'delivered the message' || echo 'acted on it');" \
             "do not retry blindly (ROMP_KERNEL_HTTP_TIMEOUT_S widens the wait)" >&2; exit 3
    fi
    if [[ $_rc -eq 2 ]]; then echo "romp $_verb: kernel not reachable on :$_kport (is romp running?) [curl exit $_pcurl]" >&2; exit 1; fi
    if [[ $_rc -ne 0 ]]; then echo "romp $_verb: $_perr" >&2; exit 1; fi
    _resp="$_pbody"
    if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
        if [[ "$_verb" == "send" && ( "$_resp" == *'"queued": true'* || "$_resp" == *'"queued":true'* ) ]]; then
            # the kernel PARKED it (a turn is open / compacting / the account is limit-held) and delivers it
            # when the session is quiet. Said out loud so a sender inside that very turn — an agent sending
            # itself a slash command — knows the command has NOT run yet.
            echo "romp send: queued ($_who) — delivers when the session is quiet"
            exit 0
        fi
        if [[ "$_verb" == "end" && ( "$_resp" == *'"deferred": true'* || "$_resp" == *'"deferred":true'* ) ]]; then
            # the kernel RECORDED the end and serves it at the turn's settle (its when:idle arm answers
            # deferred:true; a far kernel's deferral is relayed as is). Said as what happened, since a bare ok
            # here read the same for a kill that landed at once and for one still waiting on the settle
            # (review round 4, 2026-09-09). A bare ok on a --when-idle request stays ok: every kernel that ever
            # deferred answered deferred:true, so a bare ok means it killed at once
            echo "romp end: deferred ($_who), ends when idle"
            exit 0
        fi
        echo "romp $_verb: ok ($_who)"
        exit 0
    fi
    # the kernel's own words for a refusal (a session no running backend owns, a dead one: the message was
    # not delivered), never a quiet ok — the raw body only when it carries no `error` field
    _r_err="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("error") or sys.argv[1])' "$_resp" 2>/dev/null || printf '%s' "$_resp")"
    echo "romp $_verb: refused — $_r_err" >&2
    exit 1
fi

# `romp default-dir [PATH]` — the default working directory for NEW sessions (what the picker prefills).
# Persisted to ~/.config/romp/default-dir, read FIRST by the kernel's _default_create_dir() (before the
# install/serve default), so the gear dialog and this CLI share one source of truth. No arg prints the
# current value; an empty arg ("") clears it (revert to the install/serve default). Read live — no restart.
if [[ "${1:-}" == "default-dir" ]]; then
    _dd_file="$HOME/.config/romp/default-dir"
    if [[ $# -lt 2 ]]; then
        if [[ -s "$_dd_file" ]]; then cat "$_dd_file"; else echo "(unset — using the install/serve default)"; fi
        exit 0
    fi
    if [[ -z "$2" ]]; then
        rm -f "$_dd_file"; echo "default new-session dir cleared (revert to the install/serve default)."
        exit 0
    fi
    _dd="${2/#\~/$HOME}"
    _dd="$(cd "$_dd" 2>/dev/null && pwd -P)" || { echo "romp default-dir: not a directory: $2" >&2; exit 1; }
    mkdir -p "$(dirname "$_dd_file")"
    printf '%s\n' "$_dd" > "$_dd_file"
    echo "default new-session dir set to: $_dd"
    exit 0
fi

# NB: `romp --serve` (a persisted 0.0.0.0 opt-in for direct tailnet binding) was
# REMOVED 2026-07-19: phone/tailnet reach goes through `tailscale serve` proxying
# to the loopback-bound kernel instead — the kernel never leaves 127.0.0.1, and
# access rides tailnet device auth + TLS rather than a token in a URL.
# See docs/guide.md#from-your-phone.

# ── romp engine [claude|codex|status]: one switch for the machine's vendor posture ──────────────
# Sets BOTH knobs together (docs/codex.md): which harness the JUDGES call (STATE/judge-engine —
# read live per call, no restart) and which backend a NEW session defaults to
# (STATE/default-backend — honored by `romp new` and the kernel's POST /new; the dashboard's
# + dialog keeps its own per-create toggle). Running sessions are never touched.
if [[ "${1:-}" == "engine" ]]; then
    shift
    _eng_state="${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}"
    case "${1:-status}" in
        claude)
            mkdir -p "$_eng_state"
            printf 'claude\n' > "$_eng_state/judge-engine"
            printf 'sdk\n'    > "$_eng_state/default-backend"
            if ! command -v claude >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/claude" ]; then
                echo "[romp] note: no claude binary found — install Claude Code and sign in, or judges + new sessions will fail loudly" >&2
            fi
            echo "[romp] engine CLAUDE — judges run on Claude; new sessions default to the Claude Agent SDK"
            echo "[romp] running sessions are unaffected; judges pick this up on their next call" ;;
        codex)
            mkdir -p "$_eng_state"
            printf 'codex\n' > "$_eng_state/judge-engine"
            printf 'codex\n' > "$_eng_state/default-backend"
            _cx="$(command -v codex 2>/dev/null || true)"
            [ -z "$_cx" ] && [ -x "$HOME/.local/bin/codex" ] && _cx="$HOME/.local/bin/codex"
            # the bundled binary lives INSIDE codexvenv (no PATH entry point) — ccodex-setup links
            # it out, but probe the venv too so this note never cries wolf on a bundled-only box
            [ -z "$_cx" ] && _cx="$(ls -d "$_eng_state"/codexvenv/lib/python3.*/site-packages/codex_cli_bin/bin/codex 2>/dev/null | head -n1 || true)"
            if [ -z "$_cx" ] || [ ! -x "$_cx" ]; then
                echo "[romp] note: no codex binary found — run ccodex-setup, then: codex login" >&2
            elif ! "$_cx" login status 2>&1 | grep -qi '^logged in'; then   # the status goes to STDERR; "Not logged in" must not match
                echo "[romp] note: codex isn't logged in — run: codex login (or codex login --device-auth)" >&2
            fi
            echo "[romp] engine CODEX — judges run on Codex; new sessions default to the Codex backend"
            echo "[romp] running sessions are unaffected; judges pick this up on their next call" ;;
        status)
            # `|| true`: an absent file under set -euo pipefail otherwise kills the script
            # mid-substitution, printing nothing at all
            _je="$(cat "$_eng_state/judge-engine" 2>/dev/null | tr -d '[:space:]' || true)"
            _db="$(cat "$_eng_state/default-backend" 2>/dev/null | tr -d '[:space:]' || true)"
            echo "judges:               ${_je:-claude}"
            echo "new-session default:  ${_db:-sdk}" ;;
        *)
            echo "usage: romp engine [claude|codex|status]" >&2; exit 2 ;;
    esac
    exit 0
fi

# ── romp debug [on|off|status]: judge debug mode ────────────────────────────────
# When on, every judge-failure row in judge-errors.jsonl carries the failing call's
# full input + reply, and the feed joins those rows onto each card: the card modal
# grows a "Warnings (debug)" section showing every rejection as it happens (the user
# 2026-07-09). Read live by the kernel + judge (mtime-cached) — no restart needed.
if [[ "${1:-}" == "debug" ]]; then
    shift
    _dbg_conf="${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}/debug-mode.json"
    case "${1:-status}" in
        on)
            mkdir -p "$(dirname "$_dbg_conf")"
            printf '{"on": true}\n' > "$_dbg_conf"
            echo "[romp] debug mode ON — judge rejections carry input+reply; card modals show a Warnings section" ;;
        off)
            rm -f "$_dbg_conf"
            echo "[romp] debug mode OFF" ;;
        status)
            if [[ -r "$_dbg_conf" ]] && grep -q 'true' "$_dbg_conf"; then
                echo "debug mode: on"
            else
                echo "debug mode: off"
            fi ;;
        *)
            echo "usage: romp debug [on|off|status]" >&2; exit 2 ;;
    esac
    exit 0
fi

# Kernel-MANAGER commands. The manager (bin/romp-manager) is the thin, durable supervisor: normally
# the login service runs it (romp-service; installed by install.sh), and front ends (VS Code, the web
# dashboard, Obsidian) ATTACH rather than spawn. The actions are their OWN commands, none hidden under
# another (the user 2026-06-13):
#   romp up          start the manager: through the login service when one is installed, else in the
#                    foreground (Ctrl+C stops it AND its kernels); clears a `romp down` marker
#   romp down        stop the kernel and keep it stopped until `romp up`
#   romp refresh     restart EVERYTHING: the postal bus AND every kernel (picks up new code after an update)
#   romp status      manager + kernel status; a kernel stopped by `romp down` says so
# `romp down` has to go THROUGH the supervisor (romp-service stop): the manager exiting on its own is a
# crash to Restart=always / KeepAlive, respawned within seconds, which is also why a foreground Ctrl+C
# is no longer the way to stop it. A manager the service does not own (no login service installed, or
# one installed but not running, and a foreground `romp up` beside it) is stopped through its own
# /stop. The kernel port is probed last (GET /healthz): a kernel nothing above stopped (a bare
# `romp-serve`, or one that outlived its manager) is stopped through its own door, a SIGTERM at the pid
# it named on POST /down under THIS romp's serve token, and only when GET /version names the same pid.
# A kernel that rejects the token is another romp's, and the command ends at once without touching
# it, the marker, the service or the manager: a `romp down` aimed at a port it did not mean must never
# take a 403 for "nothing answered", read the pid off the auth-exempt /version and SIGTERM another
# romp's kernel, cutting every session there. Either way the command ends with a manager and a kernel
# that no longer answer, or a loud failure naming the one that does. Before stopping it asks the
# kernel to QUIESCE (POST /down): new turn starts and session creates hold, and the turns in flight
# get up to --wait seconds (default 5) to reach a turn boundary; what is still mid-turn is cut, exactly
# as under `romp refresh`, and the next start resumes it with its history (the boot reconcile). `--now`
# skips the wait. The marker (STATE/down-by-romp) is what makes the stop deliberate to everything
# else: `romp status` reports down-on-purpose instead of a crash, and `romp-manager ensure` (the
# supervised start that `romp update <host>` and the remote restart run on a far host) will not bring
# the kernel back while it exists.
# ROMP_MANAGER_BIN / ROMP_SERVICE_BIN are the test seams (same pattern as ROMP_DASHBOARD_BIN / ROMP_POSTAL_BIN).
case "${1:-}" in
    up)
        shift
        _up_fg=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --foreground) _up_fg=1 ;;
                -h|--help)
                    echo "usage: romp up [--foreground]"
                    echo "  start the kernel manager: through the login service when one is installed, else in"
                    echo "  the foreground. --foreground runs it in this terminal either way (Ctrl+C stops it"
                    echo "  and its kernels). Undoes a \`romp down\`."
                    exit 0 ;;
                *) echo "romp up: unknown option '$1' (usage: romp up [--foreground])" >&2; exit 2 ;;
            esac
            shift
        done
        _up_state="$(_romp_state_dir)"
        if [[ -f "$_up_state/down-by-romp" ]]; then
            rm -f "$_up_state/down-by-romp"
            echo "[romp] cleared the romp down marker; starting"
        fi
        # `--foreground` keeps the old behavior with a service installed (watching the manager's own
        # log in a terminal); the manager refuses to start beside a running one either way.
        if [[ -z "$_up_fg" ]]; then
            if "${ROMP_SERVICE_BIN:-romp-service}" start; then
                echo "[romp] the login service is starting the manager; \`romp status\` to check"
                exit 0
            else
                _up_rc=$?
                # 3 = no login service installed: run the manager in the foreground, as always;
                # anything else is the service failing to start, already said loudly
                [[ $_up_rc -eq 3 ]] || exit "$_up_rc"
            fi
        fi
        exec "${ROMP_MANAGER_BIN:-romp-manager}" up ;;
    down)
        shift
        _dn_now="" _dn_wait=5 _dn_quiesced=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --now)    _dn_now=1 ;;
                --wait)   _dn_wait="${2:-}"; [[ $# -gt 1 ]] && shift ;;   # a bare --wait fails the check below
                --wait=*) _dn_wait="${1#--wait=}" ;;
                -h|--help)
                    echo "usage: romp down [--now] [--wait <seconds>]"
                    echo "  stop the kernel and keep it stopped until \`romp up\`. Turns in flight get --wait"
                    echo "  seconds (default 5) to finish; --now skips the wait. Sessions resume with their"
                    echo "  history at the next \`romp up\`."
                    exit 0 ;;
                *) echo "romp down: unknown option '$1' (usage: romp down [--now] [--wait <seconds>])" >&2; exit 2 ;;
            esac
            shift
        done
        # the bound is the kernel's (DOWN_WAIT_MAX_S, 600.0) on the value AS SENT: a rounded compare
        # would let 600.4 through, which the kernel refuses with a 400 and the CLI would then turn into
        # a stop with no wait. The value goes into the request body verbatim, and JSON has no leading
        # zeros: 05, 0600 and 00.5 would pass a digits-only check and come back as the same 400
        _dn_wait_int="${_dn_wait%%.*}" _dn_wait_frac=""
        [[ "$_dn_wait" == *.* ]] && _dn_wait_frac="${_dn_wait#*.}"
        if ! [[ "$_dn_wait" =~ ^(0|[1-9][0-9]*)(\.[0-9]+)?$ ]] || (( 10#$_dn_wait_int > 600 )) \
            || { (( 10#$_dn_wait_int == 600 )) && [[ "$_dn_wait_frac" =~ [1-9] ]]; }; then
            echo "romp down: --wait takes a number of seconds, 0 to 600 (got '$_dn_wait')" >&2; exit 2
        fi
        _dn_state="$(_romp_state_dir)"
        _dn_kport="${ROMP_KERNEL_PORT:-29855}"
        _dn_kalive() { [[ "$(curl -s -m 2 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$_dn_kport/healthz" 2>/dev/null)" == 200 ]]; }
        # 1. quiesce, through the kernel's own route (see the block comment). The kernel keeps the
        #    hold for the wait plus a grace, so the stop below lands on a still-quiet kernel; if the
        #    stop never comes the hold lapses on its own. Under --now there is no wait, but the token
        #    gate is the same door: when a kernel answers on the port, the request goes out with a
        #    wait of 0 (the ask the probe makes anyway; a second wait-0 ask never shortens a hold),
        #    and only a rejected token is reported. Without it a --now aimed at another romp's kernel
        #    would stop this romp's own service and manager first, then take the marker back at the
        #    probe's 401, and the kernel it had stopped would read as a crash. _dn_nocancel: a
        #    failure below skips the release's cancel when no hold was armed here (--now with no
        #    kernel answering, or an answer other than 200). The curl timeout is the wait plus the
        #    time a turn boundary and the answer take to arrive, never the bound on the wait itself.
        _dn_ask=1 _dn_nocancel="$_dn_now" _dn_qwait="$_dn_wait" _dn_qmax=$(( 10#$_dn_wait_int + 16 ))
        if [[ -n "$_dn_now" ]]; then _dn_qwait=0 _dn_qmax=10; _dn_kalive || _dn_ask=""; fi
        if [[ -n "$_dn_ask" ]]; then
            _dn_out="$(_romp_token_cfg | curl -s -m "$_dn_qmax" --config - \
                        -H 'Content-Type: application/json' -d "{\"wait\": $_dn_qwait}" \
                        -w '\n%{http_code}' "http://127.0.0.1:$_dn_kport/down" 2>/dev/null)" || true
            _dn_code="${_dn_out##*$'\n'}"
            _dn_body="${_dn_out%$'\n'*}"
            case "$_dn_code" in
                200) _dn_quiesced=1 _dn_nocancel=""       # a hold is armed: a failure below releases it
                     if [[ -z "$_dn_now" ]]; then         # --now asked for no wait, so there is none to report
                         DN_BODY="$_dn_body" python3 - <<'PYEOF' || true
import json, os
try:
    d = json.loads(os.environ.get("DN_BODY") or "{}")
except Exception:
    d = {}
if d.get("quiet"):
    print("[romp] quiet: no turn in flight (waited %ss)" % d.get("waited", 0))
else:
    names = ", ".join(str(n) for n in (d.get("inflight") or [])) or "?"
    print("[romp] %s session(s) still mid-turn after %ss (%s); stopping anyway; they pick up where "
          "they stopped at the next romp up" % (d.get("busy", "?"), d.get("waited", "?"), names))
PYEOF
                     fi ;;
                000|"") [[ -n "$_dn_now" ]] || echo "[romp] the kernel isn't answering on :$_dn_kport; nothing to quiesce" ;;
                404)    [[ -n "$_dn_now" ]] || echo "[romp] this kernel predates the quiesce route; stopping without waiting" ;;
                401|403)
                    # not ours: the kernel answering on this port does not know this romp's token, so
                    # nothing below (marker, service, manager, the probe's signal) may act on it. The
                    # `perf` verb reads a refused token the same way. Loud, and out.
                    echo "romp down: the kernel on :$_dn_kport is not the one this romp manages (it rejected the serve token); not touching it. Check ROMP_KERNEL_PORT and the state dir" >&2
                    exit 1 ;;
                *)      [[ -n "$_dn_now" ]] || echo "[romp] quiesce failed (HTTP $_dn_code); stopping without waiting" >&2 ;;
            esac
        fi
        # 2. the marker (atomic: temp + mv), then the audit row, AFTER the wait, so the kernel's
        #    SIGTERM path finds it inside its join window and the cut ledger names the cause. The
        #    marker's cmd carries the flags; the row names the action alone.
        mkdir -p "$_dn_state"
        _dn_cmd="romp down${_dn_now:+ --now}"
        [[ -z "$_dn_now" && "$_dn_wait" != "5" ]] && _dn_cmd="$_dn_cmd --wait $_dn_wait"
        DN_CMD="$_dn_cmd" python3 -c 'import json,os,time; print(json.dumps({"t": int(time.time()), "cmd": os.environ["DN_CMD"]}))' \
            > "$_dn_state/down-by-romp.tmp" && mv -f "$_dn_state/down-by-romp.tmp" "$_dn_state/down-by-romp"
        _romp_restart_audit down
        # 3. stop through the supervisor. 3 = no login service installed, 4 = installed but not running:
        #    either way the manager, if one runs, is outside the service (a foreground `romp up`, a hand
        #    `romp-manager up`) and step 4 stops it through its own /stop. Any other failure is the
        #    service refusing to stop, and the kernel is most likely still up.
        _dn_rc=0
        "${ROMP_SERVICE_BIN:-romp-service}" stop || _dn_rc=$?
        case $_dn_rc in
            0|3|4) ;;
            *)
                _romp_down_release "$_dn_state" "$_dn_kport" "$_dn_nocancel" "the login service did not stop"
                echo "romp down: the login service did not stop; the kernel keeps running" >&2
                exit 1 ;;
        esac
        # 4. whatever the service did, "down" is checked against the manager itself, never taken from
        #    the service's word: one may still answer on the control port (started outside the service,
        #    or one the service did not take down). Stop it through its own /stop, then poll, bounded,
        #    for it to leave: the manager answers /stop first and exits once its kernels have left, or
        #    once the grace it grants them (SHUTDOWN_GRACE_MS, 8 s unless ROMP_SHUTDOWN_GRACE_MS says
        #    otherwise, then SIGKILL) plus 200 ms has run out, so the poll's bound is that grace plus a
        #    margin for the exit. The grace has ONE authoritative source: the value the manager runs
        #    with, which its status answer carries (manager.shutdownGraceMs), read off the answer this
        #    step fetches anyway. Only when the field is absent (a manager from before it carried one)
        #    or not in shape is the grace read from ROMP_SHUTDOWN_GRACE_MS in THIS shell, with the
        #    bound then floored at 10 s. Both readers accept one shape, the manager's own contract
        #    (bin/romp-manager, SHUTDOWN_GRACE_MS): a plain whole number of milliseconds, one to nine
        #    digits, above zero; any other form (an exponent, hex, a sign, a fraction, whitespace, a
        #    leading zero) is the manager's 8000 default, here as there. The margin is 2 s, counted in
        #    quarter-second polls, so the real wall time is never under the bound (each poll also
        #    spawns the control client). The bound used to be 28 polls (7 s) against the 8 s grace
        #    (raised from 5 s without the poll following), so a kernel that used its exit budget made
        #    the down report a manager that would not stop, exit 1 and take the marker back (pull-in
        #    review round 1, 2026-09-16); then it was sized from this shell's environment alone, which
        #    a manager started by a bare `romp up` or `--foreground` from a shell that set the knob need
        #    not share, and the manager's Number() read took forms (2e4, 0x2ee0) this read did not
        #    (round 2, 2026-09-16). _dn_mpolls also bounds the kernel-drain poll in step 5.
        _dn_mport="${ROMP_MANAGER_PORT:-7432}"
        _dn_mgr="" _dn_grace=""
        if _dn_mst="$("${ROMP_MANAGER_BIN:-romp-manager}" status 2>/dev/null)"; then
            _dn_mgr=1
            _dn_grace="$(DN_ST="$_dn_mst" python3 -c 'import json, os; g = (json.loads(os.environ["DN_ST"]).get("manager") or {}).get("shutdownGraceMs"); print(g if isinstance(g, int) and not isinstance(g, bool) else "")' 2>/dev/null || true)"
        fi
        if [[ "$_dn_grace" =~ ^[1-9][0-9]{0,8}$ ]]; then
            _dn_mpolls=$(( (10#$_dn_grace + 2000 + 249) / 250 ))
        else
            _dn_grace="${ROMP_SHUTDOWN_GRACE_MS:-}"
            [[ "$_dn_grace" =~ ^[1-9][0-9]{0,8}$ ]] || _dn_grace=8000
            _dn_mpolls=$(( (10#$_dn_grace + 2000 + 249) / 250 ))
            if (( _dn_mpolls < 40 )); then _dn_mpolls=40; fi
        fi
        if [[ -n "$_dn_mgr" ]]; then
            # The stop, with its answer kept. The control client exits 3 when the manager ANSWERED and
            # refused (its write gate: HTTP 401, the manager does not hold the serve token this romp sent,
            # so it runs under another state root or is another romp's, or this romp SENT NONE because it
            # found no token to send; HTTP 503, the manager cannot read its own token file), and 1 for no
            # answer at all (a timeout, a connection error), which the poll below handles as before. A
            # refusal is final: polling for the manager to leave would not change it, and a manager that refused
            # this romp's token is not this romp's to stop, so the hold is released, the marker taken back,
            # and the answer said with the status, the manager's own words and the remedy (review round 1,
            # 2026-09-10: the answer used to be discarded and the refusal reported as a manager that would
            # not leave, with "stop it by hand"). Whether a token was sent is read from the client's own
            # stderr, captured below: it says "the serve token could not be read (<file>: <why>)" before it
            # asks without one (review round 2, 2026-09-10: the 401 line used to claim a token was read from
            # the file when the file was missing or empty and no header went out).
            _dn_mout="$("${ROMP_MANAGER_BIN:-romp-manager}" down 2>&1)" && _dn_mrc=0 || _dn_mrc=$?
            if [[ "$_dn_mrc" -eq 3 ]]; then
                _dn_mref="$(DN_OUT="$_dn_mout" DN_TOK="$(_romp_state_dir)/serve-token" DN_ENV="${ROMP_SERVE_TOKEN:+1}" python3 - <<'PYEOF'
import json, os, re
out = os.environ.get("DN_OUT") or ""
m = re.search(r"answered HTTP (\d{3})", out)
code = m.group(1) if m else "?"
try:
    err = " ".join(str((json.loads(out[out.index("{"):]) or {}).get("error") or "").split())
except Exception:
    err = ""
tok = os.environ.get("DN_TOK") or "its token file"
# where the client read the token it sent, from the client's own line first (it knows what it sent; review
# round 3, 2026-09-10: this snippet's own env check could disagree with the client's), else from DN_ENV
env = bool(re.search(r"read from ROMP_SERVE_TOKEN\b", out)) if "read from " in out else bool(os.environ.get("DN_ENV"))
none = re.search(r"the serve token could not be read \((.*?)\); the manager refuses", out)
if code == "401" and none:
    why = none.group(1)
    if why.startswith(tok + ": "):
        why = why[len(tok) + 2:]
    fix = ("It needs the serve token, and this romp found none at %s (%s). Point ROMP_STATE_DIR at the manager's "
           "state root, or set ROMP_SERVE_TOKEN." % (tok, why))
elif code == "401" and env:
    # the state root changes nothing while the variable is set: the remedy is the variable (the control
    # client's and the extension's wording; review round 3, 2026-09-10)
    fix = ("It does not hold the serve token this romp read from ROMP_SERVE_TOKEN. Unset it in this shell, or set "
           "it to the manager's token, or check ROMP_MANAGER_PORT.")
elif code == "401":
    fix = ("It does not hold the serve token this romp read from %s, so it runs under another state root or "
           "belongs to another romp. Check ROMP_STATE_DIR and ROMP_MANAGER_PORT, or stop it from the shell that "
           "started it." % tok)
elif code == "503":
    fix = ("It cannot read its own serve-token file. Make that file a regular 0600 file that you own, under the "
           "manager's state root, then run romp down again.")
else:
    fix = "See the manager's log."
print(code)
print("HTTP %s%s" % (code, (": " + err) if err else ""))
print(fix)
PYEOF
)"
                _dn_mcode="${_dn_mref%%$'\n'*}"
                _dn_mrest="${_dn_mref#*$'\n'}"
                _dn_mhttp="${_dn_mrest%%$'\n'*}"
                _dn_mfix="${_dn_mrest#*$'\n'}"
                _romp_down_release "$_dn_state" "$_dn_kport" "$_dn_nocancel" "the manager on :$_dn_mport refused the stop (HTTP $_dn_mcode)"
                # the documented shape (docs/reference.md, Stopping): the manager's words close the parenthesis,
                # the remedy follows it as its own sentence (review round 2, 2026-09-10)
                echo "romp down: the manager on :$_dn_mport refused the stop ($_dn_mhttp). $_dn_mfix The kernel keeps running." >&2
                exit 1
            fi
            for _ in $(seq 1 "$_dn_mpolls"); do
                "${ROMP_MANAGER_BIN:-romp-manager}" status >/dev/null 2>&1 || break
                sleep 0.25
            done
        fi
        if _dn_st="$("${ROMP_MANAGER_BIN:-romp-manager}" status 2>/dev/null)"; then
            # still answering: the stop did not land. Release the hold, take the marker back (it would
            # report a running kernel as down on purpose) and name what is still up and where.
            _dn_pid="$(DN_ST="$_dn_st" python3 -c 'import json, os; print((json.loads(os.environ["DN_ST"]).get("manager") or {}).get("pid") or "")' 2>/dev/null || true)"
            _romp_down_release "$_dn_state" "$_dn_kport" "$_dn_nocancel" "a manager still answers on :$_dn_mport${_dn_pid:+ (pid $_dn_pid)}"
            echo "romp down: a manager is still running on :$_dn_mport${_dn_pid:+ (pid $_dn_pid)} after being asked to stop; the kernel keeps running. Stop it by hand, then run romp down again" >&2
            exit 1
        fi
        # 5. the kernel itself, last: the manager's absence is not the kernel's. Two kernels answer on
        #    the port with no manager to speak for them: a bare one (`nohup romp-serve`, what the
        #    dashboard's remote Start and the update and restart fallbacks leave on a host with no
        #    manager) and one that outlived its manager's stop. GET /healthz (auth-exempt) says whether
        #    anything is there. The pid to signal comes from POST /down under this romp's token, which
        #    the kernel gates and answers with its pid, and only when the auth-exempt GET /version
        #    names the same pid; see the ownership block below. The stop door is the manager's own:
        #    SIGTERM, which the kernel turns into a bounded drain and a cut-ledger row
        #    (_graceful_term). A kernel that step 3 or 4 already stopped gets that drain's time before
        #    it is asked again, since a second SIGTERM inside the drain writes a second, emptier ledger
        #    row over the first: the poll ends on the event the port closes, bounded by the drain. One
        #    that still answers after its own drain time has passed is the same loud failure as a
        #    lingering manager.
        _dn_kstop="" _dn_kpid=""
        if [[ "$_dn_rc" -eq 0 || -n "$_dn_mgr" ]]; then
            for _ in $(seq 1 12); do _dn_kalive || break; sleep 0.25; done
        fi
        _dn_pid_of() {   # the pid a JSON body on stdin names (a positive int), or nothing
            python3 -c 'import json, sys; p = (json.load(sys.stdin) or {}).get("pid"); print(p if isinstance(p, int) and not isinstance(p, bool) and p > 0 else "")' 2>/dev/null || true
        }
        if _dn_kalive; then
            # OWNERSHIP, at the moment of signaling. The pid comes from POST /down under this romp's
            # serve token, a route the kernel gates and answers with its pid, never from the
            # auth-exempt GET /version alone: /version answers any local process, so it proves
            # neither that the kernel is this romp's nor that it quiesced (the block comment above).
            # The ask is the quiesce with no wait, the same ask step 1 makes under --now, and a second
            # quiesce never shortens a hold step 1 armed. A 401/403 is another romp's kernel. A 200
            # without a pid is a kernel from before the field; a /version pid that differs is a kernel
            # other than the one that answered. None of these is signaled: the hold is released, the
            # marker taken back, the reason named. Every curl here ends in `|| true`: under `set -euo
            # pipefail` a kernel that leaves between the /healthz poll above and these lines (its own
            # exit, or the end of the drain a stop above began) makes curl exit non-zero, and without
            # the guard the command would die with curl's code: no line, the marker left in place, no
            # down-failed row. A kernel that is gone by now is "no answer" or "names no pid" below,
            # and takes the documented refusal.
            _dn_cout="$(_romp_token_cfg | curl -s -m 10 --config - -H 'Content-Type: application/json' \
                        -d '{"wait": 0}' -w '\n%{http_code}' "http://127.0.0.1:$_dn_kport/down" 2>/dev/null)" || true
            _dn_ccode="${_dn_cout##*$'\n'}"
            _dn_cpid="" _dn_why=""
            [[ "$_dn_ccode" == 200 ]] && _dn_cpid="$(printf '%s' "${_dn_cout%$'\n'*}" | _dn_pid_of)"
            _dn_vout="$(curl -s -m 2 "http://127.0.0.1:$_dn_kport/version" 2>/dev/null)" || true
            _dn_vpid="$(printf '%s' "$_dn_vout" | _dn_pid_of)"
            case "$_dn_ccode" in
                401|403)
                    _romp_down_release "$_dn_state" "$_dn_kport" 1 "the kernel on :$_dn_kport rejected the serve token"
                    echo "romp down: the kernel on :$_dn_kport is not the one this romp manages (it rejected the serve token); not touching it. Check ROMP_KERNEL_PORT and the state dir" >&2
                    exit 1 ;;
                200)    if [[ -z "$_dn_cpid" ]]; then
                            _dn_why="it answered POST /down without naming its pid"
                        elif [[ "$_dn_cpid" != "$_dn_vpid" ]]; then
                            _dn_vsays="names no pid"; [[ -n "$_dn_vpid" ]] && _dn_vsays="says pid $_dn_vpid"
                            _dn_why="it named pid $_dn_cpid on POST /down but GET /version $_dn_vsays"
                        fi ;;
                000|"") _dn_why="POST /down got no answer" ;;
                *)      _dn_why="POST /down answered HTTP $_dn_ccode, not a 200 naming its pid" ;;
            esac
            if [[ -n "$_dn_why" ]]; then
                # a 200 armed a hold (the confirmation's own, under --now too): release it
                _dn_rel_skip="$_dn_nocancel"; [[ "$_dn_ccode" == 200 ]] && _dn_rel_skip=""
                _romp_down_release "$_dn_state" "$_dn_kport" "$_dn_rel_skip" "the kernel on :$_dn_kport was not confirmed as this romp's ($_dn_why)"
                echo "romp down: the kernel on :$_dn_kport was not confirmed as the one this romp manages ($_dn_why); not touching it. Check ROMP_KERNEL_PORT and the state dir" >&2
                exit 1
            fi
            _dn_kpid="$_dn_cpid"
            # the poll ends on the event the port closes; its bound is the manager poll's (_dn_mpolls,
            # step 4): a kernel's exit budgets (the drain, the checkpoint and assembly writes;
            # EXIT_GRACE_S in kernel/kernel.py) are shares of the SIGTERM grace it was spawned under,
            # ROMP_SHUTDOWN_GRACE_MS less 0.5 s, so a manager-spawned kernel may use 7.5 s of an 8 s
            # grace, and a bare one assumes 5 s only when the knob is absent from its environment: the
            # kernel reads the raw value with float(), a third reader outside the digits-only contract
            # step 4's two readers share (bin/romp-manager's shutdownGrace and this command's poll
            # read), while the manager road hands it the digits the manager parsed. The readers never
            # diverge where this bound counts: a bare kernel's SIGTERM handler holds the accept loop,
            # so the poll breaks on its first iteration whatever the bound, and a kernel that outlived
            # its manager drains under the grace the manager parsed (review round 3, 2026-09-16). The
            # bound sized from that grace, with its margin, covers a kernel that uses its whole budget.
            # The poll used to be a fixed 24 x 0.25 s under a comment that called the drain about 2 s: a
            # kernel already draining on its parent-death watchdog's thread (its manager gone; the
            # SIGTERM handler proper holds the accept loop, this road does not) kept answering
            # /healthz for its whole budget, past the 6 s the poll gave it, and the down reported a
            # kernel that would not stop, exit 1 and took the marker back (pull-in review round 2,
            # 2026-09-16)
            if kill -TERM "$_dn_kpid" 2>/dev/null; then
                for _ in $(seq 1 "$_dn_mpolls"); do _dn_kalive || break; sleep 0.25; done
            fi
            if _dn_kalive; then
                _romp_down_release "$_dn_state" "$_dn_kport" "" "a kernel still answers on :$_dn_kport (pid $_dn_kpid)"
                echo "romp down: the kernel on :$_dn_kport (pid $_dn_kpid) is still running after being asked to stop; turns resume. Stop it by hand, then run romp down again" >&2
                exit 1
            fi
            _dn_kstop=1
        fi
        if [[ -n "$_dn_kstop" ]]; then
            case "$_dn_rc:$_dn_mgr" in
                3:|4:) echo "[romp] down: a kernel was running on :$_dn_kport (pid $_dn_kpid) with no manager; stopped it. \`romp up\` starts it again" ;;
                *)     echo "[romp] down: the kernel on :$_dn_kport (pid $_dn_kpid) outlived the stop and was stopped directly; \`romp up\` starts it again" ;;
            esac
            exit 0
        fi
        # "nothing was running" is never said of a kernel that answered the quiesce a moment ago
        case "$_dn_rc:$_dn_mgr:$_dn_quiesced" in
            0::*)      echo "[romp] down; \`romp up\` starts it again" ;;
            0:1:*)     echo "[romp] down: the login service stopped, and so did a manager running outside it; \`romp up\` starts it again" ;;
            *:1:*)     echo "[romp] down: the manager and its kernels are stopping; \`romp up\` starts them again" ;;
            3::1|4::1) echo "[romp] down: the kernel on :$_dn_kport answered the quiesce but has since gone (no login service installed or running, no manager on :$_dn_mport); \`romp up\` starts it again" ;;
            3::)       echo "[romp] nothing was running (no login service installed, no manager on :$_dn_mport); the auto-start stays held until \`romp up\`" ;;
            4::)       echo "[romp] nothing was running (the login service was already stopped, no manager on :$_dn_mport); the auto-start stays held until \`romp up\`" ;;
        esac
        exit 0 ;;
    refresh)   # restart EVERYTHING (the user 2026-06-29): the postal bus too, not just the kernels — the bus
               # is a separate long-lived singleton the manager doesn't own, so a kernel-only refresh left it
               # serving stale code. The kernels first, through the manager's control client, and the bus
               # (best-effort) only once the manager took the request.
               _romp_restart_audit "" "${2:-}"   # who asked (see the helper), before acting; --quiet rides along
               # Deploys bounce IMMEDIATELY, cutting in-flight turns (T160 — the parked
               # quiet window cost minutes per push; boot reconcile resumes cut turns with
               # their history). `romp refresh --quiet` defers to the next quiet window
               # explicitly (no SDK turn in flight, drain lease held, backstop-capped).
               # The client's exit is this command's: 3 when the manager ANSWERED and refused (its write
               # gate, HTTP 401 or 503; the client's stderr line names the file this romp read, or that
               # it found none, and the way out), 1 when nothing answered. On a refusal nothing restarted,
               # so the bus is left alone too (review round 2, 2026-09-10: it used to be bounced before the
               # answer was known, leaving the bus on new code and every kernel on the old).
               "${ROMP_MANAGER_BIN:-romp-manager}" restart-all "${2:-}" || exit $?
               "${ROMP_POSTAL_BIN:-romp-postal-service}" restart >/dev/null 2>&1 || true
               exit 0 ;;
    status)
        _st_marker="$(_romp_state_dir)/down-by-romp"
        [[ -f "$_st_marker" ]] || exec "${ROMP_MANAGER_BIN:-romp-manager}" status
        # a `romp down` marker: a running manager (started some other way) still wins and shows as
        # usual; a manager that does not answer is DOWN ON PURPOSE: say when and how to start it,
        # and exit 0 (a health check must not read a deliberate stop as a failure)
        if "${ROMP_MANAGER_BIN:-romp-manager}" status 2>/dev/null; then exit 0; fi
        _st_when="$(python3 - "$_st_marker" 2>/dev/null <<'PYEOF' || true
import json, sys, time
try:
    t = int(json.load(open(sys.argv[1])).get("t") or 0)
except Exception:
    t = 0
if t:
    fmt = "%H:%M" if time.strftime("%Y-%m-%d", time.localtime(t)) == time.strftime("%Y-%m-%d") else "%Y-%m-%d %H:%M"
    print(time.strftime(fmt, time.localtime(t)))
PYEOF
)"
        echo "down (romp down${_st_when:+ at $_st_when}; romp up to start)"
        exit 0 ;;
esac

# --- Retired spellings (2026-07-25): commands are bare words now ---
# Two grammar flips inside one day: PR #20 made every dashless word a session
# name (commands moved behind dashes); the user then flipped the priority — the
# most-typed things deserve the bare words, git-style, and session names moved
# behind `romp new` where they can never collide with a command. The dashed
# command spellings from that brief era (and the old short view flags) fail
# loudly naming today's word. Exception, handled in the dispatches above:
# agent-facing spellings (--mail/--url/--send/--interrupt/--end and --version)
# keep working silently — reply footers in already-delivered postal mail name
# them, and delivered text can't be re-issued. `--resume` answers with the same
# one-line refusal as `romp resume` (the verb is gone; the `new` dispatch below).
_romp_retired_flag_hint() {
    case "$1" in
        -l|--launch)   echo "the dashboard is now just: romp" ;;
        -d)            echo "the terminal monitor is gone; the browser dashboard is: romp (-d is romp new's directory option)" ;;
        -f)            echo "the terminal feed is gone; the feed lives in the dashboard: romp" ;;
        -j)            echo "the judge monitor is gone; judge warnings show on the cards themselves" ;;
        -r)            echo "the resume picker is gone; a past conversation is resumed from the dashboard (Revive): romp" ;;
        --on)          echo "the foreground manager is now: romp up" ;;
        --refresh)     echo "the fleet restart is now: romp refresh" ;;
        --status)      echo "the status report is now: romp status" ;;
        --update)      echo "the remote update is now: romp update [host]" ;;
        --checkin)     echo "the check-in is now: romp checkin <host>" ;;
        --checkout)    echo "the checkout is now: romp checkout <host>" ;;
        --default-dir) echo "the setting is now: romp default-dir [PATH]" ;;
        --debug)       echo "debug mode is now: romp debug [on|off|status]" ;;
        *)             return 1 ;;
    esac
}
if _retired="$(_romp_retired_flag_hint "${1:-}")"; then
    echo "romp: \"$1\" was retired; $_retired" >&2
    exit 2
fi

# --- new: the one command that creates a session, over the kernel's API ---
# Everything else either dispatched above or is an error here: an unknown bare
# word is NEVER silently a session (nor a typo'd command doing nothing) — it
# fails naming both readings.
session_arg=""
dir_arg=""
model_arg=""
effort_arg=""
env_args=()
no_env=false
in_args=()
no_inherit=false
use_codex=false
msg_arg=""
tag_arg=""

case "${1:-}" in
    new)
        shift
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --codex)   use_codex=true; shift ;;   # an OpenAI Codex session (docs/codex.md)
                -d)        shift
                           if [[ $# -eq 0 || "$1" == -* ]]; then
                               echo "usage: romp new [--codex] [-d <dir>] [-m <text>] [--tag <label>] [--model <id>] [--effort <level>] [--env NAME=VALUE] [--no-env] [--in <tag>] [--no-inherit] <name>" >&2; exit 2
                           fi
                           dir_arg="$1"; shift ;;
                -m|--message) shift
                           # spawn WITH the first prompt — one command from idea to a working
                           # session (the user 2026-08-14: `romp new` then `romp send` was the
                           # last two-step on the idea-to-working path). Empty text is a usage
                           # error, not a silent no-op.
                           if [[ $# -eq 0 || -z "$1" ]]; then
                               echo "usage: romp new [--codex] [-d <dir>] [-m <text>] [--tag <label>] [--model <id>] [--effort <level>] [--env NAME=VALUE] [--no-env] [--in <tag>] [--no-inherit] <name>" >&2; exit 2
                           fi
                           msg_arg="$1"; shift ;;
                --tag)     shift
                           # scheduled/scripted kickoff (the user 2026-08-18, for the nightly
                           # optimizer's briefing): the -m text is machine-sent under this label
                           # (the same third identity `romp send --tag` writes) instead of posing
                           # as the user's typed words. Rides POST /send's "tag" field — the
                           # kernel validates and appends the render-hint marker itself.
                           if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                               echo "usage: romp new [--codex] [-d <dir>] [-m <text>] [--tag <label>] [--model <id>] [--effort <level>] [--env NAME=VALUE] [--no-env] [--in <tag>] [--no-inherit] <name>" >&2; exit 2
                           fi
                           tag_arg="$1"; shift ;;
                --model)   shift
                           # per-spawn model, riding POST /new (the user 2026-08-14: the nightly
                           # optimizer must always run fable, and a headless script has no WS).
                           # VERBATIM: a family alias (fable — the CLI resolves it live, so it
                           # follows the family's newest) or a full id (claude-fable-5, a pin). A
                           # note here once said the CLI resolved "fable" to Opus 5 and so required
                           # full ids; that is not reproducible on any installed CLI.
                           if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                               echo "usage: romp new [--codex] [-d <dir>] [-m <text>] [--tag <label>] [--model <id>] [--effort <level>] [--env NAME=VALUE] [--no-env] [--in <tag>] [--no-inherit] <name>" >&2; exit 2
                           fi
                           model_arg="$1"; shift ;;
                --effort)  shift
                           # per-spawn effort (e.g. high, ultracode) — ultracode is per-session
                           # by design, never a machine default, so /new is its sanctioned door.
                           if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                               echo "usage: romp new [--codex] [-d <dir>] [-m <text>] [--tag <label>] [--model <id>] [--effort <level>] [--env NAME=VALUE] [--no-env] [--in <tag>] [--no-inherit] <name>" >&2; exit 2
                           fi
                           effort_arg="$1"; shift ;;
                --env)     shift
                           # per-session env var, repeatable — rides POST /new into the kernel's
                           # per-sid flag-settings payload, so two sessions in the SAME directory
                           # can run with different environments (the user 2026-08-17; before this,
                           # env came only from directory settings, which hit every session there).
                           # NAME=VALUE, split on the FIRST '=' (values may carry '='); an empty
                           # VALUE is meaningful (explicitly setting empty), but a missing '=' or a
                           # NAME outside [A-Za-z_][A-Za-z0-9_]* is a usage error, never a silent
                           # skip. Toggles only (FEATURE_FLAG=1, CLAUDE_CODE_*): real secrets stay
                           # behind Claude Code's apiKeyHelper (romp holds no key, and a credential name is
                           # refused here), since this payload is copied into per-sid files and the registry.
                           if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                               echo "usage: romp new [--codex] [-d <dir>] [-m <text>] [--tag <label>] [--model <id>] [--effort <level>] [--env NAME=VALUE] [--no-env] [--in <tag>] [--no-inherit] <name>" >&2; exit 2
                           fi
                           if [[ "$1" != *=* || ! "${1%%=*}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
                               echo "romp new: --env expects NAME=VALUE with NAME matching [A-Za-z_][A-Za-z0-9_]* (got: $1)" >&2; exit 2
                           fi
                           env_args+=("$1"); shift ;;
                --no-env)  shift
                           # the explicit EMPTY declaration: set_env is replace-not-merge (a re-run
                           # declares the full env the session should have), and this is that
                           # contract's limiting case — without it a debugging var set at spawn
                           # could never be removed from a running session (only overwritten, which
                           # presence-checked consumers still see). Sends "env": {}; any --env
                           # entries alongside simply fill the declaration.
                           no_env=true ;;
                --in)      shift
                           # the tag(s) the new session joins (tab groups are tags, the user
                           # 2026-09-04): its tab lands in that group's section of the strip.
                           # Repeatable; a tag that does not exist yet is created, exactly as
                           # `romp tag <name> --add` would. `--tag` was already the -m message
                           # label, hence the different word.
                           if [[ $# -eq 0 || -z "$1" || "$1" == -* ]]; then
                               echo "usage: romp new [--codex] [-d <dir>] [-m <text>] [--tag <label>] [--model <id>] [--effort <level>] [--env NAME=VALUE] [--no-env] [--in <tag>] [--no-inherit] <name>" >&2; exit 2
                           fi
                           in_args+=("$1"); shift ;;
                --no-inherit)
                           # by default a session started from INSIDE a romp session (ROMP_SID set)
                           # names that session as its parent and joins the parent's tags — a
                           # session's children land in its group. This opts the new one out.
                           no_inherit=true; shift ;;
                -*)        echo "romp new: unknown option: $1" >&2; exit 2 ;;
                *)         if [[ -n "$session_arg" ]]; then
                               echo "usage: romp new [--codex] [-d <dir>] [-m <text>] [--tag <label>] [--model <id>] [--effort <level>] [--env NAME=VALUE] [--no-env] [--in <tag>] [--no-inherit] <name>" >&2; exit 2
                           fi
                           session_arg="$1"; shift ;;
            esac
        done
        if [[ -z "$session_arg" ]]; then
            echo "usage: romp new [--codex] [-d <dir>] [-m <text>] [--tag <label>] [--model <id>] [--effort <level>] [--env NAME=VALUE] [--no-env] [--in <tag>] [--no-inherit] <name>" >&2; exit 2
        fi
        # The EFFECTIVE backend decides flag validity — the machine default (`romp engine`,
        # STATE/default-backend) counts exactly like an explicit --codex. Resolved HERE, before
        # any flag guard: validating against the flag alone let `romp new --model …` on an
        # engine-codex machine sail past, create the Codex session, silently ignore the
        # preference and warn only afterward (the user's audit, 2026-08-17).
        # `|| true`: an absent file under set -euo pipefail otherwise kills the whole command.
        _be="$(cat "${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}/default-backend" 2>/dev/null | tr -d '[:space:]' || true)"
        case "$_be" in sdk|codex) ;; *) _be="sdk" ;; esac
        $use_codex && _be="codex"
        if [[ -n "$model_arg$effort_arg" && "$_be" == "codex" ]]; then
            # per-spawn model/effort ride /new for SDK sessions only; the codex spawn takes the
            # account default and the pickers change it after. Refuse loudly (no silent drop),
            # naming which door made this spawn Codex.
            _why="--codex"; $use_codex || _why="this machine's \`romp engine codex\` default"
            echo "romp new: --model/--effort need an SDK session, and $_why makes this a Codex one — set them from the dashboard instead" >&2; exit 2
        fi
        if { [[ ${#env_args[@]} -gt 0 ]] || $no_env; } && [[ "$_be" == "codex" ]]; then
            # per-session env rides the per-sid settings file the SDK backend hands its CLI; a Codex
            # session runs on the shared app-server and takes none. The kernel refuses too, but with a
            # raw JSON body — this is the same one-line refusal as --model/--effort's, naming the door.
            _why="--codex"; $use_codex || _why="this machine's \`romp engine codex\` default"
            echo "romp new: --env/--no-env need a Claude Code session, and $_why makes this a Codex one — a Codex session takes no per-session environment" >&2; exit 2
        fi
        if [[ -n "$tag_arg" && -z "$msg_arg" ]]; then
            # a tag labels the -m text; without -m there is nothing to label
            echo "romp new: --tag needs -m <text> (the tag labels the delivered message)" >&2; exit 2
        fi
        if [[ -n "$tag_arg" ]] && ! [[ "$tag_arg" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,23}$ ]]; then
            echo "romp new: --tag must be one word (letters/digits/dashes, <=24 chars)" >&2; exit 2
        fi
        ;;
    resume|--resume)
        # `romp resume` is gone (the user 2026-09-10, with the terminal backend it drove): a past
        # conversation is resumed from the dashboard, whose Revive brings it back as a Claude Code
        # session with its history. One line, exit 2, nothing launched. `--resume` was the verb's
        # agent-facing alias and answers the same, since delivered text that names it cannot be
        # re-issued; the old reviver shapes (`romp <name> --resume <sid> --detach`, `romp --detach
        # <name>`) fall to the unknown-command and unknown-option arms below.
        echo "romp: \"$1\" is gone; a past conversation is resumed from the dashboard (Revive): romp" >&2
        exit 2
        ;;
    -*)
        echo "romp: unknown option: $1" >&2
        exit 2
        ;;
    *)
        echo "romp: unknown command \"$1\". To start a session named \"$1\": romp new $1   (commands: romp help)" >&2
        exit 2
        ;;
esac

# --- `romp new`: the session is created in the kernel, which runs it ---
# Every session runs inside the kernel (plans/sdk-backend.md) and is driven from
# the dashboard / VS Code, so nothing here needs a terminal: create it over the
# kernel API and say where to look. No silent fallback: a dead kernel fails
# loudly naming the fix (start romp). Every arm of the case above either set
# session_arg or exited, so this is the `new` dispatch's tail.
if [[ -n "$session_arg" ]]; then
    _tok="$(_romp_token)"
    _kport="${ROMP_KERNEL_PORT:-29855}"
    _dir="${dir_arg:-$PWD}"
    if [[ -z "$_tok" ]]; then
        echo "romp new: the kernel isn't running (no serve token). Start romp (the login service, or \`romp up\`) first." >&2
        exit 1
    fi
    # $_be — the effective backend — was resolved at parse time (the `new` case), where the
    # model/effort guards needed it; an explicit --codex already won there.
    # env pairs ride as trailing argv — the builder splits each on the FIRST '=' only, so values
    # carrying '=' survive; a repeated NAME keeps the LAST value, like re-exporting in a shell.
    # argv[6] is the --no-env flag: it sends the EXPLICIT empty declaration ("env": {}) — absent still
    # means "don't touch", so a plain `romp new` never carries an env key at all.
    _noenv=""; if $no_env; then _noenv=1; fi
    # parent + tags (tab groups are tags, the user 2026-09-04): run from INSIDE a romp session, the
    # new one names that session as its parent (ROMP_SID — the STABLE sid every SDK session's CLI
    # env carries; never CLAUDE_CODE_SESSION_ID, the transcript fsid) and inherits its tags in the
    # kernel; --no-inherit withholds the parent. The parent is marked parentAuto: nobody typed it,
    # so a kernel that never ran the calling session (a scratch kernel on another port) creates the
    # session untagged and echoes parentIgnored instead of refusing with a 400 naming a sid the
    # user never saw. --in tags ride as "tags"; argv[8] counts them so the env pairs still split
    # cleanly behind them. Tags are the kernel's, not the harness's, so they ride for a Codex
    # session exactly as for an SDK one.
    _parent=""; if ! $no_inherit; then _parent="${ROMP_SID:-}"; fi
    _payload="$(python3 -c 'import json,sys
d = {"name": sys.argv[1], "dir": sys.argv[2], "backend": sys.argv[3]}
sys.argv[4] and d.update(model=sys.argv[4])
sys.argv[5] and d.update(effort=sys.argv[5])
sys.argv[7] and d.update(parent=sys.argv[7], parentAuto=True)
n = int(sys.argv[8]); tags = sys.argv[9:9 + n]
tags and d.update(tags=tags)
env = dict(kv.split("=", 1) for kv in sys.argv[9 + n:])
(env or sys.argv[6]) and d.update(env=env)
print(json.dumps(d))' "$session_arg" "$_dir" "$_be" "$model_arg" "$effort_arg" "$_noenv" "$_parent" "${#in_args[@]}" ${in_args[@]+"${in_args[@]}"} ${env_args[@]+"${env_args[@]}"})"
    # No -f here: the kernel answers a bad /new payload with a 400 whose JSON body NAMES the
    # problem (reserved env names, bad session names — every validation refusal), and -f discards
    # exactly that body (exit 22), masking it as the connection-failure message below. Without -f
    # curl still exits nonzero on a real connection failure, so the || branch keeps meaning
    # "not reachable", and a 4xx body falls through to the same ok-check + refusal print the
    # kernel's 200 ok:false replies take.
    _resp="$(_romp_token_cfg | curl -s -m 15 --config - -X POST "http://127.0.0.1:$_kport/new" \
                  -H 'Content-Type: application/json' -d "$_payload")" \
        || { echo "romp new: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
    if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
        if [[ "$_resp" == *'"thread": true'* || "$_resp" == *'"thread":true'* ]]; then
            # a comment THREAD owns this name (T223): nothing was created — the ask landed on the
            # thread itself, which has no tab; it is reached from its parent session's comments
            echo "romp new: \"$session_arg\" is a comment thread (no tab) — nothing created; open it from its session's comments"
        elif [[ "$_resp" == *'"existing"'* ]]; then
            echo "romp new: \"$session_arg\" is already running; see the dashboard (romp)"
        else
            _kind="SDK"; [ "$_be" = "codex" ] && _kind="Codex"
            echo "romp new: started \"$session_arg\" ($_kind session, working in $_dir)"
            echo "romp new: watch it on the dashboard: romp"
        fi
        # --model/--effort/--env: report what the kernel APPLIED — it echoes them back (the same
        # park-aware setters as the dashboard pickers, re-asserted even on an already-running
        # session; env is born into the spawn and re-asserted through set_env). An ack missing an
        # asked key's echo means an older kernel dropped THAT ask — say so loudly instead of letting
        # this machine and the session quietly diverge. Per-asked-key, not all-or-nothing: a kernel
        # can echo model/effort while dropping env (the self-hosting window between merging this
        # code and `romp refresh`), and the aggregate check read that partial ack as full success.
        # An env echo of {} is the clear-all ack ("env cleared"), so the dropped check keys on the
        # echo's PRESENCE (is None), never its truthiness.
        # The same discipline covers tags: a `tags` echo (the session's tag names after inheriting
        # and --in) comes back whenever a parent or --in was sent — absent means an older kernel
        # dropped the ask. Which name each --in landed as rides `tagsApplied`, positional to the
        # request (`tagsRequested`): the store trims and clamps names, so a name that came back
        # respelled was APPLIED ("applied as"), and only a null slot means the kernel refused that
        # tag edit (it says why in tagError) — either way, say so. The tags line prints only when
        # tags were asked for or applied: a flagless in-session `romp new` has nothing to report.
        _tagask="${in_args[*]-}$_parent"
        if [[ -n "$_parent" ]]; then
            # the auto parent this shell's ROMP_SID named was unknown to the kernel that answered
            # (a kernel that never ran this session): nothing inherited, said once, not an error.
            # The rest of the line follows the ECHO, so it cannot contradict the "applied" line
            # below: an explicit --in still lands beside an ignored parent (tagsApplied names what
            # landed), and a name that already runs inherits nothing by design (no creation event).
            _pign=""; _pexist=""; _pnames=""
            _pinfo="$(python3 -c 'import json,sys
r = json.loads(sys.argv[1]); a = [t for t in (r.get("tagsApplied") or []) if t]
print("\x1f".join([r.get("parentIgnored") or "", "existing" if r.get("existing") else "", ", ".join(a)]))' "$_resp" 2>/dev/null || true)"
            IFS=$'\x1f' read -r _pign _pexist _pnames <<<"$_pinfo" || true   # \x1f: a tab would collapse an empty middle field
            if [[ -n "$_pign" ]]; then
                _pwhy="the kernel that answered did not run this shell's session ($_pign)"
                if [[ -n "$_pexist" ]]; then
                    echo "romp new: \"$session_arg\" inherited no tags: it was already running, and $_pwhy"
                elif [[ -n "$_pnames" ]]; then
                    echo "romp new: \"$session_arg\" inherited no tags: $_pwhy; --in applied: $_pnames"
                else
                    echo "romp new: \"$session_arg\" inherited no tags: $_pwhy"
                fi
            fi
        fi
        if [[ -n "$model_arg$effort_arg$_noenv$_tagask" || ${#env_args[@]} -gt 0 ]]; then
            _applied="$(python3 -c 'import json,sys; r=json.loads(sys.argv[1]); parts=["%s %s" % (k, r[k]) for k in ("model","effort") if r.get(k)]; e=r.get("env"); e is None or parts.append("env " + (",".join("%s=%s" % kv for kv in sorted(e.items())) or "cleared")); t=r.get("tags"); t is None or not (t or sys.argv[2] != "0") or parts.append("tags " + (", ".join(t) or "none")); print(", ".join(parts))' "$_resp" "${#in_args[@]}" 2>/dev/null || true)"
            [[ -n "$_applied" ]] && echo "romp new: applied $_applied"
            # a `refused` echo is the kernel's ANSWER to --effort (a level the session's backend or its
            # Codex catalog does not offer, in the setter's own words): say it as a refusal with its
            # reason, never as an unacknowledged ask, so --effort stays out of the dropped check below
            # (the kernel answered; it did not drop the ask). A warning on stderr: the session exists.
            # The setter's sentence names the level and the reason itself, so the line is romp new: plus that
            # sentence and nothing more (review round 2: a prefix of its own said both twice).
            _refused="$(python3 -c 'import json,sys; v=json.loads(sys.argv[1]).get("refused"); print(v if isinstance(v, str) else "")' "$_resp" 2>/dev/null || true)"
            [[ -n "$_refused" ]] && echo "romp new: $_refused" >&2
            _effask="$effort_arg"; [[ -n "$_refused" ]] && _effask=""
            _envask="${env_args[*]-}$_noenv"
            # the tags ask is named for what it was: --in, or the inheritance a parent implies
            _taglab=""; if [[ ${#in_args[@]} -gt 0 ]]; then _taglab="--in"; elif [[ -n "$_parent" ]]; then _taglab="the parent's tags"; fi
            _dropped="$(python3 -c 'import json,sys; r=json.loads(sys.argv[1]); print("/".join(lab for k,lab,a in (("model","--model",sys.argv[2]),("effort","--effort",sys.argv[3]),("env","--env",sys.argv[4]),("tags",sys.argv[6],sys.argv[5])) if a and r.get(k) is None))' "$_resp" "$model_arg" "$_effask" "$_envask" "$_tagask" "$_taglab" 2>/dev/null || echo "--model/--effort/--env/--in")"
            if [[ -n "$_dropped" ]]; then
                _hint="model/effort can be set from the dashboard"
                if [[ -n "$_taglab" && "$_dropped" == "$_taglab" ]]; then
                    _hint="tag it once it is up: romp tag <tag> --add $session_arg"
                elif [[ -n "$_taglab" && "$_dropped" == *"$_taglab"* ]]; then
                    _hint="$_hint; tags once it is up: romp tag <tag> --add $session_arg"
                fi
                echo "romp new: WARNING — the kernel did not acknowledge $_dropped (older kernel?); $_hint" >&2
            fi
            if [[ ${#in_args[@]} -gt 0 ]]; then
                # line 1: the --in names the kernel did NOT apply; line 2: the ones it applied under
                # another spelling. Positional against tagsApplied when the kernel sends it; a kernel
                # with only the `tags` echo falls back to a name match (no "applied as" possible there).
                _tagnote="$(python3 -c 'import json,sys
r = json.loads(sys.argv[1]); asked = sys.argv[2:]
t = r.get("tags")
if t is None: print(); print(); raise SystemExit      # no echo at all: the acknowledge warning covers it
ap = r.get("tagsApplied")
if isinstance(ap, list) and len(ap) == len(asked):
    print(", ".join(a for a, p in zip(asked, ap) if p is None))
    print(", ".join("%s as %s" % (json.dumps(a), p) for a, p in zip(asked, ap) if p is not None and p != a))
else:
    print(", ".join(a for a in asked if a not in t)); print()' "$_resp" "${in_args[@]}" 2>/dev/null || true)"
                _missing="$(printf '%s\n' "$_tagnote" | sed -n 1p)"
                _renamed="$(printf '%s\n' "$_tagnote" | sed -n 2p)"
                [[ -n "$_renamed" ]] && echo "romp new: --in applied $_renamed"
                if [[ -n "$_missing" ]]; then
                    _why="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("tagError") or "")' "$_resp" 2>/dev/null || true)"
                    echo "romp new: WARNING — the kernel did not apply --in $_missing${_why:+ ($_why)}" >&2
                fi
            fi
        fi
        # -m: deliver the first prompt through the same kernel route `romp send` uses, so one
        # command goes from idea to a working session. Per-leg reporting, never silent: the
        # session EXISTS by now (the /new above acked), so a failed send names the exact
        # retry command instead of pretending the spawn failed.
        if [[ -n "$msg_arg" ]]; then
            # address the send by the ID the kernel just answered with, never by name: a comment
            # thread's name resolves to no live session by design, so a by-name send to it used to
            # ack ok and land nowhere (T223)
            _mpayload="$(python3 -c 'import json,sys
r = json.loads(sys.argv[4]) if len(sys.argv) > 4 and sys.argv[4] else {}
d = ({"id": r["id"]} if r.get("id") else {"name": sys.argv[1]})
d["text"] = sys.argv[2]
if len(sys.argv) > 3 and sys.argv[3]: d["tag"] = sys.argv[3]
print(json.dumps(d))' "$session_arg" "$msg_arg" "$tag_arg" "$_resp")"
            # the same status-reading POST the send verb makes (_romp_post): a kernel that answered a
            # non-2xx (the 404 for a session it lists none of) is quoted with its reason, where `curl -sf`
            # folded it into the reason-less line a dead kernel gets (review find, 2026-09-09); a kernel
            # that took the message but answered after the cap is exit 3 with no retry advice, as for the
            # verbs, since the message may already have landed (the helper's comment says why)
            _rc=0
            _romp_post send "$_mpayload" || _rc=$?
            if [[ $_rc -eq 3 ]]; then
                echo "romp new: session is up; the kernel on :$_kport took the first message but did not answer within ${_pcap}s (mid-restart or under load); it may already have delivered the message, so check the session before sending it again (ROMP_KERNEL_HTTP_TIMEOUT_S widens the wait)" >&2; exit 3
            elif [[ $_rc -eq 2 ]]; then
                echo "romp new: session is up but the message did NOT land (kernel send failed). Retry: romp send $session_arg '<text>'" >&2; exit 1
            elif [[ $_rc -ne 0 ]]; then
                echo "romp new: the kernel refused the message: $_perr. Retry: romp send $session_arg '<text>'" >&2; exit 1
            fi
            _mresp="$_pbody"
            if [[ "$_mresp" == *'"ok": true'* || "$_mresp" == *'"ok":true'* ]]; then
                if [[ "$_mresp" == *'"queued": true'* || "$_mresp" == *'"queued":true'* ]]; then
                    # the kernel PARKED it (the fresh session is not quiet yet): it delivers when it is
                    echo "romp new: first prompt queued — delivers when the session is quiet"
                else
                    echo "romp new: first prompt delivered"
                fi
            else
                echo "romp new: session is up but the kernel refused the message: $_mresp. Retry: romp send $session_arg '<text>'" >&2
                exit 1
            fi
        fi
        exit 0
    fi
    echo "romp new: kernel refused: $_resp" >&2
    exit 1
fi
