#!/usr/bin/env bash
# romp — direct your Claude Code and Codex sessions; the dashboard is the front door
#
# Usage (see `romp help`):
#   romp                     # open the dashboard in your browser
#   romp new api             # start a session named "api" (Claude Code; it lives in the kernel)
#   romp new -m "fix X" api  # ...and deliver the first prompt in the same command
#   romp new --codex api     # ...as a Codex session
#   romp send api "text"     # scripts/agents: message a session (also: interrupt, end)
#   romp help                # the full command list
# Commands are bare words, git-style; options are dashed and belong to their
# command. A bare word that isn't a command fails loudly naming the fix
# (`romp foo` → `romp new foo`) — nothing silently becomes a session.
#
# Every session runs inside the kernel, which owns its backend (Claude Code through
# the Agent SDK, or Codex): this script talks to the kernel's API and starts nothing
# itself. A past conversation is resumed from the dashboard (Revive).

set -euo pipefail

# Sibling scripts (romp-postal-service, romp-manager, ...) live next to this script;
# make them resolvable regardless of the caller's PATH.
PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd):$PATH"


# Help. The bare word plus the conventional flags.
if [[ "${1:-}" == "help" || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    # The command list is GENERATED with a presence check per command, so it can't drift from what's
    # actually installed: a command whose backing romp-* binary is missing is hidden, and adding a new
    # romp-* front end (+ a line here) makes it appear (the user 2026-06-16). "-" = built into this
    # script (always shown). PATH already has romp's own bin dir (prepended at the top).
    _romp_cmd() {   # <invocation> <backing-bin|"-"> <description...>
        local inv="$1" bin="$2"; shift 2
        [[ "$bin" == "-" ]] || command -v "$bin" >/dev/null 2>&1 || return 0
        printf '  %-28s %s\n' "$inv" "$*"
    }
    cat <<'EOF'
romp — direct your Claude Code and Codex sessions; the dashboard is the front door

Usage:
EOF
    _romp_cmd "romp"                       -            "Open the dashboard in your browser (prints the link too)"
    _romp_cmd "romp new <name>"            -            "Start a session (SDK by default; \`romp engine\` sets the machine default)"
    _romp_cmd "romp new --codex <name>"    -            "Start it as an OpenAI Codex session (docs/codex.md)"
    _romp_cmd "romp new -d <dir> <name>"   -            "Working directory for the new session (default: the current folder)"
    _romp_cmd "romp new -m <text> <name>"  -            "Start it AND deliver <text> as its first prompt (one command, idea to working)"
    _romp_cmd "romp new --model <id> <name>" -          "Model for the SDK session: a family alias (fable — follows the newest) or a full id (claude-fable-5 — a pin); re-asserted if <name> already runs"
    _romp_cmd "romp new --effort <level> <name>" -      "Reasoning effort for the SDK session (e.g. high, ultracode); re-asserted if <name> already runs"
    _romp_cmd "romp new --env NAME=VALUE <name>" -      "Per-session env var for the SDK session (repeatable; toggles, never secrets); a re-run on a running <name> replaces the whole set"
    _romp_cmd "romp new --no-env <name>"   -            "Clear a running SDK session's per-session env (declares the empty set)"
    _romp_cmd "romp new --in <tag> <name>" -            "Put the new Claude Code or Codex session in a tag (repeatable; a new name creates the tag) — its tab lands in that group"
    _romp_cmd "romp new --no-inherit <name>" -          "Run from inside a session, a new session joins that session's tags by default; this starts it outside them"
    _romp_cmd "romp status"                romp-manager "Show manager + kernel status (a kernel stopped by romp down says so)"
    _romp_cmd "romp refresh"               romp-manager "Restart the postal bus + all romp kernels (picks up new code — run after an update)"
    _romp_cmd "romp update [host]"         romp-update  "Push this machine's committed romp to attached remotes and restart them"
    _romp_cmd "romp down [--now] [--wait N]" romp-manager "Stop the kernel and keep it stopped until romp up; turns in flight get N seconds (default 5) to finish, --now skips the wait"
    _romp_cmd "romp up [--foreground]"     romp-manager "Start the kernel manager: through the login service when installed, else in the foreground"
    _romp_cmd "romp version"               romp-version "Versions across the parts (tree, kernel, served vs built bundles)"
    _romp_cmd "romp spend-rebuild"         romp-spend-rebuild "Recount the spend ledger's token columns from the transcripts (dry run; --apply writes, dollars untouched)"
    _romp_cmd "romp restart-metrics [--json [--public]|--window day|week]" romp-restart-metrics "What kernel restarts do to the sessions, from the state ledgers and the kernel's routes: turns cut, outage and reconcile times, quiet-window waits, orphans and reaps, crash heals, redo cost, turn latency, per-session memory and CPU; --public with --json: the paste-safe form (no session name, id, pid, scope, label, free text or absolute clock stamp; not unlinkable: durations and counts stay), the shape romp perf export --public writes"
    _romp_cmd "romp spend-repair [--day D] [--apply]" romp-spend-repair "Recompute a day's spend from the turn ledger's re-attach staircase (a first result after a kernel restart that carried a surviving CLI's cumulative total): before and after per hour and per session; dry run unless --apply"
    _romp_cmd "romp uninstall"             romp-uninstall "Remove romp's installed footprint (--purge also deletes recorded state)"
    _romp_cmd "romp help"                  -            "Show this help"
    cat <<'EOF'

Session names never collide with commands: the name is always an argument, so
`romp new update` starts a session named "update".

For scripts / agents:
EOF
    _romp_cmd "romp url"                   -            "Print ONLY the tokened dashboard URL (for scripts; humans just run \`romp\`)"
    _romp_cmd "romp sessions [--json]"     -            "List the fleet with each session's state, colours and backend"
    _romp_cmd "romp perf [--interval <s>|--json|log on|off]" - "Kernel performance counters as rates over two snapshots (pusher cycles, stage times, build cache hits, bytes sent, goal loads, judge passes, rss, cpu); --json one raw snapshot; log on|off flips the romp-perf stderr log without a restart"
    _romp_cmd "romp perf stacks [--json]" - "One stack per kernel thread right now (GET /perf?stacks=1): the thread's kind, its stage mark and its frames innermost last, so a slow boot names the lock a thread waits on; --json the raw rows"
    _romp_cmd "romp perf export --public [--from F|--usage|--out P]" - "Write one paste-safe copy of the kernel's counters (every key and string folded to a code identifier or other, the by-path, by-session and stack tables and every clock stamp dropped; measurements stay, so it is not unlinkable) as perf-exports/perf-export-<stamp>.json under the state directory; --from a saved snapshot, --usage adds session and feature counts; nothing leaves the machine"
    _romp_cmd "romp perf client [--minutes <n>|--json]" - "Browser-side performance of the open dashboards (client-diag.jsonl, surface perf): handler ms/min by frame type with window p50/p90/p99 and max, main-thread-free p90, long animation frames and their attributed callbacks, the worst minute, heap and DOM, the slowest frames — per dashboard and pane over the last <n> minutes (default 10)"
    _romp_cmd "romp api-health"            -            "The API-health signal across your sessions (GET /api-health as JSON: per-key/family retry rates and a thrash state)"
    _romp_cmd "romp fork <parent> <name>"  -            "Branch a session into a new parallel one (parent untouched; --at <uuid> picks the cut)"
    _romp_cmd "romp rename <session> <name>" -          "Rename a session (uuid-keyed: mailboxes, goals and history all follow)"
    _romp_cmd "romp move <session> <dir>"   -           "Move an SDK session's working directory (its conversation follows; mid-turn it waits for the turn to end)"
    _romp_cmd "romp color <session> [<#hex|slot>]" -    "Recolor a session's identity swatch (palette hex or slot number; no color arg reads bg/fg)"
    _romp_cmd "romp emoji <session> [<emoji>|--clear]" - "Put one emoji before the session's name on its tab (a session can set its own with the set_emoji tool); --clear removes it (the only clear); no argument prints the current one — a live session by name or id, a dormant one by id"
    _romp_cmd "romp tag [<name>] [--add ...]" -         "Session tags: bare lists them; <name> with --add/--remove/--color/--delete merges one (a tagged session leaves the no-tags view); --host <kernel> edits an attached kernel's tag; --rename renames"
    _romp_cmd "romp watch-pr <n> [--repo o/r]" -        "One mail here when the PR lands or fails — the kernel owns the watch, so it survives restarts (replaces the mortal shell loop)"
    _romp_cmd "romp login add|list|remove <label>" -    "The stored Claude logins a session can be billed to beside the machine's own: add records a COMMAND that prints the login's setup-token on demand (--cmd '<shell line>'; how the token is kept is the user's); list and remove print labels only, never a token"
    _romp_cmd "romp watch --cmd '<pred>' [...]" -       "One mail when the command exits 0 (or the timeout passes) — kernel-owned like watch-pr, for ANY background wait (--every Ns --timeout Ns --note '...' | --list | --cancel <id>)"
    _romp_cmd "romp card --key <key> --title <text> [...]" - "Post a NOTICE CARD to the feed for a session (no judge): the key is the card's stable name (a second post under it is a revision); --body/--body-file, --attach <path>, --needs-you, --expires <s>, --producer; the card moves only on your dismissal, a new revision or its expiry; a session shows at most fifty live cards, the oldest superseded past that"
    _romp_cmd "romp mail ..."              romp-postal-service  "Romp Postal Service: send <to> <text> | inbox | agents | remote"
    _romp_cmd "romp send <session> [--tag <label>] <text>" - "Hand a session a message; scripts/cron SHOULD pass --tag so it renders machine-sent, not as your typed words; an unknown session is refused with the kernel's reason, exit 1; a known session that is not running is refused the same way (not delivered, exit 1); a kernel that took the request but answered late is exit 3 (the message may already have landed: do not retry blindly)"
    _romp_cmd "romp compact <session> [--wait]" -       "Compact a session's context in place (Claude's /compact) — queued safely if a turn is open; --wait blocks until it finishes (--timeout <s>, default 600)"
    _romp_cmd "romp interrupt <session>"   -            "Interrupt a session's current turn; an unknown session is refused with the kernel's reason, exit 1; a kernel that took the request but answered late is exit 3 (it may already have acted: do not retry blindly)"
    _romp_cmd "romp end <session>|self [--now|--when-idle]" - "End a session, at once by default; --when-idle ends it once its turn settles (self, the calling session, defaults to that; --now overrides); an unknown session is refused with the kernel's reason, exit 1; a kernel that took the request but answered late is exit 3 (it may already have acted: do not retry blindly)"
    _romp_cmd "romp checkin <host>"        -            "Publish this machine to an attached hub (romp checkout withdraws)"
    _romp_cmd "romp engine claude|codex"   -            "One switch: which vendor runs the judges + what new sessions default to"
    _romp_cmd "romp default-dir [PATH]"    -            "Default working dir for new sessions (no arg prints; \"\" clears)"
    _romp_cmd "romp debug [on|off|status]" -            "Judge debug mode (rejection rows carry full input+reply)"
    exit 0
fi

# (Retired) the terminal TUIs — `romp monitor`, `romp feed`, `romp judges` — and the
# `romp -g` browser timeline. All were bootstrapping views from before the browser
# dashboard existed, and the dashboard, feed and timeline now cover them
# (the user 2026-07-27).

# Romp Postal Service — peer messaging between romp sessions. A scripting/agent
# entrypoint (agents usually use the MCP tools). Delegates to romp-postal-service.
# `--mail` stays as a SILENT alias: reply footers in already-delivered mail name
# it, and delivered text can't be re-issued.
if [[ "${1:-}" == "mail" || "${1:-}" == "--mail" ]]; then
    shift
    # ROMP_POSTAL_BIN: test seam — a mock would otherwise be shadowed by the sibling-dir PATH prepend.
    exec "${ROMP_POSTAL_BIN:-romp-postal-service}" "$@"
fi

# `romp version` — what's running across the moving parts (working tree, kernel /version, bundles
# served vs on disk). Delegates to romp-version (python); quick, non-watch, so no test seam needed.
# `--version` stays as an alias: it's the one flag every CLI answers.
if [[ "${1:-}" == "version" || "${1:-}" == "--version" ]]; then
    exec romp-version
fi

# `romp uninstall` — undo install.sh (service, ~/.claude wiring, venv, build artifacts, PATH line).
# A verb rather than a README section because the footprint spans five places and reconstructing it
# by hand is how a "from scratch" reinstall ends up landing on leftovers. Delegates to
# romp-uninstall, which prompts before doing anything and needs --purge to touch recorded state.
if [[ "${1:-}" == "uninstall" ]]; then
    shift
    exec "$(dirname "$(readlink -f "$0")")/romp-uninstall" "$@"
fi

# `romp update [host...]` — PUSH this machine's committed romp to attached REMOTE kernels + restart them,
# so they run exactly the local code (the user 2026-07-04: peer-to-peer, no GitHub). No host → every
# out-of-date attached remote. Delegates to romp-update (python), which asks the LOCAL kernel to git-push
# local HEAD over ssh + restart. To update THIS machine: `git pull`/checkout then `romp refresh`.
if [[ "${1:-}" == "update" ]]; then
    shift
    exec romp-update "$@"
fi

# `romp keyswap` is retired (the user 2026-09-08): romp holds no API key. The command word keeps an
# answer so an old habit learns the new procedure instead of failing with "unknown command".
if [[ "${1:-}" == "keyswap" ]]; then
    cat >&2 <<'EOF'
romp keyswap is retired: romp holds no API key. Sessions and judges authenticate through Claude Code's own
apiKeyHelper (see docs/reference.md, "Rotating the key"). To rotate, change the vault item the helper reads;
Claude Code re-runs the helper after its TTL and on a 401 or 403, so running sessions pick the new key up
with no reconnect. Declare the billing with ROMP_EXPECTED_AUTH=key in service.env.
EOF
    exit 2
fi
# `romp spend-rebuild [--apply] [--by-session]` — recount the TOKEN columns of spend.json from the
# transcripts' own per-call usage (the user 2026-09-06: the ledger under-counted every turn but a
# process's first, because the result's flat `usage` is per-turn on current Claude Code and was
# diffed like a running total — see kernel/sdk_backend.py _turn_usage). Dollars and turn counts
# stay the recorder's. Dry run by default; --apply keeps the old file as spend.json.bak-<stamp>.
if [[ "${1:-}" == "spend-rebuild" ]]; then
    shift
    exec romp-spend-rebuild "$@"
fi

# `romp restart-metrics [--json [--public]] [--window day|week] [--anchor D] [--since D] [--until D] [--tz Z] [--no-live]`
# — the restart monitors (stage 0 of the restart-surviving sessions program, 2026-09-10): what kernel
# restarts do to the sessions, read from the state ledgers (restart-cuts, restart-audit, session-events,
# turns, the state logs, spend) and the running kernel's /version and /perf; a text summary per window, or
# the whole document as JSON for the figure script, `--json --public` its paste-safe form (the shape rule
# and denylist of cli/perf_public.py, the ones `romp perf export --public` applies: no session name, id,
# pid, scope, label, free text or absolute clock stamp; paste-safe, not unlinkable, since durations and counts
# stay). Read-only; never loads a kernel module. Delegates to
# romp-restart-metrics (python, cli/restart_metrics.py).
if [[ "${1:-}" == "restart-metrics" ]]; then
    shift
    exec romp-restart-metrics "$@"
fi
# `romp spend-repair [--day YYYY-MM-DD] [--apply] [--state DIR]`: the T354 ledger repair. Read-only unless --apply;
# never loads a kernel module. Delegates to romp-spend-repair (python, cli/spend_repair.py).
if [[ "${1:-}" == "spend-repair" ]]; then
    shift
    exec romp-spend-repair "$@"
fi

# The kernel serve token — required on EVERY kernel/bus request, loopback included (Jupyter's
# model: the 0600 file, not the socket, is the same-user trust boundary). Same resolution order
# as the kernel's _load_token: env override, else the state file.
_romp_token() {
    if [[ -n "${ROMP_SERVE_TOKEN:-}" ]]; then printf '%s' "$ROMP_SERVE_TOKEN"; return; fi
    cat "${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}/serve-token" 2>/dev/null || true
}

# The auth header as a curl CONFIG on stdin, for `curl --config -`. Never `-H "X-Romp-Token: $tok"`:
# argv is world-readable through /proc/<pid>/cmdline, so every other account on the machine can read
# the token off a running curl — and the token is full control of every session. These curls are
# short-lived, which makes reading one a race rather than a certainty; that is not a boundary.
# curl's config syntax is quoted, so a token carrying " or \ (only possible via ROMP_SERVE_TOKEN —
# the minted one is base64url) is escaped rather than silently truncating the header.
_romp_token_cfg() {
    local _t _e
    _t="$(_romp_token)"
    _e="${_t//\\/\\\\}"; _e="${_e//\"/\\\"}"
    printf 'header = "X-Romp-Token: %s"\n' "$_e"
}

# The romp state root: the marker `romp down` leaves lives here (down-by-romp: {t, cmd}), read by
# `romp status` and `romp up`, by romp-service status, and by romp-manager's ensure and up.
_romp_state_dir() { printf '%s' "${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}"; }

# A `romp down` whose stop did not land: release the quiesce hold so turns resume now, not at the
# lease's end, take the marker back, since a running kernel must not read as down on purpose, and put
# the failure on the audit ledger. The `down` row went in before the stop, and the kernel's resume
# notice reads the NEWEST row: left as it was, a later cut nobody recorded (an OOM, a hand restart)
# would be reported to every cut turn as this romp down, on purpose. A `down-failed` row after it,
# with the reason, says the stop did not happen. The third argument, when set, skips the cancel: no
# hold was armed (a --now that found no kernel to ask, or no 200).
_romp_down_release() {   # <state-dir> <kernel-port> <skip-cancel> <why>
    [[ -z "$3" ]] && { _romp_token_cfg | curl -s -m 5 --config - -H 'Content-Type: application/json' \
        -d '{"cancel": true}' -o /dev/null "http://127.0.0.1:$2/down" 2>/dev/null || true; }
    rm -f "$1/down-by-romp"
    _romp_restart_audit down-failed "" "$4"
}

# CALLER ATTRIBUTION for anything that stops or restarts the kernel (the user 2026-07-16): a refresh
# cuts SDK turns, kills pickers and sprays restart notices, and on 2026-07-16 three staged-demo
# teardowns were untraceable: kernel-downtime.jsonl has only {start,end}, agents leave no shell
# history. Append who/where/when to restart-audit.jsonl BEFORE acting, so "who restarted the
# kernel?" is one command (tail) instead of forensics. The kernel's SIGTERM path joins the newest
# request row (its `action`, and `reason` if set) onto the restart-cut ledger, so a deliberate
# `romp down` reads as one there too. The refresh row carries no action: it is the caller-attribution
# row it has always been, and the manager's `restart-all` note written after it is what names a
# refresh (the kernel's reader skips an unlabeled row). Best-effort: never blocks the restart or the
# stop itself.
_romp_restart_audit() {   # [action] [flag] [reason]   (flag --quiet: a PARKED restart; the row names it and the checkout sha)
    {
        local _ra_dir _ra_sid _ra_name="" _ra_sha=""
        _ra_dir="$(_romp_state_dir)"
        mkdir -p "$_ra_dir"
        _ra_sid="${CLAUDE_CODE_SESSION_ID:-}"
        [[ -n "$_ra_sid" && -f "$_ra_dir/names/$_ra_sid" ]] \
            && _ra_name="$(cut -f1 "$_ra_dir/names/$_ra_sid" 2>/dev/null | head -1)"
        # a quiet restart is parked at the manager: the kernel's drift check reads when + sha off this row
        # to stand down for it (T240d), where before an immediate converge pre-empted the quiet window the
        # flag asked for. The sha is the checkout this romp runs from, best-effort: no sha, no stand-down.
        # From the script's REAL path (readlink -f, as the uninstall arm spells it): invoked through a symlink,
        # the link's directory is not the repo, and the row carried when=quiet with no sha, so the stand-down
        # matched nothing and the converge pre-empted the window just the same (fold review, 2026-09-07)
        [[ "${2:-}" == "--quiet" ]] \
            && _ra_sha="$(git -C "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd -P)" rev-parse --short=8 HEAD 2>/dev/null || true)"
        RA_ACTION="${1:-}" RA_WHEN="${2:-}" RA_REASON="${3:-}" RA_SHA="$_ra_sha" \
        RA_PPID="$PPID" \
        RA_PARENT="$(ps -o command= -p "$PPID" 2>/dev/null | head -1)" \
        RA_TTY="$(tty 2>/dev/null || true)" \
        RA_SID="$_ra_sid" RA_NAME="$_ra_name" \
        python3 - >> "$_ra_dir/restart-audit.jsonl" <<'PYEOF'
import json, os, time
row = {"t": int(time.time())}
if os.environ.get("RA_ACTION"):
    row["action"] = os.environ["RA_ACTION"]         # a request row (down, down-failed); the refresh row has none
row.update({"ppid": int(os.environ.get("RA_PPID") or 0),
            "parent": os.environ.get("RA_PARENT") or "", "sid": os.environ.get("RA_SID") or "",
            "name": os.environ.get("RA_NAME") or "", "tty": os.environ.get("RA_TTY") or ""})
if os.environ.get("RA_REASON"):
    row["reason"] = os.environ["RA_REASON"]
if os.environ.get("RA_WHEN") == "--quiet":
    # a PARKED restart: the kernel's drift check reads when + sha to stand down for it (T240d)
    row["when"] = "quiet"
    if os.environ.get("RA_SHA"):
        row["sha"] = os.environ["RA_SHA"]
print(json.dumps(row))
PYEOF
    } 2>/dev/null || true
}

# `romp url` — print the tokened dashboard URL, nothing else (scripting/piping; bare `romp` is the
# human entry point). The first open seeds a year-long cookie; after that the bare URL works.
# `--url` stays as a silent alias (agent-facing text names it).
if [[ "${1:-}" == "url" || "${1:-}" == "--url" ]]; then
    _tok="$(_romp_token)"
    if [[ -z "$_tok" ]]; then
        echo "romp url: no serve token yet (start romp first — the kernel mints it)" >&2; exit 1
    fi
    echo "http://127.0.0.1:${ROMP_KERNEL_PORT:-29855}/?token=$_tok"
    exit 0
fi

# `romp sessions [--json]` — the live state of your sessions for SCRIPTS, read from the kernel, which
# owns it. Before this the only machine-readable source of per-session state and identity colour was
# a side effect of the retired terminal backend (its session table), which an external tool could read
# directly; it saw nothing of an SDK session, so every such consumer silently degraded to empty output
# (found 2026-07-27 in a downstream editor extension whose status dots and colours just vanished).
# Reading the authoritative store instead of a side effect of one backend is the repo's standing
# rule, and it is the only source that covers both backends (Claude Code and Codex).
#
# --json emits the kernel's rows verbatim (id, name, state, dir, bg, fg, backend, working, lastSid);
# bare prints one aligned line per session. A dead kernel fails LOUDLY rather than printing an empty
# list, which would read as "no sessions" and hide the breakage this command exists to end.
#
# TWO TRAPS for a consumer, both found the hard way (2026-07-27, the downstream editor extension):
#
#   * `waiting` is AT REST, not attention-needed. It is the ordinary state of a session sitting
#     there having finished its turn, and it is what most of the fleet reads most of the time.
#     Substring-matching /wait/ into an alert paints a "needs you" badge on every idle session,
#     which is worse than the blank it replaced. The states that DO want the user are `permission`
#     and `picker` (a live prompt) and `blocked`. (These are the RAW backend states; the dashboard's
#     chip vocabulary — needsInput, awaitingBg — never rides this command.)
#   * `id` is the durable key, NOT `lastSid`. Every per-session store romp keeps (states/,
#     captions/, goals/, episodes/) is filed under `id`. `lastSid` is the live Claude Code
#     transcript's fsid, which FORKS on /clear, so it is the natural guess and the wrong one. Of
#     11 sessions here, all 11 had records under `id` and only 6 under `lastSid`. That key opens
#     the per-turn one-liners at captions/<id>.jsonl, text under `caption` (the record's OWN `id`
#     is the turn's, not the session's). There is no summaries/ any more — the old path returns
#     nothing rather than erroring, so a consumer on it shows blank text and mtime 0 forever.
if [[ "${1:-}" == "sessions" ]]; then
    shift
    _json=false
    case "${1:-}" in
        --json) _json=true; shift ;;
        "")     ;;
        *)      echo "usage: romp sessions [--json]" >&2; exit 2 ;;
    esac
    _kport="${ROMP_KERNEL_PORT:-29855}"
    _resp="$(_romp_token_cfg | curl -sf -m 10 --config - "http://127.0.0.1:$_kport/sessions")" \
        || { echo "romp sessions: kernel not reachable on :$_kport (is romp running?)" >&2; exit 1; }
    if $_json; then
        printf '%s\n' "$_resp"
        exit 0
    fi
    printf '%s' "$_resp" | python3 -c '
import json, sys
rows = json.load(sys.stdin)
rows = rows.get("sessions", rows) if isinstance(rows, dict) else rows
w = max([len(r.get("name") or "") for r in rows] or [4])
for r in rows:
    print("%-*s  %-10s  %-5s  %s" % (w, r.get("name") or "", r.get("state") or "",
                                     r.get("backend") or "", r.get("dir") or ""))
'
    exit 0
fi

# `romp perf [--interval <s>] [--json]` / `romp perf log on|off` — the kernel's performance counters
# (GET /perf), read as RATES from two snapshots taken <s> seconds apart (default 10): pusher cycles and
# wakes per second, cycle time percentiles, the share of the pusher's cycle time per stage with the connect
# pushes' stage walls apart, CPU split between the
# pusher thread, the judge threads and the rest of the process, build cache hits vs rebuilds, bytes
# sent per slot kind, goal-store loads per second, judge passes, rss. It exists so an optimization can
# be checked against the LIVE kernel after each restart without attaching a profiler. --json prints one
# raw snapshot (the shape is documented on the kernel's _PerfStats). `log on|off` flips the romp-perf
# stderr log (POST /perf): before this the log needed ROMP_PERF in the kernel's environment at start,
# so turning it on meant a restart. Same contract as `sessions`: the token on stdin, a dead kernel
# fails loudly, an unknown flag is refused. Two snapshots from different kernel processes (a restart
# inside the window resets the counters) are refused rather than subtracted into negative rates.
# `romp perf export --public [--from SNAPSHOT.json] [--usage] [--out PATH]` writes one paste-safe copy of the
# snapshot under the state directory (perf-exports/), the shape rule and denylist of cli/perf_public.py
# applied to the whole document; it delegates to romp-perf-export (python, cli/perf_export.py), the
# restart-metrics pattern, and the flag is required: the verb has no raw mode.
if [[ "${1:-}" == "perf" ]]; then
    shift
    _kport="${ROMP_KERNEL_PORT:-29855}"
    _usage="usage: romp perf [--interval <s>] [--json] | romp perf log on|off | romp perf stacks [--json] | romp perf client [--minutes <n>] [--json] | romp perf export --public [--from SNAPSHOT.json] [--usage] [--out PATH]"
    if [[ "${1:-}" == "export" ]]; then
        shift
        exec romp-perf-export "$@"
    fi
    # One kernel round trip: the body on stdout and 0 when the kernel answered 2xx. curl's -f folds a
    # refused token (403) into the same exit as a dead kernel, and on a diagnostic verb that sends the
    # user off to restart a kernel that is up and answering — so the status rides -w and is read here.
    _perf_curl() {
        local _out _code
        _out="$(_romp_token_cfg | curl -s -m 10 --config - -w '\n%{http_code}' "$@")" \
            || { echo "romp perf: kernel not reachable on :$_kport (is romp running?)" >&2; return 1; }
        _code="${_out##*$'\n'}"
        case "$_code" in
            2??)     printf '%s' "${_out%$'\n'*}"; return 0 ;;
            401|403) echo "romp perf: the kernel on :$_kport refused the serve token (HTTP $_code); is ROMP_KERNEL_PORT pointing at another kernel?" >&2; return 1 ;;
            *)       echo "romp perf: the kernel on :$_kport answered HTTP $_code: ${_out%$'\n'*}" >&2; return 1 ;;
        esac
    }
    if [[ "${1:-}" == "stacks" ]]; then
        # `romp perf stacks [--json]`: one GET /perf?stacks=1, the kernel's threads as they stand at the read (T401): a
        # thread's kind, its stage mark (the pusher's tick job or push, a handler's connect push) and its frames innermost
        # last; the read a slow boot needs to NAME the lock a thread waits on where py-spy is not available.
        shift
        _json=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json) _json=1; shift ;;
                *) echo "$_usage" >&2; exit 2 ;;
            esac
        done
        _resp="$(_perf_curl "http://127.0.0.1:$_kport/perf?stacks=1")" || exit 1
        if ! printf '%s\n' "$_resp" | python3 -c '
import json, sys
st = json.load(sys.stdin).get("stacks")
ok = isinstance(st, dict) and all(isinstance(r, dict) and isinstance(r.get("frames"), list) for r in st.values())
sys.exit(0 if ok else 1)' 2>/dev/null; then
            # no stacks dict at all, or the OLD shape (ident to a list of format_stack lines: a kernel from before the sample
            # running with ROMP_PERF_STACKS): either way not this verb's rows
            echo "romp perf stacks: the kernel on :$_kport does not answer stacks (it predates GET /perf?stacks=1; restart it on this release)" >&2
            exit 1
        fi
        if [[ "$_json" -eq 1 ]]; then
            printf '%s\n' "$_resp" | python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin).get("stacks") or {}, indent=1))'
            exit 0
        fi
        printf '%s\n' "$_resp" | python3 -c '
import json, sys
snap = json.load(sys.stdin)
rows = snap.get("stacks") or {}
print("%d threads at %.3f (pid %s)" % (len(rows), snap.get("now", 0.0), (snap.get("process") or {}).get("pid")))
def order(item):
    key, r = item
    ident, _, name = key.partition(" ")
    return (bool(r.get("self")), name, int(ident) if ident.isdigit() else 0)
for key, r in sorted(rows.items(), key=order):
    ident, _, name = key.partition(" ")
    tag = " [answering this request]" if r.get("self") else ""
    stage = ("  stage " + r["stage"]) if r.get("stage") else ""
    print("\n%s (ident %s)%s%s" % (name, ident, stage, tag))
    for f in r.get("frames") or []:
        print("    " + f)
'
        exit 0
    fi
    if [[ "${1:-}" == "log" ]]; then
        case "${2:-}" in
            on)  _v=true ;;
            off) _v=false ;;
            *)   echo "$_usage" >&2; exit 2 ;;
        esac
        if [[ $# -gt 2 ]]; then echo "$_usage" >&2; exit 2; fi
        _resp="$(_perf_curl -X POST "http://127.0.0.1:$_kport/perf" -H 'Content-Type: application/json' -d "{\"log\": $_v}")" || exit 1
        if [[ "$_resp" == *'"ok": true'* || "$_resp" == *'"ok":true'* ]]; then
            # where the lines land: the manager's stderr goes to the journal under systemd and to
            # $STATE/manager.log under launchd (bin/romp-service writes StandardErrorPath there)
            if [[ "$(uname -s)" == "Darwin" ]]; then
                _hint="tail -f ${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}/manager.log | grep romp-perf"
            else
                _hint="journalctl --user -u romp-manager -f | grep romp-perf"
            fi
            echo "romp perf: log $2 (read it with: $_hint)"
            exit 0
        fi
        echo "romp perf: refused — $_resp" >&2
        exit 1
    fi
    # `romp perf client [--minutes <n>] [--json]` — the BROWSER side of the same question (2026-09-06): each
    # pane that receives frames (feed, Outline, Waiting on you, chat, timeline) posts one clientDiag row a
    # minute (surface "perf", what "minute"; ui/webview/perf-telemetry.ts) with its frame counts and handler
    # times by type (a log2 histogram per type, additive across minutes), the main-thread-free gap after a
    # frame, the browser's long-animation-frame reports with the callbacks they name, heap and DOM size — the
    # Files pane's row times the viewer's own paint pass (fileview:paint, fileview:reflow) since nothing is
    # pushed to it, and the shell (the top-level window, app "shell") posts a row with no frame types, the
    # long frames the browser reports to it alone (an iframe's long frames land there), 2026-09-09 — plus
    # a "slowframe" row the moment a frame's whole handling runs 100 ms or more, five a minute at most, the
    # rest counted in the minute row. The kernel appends them to $STATE/client-diag.jsonl with the dashboard
    # id (wid) and its clock, and rotates that file to .1 past 8 MB. Since 2026-09-18 the kernel admits each
    # surface's known top-level keys and bounds a row at 24 KiB (CLIENT_DIAG_ROW_MAX, _client_diag_line in
    # kernel/kernel.py): a perf minute row over the bound sheds its uncapped wsBytesByHost map whole, then its
    # per-minute figures (frames, loaf, free, slow, until the line fits) and names what it shed under its capped key ({"bytes": N,
    # "dropped": [...]}, the row's other keys kept); any other row over the bound, or a minute row that does
    # not fit even bare, becomes a cap marker ({"capped": true, "bytes": N}, plus the pane's app when the row
    # had one); and a row a VALUE of which the kernel stored short (a string past 64 characters cut, nesting past
    # 8 levels nulled: _client_diag_admit, since 2026-09-20) is kept whole otherwise and carries `cut`, the admitted
    # keys it happened under, the third loss shape. This reads both files, skips the markers (nothing in them
    # folds) and counts all three shapes in its header line and in --json (shed_minute_rows with shed_keys,
    # capped_rows, and cut_rows with cut_keys: the rows carrying `cut` and the keys it names, so a stored value can
    # be told from a whole one here as the two row-level shapes can), so the loss is visible and never silent; a
    # shed minute row still folds by its span, heap and DOM, and by its frames when the map alone was shed
    # (capped.dropped names what went, and the header counts the shed rows by it, every key shed named from
    # shed_keys itself: "shed keys (frames on %d, wsBytesByHost on %d)", shed_keys in --json, since the round-1
    # ladder put the map ahead of the frames a row shed alone before it; the cut term is printed only when a
    # row carried cut). It folds the last <n>
    # minutes per dashboard and pane (window percentiles from the summed histograms, the worst minute, the
    # slowest frames) and prints one screen. No kernel round trip: the files are read directly, so it works
    # with the kernel down. An absent file or one with no perf rows is said plainly: the bundles predate the
    # telemetry, or no dashboard has been open since. The dashboard shell (the top-level window, app "shell";
    # ui/webview/shell-perf.ts) posts the same minute row with no frame types: the long animation frames
    # Chromium reports to the top-level document and never to the pane whose script ran them, so the pane
    # script that blocked the page is named there, and this shows it as one more pane of its dashboard.
    if [[ "${1:-}" == "client" ]]; then
        shift
        _cusage="usage: romp perf client [--minutes <n>] [--json]"
        _cjson=false; _cmin=10
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json) _cjson=true; shift ;;
                --minutes)
                    if [[ ! "${2:-}" =~ ^[0-9]+$ || "${2:-0}" -eq 0 ]]; then echo "$_cusage" >&2; exit 2; fi
                    _cmin="$2"; shift 2 ;;
                --minutes=*)
                    _cmin="${1#--minutes=}"
                    if [[ ! "$_cmin" =~ ^[0-9]+$ || "$_cmin" -eq 0 ]]; then echo "$_cusage" >&2; exit 2; fi
                    shift ;;
                *) echo "$_cusage" >&2; exit 2 ;;
            esac
        done
        _cfile="${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}/client-diag.jsonl"
        python3 - "$_cfile" "$_cmin" "$_cjson" <<'PY'
import json, math, os, sys, time
path, minutes, as_json = sys.argv[1], int(sys.argv[2]), sys.argv[3] == "true"
RELOAD = "no browser telemetry yet: rebuild the bundles and reload the dashboard"
EDGES = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096]   # perf-telemetry.ts HIST_EDGES: bucket i is [EDGES[i-1], EDGES[i])
NBUCKETS = len(EDGES) + 1
TYPES_SHOWN, SLOW_SHOWN = 8, 5
older = path + ".1"                        # the kernel rotates the file past its size cap; the previous run is .1
now = time.time()
cutoff = now - minutes * 60
rows, newest, files = [], 0, []
shed_minute_rows, capped_rows = 0, 0       # the kernel's two cap shapes (kernel.py _client_diag_line), counted inside the window like the rest
shed_keys = {}                             # key -> the shed minute rows that dropped it (capped.dropped), so the header says WHAT went, not "frames"
cut_rows, cut_keys = 0, {}                 # the kernel's third loss shape (kernel.py _client_diag_admit): the rows carrying `cut`, and per key it names the rows that carried it
for fp in (older, path):
    try:
        f = open(fp, encoding="utf-8", errors="replace")
    except FileNotFoundError:
        continue                            # never written, or the kernel is renaming it this instant: the next run sees it
    files.append(fp)
    with f:
        for line in f:
            if '"perf"' not in line:        # cheap prefilter: the file also holds the shim's and the panes' breadcrumbs
                continue
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if not isinstance(r, dict) or r.get("surface") != "perf" or not isinstance(r.get("data"), dict):
                continue
            t = r.get("t") or 0
            newest = max(newest, t)
            if t < cutoff:
                continue
            capped = r["data"].get("capped")
            if capped is True:                  # a whole-row marker ({"capped": true, "bytes": N}, the pane's app when the row had one): nothing
                capped_rows += 1                # in it folds, so it is counted and skipped; folded, it read as a pane with one zero-ms minute,
                continue                        # and a marker without app landed under a pane named "?" (review find, 2026-09-18)
            if r.get("what") == "minute" and isinstance(capped, dict):
                shed_minute_rows += 1           # a minute row stored without some of its figures (capped.dropped names them): its span, heap and DOM
                for k in capped.get("dropped") or []:   # still fold, and so do its frames when the ladder shed the wsBytesByHost map alone (its first
                    if isinstance(k, str):              # step since 2026-09-20), so the header is worded from what each row dropped
                        shed_keys[k] = shed_keys.get(k, 0) + 1
            cut = r["data"].get("cut")
            if isinstance(cut, list):           # a value under an admitted key stored short (cut at CLIENT_DIAG_STR_MAX, nulled past CLIENT_DIAG_DEPTH_MAX):
                cut_rows += 1                   # the row folds whole otherwise, so it is counted (beside the shed count when it also shed keys) and the keys
                for k in cut:                   # it names are, or a stored value could not be told from a whole one here (the maintainer's round 4, kernel-1:
                    if isinstance(k, str):      # the writer landed without its reader)
                        cut_keys[k] = cut_keys.get(k, 0) + 1
            rows.append(r)
if not files:
    sys.stderr.write("romp perf client: %s (%s does not exist)\n" % (RELOAD, path))
    sys.exit(1)
shown = path + (" and .1" if older in files else "")
if not newest:
    sys.stderr.write("romp perf client: %s (%s has no surface \"perf\" rows)\n" % (RELOAD, shown))
    sys.exit(1)
if not rows:
    lost = ((" (%d row%s in the window %s capped whole by the kernel and hold%s no figures)"
             % (capped_rows, "" if capped_rows == 1 else "s", "was" if capped_rows == 1 else "were", "s" if capped_rows == 1 else ""))
            if capped_rows else "")   # a window of markers alone is a loss to say, not an idle dashboard
    sys.stderr.write("romp perf client: no browser telemetry in the last %d min (the newest perf row is %d min old)%s; "
                     "is a dashboard open? (--minutes to widen the window)\n" % (minutes, (now - newest) // 60, lost))
    sys.exit(1)

groups = {}                                 # (dashboard id, pane app) -> its minute rows and slowframe rows
for r in rows:
    key = ((str(r.get("wid") or ""))[:8] or "-", str(r["data"].get("app") or "?"))
    g = groups.setdefault(key, {"minute": [], "slow": []})
    if r.get("what") == "minute":
        g["minute"].append(r)
    elif r.get("what") == "slowframe":
        g["slow"].append(r)


def num(d, k, default=0.0):
    v = d.get(k) if isinstance(d, dict) else None
    return float(v) if isinstance(v, (int, float)) else default


def hist_of(st):
    h = st.get("hist") if isinstance(st, dict) else None
    if isinstance(h, list) and len(h) == NBUCKETS and all(isinstance(x, (int, float)) for x in h):
        return [int(x) for x in h]
    return [0] * NBUCKETS


def hist_q(h, q):                           # nearest-rank quantile of a histogram -> its bucket index; -1 when empty
    total = sum(h)
    if not total:
        return -1
    rank = min(total, max(1, math.ceil(q * total)))
    cum = 0
    for i, c in enumerate(h):
        cum += c
        if cum >= rank:
            return i
    return NBUCKETS - 1


def edge_label(i):                          # the bucket's upper bound, the figure a percentile is printed as
    if i < 0:
        return "-"
    if i >= len(EDGES):
        return ">=%d" % EDGES[-1]
    return "<%d" % EDGES[i]


def edge_num(i):                            # the same for --json: the exclusive upper edge, None for empty or the top bucket
    return EDGES[i] if 0 <= i < len(EDGES) else None


def clock(t):
    return time.strftime("%H:%M:%S", time.localtime(t))


def span(m):                                # a minute's span on the clock: its start (the browser's since) to the kernel's receipt of its row
    s = m.get("since")
    return (clock(s / 1000.0) + "-" if isinstance(s, (int, float)) and s > 0 else "ending ") + clock(m["t"])


panes = []
for (wid, app), g in sorted(groups.items()):
    mins = sorted(g["minute"], key=lambda r: r.get("t") or 0)
    span_min = sum(num(r["data"], "span_ms") for r in mins) / 60000.0
    if span_min <= 0:
        span_min = float(len(mins))
    rate_min = max(span_min, 1.0 / 60)
    frames, free_p90, loaf_n, blocking, worst, top, top_inv, srcs = {}, None, 0, 0.0, 0.0, {}, {}, set()
    per_minute, slow_suppressed, slow_suppressed_worst = [], 0, 0.0
    for r in mins:
        d = r["data"]
        total_ms = 0.0
        for typ, st in (d.get("frames") or {}).items():
            if not isinstance(st, dict):
                continue
            f = frames.setdefault(str(typ), {"n": 0, "ms_sum": 0.0, "max": 0.0, "n16": 0, "n100": 0, "hist": [0] * NBUCKETS})
            f["n"] += int(num(st, "n"))
            f["ms_sum"] += num(st, "ms_sum")
            f["max"] = max(f["max"], num(st, "ms_max"))
            f["n16"] += int(num(st, "n16"))
            f["n100"] += int(num(st, "n100"))
            for i, c in enumerate(hist_of(st)):
                f["hist"][i] += c
            total_ms += num(st, "ms_sum")
        fr = d.get("free")
        if isinstance(fr, dict) and num(fr, "n"):
            free_p90 = max(free_p90 or 0.0, num(fr, "p90"))
        lo = d.get("loaf") or {}
        lo_n, lo_block = 0, 0.0
        if isinstance(lo, dict):
            lo_n, lo_block = int(num(lo, "n")), num(lo, "blocking_ms")
            loaf_n += lo_n
            blocking += lo_block
            worst = max(worst, num(lo, "worst_ms"))
            srcs.add(str(lo.get("src") or "none"))
            for tp in lo.get("top") or []:
                if isinstance(tp, dict) and tp.get("k"):
                    top[str(tp["k"])] = top.get(str(tp["k"]), 0.0) + num(tp, "ms")
                    if tp.get("inv"):
                        top_inv[str(tp["k"])] = str(tp["inv"])
        sl = d.get("slow")
        if isinstance(sl, dict):
            slow_suppressed += int(num(sl, "suppressed"))
            slow_suppressed_worst = max(slow_suppressed_worst, num(sl, "suppressed_worst_ms"))
        per_minute.append({"t": r.get("t") or 0, "since": d.get("since"), "total_ms": round(total_ms, 1),
                           "loaf_n": lo_n, "blocking_ms": round(lo_block, 1), "frames": d.get("frames") or {}})
    for f in frames.values():
        f["per_min"] = f["n"] / rate_min
        f["ms_per_min"] = f["ms_sum"] / rate_min
        for q, k in ((0.5, "p50"), (0.9, "p90"), (0.99, "p99")):
            f[k + "_bucket"] = hist_q(f["hist"], q)
            f[k + "_lt"] = edge_num(f[k + "_bucket"])
    total_ms_all = sum(f["ms_sum"] for f in frames.values())
    worst_minute = max(per_minute, key=lambda m: m["total_ms"]) if per_minute else None
    last = mins[-1]["data"] if mins else {}
    slow = []
    for r in g["slow"]:
        d = r["data"]
        lo = d.get("loaf") if isinstance(d.get("loaf"), dict) else None
        slow.append({"t": r.get("t") or 0, "type": str(d.get("type") or "?"), "ms": num(d, "ms"), "dom": d.get("dom"),
                     "loaf": [{"k": str(tp.get("k")), "ms": num(tp, "ms")} for tp in (lo or {}).get("top") or [] if isinstance(tp, dict)]})
    slow.sort(key=lambda sl: -sl["ms"])
    panes.append({
        "wid": wid, "app": app, "ua": str(last.get("ua") or "?"), "minutes": round(span_min, 1), "rows": len(mins),
        "total_ms_per_min": total_ms_all / rate_min, "frames": frames, "free_p90": free_p90,
        "loaf": {"per_min": loaf_n / rate_min, "blocking_ms_per_min": blocking / rate_min, "worst_ms": worst,
                 "src": "loaf" if "loaf" in srcs else ("longtask" if "longtask" in srcs else "none")},
        "top": [{"k": k, "ms": ms, "inv": top_inv.get(k, "")} for k, ms in sorted(top.items(), key=lambda kv: -kv[1])[:5]],
        "minutes_detail": [{k: m[k] for k in ("t", "since", "total_ms", "loaf_n", "blocking_ms")} for m in per_minute],
        "worst_minute": worst_minute,
        "heap_mb": last.get("heap_mb"), "dom": last.get("dom"),
        "visible": last.get("visible"), "hidden_pane": last.get("hidden_pane"),
        "slow": slow, "slow_suppressed": slow_suppressed, "slow_suppressed_worst_ms": slow_suppressed_worst,
    })

if as_json:
    for p in panes:
        p["minutes_detail"] = p.pop("minutes_detail")
        if p["worst_minute"]:
            p["worst_minute"] = {k: p["worst_minute"][k] for k in ("t", "since", "total_ms", "loaf_n", "blocking_ms")}
    print(json.dumps({"window_min": minutes, "path": path, "files": files, "panes": panes,
                      "shed_minute_rows": shed_minute_rows, "shed_keys": shed_keys, "capped_rows": capped_rows,
                      "cut_rows": cut_rows, "cut_keys": cut_keys}, indent=1, sort_keys=True))
    sys.exit(0)

n_slow = sum(len(p["slow"]) for p in panes)
n_dash = len({p["wid"] for p in panes})
capped_note = ""                            # said only when the file lost something in any of the kernel's three shapes (shed keys, a whole-row marker, a cut value), so the loss is visible and never silent
if shed_minute_rows or capped_rows or cut_rows:   # by what was dropped: a row that shed the wsBytesByHost map alone kept its frames, which folded above; a cut row names the keys the cut fell under
    # the shed clause is worded from shed_keys itself, as the cut clause is from cut_keys (the maintainer's round 5, kernel-2: it named
    # two of the ladder's five keys by hand, so a row that shed loaf, free or slow reported it in --json and not here), and each
    # key list is rendered only when its count is above zero (round 5, regression-5: "0 rows with a value cut (no key named)" was
    # printed whenever any other shape fired); the cut term appears only when a row carried cut, and its fallback names the case
    # of a cut list naming no string key
    shed_named = ", ".join("%s on %d" % kv for kv in sorted(shed_keys.items()))
    cut_named = ", ".join("%s on %d" % kv for kv in sorted(cut_keys.items())) or "no key named"
    capped_note = "; %d minute row%s shed keys%s, %d row%s capped whole" % (
        shed_minute_rows, "" if shed_minute_rows == 1 else "s", " (%s)" % shed_named if shed_minute_rows else "",
        capped_rows, "" if capped_rows == 1 else "s")
    if cut_rows:
        capped_note += ", %d row%s with a value cut (%s)" % (cut_rows, "" if cut_rows == 1 else "s", cut_named)
print("romp perf client: browser telemetry from the last %d min (%s): %d dashboard%s, %d pane%s, %d minute row%s, %d slow frame row%s%s"
      % (minutes, shown, n_dash, "" if n_dash == 1 else "s", len(panes), "" if len(panes) == 1 else "s",
         len(rows) - n_slow, "" if len(rows) - n_slow == 1 else "s", n_slow, "" if n_slow == 1 else "s", capped_note))
print("handler time is the pane's own, by frame type (fed:<type> is the federation layer's share, additive with the pane's);\n"
      "percentiles are histogram bucket upper bounds over the window; attribution names the callback the browser ran;\n"
      "heap and DOM are the last sample's")
for p in panes:
    if p["visible"] is False:
        vis = "hidden"
    elif p["hidden_pane"]:
        vis = "hidden (no viewport)"
    else:
        vis = "visible"
    heap = ("heap %.1f MB" % p["heap_mb"]) if isinstance(p["heap_mb"], (int, float)) else "heap n/a"
    dom = ("dom %d" % p["dom"]) if isinstance(p["dom"], (int, float)) else "dom n/a"
    print("dashboard %s · %s   %s   %g min reported   %s   %s   %s" % (p["wid"], p["app"], p["ua"], p["minutes"], heap, dom, vis))
    fl = sorted(p["frames"].items(), key=lambda kv: -kv[1]["ms_sum"])
    print("  handler      %.0f ms/min total" % p["total_ms_per_min"] if fl else "  handler      no frames")
    for t, f in fl[:TYPES_SHOWN]:
        print("    %-12s %6.1f/min %6.0f ms/min   p50 %s   p90 %s   p99 %s ms   max %.0f   >16.7 ms %.0f%%   >=100 ms %.0f%%"
              % (t, f["per_min"], f["ms_per_min"], edge_label(f["p50_bucket"]), edge_label(f["p90_bucket"]), edge_label(f["p99_bucket"]),
                 f["max"], 100.0 * f["n16"] / f["n"] if f["n"] else 0.0, 100.0 * f["n100"] / f["n"] if f["n"] else 0.0))
    if len(fl) > TYPES_SHOWN:
        print("    and %d more type%s" % (len(fl) - TYPES_SHOWN, "" if len(fl) - TYPES_SHOWN == 1 else "s"))
    # each minute row's free p90 is over that minute's samples; the fold keeps the largest, so this is the worst
    # minute's figure, not a window percentile like the handler columns
    free = ("free after a frame, worst minute's p90 %.0f ms" % p["free_p90"]) if p["free_p90"] is not None else "free after a frame p90 n/a"
    lo = p["loaf"]
    if lo["src"] == "none":
        longf = "long frames: not reported by this browser"
    else:
        longf = "long frames %.1f/min   blocking %.0f ms/min   worst %.0f ms" % (lo["per_min"], lo["blocking_ms_per_min"], lo["worst_ms"])
        if lo["src"] == "longtask":
            longf += " (longtask: no attribution)"
    print("  main thread  %s   %s" % (free, longf))
    print("  attribution  " + ("   ".join("%s %.0f ms%s" % (t["k"], t["ms"], (" (%s)" % t["inv"]) if t["inv"] else "") for t in p["top"]) or "none"))
    wm = p["worst_minute"]
    if wm:
        wf = sorted(((typ, st) for typ, st in wm["frames"].items() if isinstance(st, dict)), key=lambda kv: -num(kv[1], "ms_sum"))[:3]
        parts = ["%s %d (p90 %s ms, max %.0f)" % (typ, int(num(st, "n")), edge_label(hist_q(hist_of(st), 0.9)), num(st, "ms_max")) for typ, st in wf]
        print("  worst minute %s   %.0f ms handler   %s   long frames %d, blocking %.0f ms"
              % (span(wm), wm["total_ms"], "   ".join(parts) or "no frames", wm["loaf_n"], wm["blocking_ms"]))
    if p["slow"] or p["slow_suppressed"]:
        for sl in p["slow"][:SLOW_SHOWN]:
            dom_s = (" (dom %d)" % sl["dom"]) if isinstance(sl["dom"], (int, float)) else ""
            attr = ("  " + "  ".join("%s %.0f ms" % (a["k"], a["ms"]) for a in sl["loaf"])) if sl["loaf"] else ""
            print("  slow frames  %s %s %.0f ms%s%s" % (clock(sl["t"]), sl["type"], sl["ms"], dom_s, attr))
        more = max(0, len(p["slow"]) - SLOW_SHOWN) + p["slow_suppressed"]
        if more:
            print("               and %d more%s" % (more, (" (%d not sent by the pane past its per-minute cap; worst %.0f ms)"
                                                          % (p["slow_suppressed"], p["slow_suppressed_worst_ms"])) if p["slow_suppressed"] else ""))
    else:
        print("  slow frames  none")
PY
        exit $?
    fi
    _json=false; _ival=10
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) _json=true; shift ;;
            --interval)
                if [[ ! "${2:-}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then echo "$_usage" >&2; exit 2; fi
                _ival="$2"; shift 2 ;;
            --interval=*)
                _ival="${1#--interval=}"
                if [[ ! "$_ival" =~ ^[0-9]+([.][0-9]+)?$ ]]; then echo "$_usage" >&2; exit 2; fi
                shift ;;
            *) echo "$_usage" >&2; exit 2 ;;
        esac
    done
    _a="$(_perf_curl "http://127.0.0.1:$_kport/perf")" || exit 1
    if $_json; then
        printf '%s\n' "$_a"
        exit 0
    fi
    sleep "$_ival"
    _b="$(_perf_curl "http://127.0.0.1:$_kport/perf")" || exit 1
