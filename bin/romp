parts = []
for kind in ("full", "delta", "deduped"):
    slots = set((b.get("sends") or {}).get(kind, {})) | set((a.get("sends") or {}).get(kind, {}))
    tot = sum(dl("sends", kind, sl, "bytes") for sl in slots)
