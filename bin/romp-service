#!/usr/bin/env bash
# romp-service — install/remove the login agent that keeps romp-manager (and thus the
# kernel) running at login, so you never run `romp on`: log in, open the browser, and
# you can even start sessions FROM it (the kernel is up before any session exists).
# Cross-platform: a launchd user agent on macOS, a systemd --user service on Linux.
#   romp-service install     write + load the agent (auto-start at login)
#   romp-service uninstall    unload + remove it
#   romp-service stop         stop the running agent and keep it stopped (`romp down` calls this);
#                             exit 3 when no agent is installed, so the caller can stop the
#                             manager some other way
#   romp-service start        start the installed agent again (`romp up` calls this); exit 3 when
#                             none is installed
#   romp-service status       installed? running? which key source (file, or the credential
#                             command with its selector), whether ExecStart runs the manager
#                             through a shell, credential-shaped NAMES a unit or service.env carries
# Safe + idle-free: the kernel is hardened (Origin gate + token) and the producer is
# presence-gated (zero model calls when no browser is connected). Runs as a USER-level
# agent (no root). PATH + ROMP_DIR are baked into the unit so the service finds
# node / python3 / claude / the romp bins (reinstall after a PATH change to refresh).
# Non-secret settings the service needs but only shells have (e.g. ROMP_EXPECTED_AUTH)
# go in ~/.config/romp/service.env — read at manager start, never baked into the unit.
# API keys never go in that file: they reach the manager through the environment of
# whatever starts it. See SERVICE_ENV_FILE below and docs/reference.md.
set -euo pipefail

# Resolve the repo root through any symlink (matches the other bin/ consumers).
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
    tgt="$(readlink "$src")"
    case "$tgt" in /*) src="$tgt" ;; *) src="$(cd "$(dirname "$src")" && pwd)/$tgt" ;; esac
done
ROMP_DIR="$(cd "$(dirname "$src")/.." && pwd)"
MANAGER="${ROMP_MANAGER_BIN:-$ROMP_DIR/bin/romp-manager}"
LABEL="com.romp.manager"
STATE="${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}"
LOG="$STATE/manager.log"
# macOS Full Disk Access identity: the login agent runs the manager THROUGH this
# thin launcher, which execs it under a romp-owned copy of node at $ROMP_NODE
# (created by ensure_romp_node). TCC then labels the grant "romp-node" (romp
# only) instead of the shared "node". macOS-only; the Linux systemd unit is
# unchanged (no TCC there). See bin/romp-node-launch for the full rationale.
LAUNCHER="$ROMP_DIR/bin/romp-node-launch"
ROMP_NODE="$STATE/romp-node"

# Seams: OS, where the unit is written, whether to actually (un)load it (tests set
# ROMP_SERVICE_NO_LOAD=1 and point the dirs at a tmp path to assert unit content),
# and which launchctl to call (tests stub it to exercise the bootstrap retry path).
os="${ROMP_OS_OVERRIDE:-$(uname -s)}"
LAUNCHD_DIR="${ROMP_LAUNCHD_DIR:-$HOME/Library/LaunchAgents}"
SYSTEMD_DIR="${ROMP_SYSTEMD_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}"
NO_LOAD="${ROMP_SERVICE_NO_LOAD:-}"
LAUNCHCTL="${ROMP_LAUNCHCTL:-launchctl}"
SYSTEMCTL="${ROMP_SYSTEMCTL:-systemctl}"
# `romp down` leaves this marker (time + command) so a stopped kernel reads as stopped on purpose,
# not crashed: `romp status` and the status verb below say so, and `romp-manager ensure` (the
# SessionStart auto-start) refuses to bring the manager back while it exists. A deliberate start
# (`romp up`, `romp-manager up`, the login service) clears it.
DOWN_MARKER="$STATE/down-by-romp"
PLIST="$LAUNCHD_DIR/$LABEL.plist"
UNIT="$SYSTEMD_DIR/romp-manager.service"

# Extra service environment: plain KEY=VALUE lines loaded when the manager STARTS
# (not baked at install) — systemd reads the file via EnvironmentFile=-, the macOS
# login agent's launcher (romp-node-launch) parses it before exec. This is the
# documented seam for NON-SECRET env a shell has but a service doesn't
# (ROMP_EXPECTED_AUTH, say). API keys never go here: a key in a file is a copy of
# the credential that outlives its rotation. Keys reach the manager through the
# environment of whatever starts it (a shell startup file that loads them from a
# secrets manager; see docs/reference.md, "API keys on disk: the file mode"), and
# the sessions' own key through Claude Code's apiKeyHelper — or, with
# ROMP_CREDENTIAL_COMMAND set HERE (a non-secret command line), through that
# command, which the kernel runs per launch and whose output it injects
# (kernel/envsource.py; docs/reference.md, "Installing without keys on disk").
# Values are read fresh on every manager (re)start, so changing one never needs
# a reinstall. ROMP_SERVICE_ENV_FILE overrides the path (tests); ROMP_SERVICE_ENV is
# the alias kernel/keysource.py accepts after it, resolved the same way here so an
# install from a shell that set only the alias carries the path across
# (_service_env_override writes the primary name, which the launcher and the kernel
# read). Reading the primary alone made `romp keyswap`'s "install from this shell"
# remedy write no override line from such a shell (review find, 2026-09-06).
SERVICE_ENV_FILE="${ROMP_SERVICE_ENV_FILE:-${ROMP_SERVICE_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/romp/service.env}}"

# The instance-scoping env: the variables that say WHICH romp this service supervises.
# A second OS user on one machine (a kernel handed to another person) shares the machine's
# PORT space, so their manager/kernel/bus have to be renumbered; the rest of the profile
# (state root, Claude config dir, tmux socket) is the same set romp-manager's specEnv hands
# an aux kernel. The installing shell has them set; the unit did NOT, so a supervised manager
# came up on the defaults while every foreground `romp` command used the overrides — the
# manager's control port then collides with the primary user's and the service dies at login,
# with the CLI still reporting the configured port. Bake whatever is SET at install time, and
# nothing that isn't, so a default single-user install writes the same unit it always did.
# (Reinstall after changing one, exactly like PATH.)
# ROMP_KERNEL_PORT is here because it is the SAME value as ROMP_SERVE_PORT under the other name
# (bin/romp-serve owns that seam), and it is the spelling docs/reference.md tells people to set.
# Leaving it out meant following the docs wrote a unit with NO port: the supervised manager came
# up on the default, romp-serve stamped that default back over the inherited ROMP_KERNEL_PORT,
# and a second OS user's kernel bound the primary's port while their CLI kept printing the
# renumbered one. Exactly the failure the paragraph above describes, one variable further along.
_INSTANCE_VARS=(ROMP_SERVE_PORT ROMP_KERNEL_PORT ROMP_POSTAL_PORT ROMP_MANAGER_PORT ROMP_STATE_DIR CLAUDE_CONFIG_DIR ROMP_TMUX_SOCKET)

# The SET ones, formatted for the platform: $1 = plist (EnvironmentVariables dict pairs) or
# unit (systemd Environment= lines). Each line is newline-TERMINATED; the callers decide what
# the empty case looks like, because the two files want different things there.
_instance_env_block() {
    local v out=""
    for v in "${_INSTANCE_VARS[@]}"; do
        [[ -n "${!v:-}" ]] || continue
        if [[ "$1" == plist ]]; then
            out+="    <key>$v</key><string>${!v}</string>"$'\n'
        else
            out+="Environment=$v=${!v}"$'\n'
        fi
    done
    printf '%s' "$out"
}

# The kernel resolves the env file's path from ITS OWN environment (kernel/keysource.py reads
# ROMP_SERVICE_ENV_FILE, else the alias ROMP_SERVICE_ENV, else ${XDG_CONFIG_HOME:-~/.config}/romp/service.env)
# — and the service gets
# neither variable from the installing shell. So a non-default path baked into EnvironmentFile= below
# would be read by systemd/launchd and NOT by the kernel's live key read: `romp keyswap` would rewrite
# a file the kernel never looks at (review find, 2026-09-04). Carry the resolved path across whenever
# it is not the kernel's own default; a default install writes the same unit it always did.
_service_env_override() {
    [[ "$SERVICE_ENV_FILE" != "$HOME/.config/romp/service.env" ]] || return 0
    if [[ "$1" == plist ]]; then
        # XML-escaped: a path with & or < would otherwise yield a plist launchd cannot parse
        printf '    <key>ROMP_SERVICE_ENV_FILE</key><string>%s</string>\n' \
            "$(printf '%s' "$SERVICE_ENV_FILE" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g')"
    else
        # quoted: systemd word-splits an unquoted Environment= value, so a path with a space would be cut;
        # a backslash or double quote inside the value is escaped, or systemd drops the whole assignment;
        # % is doubled because Environment= undergoes specifier expansion (%h → home, %z → "invalid slot",
        # the assignment dropped) — verified with systemd-analyze --user verify
        printf 'Environment="ROMP_SERVICE_ENV_FILE=%s"\n' \
            "$(printf '%s' "$SERVICE_ENV_FILE" | sed 's/\\/\\\\/g; s/"/\\"/g; s/%/%%/g')"
    fi
}

write_plist() {
    mkdir -p "$LAUNCHD_DIR" "$STATE"
    # $() eats the trailing newline; put it back so </dict> keeps its own line. Empty → the
    # dict closes exactly as it did before this existed.
    local _plist_env; _plist_env="$(_instance_env_block plist)"
    if [[ -n "$_plist_env" ]]; then _plist_env+=$'\n'; fi
    local _plist_envf; _plist_envf="$(_service_env_override plist)"
    if [[ -n "$_plist_envf" ]]; then _plist_envf+=$'\n'; fi
    cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$LAUNCHER</string>
    <string>$MANAGER</string>
    <string>up</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$PATH</string>
    <key>ROMP_DIR</key><string>$ROMP_DIR</string>
    <key>ROMP_SUPERVISED</key><string>1</string>
${_plist_envf}${_plist_env}  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
EOF
}

write_unit() {
    mkdir -p "$SYSTEMD_DIR" "$STATE"
    # $() eats the trailing newline; put it back so the blank line before [Install] survives.
    # Empty → the block collapses to exactly the unit this wrote before it existed.
    local _unit_env; _unit_env="$(_instance_env_block unit)"
    if [[ -n "$_unit_env" ]]; then _unit_env+=$'\n'; fi
    local _unit_envf; _unit_envf="$(_service_env_override unit)"
    if [[ -n "$_unit_envf" ]]; then _unit_envf+=$'\n'; fi
    cat > "$UNIT" <<EOF
[Unit]
Description=romp kernel supervisor (romp-manager)
After=default.target

[Service]
ExecStart=$MANAGER up
Restart=always
RestartSec=2
Environment=PATH=$PATH
Environment=ROMP_DIR=$ROMP_DIR
Environment=ROMP_SUPERVISED=1
${_unit_envf}EnvironmentFile=-$(printf '%s' "$SERVICE_ENV_FILE" | sed 's/%/%%/g')
${_unit_env}
[Install]
WantedBy=default.target
EOF
}

# Create/refresh the romp-owned node copy that romp-node-launch runs the manager
# under (macOS Full Disk Access identity). A byte-for-byte copy of the live node
# so it runs standalone; skipped when node isn't found. ROMP_NODE_SRC overrides
# the source (tests). Never fatal — a copy failure just leaves romp-node-launch
# to fall back to the system node.
ensure_romp_node() {
    local src="${ROMP_NODE_SRC:-$(command -v node 2>/dev/null || true)}"
    [[ -n "$src" ]] || return 0
    mkdir -p "$STATE"
    if [[ ! -x "$ROMP_NODE" ]] || ! cmp -s "$src" "$ROMP_NODE"; then
        if cp "$src" "$ROMP_NODE.tmp" 2>/dev/null && chmod +x "$ROMP_NODE.tmp"; then
            mv -f "$ROMP_NODE.tmp" "$ROMP_NODE"
        else
            rm -f "$ROMP_NODE.tmp" 2>/dev/null || true
        fi
    fi
    return 0
}

# Install attribution (2026-07-20): four times in one day the agent was rewritten/unloaded and the
# reload never landed — and the failure, though loud on the CALLER's stderr, left no trace saying
# WHO ran the install. Append who/where/when to the same audit journal `romp refresh` writes, so
# "who reinstalled the service?" is one tail instead of forensics. Best-effort, never blocks.
audit_install() {
    {
        _aud="$STATE/restart-audit.jsonl"
        mkdir -p "$STATE"
        _sid="${CLAUDE_CODE_SESSION_ID:-}"
        _name=""
        [[ -n "$_sid" && -f "$STATE/names/$_sid" ]] && _name="$(cut -f1 "$STATE/names/$_sid" 2>/dev/null | head -1)"
        printf '{"t": %s, "action": "service-%s", "ppid": %s, "parent": "%s", "sid": "%s", "name": "%s"}\n' \
            "$(date +%s)" "$1" "$PPID" \
            "$(ps -o command= -p "$PPID" 2>/dev/null | head -1 | tr -d '"\\' | cut -c1-160)" \
            "$_sid" "$_name" >> "$_aud"
    } 2>/dev/null || true
}

# ---- `status`: the key source and the unit's shape (2026-09-05) ----
# Non-secret configuration only, read the way the kernel reads it (kernel/envsource.py): this
# environment first, then the LAST assignment of the same name in service.env, one layer of matching
# quotes stripped. Nothing here prints a value: `status` says WHICH source is in force and names the
# selector, and lists credential-shaped NAMES (ANTHROPIC_API_KEY, *_API_KEY, *_TOKEN — the kernel's
# rule) that a unit, a drop-in, the plist or service.env sets — never what they are set to.
_svc_cfg() {   # <NAME> → its value, "" when set nowhere
    local name="$1" line v
    v="${!name:-}"                                 # a second statement: ${!name} must see name assigned
    if [[ -z "$v" && -f "$SERVICE_ENV_FILE" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line#"${line%%[![:space:]]*}"}"
            [[ "$line" =~ ^${name}[[:space:]]*= ]] || continue
            v="${line#*=}"
            v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
        done < "$SERVICE_ENV_FILE"
        if [[ ${#v} -ge 2 ]]; then
            case "$v" in \"*\"|\'*\') v="${v:1:${#v}-2}" ;; esac
        fi
    fi
    printf '%s' "$v"
}

_is_credential_name() {   # sdk_backend._is_credential_name's rule
    case "$1" in ANTHROPIC_API_KEY|*_API_KEY|*_TOKEN) return 0 ;; *) return 1 ;; esac
}

_selector_word() {   # "(selector <name>)" | "(selector undeclared, N chars)" | "(no selector)" | "(selector file holds something that is not a name)"
    # the token is printed by NAME only when ROMP_CREDENTIAL_NAMES declares it — an undeclared token
    # could be anything, a pasted secret included, so it is described by its length alone
    local f tok names n
    f="$(_svc_cfg ROMP_CREDENTIAL_SELECTOR_FILE)"
    [[ -n "$f" ]] || f="${XDG_CONFIG_HOME:-$HOME/.config}/romp/credential-selector"
    [[ "$f" == "~/"* ]] && f="$HOME/${f#\~/}"
    if [[ ! -f "$f" ]]; then printf '(no selector)'; return 0; fi
    tok="$(head -c 4096 "$f" 2>/dev/null | tr -d '\r')"
    tok="${tok#"${tok%%[![:space:]]*}"}"; tok="${tok%"${tok##*[![:space:]]}"}"
    if [[ -z "$tok" ]]; then printf '(no selector)'; return 0; fi
    if [[ ! "$tok" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; then printf '(selector file holds something that is not a name)'; return 0; fi
    names=",$(_svc_cfg ROMP_CREDENTIAL_NAMES),"; names="${names// /}"
    if [[ "$names" == *",$tok,"* ]]; then printf '(selector %s)' "$tok"
    else printf '(selector undeclared, %d chars)' "${#tok}"; fi
}

_join_names() {   # " a b c " → "a, b, c"
    local names="$1"
    names="${names# }"; names="${names% }"
    printf '%s' "${names// /, }"
}

_split_env_words() {   # <Environment= body> → one word per line, systemd's rule (systemd.syntax(7), Quoting):
    # whitespace-separated; a quoted stretch ("…" or '…') is part of ONE word with its quotes removed, so
    # "A_TOKEN=x y" is one assignment and B_TOKEN=b inside "NOT=a B_TOKEN=b" is a value, not a name; a
    # backslash escapes the next character, inside and outside quotes (\" does not close a quote, "\ "
    # does not split a word); an unterminated quote ends the parse where systemd's ends: the words
    # completed before it are printed (systemd had taken them into the environment by the time it logged
    # "Invalid syntax, ignoring" for the rest), the word the quote opened is dropped with the rest of the
    # body, and the status is 1. Approximate on purpose, since the output is NAMES: systemd's
    # C-style escapes (\n, \xNN) become the character after the backslash, which can change a value but
    # never which name an assignment sets. The assignments happen on separate lines: `local a=1 b=${#a}`
    # expands ${#a} before `local` assigns a, so a one-line form read the CALLER's variable of that name.
    local body word q c i n have out
    body="$1"; word=""; q=""; have=0; out=""
    n=${#body}
    for (( i=0; i<n; i++ )); do
        c="${body:i:1}"
        if [[ "$c" == '\' ]]; then
            (( i++ ))
            (( i < n )) && word+="${body:i:1}"       # a trailing backslash escapes nothing
            have=1
        elif [[ -n "$q" ]]; then
            if [[ "$c" == "$q" ]]; then q=""; else word+="$c"; fi
        elif [[ "$c" == '"' || "$c" == "'" ]]; then
            q="$c"; have=1
        elif [[ "$c" == " " || "$c" == $'\t' ]]; then
            [[ $have -eq 1 ]] && out+="$word"$'\n'
            word=""; have=0
        else
            word+="$c"; have=1
        fi
    done
    if [[ -n "$q" ]]; then                            # unterminated: the words before the quote stand, the rest is refused
        printf '%s' "$out"
        return 1
    fi
    [[ $have -eq 1 ]] && out+="$word"$'\n'
    printf '%s' "$out"
    return 0
}

_unit_credential_names() {   # <unit|drop-in|plist>... → credential-shaped NAMES set with a value, in order, deduped
    (
        set -f                                     # no globbing while word-splitting Environment= bodies
        local f line body tok name val names=" "
        for f in "$@"; do
            [[ -f "$f" ]] || continue
            if [[ "$f" == *.plist ]]; then
                while IFS= read -r name; do
                    [[ -n "$name" ]] || continue
                    if _is_credential_name "$name" && [[ "$names" != *" $name "* ]]; then names+="$name "; fi
                done < <(tr -d '\n' < "$f" | grep -o '<key>[A-Za-z_][A-Za-z0-9_]*</key>[[:space:]]*<string>[^<][^<]*</string>' \
                         | sed 's/<key>\([^<]*\)<\/key>.*/\1/')
                continue
            fi
            while IFS= read -r line || [[ -n "$line" ]]; do
                line="${line#"${line%%[![:space:]]*}"}"
                [[ "$line" == Environment=* ]] || continue
                body="${line#Environment=}"
                while IFS= read -r tok; do
                    [[ "$tok" == *=* ]] || continue
                    name="${tok%%=*}"; val="${tok#*=}"
                    [[ -n "$val" ]] || continue
                    if _is_credential_name "$name" && [[ "$names" != *" $name "* ]]; then names+="$name "; fi
                done < <(_split_env_words "$body")
            done < "$f"
        done
        _join_names "$names"
    )
}

_env_file_credential_names() {   # <service.env> → credential-shaped NAMES with a non-empty value (keysource's line rule)
    local line name val names=" "
    [[ -f "$1" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line#"${line%%[![:space:]]*}"}"
        if [[ -z "$line" || "$line" == \#* || "$line" != *=* ]]; then continue; fi
        name="${line%%=*}"; name="${name%"${name##*[![:space:]]}"}"
        val="${line#*=}"; val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
        if [[ ${#val} -ge 2 ]]; then case "$val" in \"*\"|\'*\') val="${val:1:${#val}-2}" ;; esac; fi
        [[ -n "$val" ]] || continue
        if _is_credential_name "$name" && [[ "$names" != *" $name "* ]]; then names+="$name "; fi
    done < "$1"
    _join_names "$names"
}

_exec_start_shape() {   # <unit|drop-in|plist>... → "direct" | "shell" | "" (nothing found); the LAST ExecStart wins, an empty one resets
    local f line last="" pa
    for f in "$@"; do
        [[ -f "$f" ]] || continue
        if [[ "$f" == *.plist ]]; then
            pa="$(tr -d '\n' < "$f" | sed -n 's/.*<key>ProgramArguments<\/key>[[:space:]]*<array>[[:space:]]*<string>\([^<]*\)<\/string>.*/\1/p')"
            [[ -n "$pa" ]] && last="$pa"
            continue
        fi
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line#"${line%%[![:space:]]*}"}"
            [[ "$line" == ExecStart=* ]] && last="${line#ExecStart=}"
        done < "$f"
    done
    last="$(printf '%s' "$last" | sed 's/^[[:space:]]*[-@:+!]*//')"
    [[ -n "$last" ]] || return 0
    (
        set -f
        set -- $last
        [[ -n "${1:-}" ]] || exit 0
        local argv0; argv0="$(basename "$1")"; argv0="${argv0//\"/}"; argv0="${argv0//\'/}"
        if [[ "$argv0" == env ]]; then
            shift; while [[ $# -gt 0 && "$1" == *=* ]]; do shift; done
            [[ -n "${1:-}" ]] || exit 0
            argv0="$(basename "$1")"
        fi
        case "$argv0" in sh|bash|zsh|dash|ksh|fish) printf 'shell' ;; *) printf 'direct' ;; esac
    )
}

_status_key_source() {   # <unit|plist> [drop-in...] — the lines `status` adds after installed/running
    local shape names
    if [[ -n "$(_svc_cfg ROMP_CREDENTIAL_COMMAND)" ]]; then
        echo "key source: command $(_selector_word)"
    else
        echo "key source: file"
    fi
    shape="$(_exec_start_shape "$@")"
    case "$shape" in
      direct) echo "ExecStart: runs the manager directly" ;;
      shell)  echo "ExecStart: runs the manager through a shell (its variables freeze until a manager restart)" ;;
    esac
    names="$(_unit_credential_names "$@")"
    [[ -z "$names" ]] || echo "unit carries credential-shaped lines: $names"
    names="$(_env_file_credential_names "$SERVICE_ENV_FILE")"
    [[ -z "$names" ]] || echo "service.env carries credential-shaped lines: $names"
}

_linux_active() { "$SYSTEMCTL" --user is-active romp-manager.service 2>/dev/null || true; }
_darwin_loaded() { "$LAUNCHCTL" print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; }

# The marker's one line for a status listing: when it was stopped and how to bring it back. Nothing
# when there is no marker. python3 renders the time (a plain `date -d @` is GNU-only).
_down_marker_line() {
    [[ -f "$DOWN_MARKER" ]] || return 0
    local when
    when="$(python3 - "$DOWN_MARKER" 2>/dev/null <<'PYRENDER' || true
import json, sys, time
try:
    d = json.load(open(sys.argv[1]))
    t = int(d.get("t") or 0)
except Exception:
    t = 0
if t:
    fmt = "%H:%M" if time.strftime("%Y-%m-%d", time.localtime(t)) == time.strftime("%Y-%m-%d") else "%Y-%m-%d %H:%M"
    print(time.strftime(fmt, time.localtime(t)))
PYRENDER
)"
    echo "stopped by romp down${when:+ at $when} (romp up to start)"
}

# stop / start: the supervisor-side halves of `romp down` and `romp up`. They act on the INSTALLED
# agent only — exit 3 when there is none, so the caller can stop or start the manager directly
# instead (a foreground `romp up` has no agent). A stop through the supervisor is what keeps the
# kernel down: the manager exiting on its own is a crash to it (Restart=always / KeepAlive) and
# it would respawn within seconds. On macOS the job is booted out (it comes back at the next login
# or `start`); on Linux the unit is stopped (still enabled, so it comes back at the next login too).
_service_stop() {
    case "$os" in
      Darwin)
        [[ -f "$PLIST" ]] || { echo "romp-service: no login agent is installed" >&2; return 3; }
        if [[ -z "$NO_LOAD" ]]; then
            if _darwin_loaded; then
                "$LAUNCHCTL" bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
                # bootout only STARTS the teardown (the install path's lesson): wait for the job to
                # actually leave launchd, bounded, so "stopped" is true when we say it
                for _ in $(seq 1 100); do
                    _darwin_loaded || break
                    sleep 0.3
                done
                if _darwin_loaded; then
                    echo "romp-service: the login agent is still draining after 30s — check $LOG" >&2
                    return 1
                fi
            fi
        fi
        echo "  Stopped the login agent; it stays stopped until \`romp up\` or the next login." ;;
      Linux)
        [[ -f "$UNIT" ]] || { echo "romp-service: no login service is installed" >&2; return 3; }
        if [[ -z "$NO_LOAD" ]]; then
            if ! "$SYSTEMCTL" --user stop romp-manager.service; then
                echo "romp-service: systemctl --user stop romp-manager.service failed" >&2
                return 1
            fi
        fi
        echo "  Stopped the login service; it stays stopped until \`romp up\` or the next login." ;;
      *) echo "romp-service: unsupported OS '$os'" >&2; return 1 ;;
    esac
}

_service_start() {
    case "$os" in
      Darwin)
        [[ -f "$PLIST" ]] || { echo "romp-service: no login agent is installed" >&2; return 3; }
        if [[ -z "$NO_LOAD" ]]; then
            if _darwin_loaded; then
                # loaded but stopped (or already running): kickstart is idempotent
                "$LAUNCHCTL" kickstart "gui/$(id -u)/$LABEL" 2>/dev/null || true
            else
                # booted out by `stop`: load it again the way install does, loudly on failure
                local loaded="" err=""
                for _ in $(seq 1 10); do
                    if err="$("$LAUNCHCTL" bootstrap "gui/$(id -u)" "$PLIST" 2>&1)"; then loaded=1; break; fi
                    sleep 0.3
                done
                if [[ -z "$loaded" ]]; then
                    echo "romp-service: FAILED to load the login agent — romp-manager is NOT running." >&2
                    echo "  launchctl bootstrap: ${err:-unknown error}" >&2
                    return 1
                fi
            fi
        fi
        echo "  Started the login agent (romp-manager)." ;;
      Linux)
        [[ -f "$UNIT" ]] || { echo "romp-service: no login service is installed" >&2; return 3; }
        if [[ -z "$NO_LOAD" ]]; then
            if ! "$SYSTEMCTL" --user start romp-manager.service; then
                echo "romp-service: systemctl --user start romp-manager.service failed" >&2
                return 1
            fi
        fi
        echo "  Started the login service (romp-manager)." ;;
      *) echo "romp-service: unsupported OS '$os'" >&2; return 1 ;;
    esac
}

case "${1:-status}" in
  install)
    audit_install install
    case "$os" in
      Darwin)
        write_plist
        ensure_romp_node
        if [[ -z "$NO_LOAD" ]]; then
            "$LAUNCHCTL" bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true   # drop any prior copy
            # bootout only STARTS the old job's teardown, and a manager draining live SDK
            # sessions takes far longer than a blind retry window — every bootstrap issued
            # while it drains is rejected ("Input/output error"), which is exactly how
            # 2026-07-20 ended (twice) with NO agent loaded and a dead dashboard. So wait
            # for the EVENT those retries were approximating: the old job actually
            # disappearing from launchd. Bounded poll; the loud failure below still
            # backstops a job that never finishes draining.
            for _ in $(seq 1 100); do
                "$LAUNCHCTL" print "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || break
                sleep 0.3
            done
            # A bootstrap can still race launchd's bookkeeping right after the job drops.
            # Retry until launchd accepts, and fail LOUDLY if it never does:
            # swallowing this error once left NO agent loaded at all (no manager,
            # no kernel, dead dashboard) with nothing saying why.
            loaded=""
            for _ in $(seq 1 10); do
                if err="$("$LAUNCHCTL" bootstrap "gui/$(id -u)" "$PLIST" 2>&1)"; then loaded=1; break; fi
                sleep 0.3
            done
            if [[ -z "$loaded" ]]; then
                echo "romp-service: FAILED to load the login agent — romp-manager is NOT running." >&2
                echo "  launchctl bootstrap: ${err:-unknown error}" >&2
                echo "  Retry by hand: launchctl bootstrap gui/$(id -u) \"$PLIST\"" >&2
                exit 1
            fi
            # bootstrap ACCEPTED ≠ job RUNNING: launchd can accept the definition and still fail
            # the spawn (bad launcher path, env). Verify the service actually reports itself
            # before exiting 0 — an install that "succeeded" onto a dead agent is exactly the
            # silent outage this script keeps causing.
            running=""
            for _ in $(seq 1 20); do
                if "$LAUNCHCTL" print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then running=1; break; fi
                sleep 0.3
            done
            if [[ -z "$running" ]]; then
                echo "romp-service: agent loaded but is NOT running — check $LOG" >&2
                exit 1
            fi
        fi
        echo "  Installed launchd agent: $PLIST"
        echo "  romp-manager now auto-starts at login — just open the browser."
        echo "  Extra service env (non-secret settings, e.g. ROMP_EXPECTED_AUTH): $SERVICE_ENV_FILE"
        echo "      KEY=VALUE lines, picked up at manager (re)start. API keys never go in it: set"
        echo "      ROMP_CREDENTIAL_COMMAND there instead (docs/reference.md, Installing without keys on"
        echo "      disk), or let the environment of whatever starts the manager carry them."
        if [[ -x "$ROMP_NODE" ]]; then
            echo
            echo "  Full Disk Access: grant it to romp's OWN node copy (not plain 'node'):"
            echo "      $ROMP_NODE"
            echo "  in System Settings > Privacy & Security > Full Disk Access (+, paste the path)."
            echo "  That scopes the grant to romp alone; re-grant once after a node upgrade."
        fi ;;
      Linux)
        write_unit
        if [[ -z "$NO_LOAD" ]]; then
            "$SYSTEMCTL" --user daemon-reload
            "$SYSTEMCTL" --user enable --now romp-manager.service
            loginctl enable-linger "$(id -un)" 2>/dev/null || true   # survive logout (best-effort)
        fi
        echo "  Installed systemd --user service: $UNIT"
        echo "  romp-manager now auto-starts at login — just open the browser."
        echo "  Extra service env (non-secret settings, e.g. ROMP_EXPECTED_AUTH): $SERVICE_ENV_FILE"
        echo "      KEY=VALUE lines, picked up at manager (re)start. API keys never go in it: set"
        echo "      ROMP_CREDENTIAL_COMMAND there instead (docs/reference.md, Installing without keys on"
        echo "      disk), or let the environment of whatever starts the manager carry them." ;;
      *) echo "romp-service: unsupported OS '$os'" >&2; exit 1 ;;
    esac ;;
  uninstall)
    case "$os" in
      Darwin)
        if [[ -z "$NO_LOAD" ]]; then
            "$LAUNCHCTL" bootout "gui/$(id -u)/$LABEL" 2>/dev/null || "$LAUNCHCTL" unload "$PLIST" 2>/dev/null || true
        fi
        rm -f "$PLIST"
        echo "  Removed launchd agent." ;;
      Linux)
        if [[ -z "$NO_LOAD" ]]; then
            "$SYSTEMCTL" --user disable --now romp-manager.service 2>/dev/null || true
        fi
        rm -f "$UNIT"
        if [[ -z "$NO_LOAD" ]]; then "$SYSTEMCTL" --user daemon-reload 2>/dev/null || true; fi
        echo "  Removed systemd --user service." ;;
      *) echo "romp-service: unsupported OS '$os'" >&2; exit 1 ;;
    esac ;;
  stop)  _service_stop ;;
  start) _service_start ;;
  status)
    case "$os" in
      Darwin)
        if [[ -f "$PLIST" ]]; then echo "installed: $PLIST"; else echo "not installed"; fi
        if [[ -z "$NO_LOAD" ]] && _darwin_loaded; then echo "running"; else _down_marker_line; fi
        _status_key_source "$PLIST" ;;
      Linux)
        if [[ -f "$UNIT" ]]; then echo "installed: $UNIT"; else echo "not installed"; fi
        if [[ -z "$NO_LOAD" ]] && [[ "$(_linux_active)" == "active" ]]; then echo "running"; else _down_marker_line; fi
        _status_key_source "$UNIT" "$UNIT.d"/*.conf ;;
      *) echo "romp-service: unsupported OS '$os'" >&2; exit 1 ;;
    esac ;;
  *) echo "usage: romp-service [install|uninstall|stop|start|status]" >&2; exit 2 ;;
esac
