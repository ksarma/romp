#!/usr/bin/env bash
# romp-serve — launches the romp web UI kernel for the manager (bin/romp-manager) to
# supervise. It is the seam between the manager's spawn contract and the kernel: the
# manager runs `romp-serve --port N` (with ROMP_SERVE_PORT / ROMP_MANAGER_PID in env)
# and supervises the resulting PID. We map those onto the Python kernel's env and
# `exec` it, so the manager keeps supervising the same PID and the kernel self-builds
# its UI bundles if stale.
#   romp-serve [--port N] [--host H]
# Host precedence: --host > local-only. The kernel stays bound to 127.0.0.1;
# tailnet/phone reach goes through `tailscale serve` proxying to loopback
# (docs/guide.md#from-your-phone), so there is no persisted off-loopback opt-in
# (`romp --serve` removed 2026-07-19). --host remains as the manager's spawn seam.
set -euo pipefail

# Resolve the repo root through any symlink (matches the other bin/ consumers).
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
    tgt="$(readlink "$src")"
    case "$tgt" in
        /*) src="$tgt" ;;
        *)  src="$(cd "$(dirname "$src")" && pwd)/$tgt" ;;
    esac
done
ROMP_DIR="$(cd "$(dirname "$src")/.." && pwd)"
# ROMP_KERNEL_BIN is the test seam (same pattern as ROMP_*_BIN elsewhere).
KERNEL="${ROMP_KERNEL_BIN:-$ROMP_DIR/bin/romp-kernel}"

# Port: the manager passes --port; fall back to the env, then the kernel default.
#
# ROMP_SERVE_PORT and ROMP_KERNEL_PORT are TWO SPELLINGS OF ONE VALUE: the port the kernel
# listens on. The split is historical and role-based, not semantic. ROMP_SERVE_PORT is the
# service-facing spelling (romp-manager, romp-service's unit, the wake hook, the VS Code
# extension); ROMP_KERNEL_PORT is the process-facing one (kernel.py, the postal bus, every
# `romp` CLI verb). This script is the seam between them, so it is where they have to agree.
#
# It used to read only ROMP_SERVE_PORT and then unconditionally OVERWRITE ROMP_KERNEL_PORT
# from it. Someone renumbering a second kernel by the documented knob alone (docs/reference.md
# names ROMP_KERNEL_PORT and not the other) got the two silently pulled apart: the unit carried
# no port, the manager fell back to the default, this script stamped that default over the
# inherited ROMP_KERNEL_PORT, and the second kernel bound the FIRST one's port while every
# foreground `romp` command went on printing the renumbered one. A collision that reports
# success is the exact shape the authoritative-sources rule exists to prevent, so now: accept
# either spelling, and if both are set and DISAGREE with no --port to settle it, refuse.
port=""
host=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --port) port="${2:-}"; shift 2 ;;
        --host) host="${2:-}"; shift 2 ;;
        *) shift ;;
    esac
done
if [[ -z "$port" ]]; then
    _sp="${ROMP_SERVE_PORT:-}"
    _kp="${ROMP_KERNEL_PORT:-}"
    if [[ -n "$_sp" && -n "$_kp" && "$_sp" != "$_kp" ]]; then
        echo "romp-serve: ROMP_SERVE_PORT=$_sp and ROMP_KERNEL_PORT=$_kp disagree." >&2
        echo "  They are two names for the kernel's listen port and must match. Set one, or pass --port." >&2
        exit 1
    fi
    port="${_sp:-$_kp}"
fi

# Host: explicit --host wins; else local-only. A leftover serve-host state file
# from the removed `romp --serve` opt-in is deliberately IGNORED — a stale file
# must never silently rebind the kernel off loopback.
host="${host:-127.0.0.1}"

[[ -x "$KERNEL" ]] || { echo "romp-serve: kernel not found/executable at $KERNEL" >&2; exit 1; }

# The kernel runs on the python its SDK venv was built with, not blindly `python3` and not whatever
# is newest: the Agent SDK backend is imported INTO the kernel process (the venv's site-packages join
# sys.path), so interpreter and venv must agree. Order: ROMP_PYTHON (checked to be an executable
# interpreter), then the interpreter the venv's pyvenv.cfg records (checked to run and to be the
# recorded X.Y), then another python of that same X.Y on PATH or in ~/.local/bin, then the newest
# pythonX.Y found (the SDK needs >= 3.10, and some hosts pin the system python3 older, Ubuntu 20.04 =
# 3.8, with a newer one alongside, e.g. a uv-managed 3.12 in ~/.local/bin, probed explicitly because a
# non-login ssh shell doesn't have it on PATH).
# KEEP IN SYNC with bin/romp-sdk-setup's pick_python — the SDK venv must be built with the SAME
# interpreter the kernel runs.
pick_python() {
    if [[ -n "${ROMP_PYTHON:-}" ]]; then
        # The pin is checked, not echoed as-is. A pin naming nothing runnable used to reach romp-serve's
        # exec, which died on bash's own "No such file or directory" with no mention of the pin while the
        # manager crash-looped on it, and romp-sdk-setup called the same pin a too-old python. The docs
        # tell operators to pin ROMP_PYTHON in service.env, so a typo, or an upgrade that removes the
        # pinned interpreter, lands here. A bare command name is looked up on PATH, as the exec would.
        local pin="$ROMP_PYTHON"
        [[ "$pin" == */* ]] || pin="$(type -P "$pin" 2>/dev/null || true)"
        if [[ -z "$pin" || ! -f "$pin" || ! -x "$pin" ]]; then
            echo "romp: ROMP_PYTHON=$ROMP_PYTHON is not an executable interpreter (set in service.env?)" >&2
            exit 1
        fi
        echo "$ROMP_PYTHON"; return
    fi
    local v c
    # THE VENV FIRST. bin/romp-sdk-setup builds the SDK venv with the interpreter this function picked at
    # the time, and pyvenv.cfg records it. Running anything else imports 3.X-compiled extensions into a
    # 3.Y process: on 2026-09-06 a `uv python install 3.14` in an unrelated shell put a python3.14 into
    # ~/.local/bin, the next kernel respawn picked it over the venv's 3.12, and every SDK session died at
    # import for two hours while the message blamed a missing install. So a box that HAS a venv runs the
    # venv's interpreter, however old, and the newest-first walk below is only for a box without one
    # (or whose recorded interpreter is gone; then we say so and romp-sdk-setup rebuilds to match).
    # Builtins only in here: the unit tests run it on a bare PATH. Kept in sync with romp-sdk-setup.
    #
    # A candidate must RUN, and when the cfg names a version it must BE that python X.Y: `home` is a
    # directory, and a distro upgrade that removes python3.12 and repoints home/python3 at 3.14 leaves
    # that path present and runnable while the venv's extensions are still 3.12's, the exact failure
    # the recorded interpreter exists to prevent. The check is a version-tuple compare (builtins only),
    # and it is bounded: this is the first place the picker executes a candidate, and an interpreter
    # that blocks (a stalled network mount, a sitecustomize reaching for the network) would otherwise
    # hang the launch with the manager watching a live pid. `timeout 5` where coreutils provides it (a
    # bare test PATH does not); running out the clock counts as not runnable.
    _runs_as() {   # $1 candidate, $2 the X.Y it must be, or "" for "runs at all"
        local -a run=("$1")
        if command -v timeout >/dev/null 2>&1; then run=(timeout 5 "$1"); fi
        if [[ -n "$2" ]]; then
            "${run[@]}" -c "import sys; sys.exit(sys.version_info[:2] != (${2%%.*}, ${2#*.}))" >/dev/null 2>&1
        else
            "${run[@]}" -c pass >/dev/null 2>&1
        fi
    }
    local state="${ROMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/romp}"
    local cfg="$state/sdkvenv/pyvenv.cfg"
    if [[ -r "$cfg" ]]; then
        local key val exe="" home="" ver="" mm=""
        while IFS='=' read -r key val || [[ -n "$key" ]]; do
            key="${key%%[[:space:]]*}"
            val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
            case "$key" in
                executable)           exe="$val" ;;    # python >= 3.11 writes the binary itself
                home)                 home="$val" ;;   # older venvs: the bin dir plus a version line
                version|version_info) ver="$val" ;;    # `version` from venv, `version_info` from uv
            esac
        done < "$cfg"
        [[ "$ver" =~ ^([0-9]+\.[0-9]+) ]] && mm="${BASH_REMATCH[1]}"
        # The home candidates need the version. Without it `$home/python$mm` is the bare `$home/python`
        # (python2 on many boxes) and `$home/python3` can be checked against nothing, so a cfg with a
        # home but no version line (hand-edited or truncated; venv, uv and virtualenv all write one)
        # offers only its `executable`, the recorded binary itself.
        for c in "$exe" "${mm:+${home:+$home/python$mm}}" "${mm:+${home:+$home/python3}}"; do
            [[ -n "$c" && -x "$c" ]] || continue
            if _runs_as "$c" "$mm"; then echo "$c"; return; fi
        done
        local rec="${exe:-${home:-?}/python${mm:-?}}"
        # SAME MINOR NEXT. The venv's site-packages are ABI-valid for any python $mm, so another python$mm
        # on PATH or in ~/.local/bin keeps the kernel and the venv agreeing with nothing rebuilt:
        # `executable` is a realpath into a patch-versioned install root (Homebrew's Cellar, a uv
        # per-patch directory), which a patch upgrade removes while `python3.12` on PATH still runs.
        # Newest-first is the last resort, and it costs a rebuild.
        if [[ -n "$mm" ]]; then
            for c in "python$mm" "$HOME/.local/bin/python$mm"; do
                c="$(command -v "$c" 2>/dev/null || true)"
                [[ -n "$c" ]] || continue
                if _runs_as "$c" "$mm"; then
                    echo "romp: the SDK venv at $state/sdkvenv was built with $rec, which is gone, will not run, or is no longer python $mm; using $c, another python $mm, so the venv still matches." >&2
                    echo "$c"; return
                fi
            done
        fi
        echo "romp: the SDK venv at $state/sdkvenv was built with $rec, which is gone, will not run, or is no longer python ${mm:-?}, and no other python ${mm:-?} was found; picking the newest python instead. Re-run bin/romp-sdk-setup to rebuild the venv for it." >&2
    fi
    # Newest first. The list has to GROW with each release: a machine whose only python is newer than
    # everything named here falls through to `python3`, which is right when that IS the new one and wrong
    # when python3 points at something ancient. Seen on a 3.14-only box, 2026-07-28.
    for v in 3.14 3.13 3.12 3.11 3.10; do
        for c in "python$v" "$HOME/.local/bin/python$v"; do
            if command -v "$c" >/dev/null 2>&1; then command -v "$c"; return; fi
        done
    done
    command -v python3 || { echo "romp: no python3 on PATH" >&2; exit 1; }
}
PY="$(pick_python)"

# Map onto the kernel's env, then exec it (preserving the PID for the manager).
# ROMP_MANAGER_PID (parent-death watchdog) and ROMP_SERVE_TOKEN (auto-loaded from the
# persisted token file if unset) flow through untouched. ROMP_KERNEL_NO_OPEN keeps a
# supervised kernel from popping a browser on every (re)spawn.
export ROMP_DIR
export ROMP_BIN="${ROMP_BIN:-$ROMP_DIR/bin/romp}"
# Export BOTH spellings from the ONE resolved port, so nothing downstream can read a stale
# inherited copy of the other name: the kernel and the postal bus read ROMP_KERNEL_PORT, while
# the wake hook and any `romp` CLI run inside a session of this kernel may read either. Unset
# stays unset (the kernel applies its own default), so a bare launch is unchanged.
if [[ -n "$port" ]]; then
    export ROMP_KERNEL_PORT="$port"
    export ROMP_SERVE_PORT="$port"
fi
export ROMP_SERVE_HOST="$host"
export ROMP_KERNEL_NO_OPEN=1
exec "$PY" "$KERNEL"
